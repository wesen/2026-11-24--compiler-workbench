{
  "name": "compiler-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "An inspectable compiler workbench: the IR Workbench v6 framework extended for a complete Typed -> RV32 compiler",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "build:site": "node tools/build-site.mjs",
    "serve:site": "node tools/serve-site.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\"",
    "test:only": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
