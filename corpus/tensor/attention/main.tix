fn attention(q: f32[Q, D], k: f32[K, D], v: f32[K, V]): f32[Q, V] {
  scores[i, j] = (sum(d) q[i, d] * k[j, d]) / sqrt(D);
  m[i] = max(j) scores[i, j];
  e[i, j] = exp(scores[i, j] - m[i]);
  denom[i] = sum(j) e[i, j];
  p[i, j] = e[i, j] / denom[i];
  y[i, h] = sum(j) p[i, j] * v[j, h];
  return y;
}
