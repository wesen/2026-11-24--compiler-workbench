fn attention(q: f32[Q, D], k: f32[K, D], v: f32[K, V]): f32[Q, V] {
  score[i, j] = (sum(d) q[i, d] * k[j, d]) / sqrt(D);
  peak[i] = max(j) score[i, j];
  e[i, j] = exp(score[i, j] - peak[i]);
  denom[i] = sum(j) e[i, j];
  weights[i, j] = e[i, j] / denom[i];
  y[i, c] = sum(j) weights[i, j] * v[j, c];
  return y;
}
