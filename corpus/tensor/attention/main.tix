fn attention(q: f32[Q,D], k: f32[K,D], v: f32[K,V]): f32[Q,V] {
  score[i,j] = (sum(d) q[i,d] * k[j,d]) / sqrt(D);
  peak[i] = max(j) score[i,j];
  weight[i,j] = exp(score[i,j] - peak[i]);
  total[i] = sum(j) weight[i,j];
  prob[i,j] = weight[i,j] / total[i];
  y[i,h] = sum(j) prob[i,j] * v[j,h];
  return y;
}
