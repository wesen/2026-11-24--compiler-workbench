// The "inside" division placement of attention: the score reduction divides per term and the output
// reduction divides by the row sum per term, with no weight statement.
fn attention(q: f32[Q,D], k: f32[K,D], v: f32[K,V]): f32[Q,V] {
  s[i,j] = sum(d) q[i,d] * k[j,d] / sqrt(D);
  m[i] = max(j) s[i,j];
  e[i,j] = exp(s[i,j] - m[i]);
  l[i] = sum(j) e[i,j];
  o[i,c] = sum(j) e[i,j] * v[j,c] / l[i];
  return o;
}
