// An MLP block: linear, GELU in its tanh form, linear.
fn mlp(x: f32[N, D], w1: f32[D, H], b1: f32[H], w2: f32[H, D], b2: f32[D]): f32[N, D] {
  h[n, j] = (sum(i) x[n, i] * w1[i, j]) + b1[j];
  g[n, j] = 0.5 * h[n, j] * (1 + tanh(0.7978845608 * (h[n, j] + 0.044715 * h[n, j] * h[n, j] * h[n, j])));
  y[n, i] = (sum(j) g[n, j] * w2[j, i]) + b2[i];
  return y;
}
