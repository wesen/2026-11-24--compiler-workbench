// Two dense layers separated by tanh-approximated GELU.
fn mlp(x: f32[N,D], w: f32[D,H], b: f32[H], v: f32[H,O], c: f32[O]): f32[N,O] {
  a[i,h] = (sum(d) x[i,d] * w[d,h]) + b[h];
  g[i,h] = 0.5 * a[i,h] * (1 + tanh(0.7978845608028654 * (a[i,h] + 0.044715*a[i,h]*a[i,h]*a[i,h])));
  y[i,j] = (sum(h) g[i,h] * v[h,j]) + c[j];
  return y;
}
