fn mlp(x: f32[N, I], w1: f32[I, H], b1: f32[H], w2: f32[H, O], b2: f32[O]): f32[N, O] {
  hidden[i, j] = (sum(k) x[i, k] * w1[k, j]) + b1[j];
  gelu[i, j] = 0.5 * hidden[i, j] * (1 + tanh(0.7978845608028654 *
    (hidden[i, j] + 0.044715 * hidden[i, j] * hidden[i, j] * hidden[i, j])));
  y[i, j] = (sum(k) gelu[i, k] * w2[k, j]) + b2[j];
  return y;
}
