fn mlp(x: f32[N, D], w1: f32[D, H], b1: f32[H], w2: f32[H, O], b2: f32[O]): f32[N, O] {
  h[i, j] = (sum(d) x[i, d] * w1[d, j]) + b1[j];
  g[i, j] = 0.5 * h[i, j] * (1 + tanh(0.7978845608028654 * (h[i, j] + 0.044715 * h[i, j] * h[i, j] * h[i, j])));
  y[i, j] = (sum(hh) g[i, hh] * w2[hh, j]) + b2[j];
  return y;
}
