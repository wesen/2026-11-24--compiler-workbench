fn mlp(x: f32[N, I], w1: f32[I, H], b1: f32[H], w2: f32[H, O], b2: f32[O]): f32[N, O] {
  z[i, h] = (sum(d) x[i, d] * w1[d, h]) + b1[h];
  g[i, h] = 0.5 * z[i, h] * (1 + tanh(0.7978845608028654 * (z[i, h] + 0.044715 * z[i, h] * z[i, h] * z[i, h])));
  y[i, o] = (sum(h) g[i, h] * w2[h, o]) + b2[o];
  return y;
}
