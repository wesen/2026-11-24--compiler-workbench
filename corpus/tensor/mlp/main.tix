fn mlp(x: f32[N, D], w1: f32[D, H], b1: f32[H], w2: f32[H, O], b2: f32[O]): f32[N, O] {
  a[i, h] = (sum(d) x[i, d] * w1[d, h]) + b1[h];
  // tanh approximation to GELU
  g[i, h] = 0.5 * a[i, h] * (1 + tanh(0.7978845608028654 * (a[i, h] + 0.044715 * a[i, h] * a[i, h] * a[i, h])));
  y[i, o] = (sum(h) g[i, h] * w2[h, o]) + b2[o];
  return y;
}
