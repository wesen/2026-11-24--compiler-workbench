function sign(x: i32): i32 {
    if (x < 0) { return 0 - 1; }
    if (x > 0) { return 1; }
    return 0;
}
function grade(score: i32): i32 {
    let g = 0;
    if (score >= 90) {
        g = 4;
    } else {
        if (score >= 80) {
            g = 3;
        } else {
            if (score >= 70) {
                g = 2;
            } else {
                g = 1;
            }
        }
    }
    return g;
}
