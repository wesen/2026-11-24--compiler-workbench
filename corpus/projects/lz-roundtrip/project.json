{
  "title": "LZ round trip",
  "about": [
    "Find repeated triples through a hash chain, then decode literals and",
    "overlapping back-references with checked buffer accesses."
  ],
  "group": "Programs",
  "sources": ["main.typed"],
  "pipeline": "speed",
  "ingest": { "tape": true },
  "focus": 74,
  "scripts": {
    "explore": { "about": "Encode and decode 24 A cells and count RV32 instructions.", "fresh": true }
  },
  "inputs": {
    "hash3": { "a": [0, 127], "b": [0, 127], "c": [0, 127] },
    "compress": {
      "input": { "buffer": [0, 24], "cell": [65, 66] },
      "packed": { "buffer": [24, 24], "cell": [0, 0] },
      "chainLimit": [1, 3]
    },
    "decompress": {
      "packed": { "cells": [65, 224, 66, 192, 127] },
      "packedLen": 5,
      "output": { "buffer": [24, 24], "cell": [0, 0] }
    },
    "roundTrip": {
      "input": { "buffer": [0, 24], "cell": [65, 66] },
      "packed": { "buffer": [24, 24], "cell": [0, 0] },
      "output": { "buffer": [24, 24], "cell": [0, 0] },
      "chainLimit": [1, 3]
    }
  }
}
