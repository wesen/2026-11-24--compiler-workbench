enum Shape { Circle, Square = 4, Tri }
record Point { x: i32; y: i32; }
function area(s: Shape, k: i32): i32 {
    let r = 0;
    match (s) {
        Circle: { r = 3 * k * k; }
        Square: { r = k * k; }
        Tri: { r = k * k / 2; }
    }
    return r;
}
function dist(p: Point, q: Point): i32 {
    const dx = p.x - q.x;
    const dy = p.y - q.y;
    return Math.max(dx, 0 - dx) + Math.max(dy, 0 - dy);
}
function vowels(s: string): i32 {
    let n = 0;
    for (let i = 0; i < s.length; i = i + 1) {
        const c = s.charCodeAt(i);
        if (c === 97 || c === 101 || c === 105 ||
            c === 111 || c === 117) {
            n = n + 1;
        }
    }
    return n;
}
function digits(s: string): i32 {
    let v = 0;
    for (let i = 0; i < s.length; i = i + 1) {
        const c = s.charCodeAt(i);
        if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); }
    }
    return v;
}
function histogram(work: buffer, bins: buffer): i32 {
    let biggest = 0;
    for (let i = 0; i < work.length; i = i + 1) {
        const k = work.charCodeAt(i) / 10;
        bins.setCharCodeAt(k, bins.charCodeAt(k) + 1);
        biggest = Math.max(biggest, bins.charCodeAt(k));
    }
    return biggest;
}
function sort(work: buffer): i32 {
    let swaps = 0;
    for (let i = 1; i < work.length; i = i + 1) {
        let j = i;
        while (j > 0 && work.charCodeAt(j - 1) > work.charCodeAt(j)) {
            const t = work.charCodeAt(j);
            work.setCharCodeAt(j, work.charCodeAt(j - 1));
            work.setCharCodeAt(j - 1, t);
            swaps = swaps + 1;
            j = j - 1;
        }
    }
    return swaps;
}
