{
  "title": "Enums and match",
  "about": [
    "An enum with an explicit value, a match over it, and a record.",
    "The front end lowers match into compares and branches."
  ],
  "group": "Control flow",
  "pipeline": "O2",
  "inputs": { "area": { "k": [-50, 50] } },
  "chapter": "language",
  "focus": 6,
  "try": [
    "How does the front end lower match? Show me the ops for line 6.",
    "How are record fields laid out in memory, judging by the loads?"
  ]
}
enum Shape { Circle, Square = 4, Tri }
record Point { x: i32; y: i32; }
function area(s: Shape, k: i32): i32 {
    let r = 0;
    match (s) {
        Circle: { r = 3 * k * k; }
        Square: { r = k * k; }
        Tri: { r = k * k / 2; }
    }
    return r;
}
function dist(p: Point, q: Point): i32 {
    const dx = p.x - q.x;
    const dy = p.y - q.y;
    return Math.max(dx, 0 - dx) + Math.max(dy, 0 - dy);
}
Each arm of the match tests the enum value: Circle against 0 on line 6,
Square against its explicit 4 on line 7. Records are pointers: p.x is a
load at offset 0, p.y at offset 4.
