      "bins": { "buffer": [4, 4], "cell": [0, 0] }
    }
  },
  "chapter": "bounds",
  "focus": 5,
  "try": [
    "What range does ranges give k, and why can bce not use it?",
    "What happens with a value of 40 in work?"
  ]
}
function histogram(work: buffer, bins: buffer): i32 {
    let biggest = 0;
    for (let i = 0; i < work.length; i = i + 1) {
        const k = work.charCodeAt(i) / 10;
        bins.setCharCodeAt(k, bins.charCodeAt(k) + 1);
        biggest = Math.max(biggest, bins.charCodeAt(k));
    }
    return biggest;
}
k comes from a division, so ranges gives it [0, 6553]: not enough to
drop a check against a 4-cell buffer.
