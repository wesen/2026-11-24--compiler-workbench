{
  "title": "Records in memory",
  "about": [
    "A record is a pointer to one word per field. Assigning a field is",
    "a store; the check compares the memory afterwards."
  ],
  "group": "Bounds",
  "pipeline": "O2",
  "inputs": {
    "nudge": {
      "p": { "record": { "x": [-100, 100], "y": [-100, 100] } },
      "dx": [-10, 10]
    }
  },
  "chapter": "language",
  "focus": 7,
  "try": [
    [
      "Could a pass reuse the stored value instead of loading p.x",
      "again? What would it need to know?"
    ],
    "Show me the loads and stores of nudge in the image."
  ]
}
record Point { x: i32; y: i32; }
function manhattan(p: Point, q: Point): i32 {
    const dx = p.x - q.x;
    const dy = p.y - q.y;
    return Math.max(dx, 0 - dx) + Math.max(dy, 0 - dy);
}
function nudge(p: Point, dx: i32): i32 {
    p.x = p.x + dx;
    p.y = p.y - dx;
    return p.x * p.y;
}
p.x after the store reads memory again: the IR does not assume a load
returns what was just stored.
