// The order passes run in matters: each one can create or destroy the
// others' opportunities.
function kernel(v: buffer, n: i32, k: i32): i32 {
    const scale = 2 * 8;
    let s = 0;
    for (let i = 0; i < n; i = i + 1) {
        const a = k * scale + 3;
        const b = k * scale + 3;
        s = s + v.charCodeAt(i) * a + b / 4;
    }
    return s * 4;
}
function rescale(x: i32, y: i32): i32 {
    const unit = 3 * 3 - 1;
    const t = x * unit;
    const u = x * unit;
    return (t + u) / unit + y * 0;
}
