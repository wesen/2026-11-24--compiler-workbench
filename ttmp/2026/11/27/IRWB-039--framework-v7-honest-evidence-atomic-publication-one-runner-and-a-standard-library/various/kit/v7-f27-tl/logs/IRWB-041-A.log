import test from 'node:test';
import assert from 'node:assert/strict';

const S = await import('../../dist/framework/strategy/index.js');
const { definePass } = await import('../../dist/framework/passes/index.js');
const T = await import('../../dist/tensor/index.js');
const { inlinePass, splitPass } = await import('../../dist/tensor/passes.js');
const { parse } = await import('../../dist/tensor/parser.js');

const src = 'fn f(x:f32[N,K]):f32[N] { a[i,k] = x[i,k] * 2; y[i] = sum(k) a[i,k]; return y; }';
const wrong = definePass({
  ...inlinePass,
  id: 'r3.wrong',
  description: 'inline, but multiplies by 3',
  run: () => ({ native: parse('fn f(x:f32[N,K]):f32[N] { y[i] = sum(k) x[i,k] * 3; return y; }') }),
});

test(
  'F27: a wrong Tix pass is rejected inside a strategy plan; correct passes are accepted',
  { todo: 'F27' },
  async () => {
    assert.equal(typeof T.tixAlgorithm, 'function', 'src/tensor exports tixAlgorithm(pass, { origin })');
    const p = T.compileTix(src);
    const keep = { id: 'keep', version: '1', kind: 'transform', description: 'identity', run: (_c, a) => a };
    const reg = new S.AlgorithmRegistry()
      .register(T.tixAlgorithm(wrong, { origin: p.origin }))
      .register(T.tixAlgorithm(inlinePass, { origin: p.origin }))
      .register(T.tixAlgorithm(splitPass, { origin: p.origin }))
      .register(keep);
    // the wrong pass alone: the plan must not succeed with its output
    const bad = await S.execute(S.plan('w', S.apply('wrong', S.algorithm('r3.wrong'))), reg, p.current);
    assert.ok(
      bad.status !== 'succeeded' || bad.value.revision === p.current.revision,
      'the wrong pass was accepted in a plan',
    );
    // inside attempt/fallback: the fallback runs and the result is the input
    const tried = await S.execute(
      S.plan(
        't',
        S.attempt('try', S.apply('wrong', S.algorithm('r3.wrong')), S.apply('keep', S.algorithm('keep'))),
      ),
      reg,
      p.current,
    );
    assert.equal(tried.status, 'succeeded');
    assert.equal(tried.value.revision, p.current.revision);
    // a correct sequence through plans gives the same revision as optimizeTix
    const seq = await S.execute(
      S.plan(
        's',
        S.sequence(
          'main',
          S.apply('inline', S.algorithm(inlinePass.id)),
          S.apply('split', S.algorithm(splitPass.id)),
        ),
      ),
      reg,
      p.current,
    );
    assert.equal(seq.status, 'succeeded');
    assert.equal(seq.value.revision, T.optimizeTix(p, ['inline', 'split-sum']).program.current.revision);
  },
);
{
  let captured;
  const reg = new S.AlgorithmRegistry().register(passAlgorithm(wrong, { manager: new C.AnalysisManager(), onResult: r => (captured = r) }));
  const run = await S.execute(S.plan('w', S.apply('wrong', S.algorithm('probe.wrong'))), reg, p.current);
  const inputs = { x: { shape: [1, 2], data: new Float32Array([1, 1]) } };
  console.log('2b. same pass through the stock bridge:', run.status, '| contract recorded:', captured?.contract !== undefined,
    '| y(origin)', runTix(p, 'f', inputs).data[0], 'y(result)', runTix({ ...p, current: run.value }, 'f', inputs).data[0]);
}

// 3. the gate as a contract, through the bridge's existing options
const gateContract = relation => {
  const invariant = C.defineInvariant({
    id: 'tix.meaning-gate.' + relation, version: '1', description: 'the Tix meaning gate as an invariant',
    inputs: { before: TixIR, origin: TixIR, after: TixIR },
    // the gate's evidence carries an `undefined` field, which the manager refuses ("IR data cannot contain
    // undefined"), so it is passed through a JSON round trip: the only adaptation the gate needed
    check: (_ctx, { before, origin, after }) => {
      const r = meaningGate(origin, relation)(before, after);
      return r.ok ? { ok: true, evidence: JSON.parse(JSON.stringify(r.evidence ?? null)) } : { ok: false, reason: r.reason };
    },
  });
  return C.defineTransformation({
    id: 'tix.gated.' + relation, version: '1', description: 'a Tix pass under its meaning gate',
    inputs: { input: TixIR, origin: TixIR }, outputs: { output: TixIR },
    ensures: [{ invariant, bindings: { before: { from: 'inputs', port: 'input' }, origin: { from: 'inputs', port: 'origin' }, after: { from: 'outputs', port: 'output' } } }],
  });
};
const gated = (q, relation, sink) => passAlgorithm(q, { manager: new C.AnalysisManager(), contract: gateContract(relation), contractInputs: () => ({ origin: p.origin }), onResult: sink });
