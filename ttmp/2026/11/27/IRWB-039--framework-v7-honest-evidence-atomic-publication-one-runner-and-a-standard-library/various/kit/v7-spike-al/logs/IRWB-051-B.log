    try {answer = step.value.sync();} catch(e) {step = run.throw(e); continue;}
    step = run.next(answer);
  }
  return step.value;
}

export async function runTransformation<S,N extends Needs,P>(tx: Transformation<S,N,P>, before: Artifact<S>, options: ApplyOptions<P>): Promise<PassResult<S>> {
  const run = application(tx,before,options);
  let step = run.next();
  while (!step.done) {
    let answer;
    try {answer = await step.value.async();} catch(e) {step = run.throw(e); continue;}
    step = run.next(answer);
  }
  return step.value;
}
