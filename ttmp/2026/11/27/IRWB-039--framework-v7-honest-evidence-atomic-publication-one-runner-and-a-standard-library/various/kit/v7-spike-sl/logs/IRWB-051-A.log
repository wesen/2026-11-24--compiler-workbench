  decide?(inputs, facts): Plan;           // D C2: untrusted; search, cost, guesses
  eligible(inputs, facts, plan): Eligible&lt;Witness&gt; | Ineligible&lt;Reason&gt; | Unknown&lt;Reason&gt;;   // A
  prepare(inputs, facts, plan, witness, sink: StepSink): Candidate&lt;Out&gt;;                      // B, D apply
  obligations(inputs, candidate): Obligation[];   // A; C requires/ensures/preserves/refines, each sync or deferred
}
type Outcome =
  | accepted(receipt) | unchanged | refused(reason) | rejected(obligation, counterexample)
  | unavailable(reason) | pending(deferred, resume);

// The runner, written once (D C5). It yields requests; a sync or an async driver answers them.
function* run(t, inputs, params, policy) {
  const facts = yield* analyses(t.needs, inputs);                 // the manager answers, sync where pure (K5's real work)
  const plan = t.decide ? t.decide(inputs, facts) : params.plan;
  const e = t.eligible(inputs, facts, plan);
  if (!e.ok) return refused(e.reason);                            // A: unknown eligibility is not disagreement
  const stage = yield { effect: 'stage', inputs };                // B: a private view; no head, no fact visible
  const candidate = t.prepare(inputs, facts, plan, e.witness, stage.sink);
  if (sameRevision(candidate, inputs)) return unchanged;
  audit(stage.derivation, diff(inputs, candidate), t.writes);     // C R4: the diff audits the derivation
  const results = [];
  for (const ob of t.obligations(inputs, candidate))
    results.push(yield { effect: ob.mode, obligation: ob, candidate });   // 'sync' now, 'deferred' batched (C R2)
  if (results.some(refuted)) return rejected(first(results, refuted));
  if (results.some(failed)) return unavailable(first(results, failed));
  const evidence = combine(t.relation, results);                  // K3: relation x method x scope
  if (!policy.accepts(evidence)) return rejected('policy', evidence);
  return yield { effect: 'publish', stage, evidence, expected: heads(inputs) };   // B: all or none, or stale
}
