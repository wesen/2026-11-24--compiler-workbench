// Batches span at least 100 ms to amortize timer granularity and startup jitter.
// Six rotations put each mode first twice, and the median reduces the effect of a slow batch.
async function measure(title, modes) {
  const values = modes.map(() => []);
  for (let round = -modes.length; round < modes.length * 2; round++)
    for (let i = 0; i < modes.length; i++) {
      const index = (round + i + modes.length) % modes.length;
      const [name, make] = modes[index];
      const apply = make(new AnalysisManager());
      const isAsync = name.endsWith('async');
      const start = performance.now();
      let iterations = 0;
      let duration;
      do {
        const result = isAsync ? await apply() : apply();
        assert.equal(result.changed, true);
        iterations++;
        duration = performance.now() - start;
      } while (duration < 100);
      if (round >= 0) values[index].push(duration / iterations);
    }
  console.log(title);
