@@ -0,0 +1,19 @@
+import {readFileSync} from 'node:fs';
+import assert from 'node:assert/strict';
+import {compileTix,optimizeTix} from '../../../../../../dist/tensor/index.js';
+import {regions,inspectRow} from './12-row-region.mjs';
+for(const name of ['attention','conv2d','layernorm','matmul','mlp','softmax']) {
+  const s=readFileSync('corpus/tensor/'+name+'/main.tix','utf8'),p=compileTix(s);
+  const found=regions(p.current.value.functions[0]);
+  console.log(JSON.stringify({name,found}));
+  assert.equal(found.length,Number(name==='attention'||name==='softmax'));
+  if(name==='attention') {
+    const escaping=compileTix(s.replace('weight[i,j] * v[j,c]','(weight[i,j]+e[i,j]) * v[j,c]'));
+    const reason=inspectRow(escaping.current.value.functions[0],1).error;
+    assert(reason.includes('escapes')); console.log(JSON.stringify({mutation:'extra downstream read',reason}));
+    const split=optimizeTix(p,['split-sum']);
+    assert(split.steps[0].accepted);
+    assert.equal(regions(split.program.current.value.functions[0]).length,0);
+    console.log('split attention has no eligible original-fold region');
+  }
+}
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/12-row-region.mjs b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/12-row-region.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..28143dc723b3ab038cc11346afa83e4696a05d8c
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/12-row-region.mjs
@@ -0,0 +1,37 @@
+// A four-definition region can have any rank-two input produced earlier in this function.
+// Fail closed on index maps, extents, grouping, or live intermediate definitions.
+import {visit} from '../../../../../../dist/tensor/model.js';
+const eq=(a,b)=>JSON.stringify(a)===JSON.stringify(b);
+const dim=(a,extent)=>a?.extent.kind==='dim' && eq(a.extent.dim,extent);
+const plain=(a,id)=>a?.constant===0 && a.terms.length===1 && eq(a.terms[0],[id,1]);
+const load=(e,name,ids)=>e?.kind==='load'&&e.name===name&&e.indices.length===ids.length&&e.indices.every((a,i)=>plain(a,ids[i]));
+const op=(e,name)=>e?.kind==='op'&&e.op===name;
+
+export function inspectRow(fn,first) {
+  const [m,e,s,y]=fn.statements.slice(first,first+4);
+  if(!y) return {error:'region too short'};
+  const input=m.expr.body?.name;
+  const x=[...fn.params,...fn.statements.slice(0,first)].find(t=>t.name===input);
+  if(x?.shape.length!==2) return {error:'missing rank-two producer'};
+  const [N,C]=x.shape;
+  for(const [stmt,shape] of [[m,[N]],[e,[N,C]],[s,[N]],[y,[N,C]]])
+    if(!eq(stmt.shape,shape)||stmt.axes.length!==shape.length||!stmt.axes.every((a,i)=>dim(a,shape[i]))) return {error:'iteration domain'};
+  function rowFold(stmt,name,tensor) {
+    const r=stmt.expr;
+    return r.kind==='reduce'&&r.op===name&&r.axes.length===1&&dim(r.axes[0],C)&&load(r.body,tensor,[stmt.axes[0].id,r.axes[0].id]);
+  }
+  if(!rowFold(m,'max',x.name)) return {error:'maximum must cover this parameter row'};
+  const ea=e.axes.map(a=>a.id),ya=y.axes.map(a=>a.id),sub=e.expr.args?.[0];
+  if(!op(e.expr,'exp')||!op(sub,'-')||!load(sub.args[0],x.name,ea)||!load(sub.args[1],m.name,[ea[0]])) return {error:'shift lacks its same-row maximum'};
+  if(!rowFold(s,'sum',e.name)) return {error:'sum has different fold tree or index map'};
+  if(!op(y.expr,'/')||!load(y.expr.args[0],e.name,ya)||!load(y.expr.args[1],s.name,[ya[0]])) return {error:'divide or broadcast differs'};
+  const privateTensors=new Set([m.name,e.name,s.name]);
+  let escape=privateTensors.has(fn.result);
+  for(const later of fn.statements.slice(first+4))
+    visit(later.expr,node=>{ if(node.kind==='load' && privateTensors.has(node.name)) escape=true; });
+  if(escape) return {error:'internal tensor escapes the four-statement region'};
+  return {first,input:x.name,output:y.name,shape:y.shape};
+}
+export function regions(fn) {
+  return fn.statements.map((_,i)=>inspectRow(fn,i)).filter(s=>!s.error);
+}
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/13-attention.cu b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/13-attention.cu
new file mode 100644
index 0000000000000000000000000000000000000000..37b05f2f8689d4f1e15157ebb496c1dce5a6e3fa
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/13-attention.cu
@@ -0,0 +1,45 @@
+// Reuses the audited scalar routine, row schedule and digest helpers from 11-deploy.cu.
+int main(int argc,char** argv) {
+  if(system("sha256sum ./prog")!=0) return 4;
+  cudaDeviceProp p; check(cudaGetDeviceProperties(&p,0)); int rt,drv;
+  check(cudaRuntimeGetVersion(&rt)); check(cudaDriverGetVersion(&drv));
+  printf("%s sm_%d%d runtime=%d driver=%d nvcc=%d.%d.%d\n",p.name,p.major,p.minor,rt,drv,__CUDACC_VER_MAJOR__,__CUDACC_VER_MINOR__,__CUDACC_VER_BUILD__);
+  fflush(stdout);
+  if(argc==4 && !strcmp(argv[1],"audit")) {
+    audit(strtoul(argv[2],nullptr,16),strtoul(argv[3],nullptr,16)); return 0;
+  }
+  if(argc!=7 || strcmp(argv[1],"bench")) return 2;
+  int Q=atoi(argv[2]),K=atoi(argv[3]),D=atoi(argv[4]),V=atoi(argv[5]),reps=atoi(argv[6]);
+  if(Q<1||Q>2048||K<1||K>1024||D<1||D>256||V<1||V>256||reps<1||reps>31) return 2;
+  DeviceBuffer q(Q*D),k(K*D),v(K*V),score(Q*K),m(Q),e(Q*K),s(Q),w(Q*K),out(Q*V);
+  unsigned seed=23023;
+  for(DeviceBuffer* p:{&q,&k,&v}) {
+    std::vector<float> h(p->size); for(float& x:h) x=float(rng(seed)>>8)*0x1p-23f-1.0f;
+    p->upload(h.data());
+  }
+  auto launch=[&](int mode) {
+    if(mode!=2) att::k0<<<(Q*K+255)/256,256>>>(Q,D,K,V,q.ptr,k.ptr,score.ptr,Q*K);
+    if(mode==0) {
+      att::k1<<<(Q+255)/256,256>>>(Q,D,K,V,score.ptr,m.ptr,Q);
+      att::k2<<<(Q*K+255)/256,256>>>(Q,D,K,V,score.ptr,m.ptr,e.ptr,Q*K);
+      att::k3<<<(Q+255)/256,256>>>(Q,D,K,V,e.ptr,s.ptr,Q);
+      att::k4<<<(Q*K+255)/256,256>>>(Q,D,K,V,e.ptr,s.ptr,w.ptr,Q*K);
+    } else rowSoftmax<Owner,SelectedExp><<<Q,threads>>>(score.ptr,w.ptr,K);
+    if(mode!=2) att::k5<<<(Q*V+255)/256,256>>>(Q,D,K,V,w.ptr,v.ptr,out.ptr,Q*V);
+    check(cudaGetLastError());
+  };
+  std::vector<float> before(Q*V),after(Q*V);
+  launch(0); out.download(before.data()); launch(1); out.download(after.data());
+  if(memcmp(before.data(),after.data(),Q*V*sizeof(float))) return 3;
+  printf("Q=%d K=%d D=%d V=%d matched=%d\n",Q,K,D,V,Q*V);
+  fflush(stdout); digest(after.data(),after.size()*4);
+  launch(2); check(cudaDeviceSynchronize());
+  Event a,b; std::vector<float> times[3];
+  for(int rep=0;rep<reps;rep++) for(int i=0;i<3;i++) {
+    int op=(i+rep)%3;
+    check(cudaEventRecord(a.handle)); launch(op); check(cudaEventRecord(b.handle)); check(cudaEventSynchronize(b.handle));
+    float ms; check(cudaEventElapsedTime(&ms,a.handle,b.handle)); times[op].push_back(ms);
+  }
+  const char* names[]={"generated","three","region"};
+  for(int i=0;i<3;i++) { printf("%s ms",names[i]); for(float t:times[i]) printf(" %.6f",t); puts(""); }
+}
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/13-node-attention.mjs b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/13-node-attention.mjs
