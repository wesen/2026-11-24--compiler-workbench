+  node "$p/06-node-audit.mjs" "$1" "$2" "$p/11-$3-gpu.json" > "$p/11-$3-node.json"
+done
+for shape in full wide tail; do
+  node "$p/11-node-program.mjs" "$p/11-$shape.json" > "$p/11-$shape-node.jsonl"
+done

