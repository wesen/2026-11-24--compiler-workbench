diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/02-kernels.cu b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/02-kernels.cu
