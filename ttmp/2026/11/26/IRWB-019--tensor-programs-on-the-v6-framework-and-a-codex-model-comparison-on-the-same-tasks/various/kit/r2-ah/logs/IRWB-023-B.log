+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/02-kernels.cu
@@ -0,0 +1,145 @@
+// Appended to unmodified stage-2 softmax kernels by 02-benchmark.mjs.
+// Each input row is finite. Width is in [1,1024]; host owns the dispatch.
+#include <cstdlib>
+enum Method { Stage2, Owner, Translate, Tree, Methods };
+constexpr int threads = 128, maxCols = 1024, chunk = 32;
+struct Transfer { unsigned seed, end[2]; };
+
+__device__ float prefix(float x, int lane) {
+  for (int step=1; step<32; step*=2) {
+    float prior = __shfl_up_sync(0xffffffffu,x,step);
+    if (lane>=step) x=__fadd_rn(x,prior);
+  }
+  return x;
+}
+
+struct RoundedDoubleExp {
+  __device__ static float eval(float x) { return __double2float_rn(exp(static_cast<double>(x))); }
+};
+
+template<Method method, class Exp = RoundedDoubleExp>
+__global__ void rowSoftmax(const float* input, float* output, int cols) {
+  __shared__ float e[maxCols], work[threads], maximum, denominator;
+  __shared__ Transfer table[32];
+  const int lane=threadIdx.x, row=blockIdx.x;
+  int base=row*cols;
+  float local=-INFINITY;
+  for (int j=lane;j<cols;j+=threads) local=minmax(local,input[base+j],true);
+  work[lane]=local;
+  __syncthreads();
+  for (int step=threads/2;step>0;step/=2) {
+    if (lane<step) work[lane]=minmax(work[lane],work[lane+step],true);
+    __syncthreads();
+  }
+  if (lane==0) maximum=work[0];
+  __syncthreads();
+  for (int j=lane;j<cols;j+=threads) {
+    float shift=__fsub_rn(input[base+j],maximum);
+    e[j]=Exp::eval(shift);
+  }
+  __syncthreads();
+  if constexpr (method==Owner) {
+    if (lane==0) {
+      float carry=0;
+      for (int j=0;j<cols;++j) carry=__fadd_rn(carry,e[j]);
+      denominator=carry;
+    }
+  }
+  if constexpr (method==Tree) {
+    float part=0;
+    for (int j=lane;j<cols;j+=threads) part=__fadd_rn(part,e[j]);
+    work[lane]=part;
+    __syncthreads();
+    for (int step=threads/2;step>0;step/=2) {
+      if (lane<step) work[lane]=__fadd_rn(work[lane],work[lane+step]);
+      __syncthreads();
+    }
+    if (lane==0) denominator=work[0];
+  }
+  if constexpr (method==Translate) {
+    if (lane<32) {
+      int first=lane*chunk, last=min(cols,first+chunk);
+      float part=0;
+      for (int j=first;j<last;++j) part=__fadd_rn(part,e[j]);
+      float incl=prefix(part,lane);
+      float pred=__shfl_up_sync(0xffffffffu,incl,1);
+      unsigned seed=__float_as_uint(lane==0 ? 0.0f : pred) & ~1u;
+      float a=__uint_as_float(seed), b=__uint_as_float(seed+1);
+      for (int j=first;j<last;++j) { a=__fadd_rn(a,e[j]); b=__fadd_rn(b,e[j]); }
+      table[lane]={seed,{__float_as_uint(a),__float_as_uint(b)}};
+    }
+    __syncthreads();
+    if (lane==0) {
+      float carry=0;
+      for (int j=0;j<cols;j+=chunk) {
+        Transfer t=table[j/chunk];
+        unsigned w=__float_as_uint(carry), parity=w&1, s=t.seed+parity, end=t.end[parity];
+        // Monotone nonnegative terms. Endpoints bound all intermediate states.
+        // For this softmax row, 0 <= carry,end <= 1024; signed int fits every word.
+        int d=int(w)-int(s);
+        if (d==0) carry=__uint_as_float(end);
+        else if ((w>>23)==(s>>23) && (s>>23)>0 && (end>>23)==(s>>23) &&
+                 (w&0x7fffff)>0 && (s&0x7fffff)>0 &&
+                 int(end&0x7fffff)+d<0x800000) {
+          carry=__uint_as_float(end+d);
+        } else {
+          for (int k=j;k<min(cols,j+chunk);++k) carry=__fadd_rn(carry,e[k]);
+        }
+      }
+      denominator=carry;
+    }
+  }
+  __syncthreads();
+  for (int j=lane;j<cols;j+=threads) output[base+j]=__fdiv_rn(e[j],denominator);
+}
+
+static unsigned rng(unsigned& s) { s^=s<<13; s^=s>>17; s^=s<<5; return s; }
+static unsigned bits(float x) { unsigned u; memcpy(&u,&x,sizeof(x)); return u; }
+#ifndef TIX_KERNELS_ONLY
+int main(int argc,char** argv) {
+  int rows=argc>1?atoi(argv[1]):4096, cols=argc>2?atoi(argv[2]):1024;
+  int spread=argc>3?atoi(argv[3]):2, repeats=argc>4?atoi(argv[4]):11;
+  if (rows<1 || rows>16384 || cols<1 || cols>maxCols || spread<1 || repeats<1 || repeats>31) return 2;
+  cudaDeviceProp prop; check(cudaGetDeviceProperties(&prop,0));
+  printf("%s sm_%d%d rows=%d cols=%d spread=%d repeats=%d\n",prop.name,prop.major,prop.minor,rows,cols,spread,repeats);
+  int count=rows*cols;
+  DeviceBuffer x(count), maxRow(rows), expRow(count), sumRow(rows), output(count);
+  std::vector<float> host(count), baseline(count), result(count);
+  unsigned seed=23023;
+  for (float& v:host) v=(float(rng(seed)>>8)*0x1p-24f-0.5f)*spread;
+  x.upload(host.data());
+  auto launch=[&](int variant) {
+    switch (variant) {
+    case Stage2:
+      k0<<<(rows+255)/256,256>>>(rows,cols,x.ptr,maxRow.ptr,rows);
+      k1<<<(count+255)/256,256>>>(rows,cols,x.ptr,maxRow.ptr,expRow.ptr,count);
+      k2<<<(rows+255)/256,256>>>(rows,cols,expRow.ptr,sumRow.ptr,rows);
+      k3<<<(count+255)/256,256>>>(rows,cols,expRow.ptr,sumRow.ptr,output.ptr,count); break;
+    case Owner: rowSoftmax<Owner><<<rows,threads>>>(x.ptr,output.ptr,cols); break;
+    case Translate: rowSoftmax<Translate><<<rows,threads>>>(x.ptr,output.ptr,cols); break;
+    case Tree: rowSoftmax<Tree><<<rows,threads>>>(x.ptr,output.ptr,cols); break;
+    }
+    check(cudaGetLastError());
+  };
+  std::vector<float> samples[Methods];
+  const char* names[]={"stage2","owner","translate","tree"};
+  for (int m=0;m<Methods;++m) {
+    launch(m); output.download(result.data());
+    if (m==0) baseline=result;
+    int wrong=0; for (int i=0;i<count;++i) wrong+=bits(result[i])!=bits(baseline[i]);
+    printf("%s mismatches %d/%d\n",names[m],wrong,count);
+    if (m!=Tree && wrong) return 3;
+  }
+  Event begin,finish;
+  for (int k=0;k<repeats;++k) for (int i=0;i<Methods;++i) {
+    int m=(i+k)%Methods;
+    check(cudaEventRecord(begin.handle)); launch(m); check(cudaEventRecord(finish.handle));
+    check(cudaEventSynchronize(finish.handle));
+    float ms; check(cudaEventElapsedTime(&ms,begin.handle,finish.handle)); samples[m].push_back(ms);
+  }
+  for (int m=0;m<Methods;++m) {
+    printf("%s ms",names[m]); for(float ms:samples[m]) printf(" %.6f",ms);
+    puts("");
+  }
+}
+#endif
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/03-miniature.mjs b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/03-miniature.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a3da653f9911c06b230bc712cacec22b95c3983b
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/03-miniature.mjs
@@ -0,0 +1,40 @@
+// Integer model: four significant bits, subnormal spacing 1, no saturation in tested interval.
+// Native arithmetic on these small integers is exact. All rounding is explicit.
+import assert from 'node:assert/strict';
+const levels=[0,1,2,3,4,5,6,7];
+for (let step=1;step<=64;step*=2) for (let i=8;i<16;i++) levels.push(i*step);
+function rn(x) {
+  let s=Math.sign(x), v=Math.abs(x);
+  if (v<8) return x;
+  let q=2**(Math.floor(Math.log2(v))-3), a=Math.floor(v/q), rem=v-a*q;
+  return s*q*(a+Number(rem*2>q || (rem*2===q && (a&1)===1)));
+}
+const terms=[...new Set(levels.filter(n=>n<=64).flatMap(n=>[n,-n]))];
+const counts={}, witnesses={};
+function record(mode, ok, expected, got, data) {
+  const t=counts[mode]??={accepted:0,wrong:0};
+  if (!ok) return;
+  t.accepted++;
+  if (got!==expected) { t.wrong++; witnesses[mode]??={...data,expected,got}; }
+}
+for (const sign of [-1,1]) for (let anchor=32;anchor<64;anchor+=4)
+for (let entry=32;entry<64;entry+=4) {
+  if (anchor===entry) continue;
+  const delta=entry-anchor, even=(delta%8===0);
+  for (const a of terms) for(const b of terms) {
+    const mid=rn(sign*anchor+a)*sign, end=rn(sign*mid+b)*sign;
+    const expected=rn(rn(sign*entry+a)+b);
+    const low=Math.min(anchor,mid,end,entry,mid+delta,end+delta);
+    const high=Math.max(anchor,mid,end,entry,mid+delta,end+delta);
+    const got=sign*(end+delta), d={sign,anchor,entry,a,b,mid,end};
+    record('strict',even && low>32 && high<64,expected,got,d);
+    record('directional',even && sign*a>=0 && sign*b>=0 && low>=32 && high<64,expected,got,d);
+    record('noParity',low>32 && high<64,expected,got,d);
+    record('includeLower',even && low>=32 && high<64,expected,got,d);
+    record('endOnly',even && Math.min(anchor,end,entry,end+delta)>32 &&
+      Math.max(anchor,end,entry,end+delta)<64,expected,got,d);
+  }
+}
+assert.equal(counts.strict.wrong,0); assert.equal(counts.directional.wrong,0);
+for (const m of ['noParity','includeLower','endOnly']) assert(counts[m].wrong>0);
+console.log(JSON.stringify({termCount:terms.length,counts,witnesses},null,2));
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/04-exp.cuh b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/04-exp.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..cd99069896962666ad136050c52faee2958faac6
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/04-exp.cuh
@@ -0,0 +1,19 @@
+// The driver emits uint64 words for 1024 powers of two. Scope: x <= 0 and x is not NaN.
+constexpr unsigned startMag=0x33000000u, stopMag=0x42d00000u;
+template<int tableBits,int degree>
+__device__ float shortExp(float x) {
+  unsigned mag=__float_as_uint(x)&0x7fffffffu;
+  if (mag<=startMag) return 1.0f;
+  if (mag>=stopMag) return 0.0f;
+  constexpr int B=1<<tableBits;
+  // A single precision estimate only selects a nearby cell. The residual uses the actual k.
+  int k=__float2int_rn(__fmul_rn(x,float(B)*0x1.715476p+0f));
+  int t=k&(B-1), j=(k-t)/B;
+  auto scale=__longlong_as_double(powerBits[t*(1024/B)]+(static_cast<unsigned long long>(j)<<52));
+  double r=__fma_rn(double(k),-0x1.62e42fefa39efp-1/double(B),double(x));
+  double c=0.5;
+  if constexpr (degree==3) c=__fma_rn(r,1.0/6.0,0.5);
+  if constexpr (degree==4) c=__fma_rn(r,__fma_rn(r,1.0/24.0,1.0/6.0),0.5);
+  double u=__dmul_rn(r,__fma_rn(r,c,1.0));
+  return __double2float_rn(__fma_rn(scale,u,scale));
+}
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/04-run.mjs b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/04-run.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5c12f78ccc6c2597ee128ddbb09c1a5974f9b3a0
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/04-run.mjs
@@ -0,0 +1,29 @@
+// Modes: sweep [hex-start hex-end], bench rows cols spread repeats, audit start end.
+import {readFileSync,writeFileSync,mkdtempSync,rmSync} from 'node:fs';
+import {execFileSync} from 'node:child_process';
+import {join} from 'node:path';
+import {tmpdir} from 'node:os';
+import {createHash} from 'node:crypto';
+import {compileTix,cudaSource} from '../../../../../../dist/tensor/index.js';
+const read=name=>readFileSync(new URL(name,import.meta.url),'utf8');
+const dir=mkdtempSync(join(tmpdir(),'tix-exp-'));
+try {
+  const [mode,...args]=process.argv.slice(2);
+  const buf=new ArrayBuffer(8), view=new DataView(buf);
+  const entries=Array.from({length:1024},(_,t)=>{
+    view.setFloat64(0,2**(t/1024));
+    return '0x'+view.getBigUint64(0).toString(16)+'ull';
+  });
+  const powers='__device__ const unsigned long long powerBits[1024]={'+entries.join(',')+'};\n';
+  writeFileSync(join(dir,'power.cuh'),powers);
+  writeFileSync(join(dir,'exp.cuh'),read('04-exp.cuh'));
+  if (mode==='sweep') writeFileSync(join(dir,'main.cu'),read('04-sweep.cu'));
+  else {
+    if (mode!=='bench' && mode!=='audit') throw Error('expected sweep, bench, or audit');
+    const src=cudaSource(compileTix(readFileSync('corpus/tensor/softmax/main.tix','utf8')),'softmax');
+    writeFileSync(join(dir,'main.cu'),src.slice(0,src.indexOf('static void run_case('))+
+      '\n#include "power.cuh"\n#include "exp.cuh"\n#define TIX_KERNELS_ONLY\n'+read('02-kernels.cu')+read('05-kernels.cu'));
+  }
+  const result=JSON.parse(execFileSync('node',['tools/cuda-remote.mjs',dir,...(mode==='bench'?['--timed']:[]),'--',...(mode==='sweep'?[]:[mode]),...args],{encoding:'utf8'}));
+  console.log(JSON.stringify({...result,tableSha256:createHash('sha256').update(powers).digest('hex')}));
+} finally { rmSync(dir,{recursive:true,force:true}); }
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/04-sweep.cu b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/04-sweep.cu
new file mode 100644
index 0000000000000000000000000000000000000000..81442656937e922e5aac8fc9fd888e2f0ec07828
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/04-sweep.cu
@@ -0,0 +1,52 @@
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <cstdlib>
+#include <algorithm>
+#include <vector>
+#include "power.cuh"
+#include "exp.cuh"
+constexpr int methods=6, keep=128;
+struct Hit { unsigned mag,got,want; };
+struct Stats { unsigned count[methods]; Hit hits[methods][keep]; };
+
+__device__ void record(int variant,unsigned mag,float got,unsigned want,Stats* out) {
+  unsigned v=__float_as_uint(got);
+  unsigned mask=__ballot_sync(0xffffffffu,v!=want);
+  if (!mask) return;
+  unsigned base=0, lane=threadIdx.x%32;
+  if (lane==0) base=atomicAdd(&out->count[variant],__popc(mask));
+  base=__shfl_sync(0xffffffffu,base,0);
+  unsigned rank=base+__popc(mask&((1u<<lane)-1));
+  if (v!=want && rank<keep) out->hits[variant][rank]={mag,v,want};
+}
+__global__ void sweep(unsigned first,unsigned last,Stats* out) {
+  for (unsigned mag=first+blockIdx.x*blockDim.x+threadIdx.x;mag<last;mag+=gridDim.x*blockDim.x) {
+    float x=-__uint_as_float(mag);
+    unsigned want=__float_as_uint(__double2float_rn(exp(double(x))));
+    record(0,mag,expf(x),want,out);
+    record(1,mag,shortExp<7,2>(x),want,out);
+    record(2,mag,shortExp<7,3>(x),want,out);
+    record(3,mag,shortExp<10,2>(x),want,out);
+    record(4,mag,shortExp<10,3>(x),want,out);
+    record(5,mag,shortExp<7,4>(x),want,out);
+  }
+}
+static void check(cudaError_t e) { if(e!=cudaSuccess) { puts(cudaGetErrorString(e)); exit(1); } }
+int main(int argc,char** argv) {
+  unsigned first=argc>1?strtoul(argv[1],nullptr,16):startMag;
+  unsigned last=argc>2?strtoul(argv[2],nullptr,16):stopMag;
+  if (first>=last || first%32 || last%32 || last>0x7f800000u) return 2;
+  Stats* d; Stats h{}; check(cudaMalloc(&d,sizeof(h))); check(cudaMemset(d,0,sizeof(h)));
+  sweep<<<1024,256>>>(first,last,d); check(cudaMemcpy(&h,d,sizeof(h),cudaMemcpyDeviceToHost));
+  printf("range %08x %08x count %u\n",first,last,last-first);
+  for (int m=0;m<methods;++m) {
+    printf("variant %d mismatches %u\n",m,h.count[m]);
+    unsigned n=std::min(h.count[m],(unsigned)keep);
+    std::sort(h.hits[m],h.hits[m]+n,[](Hit a,Hit b){return a.mag<b.mag;});
+    if(h.count[m]>keep) n=std::min(n,3u);
+    for (unsigned i=0;i<n;++i) {
+      Hit p=h.hits[m][i];
+      printf("hit %d %08x %08x %08x\n",m,p.mag,p.got,p.want);
+    }
+  }
+}
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/05-kernels.cu b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/05-kernels.cu
new file mode 100644
index 0000000000000000000000000000000000000000..ddc67858841ad076543ed7d7359e1672c920253a
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/05-kernels.cu
@@ -0,0 +1,107 @@
+
+// No inlining: the audit and deployment call the same device functions in this executable.
+struct Cubic {
+  __device__ __noinline__ static float eval(float x) {
+    if (__float_as_uint(x)==0xc16912cdu) return __uint_as_float(0x34fd331bu);
+    return shortExp<10,3>(x);
+  }
+};
+struct Quartic {
+  __device__ __noinline__ static float eval(float x) {
+    if (__float_as_uint(x)==0xc16912cdu) return __uint_as_float(0x34fd331bu);
+    return shortExp<7,4>(x);
+  }
+};
+struct NativeExp { __device__ static float eval(float x) { return expf(x); } };
+
+__global__ void audit(unsigned first,unsigned n,unsigned *output,unsigned* different) {
+  unsigned i=blockIdx.x*blockDim.x+threadIdx.x;
+  if (i>=n) return;
+  float x=-__uint_as_float(first+i);
+  unsigned a=__float_as_uint(Cubic::eval(x)), b=__float_as_uint(Quartic::eval(x));
+  if(a!=b) atomicAdd(different,1u);
+  output[i]=a;
+}
+
+int digestRange(unsigned first,unsigned end) {
+  if (first>=end || end>0x7f800001u) return 2;
+  constexpr unsigned block=1u<<20;
+  std::vector<unsigned> words(block);
+  unsigned *out,*different,wrong;
+  check(cudaMalloc(&out,block*sizeof(unsigned))); check(cudaMalloc(&different,sizeof(unsigned)));
+  check(cudaMemset(different,0,sizeof(unsigned)));
+  // Hash the actual bytes emitted in input-word order on the little-endian GPU host.
+  FILE* pipe=popen("sha256sum","w"); if(!pipe) return 4;
+  for (unsigned cursor=first;cursor<end;) {
+    unsigned count=std::min(end-cursor,block);
+    audit<<<(count+255)/256,256>>>(cursor,count,out,different);
+    check(cudaMemcpy(words.data(),out,count*sizeof(unsigned),cudaMemcpyDeviceToHost));
+    if(fwrite(words.data(),sizeof(unsigned),count,pipe)!=count) return 5;
+    cursor+=count;
+  }
+  if(pclose(pipe)!=0) return 6;
+  check(cudaMemcpy(&wrong,different,sizeof(unsigned),cudaMemcpyDeviceToHost));
+  printf("audit [%08x,%08x) words=%u cubic-quartic-diff=%u\n",first,end,end-first,wrong);
+  return wrong!=0;
+}
+
+enum Version {Generated,FusedDouble,FusedCubic,FusedQuartic,CubicTransfer,CubicTree,FusedNative,Versions};
+int main(int argc,char** argv) {
+  if(system("sha256sum ./prog")!=0) return 4;
+  cudaDeviceProp props; check(cudaGetDeviceProperties(&props,0));
+  int runtime,driver; check(cudaRuntimeGetVersion(&runtime)); check(cudaDriverGetVersion(&driver));
+  printf("%s sm_%d%d runtime=%d driver=%d nvcc=%d.%d.%d\n",props.name,props.major,props.minor,runtime,driver,
+         __CUDACC_VER_MAJOR__,__CUDACC_VER_MINOR__,__CUDACC_VER_BUILD__);
+  fflush(stdout);
+  if(argc==4 && !strcmp(argv[1],"audit")) return digestRange(strtoul(argv[2],nullptr,16),strtoul(argv[3],nullptr,16));
+  if(argc!=6 || strcmp(argv[1],"bench")) return 2;
+  int rows=atoi(argv[2]), cols=atoi(argv[3]), spread=atoi(argv[4]), repeats=atoi(argv[5]);
+  if(rows<1||rows>16384||cols<1||cols>maxCols||spread<1||spread>200||repeats<1||repeats>31) return 2;
+  int count=rows*cols;
+  DeviceBuffer x(count),m(rows),e(count),s(rows),y(count);
+  unsigned seed=23023;
+  std::vector<float> host(count),reference(count),result(count);
+  for(auto& v:host) v=(float(rng(seed)>>8)*0x1p-24f-0.5f)*spread;
+  x.upload(host.data());
+  auto launch=[&](int version) {
+    switch(version) {
+    case Generated:
+      k0<<<(rows+255)/256,256>>>(rows,cols,x.ptr,m.ptr,rows);
+      k1<<<(count+255)/256,256>>>(rows,cols,x.ptr,m.ptr,e.ptr,count);
+      k2<<<(rows+255)/256,256>>>(rows,cols,e.ptr,s.ptr,rows);
+      k3<<<(count+255)/256,256>>>(rows,cols,e.ptr,s.ptr,y.ptr,count); break;
+    case FusedDouble: rowSoftmax<Owner><<<rows,threads>>>(x.ptr,y.ptr,cols); break;
+    case FusedCubic: rowSoftmax<Owner,Cubic><<<rows,threads>>>(x.ptr,y.ptr,cols); break;
+    case FusedQuartic: rowSoftmax<Owner,Quartic><<<rows,threads>>>(x.ptr,y.ptr,cols); break;
+    case CubicTransfer: rowSoftmax<Translate,Cubic><<<rows,threads>>>(x.ptr,y.ptr,cols); break;
+    case CubicTree: rowSoftmax<Tree,Cubic><<<rows,threads>>>(x.ptr,y.ptr,cols); break;
+    case FusedNative: rowSoftmax<Owner,NativeExp><<<rows,threads>>>(x.ptr,y.ptr,cols); break;
+    }
+    check(cudaGetLastError());
+  };
+  const char* names[]={"generated","double","cubic","quartic","transfer","tree","expf"};
+  std::vector<float> samples[Versions];
+  printf("rows=%d cols=%d spread=%d repeats=%d\n",rows,cols,spread,repeats);
+  for(int v=0;v<Versions;++v) {
+    launch(v); y.download(result.data());
+    if(v==Generated) reference=result;
+    int wrong=0,changedRows=0;
+    for(int r=0;r<rows;r++) {
+      int before=wrong;
+      for(int c=0;c<cols;c++) { int i=r*cols+c; wrong+=bits(result[i])!=bits(reference[i]); }
+      changedRows+=wrong!=before;
+    }
+    printf("%s mismatches %d/%d rows %d/%d\n",names[v],wrong,count,changedRows,rows);
+    if(v!=CubicTree && v!=FusedNative && wrong) return 3;
+  }
+  Event a,b;
+  for(int k=0;k<repeats;k++) for(int i=0;i<Versions;i++) {
+    int v=(k+i)%Versions;
+    check(cudaEventRecord(a.handle)); launch(v); check(cudaEventRecord(b.handle));
+    check(cudaEventSynchronize(b.handle));
+    float ms; check(cudaEventElapsedTime(&ms,a.handle,b.handle)); samples[v].push_back(ms);
+  }
+  for(int v=0;v<Versions;v++) {
+    printf("%s ms",names[v]); for(float ms:samples[v]) printf(" %.6f",ms); puts("");
+  }
+}
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/06-cross-check.sh b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/06-cross-check.sh
new file mode 100644
index 0000000000000000000000000000000000000000..1abd4e8fa4eafaea84ae6adf224b98c800847163
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/06-cross-check.sh
@@ -0,0 +1,9 @@
+#!/bin/sh
+set -eu
+p=$(dirname "$0")
+for range in '00000000 33000000 low' '33000000 42d00000 active' '42d00000 7f800001 high'; do
+  set -- $range
+  node "$p/04-run.mjs" audit "$1" "$2" > "$p/06-$3-gpu.json"
+  node "$p/06-node-audit.mjs" "$1" "$2" "$p/06-$3-gpu.json" > "$p/06-$3-node.json"
+  cat "$p/06-$3-node.json"
+done
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/06-node-audit.mjs b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/06-node-audit.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2da070ee10b5459c91fd8919243ef7fe4490c47f
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/06-node-audit.mjs
@@ -0,0 +1,29 @@
+// Compare bytes from an independent implementation with the GPU's audit digest.
+import {createHash} from 'node:crypto';
+import {endianness} from 'node:os';
+import {readFileSync} from 'node:fs';
+import assert from 'node:assert/strict';
+const [lo,hi,receipt]=process.argv.slice(2);
+const first=parseInt(lo,16),end=parseInt(hi,16);
+assert(first>=0 && end<=0x7f800001 && first<end && endianness()==='LE');
+const block=new Float32Array(1<<18), bytes=Buffer.from(block.buffer);
+const input=new Float32Array(1), bits=new Uint32Array(input.buffer);
+const hash=createHash('sha256'), started=performance.now();
+for(let pos=first;pos<end;) {
+  const n=Math.min(block.length,end-pos);
+  for(let i=0;i<n;i++) {
+    bits[0]=pos+i;
+    block[i]=Math.fround(Math.exp(-input[0]));
+  }
+  hash.update(bytes.subarray(0,4*n));
+  pos+=n;
+}
+const sha256=hash.digest('hex');
+if(receipt) {
+  const report=JSON.parse(readFileSync(receipt,'utf8'));
+  assert.equal(report.exit,0);
+  const interval='audit ['+lo.padStart(8,'0')+','+hi.padStart(8,'0')+') words='+(end-first)+' cubic-quartic-diff=0';
+  assert(report.stdout.includes(interval));
+  assert.equal(report.stdout.match(/^([0-9a-f]{64})  -$/m)?.[1],sha256);
+}
+console.log(JSON.stringify({first:lo,end:hi,words:end-first,sha256,node:process.version,v8:process.versions.v8,ms:performance.now()-started,matched:!!receipt}));
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/07-midpoint.py b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/07-midpoint.py
new file mode 100644
index 0000000000000000000000000000000000000000..684a82f187177b638bb2562eba8c0a3b15315ae3
--- /dev/null
+++ b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/07-midpoint.py
@@ -0,0 +1,19 @@
+"""Locate the shared exceptional input relative to the binary32 midpoint."""
+from decimal import Decimal, localcontext
+import struct
+
+def exact(bits):
+    x, = struct.unpack(">f", bytes.fromhex(bits))
+    return Decimal.from_float(x)
+
+for precision in (60, 100):
+    with localcontext() as ctx:
+        ctx.prec = precision
+        x = exact("c16912cd")
+        lo, hi = exact("34fd331a"), exact("34fd331b")
+        mid = (lo + hi) / 2
+        offset = x.exp() - mid
+        # Both outputs have biased binary32 exponent 105; binary64 has 29 extra fraction bits.
+        print(f"prec={precision} x={x} midpoint={mid} above_midpoint={offset:.12E} "
+              f"f32_ulp={offset/(hi-lo):.12E} f64_ulp={offset/(hi-lo)*2**29:.12E}")
+        assert 0 < offset < (hi-lo)/2
diff --git a/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/08-meaning-gap.mjs b/ttmp/2026/11/26/IRWB-023-B--exact-parallel-folds-for-tix/scripts/08-meaning-gap.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e44e7625a177d7292e2887a6f78575a264a41721
