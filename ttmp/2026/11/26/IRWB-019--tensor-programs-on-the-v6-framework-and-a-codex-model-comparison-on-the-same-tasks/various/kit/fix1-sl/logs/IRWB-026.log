    const elsewhere = todo.length ? spec.decide?.(inputs, cases, todo) : undefined;
    if (elsewhere) {
      const batch = elsewhere.then(decided => {
        if (decided.length !== todo.length)
          throw new Error(`${spec.id}: decide returned ${decided.length} of ${todo.length}`);
