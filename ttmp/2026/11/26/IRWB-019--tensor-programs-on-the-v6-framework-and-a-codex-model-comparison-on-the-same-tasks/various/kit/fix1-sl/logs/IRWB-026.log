      dirs.map(async (dir, i) => {
        await writeFile(join(dir, 'main.cu'), source);
        await writeFile(join(dir, 'header.h'), "#define EXTRA '1'\n");
        await writeFile(join(dir, 'input.txt'), i ? 'B' : 'A');
      }),
