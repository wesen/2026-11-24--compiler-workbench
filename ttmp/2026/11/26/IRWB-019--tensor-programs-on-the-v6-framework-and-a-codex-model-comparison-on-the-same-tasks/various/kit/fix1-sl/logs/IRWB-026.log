import assert from 'node:assert/strict';
import { compileTix } from './dist/tensor/index.js';
import { createCudaLowering } from './dist/tensor/cuda-contract.js';
import { evaluate } from './dist/tensor/evaluate.js';

const source = 'fn f(x:f32[N]):f32[N]{return x;}';
const first = compileTix(source);
const target = first.current.value.functions[0];
let release;
let started;
const gate = new Promise(resolve => { release = resolve; });
const running = new Promise(resolve => { started = resolve; });
let targetBatches = 0;
const checkTarget = createCudaLowering('eviction-probe-active', async (_src, fn, cases) => {
  targetBatches++;
  started();
  await gate;
  return cases.map(inputs => ({ ...evaluate(fn, inputs, 'f32'), gpuMs: 0 }));
});
const checkOther = createCudaLowering('eviction-probe-pressure', async (_src, fn, cases) =>
  cases.map(inputs => ({ ...evaluate(fn, inputs, 'f32'), gpuMs: 0 })),
);
const active = checkTarget(first.current, target.name);
await running;
// Fill all four settled memo slots while the target batch is still active.
for (const name of ['a', 'b', 'c', 'd']) {
  const other = compileTix(source + 'fn ' + name + '(x:f32[N]):f32[N]{return x;}');
  assert.equal((await checkOther(other.current, 'f')).accepted, true);
}
const joined = checkTarget(first.current, 'f');
release();
assert.deepEqual((await Promise.all([active, joined])).map(result => result.accepted), [true, true]);
assert.equal(targetBatches, 1);
console.log('One active batch after four other baseline keys');
