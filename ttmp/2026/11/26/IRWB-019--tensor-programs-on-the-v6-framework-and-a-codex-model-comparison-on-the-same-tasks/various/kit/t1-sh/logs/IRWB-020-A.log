const VERIFIED = new WeakSet<object>();
/**
 * Projections by adapter and canonical value. A captured adapter is frozen and a canonical value is deep-frozen;
 * projecting is a deterministic function of the two, and it already validated the graph and every resolve.
 */
const PROJECTED = new WeakMap<object, WeakMap<object, IRGraph>>();
export function createIRArtifact<T>(definition: IRAdapter<T>, id: string, value: T): Artifact<T> {
  const adapter = defineAdapter(definition);
  requireText(id, 'Artifact ID');
  const snapshot = immutable(value);
  if (adapter.validate)
    validateOnce(adapter.validate, snapshot, r => synchronous(r, 'Adapter validation'), adapter);
  const artifact = immutable({
    id,
    kind: adapter.kind,
    schemaVersion: adapter.schemaVersion,
    value: snapshot,
    contentHash: fingerprint(snapshot),
    revision: revisionOf(adapter.kind, adapter.schemaVersion, snapshot),
  });
  project(adapter, artifact.value);
  VERIFIED.add(artifact);
  return artifact;
}
export function validateIRArtifact<T>(definition: IRAdapter<T>, artifact: Artifact<T>): Artifact<T> {
  const adapter = defineAdapter(definition),
    snapshot = immutable(artifact);
  requireText(snapshot.id, 'Artifact ID');
  if (snapshot.kind !== adapter.kind || snapshot.schemaVersion !== adapter.schemaVersion)
    throw new IRError('ir.kind', `Adapter ${adapter.id} requires ${adapter.kind}@${adapter.schemaVersion}`);
  if (
    !VERIFIED.has(snapshot) &&
    (snapshot.contentHash !== fingerprint(snapshot.value) ||
      snapshot.revision !== revisionOf(snapshot.kind, snapshot.schemaVersion, snapshot.value))
  )
    throw new IRError('ir.revision', 'Artifact content/revision hash does not match its value');
  VERIFIED.add(snapshot);
  if (adapter.validate)
    validateOnce(adapter.validate, snapshot.value, r => synchronous(r, 'Adapter validation'), adapter);
  return snapshot;
}
export function validateEntity(entity: IREntity): IREntity {
  const e = immutable(entity);
  requireText(e.id, 'Entity ID');
import { canonical, immutable } from '../core/data.js';
import type {
  ChangeSet,
  EditOperation,
  EntityChange,
  IRGraph,
  IRRef,
  IRView,
  RelationChange,
  RevisionRef,
} from './types.js';
import { compareText, refKey, revisionRef } from './common.js';
export function diffGraphs(
  before: IRGraph,
  after: IRGraph,
  from: RevisionRef,
  to: RevisionRef,
  operations: readonly EditOperation[] = [],
): ChangeSet {
  const entities: EntityChange[] = [],
    relations: RelationChange[] = [];
  const oldEntities = new Map(before.entities.map(e => [e.id, e])),
    newEntities = new Map(after.entities.map(e => [e.id, e]));
  const oldRelations = new Map(before.relations.map(r => [r.id, r])),
    newRelations = new Map(after.relations.map(r => [r.id, r]));
  for (const id of [...new Set([...oldEntities.keys(), ...newEntities.keys()])].sort(compareText)) {
    const old = oldEntities.get(id),
      current = newEntities.get(id);
    if (!old)
      entities.push({
        entity: id,
        kind: 'inserted',
        after: current!,
      });
    else if (!current)
      entities.push({
        entity: id,
        kind: 'removed',
        before: old,
      });
    else if (old !== current && canonical(old) !== canonical(current))
      entities.push({
        entity: id,
        kind: 'updated',
        before: old,
        after: current,
      });
  }
  for (const id of [...new Set([...oldRelations.keys(), ...newRelations.keys()])].sort(compareText)) {
    const old = oldRelations.get(id),
      current = newRelations.get(id);
    if (!old)
      relations.push({
        relation: id,
        kind: 'inserted',
        after: current!,
      });
    else if (!current)
      relations.push({
        relation: id,
        kind: 'removed',
        before: old,
      });
    else if (old !== current && canonical(old) !== canonical(current))
      relations.push({
        relation: id,
        kind: 'updated',
        before: old,
        after: current,
      });
  }
  const rootsChanged = before.roots !== after.roots && canonical(before.roots) !== canonical(after.roots);
  return immutable({
    from,
    to,
    entities,
    relations,
    ...(rootsChanged
      ? {
          roots: {
            before: before.roots,
            after: after.roots,
          },
        }
      : {}),
    operations,
    changed: entities.length > 0 || relations.length > 0 || rootsChanged,
  });
}
/** Diff logical projections, even across different adapters/representations. */
export function diff(before: IRView<any>, after: IRView<any>): ChangeSet {
  return diffGraphs(before.graph(), after.graph(), revisionRef(before.artifact), revisionRef(after.artifact));
}
export function affectedEntities(changes: ChangeSet): readonly IRRef[] {
  const refs = new Map<string, IRRef>();
  function add(revision: RevisionRef, entity: string): void {
    const ref = {
      ...revision,
      entity,
    };
    refs.set(refKey(ref), ref);
  }
  for (const change of changes.entities) {
    if (change.before) add(changes.from, change.entity);
    if (change.after) add(changes.to, change.entity);
  }
  for (const change of changes.relations) {
    if (change.before) {
      add(changes.from, change.before.from);
      add(changes.from, change.before.to);
    }
    if (change.after) {
      add(changes.to, change.after.from);
      add(changes.to, change.after.to);
    }
  }
  for (const id of changes.roots?.before ?? []) add(changes.from, id);
  for (const id of changes.roots?.after ?? []) add(changes.to, id);
  return immutable([...refs.values()].sort((a, b) => compareText(refKey(a), refKey(b))));
}
