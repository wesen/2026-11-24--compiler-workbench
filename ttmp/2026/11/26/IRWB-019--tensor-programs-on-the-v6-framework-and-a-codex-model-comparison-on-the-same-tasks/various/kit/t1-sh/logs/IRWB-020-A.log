}

const view = (name: AnalysisName, value: unknown, st: Store, fname: string): unknown => {
  switch (name) {
    case 'liveness':
      return liveView(value as DataflowResult, st, fname);
    case 'reaching':
      return reachView(value as DataflowResult, st, fname);
    case 'ranges':
      return rangeView(value as DataflowResult, st, fname);
    case 'dominators':
      return domView((value as Record<string, Dominators>)[fname]);
    default:
      return (value as Record<string, unknown>)[fname];
  }
};

/** Correspondence entries from origins of new entities and the reasons of removals. */
export function revisionCorrespondence(
  before: TypedBlocks,
  after: TypedBlocks,
  edits: readonly Edit[],
): CorrespondenceEntry[] {
  const src = entityIdSet(before),
    dst = entityIdSet(after);
  const groups = new Map<
    string,
    { to: Set<string>; because: Set<string>; notes: string[]; relation: string }
  >();
  const group = (from: string, relation: string) => {
    let g = groups.get(from);
    if (!g)
      groups.set(
        from,
        (g = { to: new Set(dst.has(from) ? [from] : []), because: new Set(), notes: [], relation }),
      );
    return g;
  };
  for (const table of [after.values, after.stmts, after.blocks] as const)
    for (const e of Object.values(table) as (ValueRec | StmtRec | BlockRec)[]) {
      if (src.has(e.id)) continue;
      const o = e.origin[0];
      if (!o || !o.from || !src.has(o.from)) continue;
      const g = group(o.from, o.via);
      g.to.add(e.id);
      for (const b of o.because ?? []) g.because.add(b);
      if (o.note) g.notes.push(o.note);
    }
  for (const e of edits)
    if (e.kind === 'remove' && src.has(e.stmt as string) && !dst.has(e.stmt as string)) {
      const g = group(e.stmt as string, e.pass);
      for (const b of (e.because as string[]) ?? []) g.because.add(b);
      if (e.note) g.notes.push(e.note as string);
    }
  return [...groups].map(([from, g]) => ({
    from: [from],
    to: [...g.to].sort(),
    relation: g.to.size ? g.relation : 'removed',
    ...(g.because.size ? { because: [...g.because].sort() } : {}),
    ...(g.notes.length ? { note: [...new Set(g.notes)].join(' > ') } : {}),
  }));
}

export type TypedPass = Pass<TypedBlocks, Record<string, any>, Record<string, unknown>> & {
  readonly typed: TypedPassSpec;
};

export function typedPass(spec: TypedPassSpec): TypedPass {
  const needs = Object.fromEntries(
    Object.entries(spec.needs ?? {}).map(([alias, name]) => [alias, ANALYSES[name]]),
}

/** r0 of a project as a v6 artifact. */
export function ingestProject(p: ProjectSource): Artifact<TypedBlocks> {
  return createIRArtifact(blocksAdapter, p.name, ingest(p.name, p.source, p.meta.ingest ?? {}).toNative());
}

export interface PipelineStep {
  readonly pass: string;
  readonly changed: boolean;
  readonly rev: number;
  readonly edits: number;
  readonly report?: RevisionReport;
  readonly result?: PassResult<TypedBlocks>;
  readonly rejected?: string;
}

/**
 * Run a named pipeline (or a list of pass names), checking each changed revision against `origin` with the
 * optimization contract, as Compiler Workbench's `p.pipeline(x)` does with checkEach. A rejected pass leaves the
 * program as it was and is reported; the pipeline continues.
 */
export async function runPipeline(
  origin: Artifact<TypedBlocks>,
  pipeline: string | readonly string[],
  options: {
    manager: AnalysisManager;
    inputs?: ProgramInputs;
    count?: number;
    seed?: number;
    /** The step limit of each case of the meaning check (default the check's 2e4 statements). */
    limit?: number;
    /** Check only from these entry functions (a project's `entries`); default every function. */
    roots?: readonly string[];
    start?: Artifact<TypedBlocks>;
  },
): Promise<{ artifact: Artifact<TypedBlocks>; steps: PipelineStep[] }> {
  const names = typeof pipeline === 'string' ? PIPELINES[pipeline] : pipeline;
  if (!names)
    throw new Error(
      `unknownPipeline: no pipeline "${pipeline}"; pipelines: ${Object.keys(PIPELINES).join(', ')}`,
    );
  const contract = optimizationContract({
    inputs: options.inputs ?? {},
    count: options.count ?? 40,
    seed: options.seed ?? 7,
    ...(options.limit === undefined ? {} : { limit: options.limit }),
    ...(options.roots ? { roots: options.roots } : {}),
  });
  let cur = options.start ?? origin;
  const steps: PipelineStep[] = [];
  for (const name of names) {
    const pass = PASSES[name];
    if (!pass) throw new Error(`unknownPass: no pass named "${name}"`);
    try {
      const r = await applyPass(pass, cur, {
        manager: options.manager,
        contract,
        contractInputs: { origin },
      });
      steps.push({
        pass: name,
        changed: r.changed,
        rev: r.artifact.value.rev,
        edits: r.edits,
        report: r.report as RevisionReport,
        result: r,
      });
      cur = r.artifact;
    } catch (e) {
      if ((e as { code?: string }).code !== 'contractRejected') throw e;
      steps.push({
        pass: name,
        changed: false,
        rev: cur.value.rev,
        edits: 0,
        rejected: (e as Error).message,
      });
    }
  }
  return { artifact: cur, steps };
}
