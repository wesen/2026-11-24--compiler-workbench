/**
 * IRWB-001 E5: differential checkers as v6 invariants.
 *
 * Compiler Workbench checks meaning by running two artifacts on the same generated inputs and comparing results,
 * traps and memory. v6 knows only exact checkers. `differential()` packages the sampled method as an ordinary
 * `InvariantDefinition`, so a transformation contract can `ensure` it like any other invariant. Its evidence records
 * the method (`sampled`), the case count and seed, how many cases agreed, disagreed or were inconclusive, and the
 * first counterexamples. Inconclusive cases (for example a step limit hit by either side) are counted and never
 * treated as a verdict; a check with no decided case fails, because it has established nothing.
 */
import { defineInvariant } from './definitions.js';
import type { CheckResult, InvariantDefinition, PortValue, PortValues, Ports } from './types.js';

/** A small deterministic generator (mulberry32), so a reported counterexample can be run again from its seed. */
export function seededRandom(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

export interface CaseComparison {
  readonly ok: boolean;
  readonly reason?: string;
}

export interface DifferentialSpec<P extends Ports, Case, Outcome> {
  readonly id: string;
  readonly version: string;
  readonly description: string;
  readonly inputs: P;
  /** The port whose behaviour defines the expected meaning (e.g. `origin`, r0). */
  readonly baseline: keyof P & string;
  /** The port being checked against it (e.g. `candidate`). */
  readonly subject: keyof P & string;
  readonly count: number;
  readonly seed?: number;
  /** The generator to seed (default `seededRandom`, mulberry32); a port may supply its tool's own generator. */
  readonly random?: (seed: number) => () => number;
  /** Generate the cases, deterministically from `random` and the inputs. */
  cases(inputs: PortValues<P>, random: () => number, count: number): readonly Case[];
  /** Run one side on one case. `side` names which port `value` came from. */
  run(side: 'baseline' | 'subject', value: PortValue<P[keyof P]>, kase: Case, inputs: PortValues<P>): Outcome;
  compare(baseline: Outcome, subject: Outcome, kase: Case): CaseComparison | boolean;
  inconclusive?(outcome: Outcome): boolean;
  describeCase?(kase: Case): unknown;
  readonly maxCounterexamples?: number;
  /**
   * IRWB-004 D1: a key such that the cases, and the baseline's outcome on each, are a function of this spec (its id,
   * version, seed and count) and the key alone; for a check against a fixed origin, the origin's revision. With a
   * key, both are computed once per key and reused by every later check.
   */
  readonly baselineKey?: (inputs: PortValues<P>) => string | undefined;
  /**
   * IRWB-004 D1: a key such that the subject's outcome on a case is a function of the case and the key alone (for a
   * program, a hash of the code the case can reach). Used only together with `baselineKey`: a decided verdict is
   * kept under (baseline key, case index, subject key) and replayed instead of evaluating the case again.
   */
  readonly subjectKey?: (subject: PortValue<P[keyof P]>, kase: Case, inputs: PortValues<P>) => string | undefined;
  /**
   * IRWB-004 F4: decide the cases at the indices `todo` elsewhere (e.g. on worker threads), returning one verdict
   * per index, in the order of `todo`, exactly as `run`, `inconclusive` and `compare` would decide them; or
   * `undefined` to decide them here. The check's evidence is assembled in case order, whoever decided a case.
   */
  readonly decide?: (
    inputs: PortValues<P>,
    cases: readonly Case[],
    todo: readonly number[],
  ) => Promise<readonly Decided[]> | undefined;
}

/** One decided case: what `compare` (or `inconclusive`) concluded. */
export type Decided =
  | { readonly v: 'agree' }
  | { readonly v: 'inconclusive' }
  | { readonly v: 'disagree'; readonly reason: string };

export interface DifferentialEvidence {
  readonly method: 'sampled';
  readonly invariant: string;
  readonly seed: number;
  readonly total: number;
  readonly agree: number;
  readonly disagree: number;
  readonly inconclusive: number;
  readonly status: 'agree' | 'disagree' | 'inconclusive';
  readonly counterexamples: readonly { readonly case: unknown; readonly reason: string }[];
}

export type DifferentialInvariant<P extends Ports> = InvariantDefinition<P> & {
  readonly method: 'sampled';
};

export function differential<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
): DifferentialInvariant<P> {
  if (!(spec.count > 0 && Number.isInteger(spec.count)))
    throw new Error('Differential check needs a positive case count');
  if (!(spec.baseline in spec.inputs) || !(spec.subject in spec.inputs) || spec.baseline === spec.subject)
    throw new Error('Differential check needs distinct baseline and subject ports');
  const seed = spec.seed ?? 1,
    maxCx = spec.maxCounterexamples ?? 5;
  const result = (evidence: DifferentialEvidence): CheckResult => ({
    ok: evidence.status === 'agree',
    reason:
      evidence.status === 'agree'
        ? `${evidence.agree}/${evidence.total} sampled cases agree (${evidence.inconclusive} inconclusive)`
        : evidence.status === 'disagree'
          ? `${evidence.disagree}/${evidence.total} sampled cases disagree`
          : `no decided case among ${evidence.total} (all inconclusive)`,
    evidence,
  });
  const inv = defineInvariant<P>({
    id: spec.id,
    version: spec.version,
    description: spec.description,
    inputs: spec.inputs,
    check(_ctx, inputs): CheckResult | Promise<CheckResult> {
      if (spec.decide) return runDifferentialAsync(spec, inputs, seed, maxCx).then(result);
      return result(runDifferential(spec, inputs, seed, maxCx));
    },
  });
  const out = Object.assign(Object.create(null), inv, { method: 'sampled' as const }) as DifferentialInvariant<P>;
  SPECS.set(out, spec as DifferentialSpec<any, any, any>);
  return out;
}

const SPECS = new WeakMap<object, DifferentialSpec<any, any, any>>();
/** IRWB-004 F4: the specification a differential invariant was made from (a worker decides cases with it). */
export function differentialSpec<P extends Ports>(inv: DifferentialInvariant<P>): DifferentialSpec<P, any, any> {
  const spec = SPECS.get(inv);
  if (!spec) throw new Error(`${inv.id} is not a differential invariant of this realm`);
  return spec;
}

/**
 * IRWB-004 D1: what a check against a baseline key keeps. The cases and the baseline's outcomes (computed as cases
 * are first evaluated) are fixed by the key; `verdicts` maps `index \0 subject key` to the decided verdict. A few
 * keys are kept, least recently used first out.
 */
interface Reuse {
  readonly cases: readonly unknown[];
  readonly outcomes: unknown[];
  readonly verdicts: Map<string, Decided>;
}
const REUSE = new Map<string, Reuse>();
const REUSE_MAX = 4;
let reuseEnabled = true;
/** Turn the reuse of cases, baseline outcomes and verdicts on or off (tests and measurements compare both). */
export function setDifferentialReuse(enabled: boolean): void {
  reuseEnabled = enabled;
  if (!enabled) REUSE.clear();
}
/** Counts since the last reset: sides run here, verdicts replayed from the memo, cases decided by `decide`. */
const STATS = { baselineRuns: 0, subjectRuns: 0, replayed: 0, delegated: 0 };
export function differentialStats(reset = false): Readonly<typeof STATS> {
  const out = { ...STATS };
  if (reset) for (const k of Object.keys(STATS) as (keyof typeof STATS)[]) STATS[k] = 0;
  return out;
}

function prepare<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  seed: number,
): { cases: readonly Case[]; reuse?: Reuse } {
  const bk = reuseEnabled ? spec.baselineKey?.(inputs) : undefined;
  if (bk === undefined) return { cases: spec.cases(inputs, (spec.random ?? seededRandom)(seed), spec.count) };
  const key = `${spec.id}@${spec.version}#${seed}#${spec.count}#${bk}`;
  let reuse = REUSE.get(key);
  if (reuse) REUSE.delete(key);
  else
    reuse = {
      cases: spec.cases(inputs, (spec.random ?? seededRandom)(seed), spec.count),
      outcomes: [],
      verdicts: new Map(),
    };
  REUSE.set(key, reuse);
  while (REUSE.size > REUSE_MAX) REUSE.delete(REUSE.keys().next().value!);
  return { cases: reuse.cases as readonly Case[], reuse };
}

const AGREE: Decided = Object.freeze({ v: 'agree' }),
  INCONCLUSIVE: Decided = Object.freeze({ v: 'inconclusive' });
/**
 * Decide one case: run both sides, then `inconclusive`, then `compare`, as a check always has. `outcomes`, when
 * given, keeps the baseline's outcome by case index (it is fixed by the baseline key); a worker deciding cases for a
 * check (IRWB-004 F4) calls this too, with its own `outcomes`.
 */
export function decideCase<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  kase: Case,
  index: number,
  outcomes?: unknown[],
): Decided {
  let a = outcomes?.[index] as Outcome | undefined;
  if (a === undefined) {
    a = spec.run('baseline', inputs[spec.baseline] as PortValue<P[keyof P]>, kase, inputs);
    STATS.baselineRuns++;
    if (outcomes) outcomes[index] = a;
  }
  STATS.subjectRuns++;
  const b = spec.run('subject', inputs[spec.subject] as PortValue<P[keyof P]>, kase, inputs);
  if (spec.inconclusive?.(a) || spec.inconclusive?.(b)) return INCONCLUSIVE;
  const c = spec.compare(a, b, kase);
  const verdict = typeof c === 'boolean' ? { ok: c } : c;
  return verdict.ok ? AGREE : Object.freeze({ v: 'disagree', reason: verdict.reason ?? 'outcomes differ' });
}

/** The evidence of decided cases, counted in case order (so counterexamples come in case order). */
function tally<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  seed: number,
  cases: readonly Case[],
  verdicts: readonly Decided[],
  maxCounterexamples: number,
): DifferentialEvidence {
  let agree = 0,
    disagree = 0,
    inconclusive = 0;
  const counterexamples: { case: unknown; reason: string }[] = [];
  for (let i = 0; i < cases.length; i++) {
    const d = verdicts[i];
    if (d.v === 'inconclusive') inconclusive++;
    else if (d.v === 'agree') agree++;
    else {
      disagree++;
      if (counterexamples.length < maxCounterexamples)
        counterexamples.push({
          case: spec.describeCase ? spec.describeCase(cases[i]) : cases[i],
          reason: d.reason,
        });
    }
  }
  return {
    method: 'sampled',
    invariant: spec.id,
    seed,
    total: cases.length,
    agree,
    disagree,
    inconclusive,
    status: disagree ? 'disagree' : agree ? 'agree' : 'inconclusive',
    counterexamples,
  };
}

/** The memo keys of the cases (undefined where a case has no subject key or nothing is reused). */
function memoKeys<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  cases: readonly Case[],
  reuse: Reuse | undefined,
): (string | undefined)[] {
  if (!reuse || !spec.subjectKey) return new Array(cases.length).fill(undefined);
  const subject = inputs[spec.subject] as PortValue<P[keyof P]>;
  return cases.map((c, i) => {
    const sk = spec.subjectKey!(subject, c, inputs);
    return sk === undefined ? undefined : `${i}\u0000${sk}`;
  });
}

/**
 * Run a differential specification directly (tools, the workbench's Checks view) without a manager. IRWB-004: with
 * `baselineKey`, the cases and baseline outcomes are kept and reused; with `subjectKey` too, a case whose verdict is
 * known for its subject key is not evaluated again. The evidence is the same either way.
 */
export function runDifferential<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  seed = spec.seed ?? 1,
  maxCounterexamples = spec.maxCounterexamples ?? 5,
): DifferentialEvidence {
  const { cases, reuse } = prepare(spec, inputs, seed);
  const keys = memoKeys(spec, inputs, cases, reuse);
  const verdicts: Decided[] = new Array(cases.length);
  for (let i = 0; i < cases.length; i++) {
    const known = keys[i] === undefined ? undefined : reuse!.verdicts.get(keys[i]!);
    if (known) {
      verdicts[i] = known;
      STATS.replayed++;
      continue;
    }
    verdicts[i] = decideCase(spec, inputs, cases[i], i, reuse?.outcomes);
    if (keys[i] !== undefined) reuse!.verdicts.set(keys[i]!, verdicts[i]);
  }
  return tally(spec, seed, cases, verdicts, maxCounterexamples);
}

/** `runDifferential`, with the cases nobody decided yet handed to `spec.decide` (IRWB-004 F4). */
export async function runDifferentialAsync<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  seed = spec.seed ?? 1,
  maxCounterexamples = spec.maxCounterexamples ?? 5,
): Promise<DifferentialEvidence> {
  const { cases, reuse } = prepare(spec, inputs, seed);
  const keys = memoKeys(spec, inputs, cases, reuse);
  const verdicts: Decided[] = new Array(cases.length);
  const todo: number[] = [];
  for (let i = 0; i < cases.length; i++) {
    const known = keys[i] === undefined ? undefined : reuse!.verdicts.get(keys[i]!);
    if (known) {
      verdicts[i] = known;
      STATS.replayed++;
    } else todo.push(i);
  }
  const elsewhere = todo.length ? spec.decide?.(inputs, cases, todo) : undefined;
  if (elsewhere) {
    const decided = await elsewhere;
    if (decided.length !== todo.length) throw new Error(`${spec.id}: decide returned ${decided.length} of ${todo.length}`);
    todo.forEach((i, k) => (verdicts[i] = decided[k]));
    STATS.delegated += todo.length;
  } else for (const i of todo) verdicts[i] = decideCase(spec, inputs, cases[i], i, reuse?.outcomes);
  for (const i of todo) if (keys[i] !== undefined) reuse!.verdicts.set(keys[i]!, verdicts[i]);
  return tally(spec, seed, cases, verdicts, maxCounterexamples);
}

/** The assurance a check's evidence supports: sampled differential testing is weaker than an exact checker. */
export function assuranceOf(evidence: unknown): 'checked-sampled' | 'checked-exact' {
  return (evidence as { method?: string } | null)?.method === 'sampled' ? 'checked-sampled' : 'checked-exact';
}
import {
  canonical,
  deepFreeze,
  fingerprint,
  immutable,
  isCanonical,
  revisionOf,
  validateOnce,
} from '../core/data.js';
import type { Artifact } from '../core/types.js';
import type {
  AnalysisDefinition,
  AnyDefinition,
  CheckResult,
  DefinitionDescriptor,
  EffectDefinition,
  IRType,
  InvariantDefinition,
  ObjectiveDefinition,
  Ports,
  PropertyDefinition,
  TransformationDefinition,
  ValueType,
  VersionRef,
} from './types.js';
const nonempty = (value: unknown): value is string => typeof value === 'string' && value.trim().length > 0;
function portType(value: unknown, category?: 'ir' | 'type'): asserts value is IRType<any> | ValueType<any> {
  if (
    !value ||
    typeof value !== 'object' ||
    !['ir', 'type'].includes(
      (
        value as {
          category: string;
        }
      ).category,
    ) ||
    (category &&
      (
        value as {
          category: string;
        }
      ).category !== category) ||
    typeof (
      value as {
        validate?: unknown;
      }
    ).validate !== 'function'
  )
    throw new Error(`Expected ${category ?? 'IR or scalar'} type with runtime validator`);
}
function ports(value: unknown): asserts value is Ports {
  if (!value || typeof value !== 'object' || Array.isArray(value))
    throw new Error('Expected named port definitions');
  for (const [name, type] of Object.entries(value)) {
    if (!nonempty(name)) throw new Error('Port name required');
    portType(type);
  }
}
function base<
  T extends {
    id: string;
    version: string;
    description: string;
  },
>(value: T): T {
  if (!nonempty(value.id) || !nonempty(value.version) || typeof value.description !== 'string')
    throw new Error('Definitions need id, version and description');
  return deepFreeze(value);
}
export const defineType = <T>(d: Omit<ValueType<T>, 'category'>): ValueType<T> => {
  if (typeof d.validate !== 'function') throw new Error('Type requires a runtime validator');
  return base({
    ...d,
    category: 'type',
  });
};
export const defineIR = <T>(d: Omit<IRType<T>, 'category'>): IRType<T> => {
  if (typeof d.validate !== 'function') throw new Error('IR requires a runtime validator');
  return base({
    ...d,
    category: 'ir',
  });
};
export const defineEffect = <T>(d: Omit<EffectDefinition<T>, 'category'>): EffectDefinition<T> => {
  portType(d.type, 'type');
  if (!nonempty(d.resource) || !['read', 'write'].includes(d.access))
    throw new Error('Effect needs resource and read/write access');
  return base({
    ...d,
    category: 'effect',
  });
};
export const defineAnalysis = <S, R>(
  d: Omit<AnalysisDefinition<S, R>, 'category' | 'effects'> & {
    effects?: readonly EffectDefinition[];
  },
): AnalysisDefinition<S, R> => {
  portType(d.input, 'ir');
  portType(d.output, 'type');
  if (typeof d.run !== 'function') throw new Error('Analysis needs run');
  if (
    d.transfer &&
    (!nonempty(d.transfer.id) || !nonempty(d.transfer.version) || typeof d.transfer.verify !== 'function')
  )
    throw new Error('Analysis transfer needs exact rule identity and verifier');
  if (d.effects?.some(e => e.access === 'write')) throw new Error('Analyses cannot declare write effects');
  return base({
    ...d,
    effects: d.effects ?? [],
    category: 'analysis',
  });
};
export const defineProperty = <S>(d: Omit<PropertyDefinition<S>, 'category'>): PropertyDefinition<S> => {
  portType(d.subject, 'ir');
  if (!d.check || d.check.category !== 'analysis') throw new Error('Property needs an analysis checker');
  if (
    d.proofVerifier &&
    (d.proofVerifier.input.id !== d.subject.id || d.proofVerifier.input.version !== d.subject.version)
  )
    throw new Error('Proof verifier input must match property subject IR');
  if (d.subject.id !== d.check.input.id || d.subject.version !== d.check.input.version)
    throw new Error('Property checker input must match its subject IR');
  return base({
    ...d,
    category: 'property',
  });
};
export const defineInvariant = <P extends Ports>(
  d: Omit<InvariantDefinition<P>, 'category' | 'effects'> & {
    effects?: readonly EffectDefinition[];
  },
): InvariantDefinition<P> => {
  ports(d.inputs);
  if (typeof d.check !== 'function') throw new Error('Invariant needs a checker');
  if (d.effects?.some(e => e.access === 'write')) throw new Error('Invariants cannot declare write effects');
  return base({
    ...d,
    effects: d.effects ?? [],
    category: 'invariant',
  });
};
export const defineObjective = <S>(d: Omit<ObjectiveDefinition<S>, 'category'>): ObjectiveDefinition<S> => {
  if (!['min', 'max'].includes(d.direction)) throw new Error('Objective direction must be min/max');
  return base({
    ...d,
    category: 'objective',
  });
};
export function defineTransformation<I extends Ports, O extends Ports>(
  d: Omit<
    TransformationDefinition<I, O>,
    'category' | 'requires' | 'preserves' | 'ensures' | 'establishes' | 'effects' | 'cache' | 'correspondence'
  > &
    Partial<
      Pick<
        TransformationDefinition<I, O>,
        'requires' | 'preserves' | 'ensures' | 'establishes' | 'effects' | 'cache' | 'correspondence'
      >
    >,
): TransformationDefinition<I, O> {
  ports(d.inputs);
  ports(d.outputs);
  if (d.run !== undefined && typeof d.run !== 'function')
    throw new Error('Transformation run must be a function');
  const result = base({
    ...d,
    category: 'transformation' as const,
    requires: d.requires ?? [],
    preserves: d.preserves ?? [],
    ensures: d.ensures ?? [],
    establishes: d.establishes ?? [],
    effects: d.effects ?? [],
    cache: d.cache ?? 'pure',
    correspondence: d.correspondence ?? [],
  });
  if (result.cache === 'pure' && result.effects.length)
    throw new Error('Pure transformation cannot declare resource effects');
  if (result.cache !== 'never' && result.effects.some(e => e.access === 'write'))
    throw new Error('Write effects require cache: never');
  if (!['pure', 'tracked', 'never'].includes(result.cache)) throw new Error('Invalid cache policy');
  const selector = (
    s: {
      from: 'inputs' | 'outputs';
      port: string;
    },
    pre = false,
  ) => {
    if (!s || !['inputs', 'outputs'].includes(s.from) || !nonempty(s.port))
      throw new Error('Invalid contract port selector');
    if (pre && s.from === 'outputs') throw new Error('Preconditions cannot refer to outputs');
    const ports = s.from === 'inputs' ? result.inputs : result.outputs;
    if (!Object.hasOwn(ports, s.port)) throw new Error(`Unknown ${s.from} port ${s.port}`);
    return ports[s.port];
  };
  for (const [phase, conditions] of [
    ['requires', result.requires],
    ['ensures', result.ensures],
    ['establishes', result.establishes],
  ] as const)
    for (const c of conditions) {
      if ('property' in c) {
        const type = selector(c.subject, phase === 'requires');
        if (
          type.category !== 'ir' ||
          type.id !== c.property.subject.id ||
          type.version !== c.property.subject.version
        )
          throw new Error(`Property ${c.property.id} is incompatible with port ${c.subject.port}`);
      } else {
        for (const [name, type] of Object.entries(c.invariant.inputs as Ports)) {
          const s = c.bindings[name];
          if (!s) throw new Error(`Missing invariant binding ${name}`);
          const bound = selector(s, phase === 'requires');
          if (bound.category !== type.category || bound.id !== type.id || bound.version !== type.version)
            throw new Error(`Invariant port ${name} is incompatible`);
        }
        if (Object.keys(c.bindings).length !== Object.keys(c.invariant.inputs).length)
          throw new Error('Unexpected invariant bindings');
      }
    }
  for (const p of result.preserves) {
    const from = result.inputs[p.from],
      to = result.outputs[p.to];
    if (
      !from ||
      !to ||
      from.category !== 'ir' ||
      to.category !== 'ir' ||
      from.id !== p.property.subject.id ||
      to.id !== p.property.subject.id ||
      from.version !== p.property.subject.version ||
      to.version !== p.property.subject.version
    )
      throw new Error(`Preservation ${p.property.id} needs compatible IR input/output ports`);
    if (!['check', 'transfer'].includes(p.mode)) throw new Error('Preservation mode must be check/transfer');
    if (p.mode === 'transfer' && (!p.correspondence || !p.property.check.transfer))
      throw new Error('Transfer preservation needs a correspondence and registered transfer checker');
  }
  for (const c of result.correspondence) {
    if (result.inputs[c.from]?.category !== 'ir' || result.outputs[c.to]?.category !== 'ir')
      throw new Error('Correspondence requirements need IR input/output ports');
  }
  return result;
}
export const definitionRef = (d: VersionRef): VersionRef => ({
  id: d.id,
  version: d.version,
});
function shape(v: unknown): unknown {
  if (typeof v === 'function') return '[implementation]';
  if (Array.isArray(v)) return v.map(shape);
  if (v && typeof v === 'object') {
    if ('category' in v && 'id' in v && 'version' in v) return definitionRef(v as VersionRef);
    return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, shape(x)]));
  }
  return v;
}
export function describeDefinition(d: AnyDefinition): DefinitionDescriptor {
  const { id, version, description, category, ...other } = d;
  return immutable({
    id,
    version,
    description,
    category,
    schema: shape(other),
  });
}
export function createArtifact<T>(ir: IRType<T>, id: string, value: T): Artifact<T> {
  if (!nonempty(id)) throw new Error('Artifact id required');
  const captured = immutable(value);
  ir.validate(captured);
  return immutable({
    id,
    kind: ir.id,
    schemaVersion: ir.version,
    contentHash: fingerprint(captured),
    revision: fingerprint({
      kind: ir.id,
      schemaVersion: ir.version,
      value: captured,
    }),
    value: captured,
  });
}
export function validateArtifact<T>(ir: IRType<T>, value: unknown): asserts value is Artifact<T> {
  if (!value || typeof value !== 'object') throw new Error(`Expected ${ir.id} artifact`);
  const a = value as Artifact<T>;
  if (a.kind !== ir.id || a.schemaVersion !== ir.version || !nonempty(a.id))
    throw new Error(`Expected ${ir.id}@${ir.version} artifact`);
  // IRWB-004: a frozen value the validator accepted is not validated again; the revision is computed once per value;
  // and an artifact `immutable` built is encodable by construction (it passed the same checks as `canonical`)
  validateOnce(ir.validate, a.value, undefined, ir);
  if (a.contentHash !== fingerprint(a.value) || a.revision !== revisionOf(a.kind, a.schemaVersion, a.value))
    throw new Error('Artifact content/revision hash does not match its immutable value');
  if (!isCanonical(a)) canonical(a);
}
export const Check: ValueType<CheckResult> = defineType<CheckResult>({
  id: 'contract.check-result',
  version: '1',
  description: 'Dynamically checked proposition and its evidence',
  validate(v: unknown): asserts v is CheckResult {
    if (!v || typeof v !== 'object' || typeof (v as CheckResult).ok !== 'boolean')
      throw new Error('Expected {ok:boolean, reason?, evidence?}');
    if ((v as CheckResult).reason !== undefined && typeof (v as CheckResult).reason !== 'string')
      throw new Error('Check reason must be text');
  },
});
export const FiniteNumber = defineType<number>({
  id: 'contract.finite-number',
  version: '1',
  description: 'Finite scalar number',
  validate(v: unknown): asserts v is number {
    if (typeof v !== 'number' || !Number.isFinite(v)) throw new Error('Expected finite number');
  },
});
export const Integer = defineType<number>({
  id: 'contract.integer',
  version: '1',
  description: 'Safe integer',
  validate(v: unknown): asserts v is number {
    if (!Number.isSafeInteger(v)) throw new Error('Expected safe integer');
  },
});
export const JsonValue = defineType<unknown>({
  id: 'contract.json',
  version: '1',
  description: 'Finite acyclic JSON value',
  validate(v: unknown): asserts v is unknown {
    canonical(v);
  },
});
import type { Artifact, EntityRef } from '../core/types.js';
export interface VersionRef {
  readonly id: string;
  readonly version: string;
}
export interface DefinitionBase extends VersionRef {
  readonly description: string;
}
export interface ValueType<T = unknown> extends DefinitionBase {
  readonly category: 'type';
  validate(value: unknown): asserts value is T;
}
export interface IRType<T = unknown> extends DefinitionBase {
  readonly category: 'ir';
  validate(value: unknown): asserts value is T;
}
export type PortType = ValueType<any> | IRType<any>;
export type Ports = Readonly<Record<string, PortType>>;
export type PortValue<T extends PortType> =
  T extends IRType<infer V> ? Artifact<V> : T extends ValueType<infer V> ? V : never;
export type PortValues<P extends Ports> = {
  readonly [K in keyof P]: PortValue<P[K]>;
};
export interface CheckResult {
  readonly ok: boolean;
  readonly reason?: string;
  readonly evidence?: unknown;
}
export interface ResourceStamp {
  readonly resource: string;
  readonly revision: string;
}
export interface ResourceValue extends ResourceStamp {
  readonly value: unknown;
}
export interface ResourceWrite {
  readonly resource: string;
  readonly value: unknown;
}
/** Synchronous snapshot reads and atomic synchronous commit; returned Promises are rejected.
 * The adapter must check all expected revisions and apply all writes, or apply none. */
export interface ResourcePort {
  read(resource: string): ResourceValue | undefined;
  commit(writes: readonly ResourceWrite[], expected: readonly ResourceStamp[]): void;
}
export interface EffectDefinition<T = unknown> extends DefinitionBase {
  readonly category: 'effect';
  readonly resource: string;
  readonly access: 'read' | 'write';
  readonly type: ValueType<T>;
}
export interface Correspondence {
  readonly id: string;
  readonly from: EntityRef;
  readonly to: EntityRef;
  readonly relation: string;
  readonly entities?: readonly {
    readonly from: readonly string[];
    readonly to: readonly string[];
  }[];
  readonly evidence: unknown;
}
export interface AnalysisDefinition<S = unknown, R = unknown> extends DefinitionBase {
  readonly category: 'analysis';
  readonly input: IRType<S>;
  readonly output: ValueType<R>;
  readonly effects: readonly EffectDefinition[];
  run(ctx: ContractContext, subject: Artifact<S>, params: unknown): R | Promise<R>;
  readonly transfer?: {
    readonly id: string;
    readonly version: string;
    verify(
      ctx: ContractContext,
      input: {
        from: Artifact<S>;
        to: Artifact<S>;
        record: AnalysisRecord<R>;
        correspondence: Correspondence;
      },
    ): CheckResult | Promise<CheckResult>;
  };
}
export interface PropertyDefinition<S = unknown> extends DefinitionBase {
  readonly category: 'property';
  readonly subject: IRType<S>;
  readonly check: AnalysisDefinition<S, CheckResult>;
  readonly proofVerifier?: AnalysisDefinition<S, CheckResult>;
}
export interface InvariantDefinition<P extends Ports = Ports> extends DefinitionBase {
  readonly category: 'invariant';
  readonly inputs: P;
  readonly effects: readonly EffectDefinition[];
  check(ctx: ContractContext, inputs: PortValues<P>): CheckResult | Promise<CheckResult>;
}
export interface ObjectiveDefinition<S = unknown> extends DefinitionBase {
  readonly category: 'objective';
  readonly analysis: AnalysisDefinition<S, number>;
  readonly direction: 'min' | 'max';
}
export interface PortSelector {
  readonly from: 'inputs' | 'outputs';
  readonly port: string;
}
export type Condition =
  | {
      readonly property: PropertyDefinition<any>;
      readonly subject: PortSelector;
    }
  | {
      readonly invariant: InvariantDefinition<any>;
      readonly bindings: Readonly<Record<string, PortSelector>>;
    };
export interface Preservation {
  readonly property: PropertyDefinition<any>;
  readonly from: string;
  readonly to: string;
  readonly mode: 'check' | 'transfer';
  readonly correspondence?: string;
}
export interface CorrespondenceRequirement {
  readonly id: string;
  readonly from: string;
  readonly to: string;
  readonly relation?: string;
}
export type CachePolicy = 'pure' | 'tracked' | 'never';
export interface TransformationDefinition<I extends Ports = Ports, O extends Ports = Ports>
  extends DefinitionBase {
  readonly category: 'transformation';
  readonly inputs: I;
  readonly outputs: O;
  readonly requires: readonly Condition[];
  readonly preserves: readonly Preservation[];
  readonly ensures: readonly Condition[];
  readonly establishes: readonly Condition[];
  readonly effects: readonly EffectDefinition[];
  readonly cache: CachePolicy;
  readonly correspondence: readonly CorrespondenceRequirement[];
  run?(
    ctx: ContractContext,
    inputs: PortValues<I>,
  ): TransformationBodyResult<O> | Promise<TransformationBodyResult<O>>;
