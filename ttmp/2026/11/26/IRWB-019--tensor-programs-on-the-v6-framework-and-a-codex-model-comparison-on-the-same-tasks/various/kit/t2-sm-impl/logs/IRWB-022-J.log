import json
import statistics
import sys
from pathlib import Path

def entries(*files):
    rows = {}
    for name in files:
        for line in Path(name).read_text().splitlines():
            item = json.loads(line)
            if 'name' in item:
                rows.setdefault(item['name'], item)
    return rows

gpu = entries('/tmp/irwb-022-j-gpu-final.jsonl')
cpu = entries('/tmp/irwb-022-j-cpu.jsonl', '/tmp/irwb-022-j-cpu-rest.jsonl')
expected = ['matmul', 'softmax', 'layernorm', 'attention', 'mlp', 'conv2d']
assert list(gpu) == expected and list(cpu) == expected
lines = [
    '## Full-size timings', '',
    '| Program | Shape bindings | GB10 median (ms) | GB10 range (ms) | Tix f32 (ms) | CPU / GPU |',
    '| --- | --- | ---: | ---: | ---: | ---: |',
]
raw = []
for name in expected:
    g, c = gpu[name], cpu[name]
    assert g['dims'] == c['dims'] and len(g['milliseconds']) == 5
    bindings = ', '.join(f'{axis}={value}' for axis, value in g['dims'].items())
    trials, elapsed = g['milliseconds'], c['milliseconds']
    median = statistics.median(trials)
    lines.append(f'| {name} | {bindings} | {median:.3f} | {min(trials):.3f}–{max(trials):.3f} | '
                 f'{elapsed:,.1f} | {elapsed / median:,.0f}× |')
    raw.append(json.dumps({'name': name, 'gpuMs': trials, 'cpuMs': elapsed}, separators=(',', ':')))
lines += ['', '### Recorded intervals', '', '"'```jsonl'"', *raw, '"'```'"', '']
with open(sys.argv[1], 'a') as report:
    report.write('\\n'.join(lines))
print('\\n'.join(lines[:11]))
PY
