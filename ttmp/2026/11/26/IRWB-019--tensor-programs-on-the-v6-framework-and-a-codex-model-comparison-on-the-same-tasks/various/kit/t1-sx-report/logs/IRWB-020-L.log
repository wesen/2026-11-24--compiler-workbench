   169	    version: '1',
   170	    description: 'Compare returned tensors on generated calls',
   171	    inputs: ports,
   172	    baseline: 'baseline',
   173	    subject: 'candidate',
   174	    count: cases.items.length,
   175	    seed,
   176	    cases: () => cases.items,
