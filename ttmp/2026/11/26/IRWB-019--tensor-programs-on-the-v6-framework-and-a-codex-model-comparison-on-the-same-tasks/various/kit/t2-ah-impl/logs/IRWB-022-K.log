export function mapExpr(e: Expr, f: (e: Expr) => Expr): Expr {
  if (e.kind === 'op') e = { ...e, args: e.args.map(x => mapExpr(x, f)) };
  if (e.kind === 'reduce') e = { ...e, body: mapExpr(e.body, f) };
