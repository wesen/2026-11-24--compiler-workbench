import { createIRArtifact } from '../framework/ir/index.js';
import { applyNativePassSync, PassError } from '../framework/passes/index.js';
import { meaningGate } from './contract.js';
import { evaluate, type Inputs, type Precision, type BufferValue } from './evaluate.js';
import { adapter } from './ir.js';
import type { Module } from './model.js';
import { parse } from './parser.js';
import { inlinePass, splitPass } from './passes.js';

export interface TixProgram {
  readonly origin: Artifact<Module>;
  readonly current: Artifact<Module>;
}
export function compileTix(source: string): TixProgram {
  const origin = createIRArtifact(adapter, 'tix', parse(source));
  return { origin, current: origin };
}
export function runTix(
  program: TixProgram,
  fn: string,
  inputs: Inputs,
  options?: { precision?: Precision },
): BufferValue {
  const f = program.current.value.functions.find(f => f.name === fn);
  if (!f) throw Error('Unknown function ' + fn);
  return evaluate(f, inputs, options?.precision ?? 'f32');
}
export function optimizeTix(program: TixProgram, passes: string[]) {
  const { origin } = program;
  let { current } = program;
  const steps = passes.map(pass => {
    const definition = pass === 'inline' ? inlinePass : pass === 'split-sum' ? splitPass : undefined;
    if (!definition) throw Error('Unknown pass ' + pass);
    try {
      current = applyNativePassSync(
        definition,
        current,
        meaningGate(origin, pass === 'inline' ? 'exact' : 'tolerance'),
      ).artifact;
      return { pass, accepted: true };
    } catch (error) {
      if (error instanceof PassError && error.code === 'contractRejected') return { pass, accepted: false };
      throw error;
    }
  });
  return { program: { origin, current }, steps };
}
// Affine forms use ordered terms so equivalent dimensions have the same artifact identity.
export interface Affine {
  constant: number;
  terms: [string, number][];
}
export const constant = (value: number): Affine => ({ constant: value, terms: [] });
export const variable = (name: string): Affine => ({ constant: 0, terms: [[name, 1]] });
export function add(a: Affine, b: Affine, scale = 1): Affine {
  const terms = new Map(a.terms);
  for (const [name, k] of b.terms) terms.set(name, (terms.get(name) ?? 0) + k * scale);
  const result = {
    constant: a.constant + b.constant * scale,
    terms: [...terms].filter(([, k]) => k !== 0).sort(([x], [y]) => (x < y ? -1 : 1)),
  };
  if (![result.constant, ...result.terms.map(([, k]) => k)].every(Number.isSafeInteger))
    throw Error('Affine integer overflow');
  return result;
}
export function substitute(a: Affine, bindings: Map<string, Affine>): Affine {
  return a.terms.reduce(
    (v, [name, k]) => add(v, bindings.get(name) ?? variable(name), k),
    constant(a.constant),
  );
}
export function value(a: Affine, env: Map<string, number>): number {
  return a.terms.reduce((v, [name, k]) => v + env.get(name)! * k, a.constant);
}
export function plain(a: Affine): string | undefined {
  return a.constant === 0 && a.terms.length === 1 && a.terms[0][1] === 1 ? a.terms[0][0] : undefined;
}
export type Extent =
  | { kind: 'dim'; dim: Affine }
  | { kind: 'blocks'; dim: Affine; rounding: 'ceil' | 'floor' }
  | { kind: 'tail'; dim: Affine; block: string };
export interface Axis {
  id: string;
  extent: Extent;
}
export type Op = '+' | '-' | '*' | '/' | 'neg' | 'exp' | 'log' | 'sqrt' | 'tanh' | 'max' | 'min';
export type Expr =
  | { kind: 'literal'; text: string }
  | { kind: 'shape'; name: string }
  | { kind: 'load'; name: string; indices: Affine[] }
  | { kind: 'op'; op: Op; args: Expr[] }
  | { kind: 'reduce'; op: 'sum' | 'max'; axes: Axis[]; body: Expr };
export interface Tensor {
  name: string;
  shape: Affine[];
}
export interface Statement extends Tensor {
  axes: Axis[];
  expr: Expr;
}
export interface Fn {
  name: string;
  params: Tensor[];
  statements: Statement[];
  result: string;
  shape: Affine[];
}
export interface Module {
  functions: Fn[];
}
export const width = 4;
export function mapExpr(e: Expr, f: (e: Expr) => Expr): Expr {
  if (e.kind === 'op') e = { ...e, args: e.args.map(x => mapExpr(x, f)) };
  if (e.kind === 'reduce') e = { ...e, body: mapExpr(e.body, f) };
  return f(e);
}
export function visit(e: Expr, f: (e: Expr) => void) {
  f(e);
  if (e.kind === 'op') e.args.forEach(x => visit(x, f));
  if (e.kind === 'reduce') visit(e.body, f);
}
import { plain, value, width, type Axis, type Expr, type Fn, type Op } from './model.js';
export interface BufferValue {
  shape: number[];
  data: Float32Array | Float64Array;
}
export type Inputs = Record<string, BufferValue>;
export type Precision = 'f32' | 'f64';
export const size = (shape: number[]) => shape.reduce((a, b) => a * b, 1);
const operations: Record<Op, (a: number, b: number) => number> = {
  '+': (a, b) => a + b,
  '-': (a, b) => a - b,
  '*': (a, b) => a * b,
  '/': (a, b) => a / b,
  neg: a => -a,
  exp: Math.exp,
  log: Math.log,
  sqrt: Math.sqrt,
  tanh: Math.tanh,
  max: Math.max,
  min: Math.min,
};
export class OutsideSample extends Error {}
// Limits apply only when selecting the contract's cases.
export function evaluate(fn: Fn, inputs: Inputs, precision: Precision, sampling = false): BufferValue {
  const ArrayType = precision === 'f32' ? Float32Array : Float64Array;
  const round = precision === 'f32' ? Math.fround : (x: number) => x;
  const shapes = new Map<string, number>(),
    indices = new Map<string, number>(),
    tensors = new Map<string, BufferValue>();
  let work = 0;
  function tick() {
    if (sampling && ++work > 1e6) throw new OutsideSample('Sample work limit');
  }
  for (const p of fn.params) {
    const input = inputs[p.name];
    p.shape.forEach((a, i) => {
      const n = plain(a);
      if (n) shapes.set(n, input.shape[i]);
    });
    tensors.set(p.name, { shape: input.shape, data: ArrayType.from(input.data) });
  }
  function loop(axes: Axis[], i: number, body: () => void) {
    if (i === axes.length) {
      body();
      return;
    }
    const { id, extent } = axes[i],
      dim = value(extent.dim, shapes);
    const n =
      extent.kind === 'blocks'
        ? Math[extent.rounding](dim / width)
        : extent.kind === 'tail'
          ? Math.min(width, dim - width * indices.get(extent.block)!)
          : dim;
    for (let j = 0; j < n; j++) {
      tick();
      indices.set(id, j);
      loop(axes, i + 1, body);
    }
  }
  function scalar(e: Expr): number {
    tick();
    switch (e.kind) {
      case 'literal':
        return round(Number(e.text));
      case 'shape':
        return round(shapes.get(e.name)!);
      case 'load': {
        const t = tensors.get(e.name)!;
        let offset = 0;
        for (let i = 0; i < e.indices.length; i++) {
          const ix = value(e.indices[i], indices);
          if (sampling && (ix < 0 || ix >= t.shape[i]))
            throw new OutsideSample('Sample outside address domain');
          offset = offset * t.shape[i] + ix;
        }
        return t.data[offset];
      }
      case 'op':
        return round(operations[e.op](scalar(e.args[0]), e.args.length === 2 ? scalar(e.args[1]) : 0));
      case 'reduce': {
        let acc = e.op === 'sum' ? 0 : -Infinity;
        loop(e.axes, 0, () => {
          const x = scalar(e.body);
          acc = round(e.op === 'sum' ? acc + x : Math.max(acc, x));
        });
        return acc;
      }
    }
  }
  for (const s of fn.statements) {
    const shape = s.shape.map(a => value(a, shapes));
    if (sampling && (shape.some(n => n < 0) || size(shape) > 4096))
      throw new OutsideSample('Sample shape limit');
    const data = new ArrayType(size(shape));
    let offset = 0;
    loop(s.axes, 0, () => {
      data[offset++] = scalar(s.expr);
    });
    tensors.set(s.name, { shape, data });
  }
  return tensors.get(fn.result)!;
}

