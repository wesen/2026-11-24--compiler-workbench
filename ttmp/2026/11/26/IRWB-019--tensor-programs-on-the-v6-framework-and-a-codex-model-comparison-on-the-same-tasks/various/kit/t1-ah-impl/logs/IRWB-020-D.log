export function synchronous<T>(value: T, label: string): T {
  if (
    value &&
    (typeof value === 'object' || typeof value === 'function') &&
    typeof (
      value as {
        then?: unknown;
      }
    ).then === 'function'
  ) {
    void Promise.resolve(value).catch(() => {});
