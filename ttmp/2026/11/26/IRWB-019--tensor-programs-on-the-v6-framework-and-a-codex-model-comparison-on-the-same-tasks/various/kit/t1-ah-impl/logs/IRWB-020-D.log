fn layernorm(x: f32[N,D], gamma: f32[D], beta: f32[D]): f32[N,D] {
  mean[i] = (sum(j) x[i,j]) / D;
  centered[i,j] = x[i,j] - mean[i];
  variance[i] = (sum(j) centered[i,j] * centered[i,j]) / D;
  y[i,j] = gamma[j] * (centered[i,j] / sqrt(variance[i] + 1e-5)) + beta[j];
  return y;
}
