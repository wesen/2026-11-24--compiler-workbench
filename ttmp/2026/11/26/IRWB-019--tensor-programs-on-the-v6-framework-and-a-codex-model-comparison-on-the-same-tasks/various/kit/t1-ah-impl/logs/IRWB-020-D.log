          switch (pattern) {
            case 'ramp':
              data[i] = (1 + ((i + 3 * ordinal) % 16)) / 16;
              break;
            case 'mixed':
              data[i] = 2 * random() - 1;
              break;
            case 'witness':
              data[i] = witness[(i % shape[shape.length - 1]) % witness.length];
              break;
          }
        }
        inputs[p.name] = { shape, data };
      });
      cases.push({ fn: fn.name, sizes: Object.fromEntries(sizes), pattern, inputs });
    }
  }
