  a.bytes[0] += r.bytes[0]; a.bytes[1] += r.bytes[1];
  return a;
}, { ref: { fns: 0, decided: 0, inconclusive: 0 }, parity: { fns: 0, total: 0, agree: 0, inconclusive: 0 }, bytes: [0, 0] });
