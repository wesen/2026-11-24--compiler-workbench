new file mode 100644
index 0000000000000000000000000000000000000000..794baaea54251af185992bdfcdc4009293def63c
--- /dev/null
+++ b/src/tensor/contract.ts
@@ -0,0 +1,106 @@
+import type { Artifact } from '../framework/core/types.js';
+import { differential, differentialSpec, runDifferential, type CheckResult } from '../framework/contracts/index.js';
+import { evaluate, sizeOf, type Inputs, type Tensor } from './evaluate.js';
+import { indexBounds, TensorIR } from './ir.js';
+import { children, valueOf, type Axis, type Expr, type TensorFn, type TensorModule } from './model.js';
+
+export type Relation = 'exact'|'tolerance';
+type Ports = {origin:typeof TensorIR; before:typeof TensorIR; candidate:typeof TensorIR};
+interface Sample { fn:string; dims:number[]; fill:string; inputs?:Inputs }
+type Observation = {output:Tensor} | {error:string};
+const motif=[1,0,0,0,2**-24,2**-24,0,0];
+const patterns=['ones','motif','signed'] as const;
+
+/** Check the concrete instantiation of the original program before allocating any example data. */
+function legal(fn:TensorFn,dims:Map<string,number>):boolean {
+  const tensors=new Map<string,number[]>();
+  function validRead(e:Expr,axes:Map<string,Axis>):boolean {
+    if(e.kind==='read'){
+      return e.indices.every((a,i)=>{
+        const [lo,hi]=indexBounds(a,axes);
+        return valueOf(lo,dims)>=0 && valueOf(hi,dims)<tensors.get(e.tensor)![i];
+      });
+    }
+    if(e.kind==='fold'){
+      const inner=new Map(axes);
+      const extents=e.axes.map(r=>valueOf(r.extent,dims));
+      if(extents.some(n=>!Number.isSafeInteger(n)||n<0)) return false;
+      if(extents.includes(0)) return true;
+      for(const axis of e.axes) inner.set(axis.id,axis);
+      return validRead(e.body,inner);
+    }
+    return children(e).every(child=>validRead(child,axes));
+  }
+  for (const d of [...fn.params,...fn.definitions]) {
+    const shape=d.shape.map(a=>valueOf(a,dims));
+    if(shape.some(n=>!Number.isSafeInteger(n)||n<0)||!Number.isSafeInteger(sizeOf(shape))) return false;
+    tensors.set(d.name,shape);
+  }
+  if(!sizeOf(tensors.get(fn.result)!)) return false;
+  return fn.definitions.every(d=>!sizeOf(tensors.get(d.name)!) || validRead(d.body,new Map(d.axes.map(a=>[a.id,a]))));
+}
+export function samples(origin:TensorModule, random:()=>number):Sample[] {
+  const cases:Sample[]=[];
+  for(const f of origin.functions){
+    const start=cases.length, seen=new Set<string>();
+    for(const size of [1,8,9,0]){
+      const bindings=new Map(f.symbols.map((s,i)=>[s,size || [3,5,9][i%3]]));
+      const dims=[...bindings.values()];
+      if(seen.has(dims.join(','))||!legal(f,bindings)) continue;
+      seen.add(dims.join(','));
+      for(const [pattern,fill] of patterns.entries()){
+        const inputs:Inputs=Object.create(null);
+        for(const p of f.params){
+          const shape=p.shape.map(a=>valueOf(a,bindings)), data=new Float32Array(sizeOf(shape));
+          if(p.shape.length===1&&!p.shape[0].terms.length&&p.shape[0].constant===1) data.fill([1,2**-10,2**-5][pattern]);
+          else for(let i=0;i<data.length;i++) data[i]=fill==='ones'?1:fill==='motif'?motif[i%motif.length]:random()*2-1;
+          inputs[p.name]={shape,data};
+        }
+        cases.push({fn:f.name,dims,fill,inputs});
+      }
+    }
+    if(cases.length===start) cases.push({fn:f.name,dims:[],fill:'no legal sample'});
+  }
+  return cases;
+}
+
+function compare(relation:Relation,a:Observation,b:Observation):CheckResult {
+  if('error' in a) return {ok:false,reason:a.error};
+  if('error' in b) return {ok:false,reason:b.error};
+  const ref=a.output, actual=b.output;
+  if(ref.shape.length!==actual.shape.length||ref.shape.some((n,i)=>n!==actual.shape[i])) return {ok:false,reason:'returned shape differs'};
+  if(relation==='exact'){
+    const words=(t:Tensor)=>new Uint32Array(t.data.buffer,t.data.byteOffset,t.data.length);
+    const x=words(ref),y=words(actual);
+    for(let i=0;i<x.length;i++) if(x[i]!==y[i]) return {ok:false,reason:`element ${i}: 0x${x[i].toString(16)} vs 0x${y[i].toString(16)}`};
+  }else{
+    for(let i=0;i<ref.data.length;i++){
+      const x=ref.data[i],y=actual.data[i];
+      if(!Number.isFinite(x)||!Number.isFinite(y)||Math.abs(y-x)>1e-5+1e-5*Math.abs(x))
+        return {ok:false,reason:`element ${i}: reference ${x}, candidate ${y}`};
+    }
+  }
+  return {ok:true};
+}
+function invariant(relation:Relation){
+  return differential<Ports,Sample,Observation>({
+    id:'tensor.meaning.'+relation,version:'1',description:'Compare every returned element on origin-derived examples',
+    inputs:{origin:TensorIR,before:TensorIR,candidate:TensorIR}, baseline:relation==='exact'?'before':'origin',
+    subject:'candidate',count:12,seed:20,
+    cases:({origin},random)=>samples(origin.value,random),
+    describeCase:({fn,dims,fill})=>({fn,dims,fill,seed:20}),
+    run(side,artifact,sample){
+      if(!sample.inputs) return {error:`no legal sample for ${sample.fn}`};
+      const f=artifact.value.functions.find(f=>f.name===sample.fn);
+      if(!f) return {error:`missing function ${sample.fn}`};
+      try {return {output:evaluate(f,sample.inputs,relation==='tolerance'&&side==='baseline'?'f64':'f32')};}
+      catch(e){return {error:String(e)};}
+    },
+    compare:(a,b)=>compare(relation,a,b),
+  });
+}
+const invariants={exact:invariant('exact'),tolerance:invariant('tolerance')};
+export function checkMeaning(relation:Relation,origin:Artifact<TensorModule>,before:Artifact<TensorModule>,candidate:Artifact<TensorModule>):CheckResult {
+  const evidence=runDifferential(differentialSpec(invariants[relation]),{origin,before,candidate});
+  return {ok:evidence.status==='agree',evidence,reason:evidence.counterexamples[0]?.reason};
+}
diff --git a/src/tensor/evaluate.ts b/src/tensor/evaluate.ts
new file mode 100644
index 0000000000000000000000000000000000000000..35ebfc03fcd16cbeeb2e5b8127e3a28befba4660
--- /dev/null
+++ b/src/tensor/evaluate.ts
@@ -0,0 +1,82 @@
+import { singleName, valueOf, type Expr, type Range, type TensorFn } from './model.js';
+export type Precision='f32'|'f64';
+export interface Tensor { shape:number[]; data:Float32Array|Float64Array }
+export type Inputs=Record<string,Tensor>;
+export const sizeOf=(shape:number[])=>shape.reduce((n,d)=>n*d,1);
+
+export function evaluate(fn:TensorFn,inputs:Inputs,precision:Precision):Tensor {
+  const BufferType=precision==='f32'?Float32Array:Float64Array;
+  const round=precision==='f32'? Math.fround : (x:number)=>x;
+  const shapes=new Map<string,number>(),indices=new Map<string,number>(),tensors=new Map<string,Tensor>();
+  for(const p of fn.params) {
+    const input=inputs[p.name];
+    p.shape.forEach((d,i)=>{const symbol=singleName(d); if(symbol!==undefined) shapes.set(symbol,input.shape[i]);});
+    tensors.set(p.name,{shape:[...input.shape],data:new BufferType(input.data)});
+  }
+  const extent=(r:Range)=>valueOf(r.extent,shapes);
+  // Bind invariant strides and extents once per expression, before entering its loops.
+  function scalar(e:Expr):()=>number {
+    switch(e.kind) {
+      case 'literal': {const n=round(Number(e.text)); return ()=>n;}
+      case 'shape': {const n=round(shapes.get(e.name)!); return ()=>n;}
+      case 'read': {
+        const t=tensors.get(e.tensor)!;
+        return ()=>{
+          let pos=0;
+          for(let i=0;i<e.indices.length;i++) {
+            const index=valueOf(e.indices[i],indices);
+            if(index<0||index>=t.shape[i]) throw new RangeError(`out-of-bounds read from ${e.tensor}`);
+            pos=pos*t.shape[i]+index;
+          }
+          return t.data[pos];
+        };
+      }
+      case 'fold': {
+        const body=scalar(e.body), ranges=e.axes.map(r=>({r,n:extent(r)}));
+        const initial=e.op==='sum'?0:-Infinity;
+        const step=e.op==='sum'?(a:number,b:number)=>round(a+b):(a:number,b:number)=>round(Math.max(a,b));
+        return ()=>{
+          let acc=initial;
+          function loop(axis:number):void {
+            if(axis===ranges.length) {acc=step(acc,body());return;}
+            const {r,n}=ranges[axis];
+            const lo=r.kind==='within'?indices.get(r.outer)!*r.size:0;
+            const hi=r.kind==='within'?Math.min(n,lo+r.size):r.kind==='blocks'?Math.ceil(n/r.size):n;
+            for(let i=lo;i<hi;i++) {indices.set(r.id,i); loop(axis+1);}
+          }
+          loop(0);
+          return acc;
+        };
+      }
+      case 'binary': {
+        const l=scalar(e.left),r=scalar(e.right);
+        switch(e.op) {
+          case '+':return ()=>round(l()+r());
+          case '-':return ()=>round(l()-r());
+          case '*':return ()=>round(l()*r());
+          case '/':return ()=>round(l()/r());
+          case 'min':return ()=>round(Math.min(l(),r()));
+          case 'max':return ()=>round(Math.max(l(),r()));
+        }
+        break;
+      }
+      default:{
+        const x=scalar(e.arg);
+        if(e.kind==='neg') return ()=>round(-x());
+        const op=Math[e.kind]; return ()=>round(op(x()));
+      }
+    }
+    throw new Error('unknown scalar expression');
+  }
+  for(const d of fn.definitions) {
+    const shape=d.shape.map(a=>valueOf(a,shapes)), data=new BufferType(sizeOf(shape)), body=scalar(d.body);
+    let offset=0;
+    function loop(axis:number):void {
+      if(axis===shape.length) {data[offset++]=body(); return;}
+      for(let i=0;i<shape[axis];i++){indices.set(d.axes[axis].id,i);loop(axis+1);}
+    }
+    loop(0);
+    tensors.set(d.name,{shape,data});
+  }
+  return tensors.get(fn.result)!;
+}
diff --git a/src/tensor/index.ts b/src/tensor/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..11c4587d85de89ccad8284aae388ca815f19a68f
--- /dev/null
+++ b/src/tensor/index.ts
@@ -0,0 +1,20 @@
+import type { Artifact } from '../framework/core/types.js';
+import { createIRArtifact } from '../framework/ir/index.js';
+import { evaluate, type Inputs, type Precision, type Tensor } from './evaluate.js';
+import { tensorAdapter } from './ir.js';
+import type { TensorModule } from './model.js';
+import { parseTix } from './parser.js';
+
+export interface TixProgram {
+  readonly origin: Artifact<TensorModule>;
+  readonly current: Artifact<TensorModule>;
+}
+export function compileTix(source:string):TixProgram {
+  const origin=createIRArtifact(tensorAdapter,'tix',parseTix(source));
+  return Object.freeze({origin,current:origin});
+}
+export function runTix(program:TixProgram,fn:string,inputs:Inputs,options?:{precision?:Precision}):Tensor {
+  const entry=program.current.value.functions.find(f=>f.name===fn);
+  if(!entry) throw new Error(`unknown Tix function ${fn}`);
+  return evaluate(entry,inputs,options?.precision??'f32');
+}
diff --git a/src/tensor/ir.ts b/src/tensor/ir.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ecace6cb0bf3ae7ad96fe815322a72cb5f49381e
--- /dev/null
+++ b/src/tensor/ir.ts
@@ -0,0 +1,136 @@
+import { defineIR } from '../framework/contracts/index.js';
+import { defineAdapter, type IREntity, type IRRelation } from '../framework/ir/index.js';
+import { addScaled, children, constant, equalForm, equalShape, singleName, walk, numericLiteral,
+  type Affine, type Expr, type Range, type TensorModule, type Axis } from './model.js';
+
+type Diagnose = (node: object, why: string) => never;
+const invalid: Diagnose = (_node,why) => { throw new Error(why); };
+const nonnegative = (x: Affine) => x.constant >= 0 && x.terms.every(([,c])=>c>=0);
+
+/** Extrema over a rectangular iteration space. The within-block index covers a subset of its original axis. */
+export function indexBounds(index:Affine, axes:ReadonlyMap<string, Axis>): [Affine,Affine] {
+  let lo=constant(index.constant), hi=lo;
+  for (const [id,c] of index.terms) {
+    const last=addScaled(axes.get(id)!.extent,constant(-1));
+    if (c<0) lo=addScaled(lo,last,c); else hi=addScaled(hi,last,c);
+  }
+  return [lo,hi];
+}
+
+export function checkModule(m:TensorModule, fail:Diagnose=invalid):void {
+  if (!Array.isArray(m.functions)||!m.functions.length) fail(m,'expected tensor functions');
+  const names=new Set<string>();
+  for (const fn of m.functions) {
+    const symbols=new Set(fn.symbols), tensors=new Map<string,Affine[]>(), anchors=new Set<string>();
+    if (!fn.name||names.has(fn.name)||symbols.size!==fn.symbols.length||!fn.params.length) fail(fn,'invalid function signature');
+    names.add(fn.name);
+    const checkForm=(a:Affine,known:ReadonlySet<string>|ReadonlyMap<string,unknown>)=>{
+      let last:string|undefined;
+      if (!Number.isSafeInteger(a.constant)||!Array.isArray(a.terms)) fail(a,'invalid affine constant or terms');
+      for (const [id,c] of a.terms) {
+        if (!known.has(id)||!Number.isSafeInteger(c)||c===0||(last!==undefined && last>=id)) fail(a,'invalid affine coefficient or name');
+        last=id;
+      }
+    };
+    const dimension=(a:Affine)=>{
+      checkForm(a,symbols);
+      if (a.constant<0 && a.terms.every(([,c])=>c<=0)) fail(a,'negative dimension');
+    };
+    const bind=(name:string,shape:Affine[])=>{
+      if (!name||tensors.has(name)||!shape.length) fail(fn,`invalid tensor definition ${name}`);
+      shape.forEach(dimension);
+      tensors.set(name,shape);
+    };
+    for (const p of fn.params) {
+      bind(p.name,p.shape);
+      for (const a of p.shape) { const id=singleName(a); if(id!==undefined) anchors.add(id); }
+    }
+    if (fn.symbols.some(s=>!anchors.has(s))) fail(fn,'unbound shape symbol');
+    function expression(e:Expr,scope:Map<string,Axis|Range>) {
+      switch(e.kind) {
+        case 'literal': if (!numericLiteral.test(e.text)) fail(e,'invalid number'); break;
+        case 'shape': if (!symbols.has(e.name)) fail(e,'unbound shape'); break;
+        case 'read': {
+          const shape=tensors.get(e.tensor);
+          if (!shape || e.indices.length !== shape.length) return fail(e,'unknown tensor or wrong read rank');
+          const empty=[...scope.values()].some(a=>!a.extent.terms.length && a.extent.constant===0);
+          e.indices.forEach((a,i)=>{
+            checkForm(a,scope);
+            if (empty) return;
+            const [lo,hi]=indexBounds(a,scope);
+            // A negative minimum or a maximum >= the dimension for every symbolic assignment.
+            if ((lo.constant<0 && lo.terms.every(([,c])=>c<=0)) || nonnegative(addScaled(hi,shape[i],-1)))
+              fail(e,`subscript outside axis ${i} of ${e.tensor}`);
+          });
+          break;
+        }
+        case 'fold': {
+          if (!['sum','max'].includes(e.op)||!e.axes.length) fail(e,'invalid reduction');
+          const inner=new Map(scope);
+          for (const r of e.axes) {
+            dimension(r.extent);
+            if (!r.id || inner.has(r.id)) fail(e,'duplicate reduction binder');
+            if (r.kind!=='full') {
+              if (!['blocks','within'].includes(r.kind)||!Number.isSafeInteger(r.size)||r.size<1) fail(e,'invalid block range');
+              if (r.kind==='within') {
+                const outer=inner.get(r.outer);
+                if(!outer||!('kind' in outer)||outer.kind!=='blocks'||outer.size!==r.size||!equalForm(outer.extent,r.extent))
+                  fail(e,'incompatible enclosing block');
+              }
+            }
+            inner.set(r.id,r);
+          }
+          expression(e.body,inner); return;
+        }
+        case 'binary': if(!['+','-','*','/','min','max'].includes(e.op)) fail(e,'invalid scalar operator'); break;
+        case 'exp': case 'log': case 'sqrt': case 'tanh': case 'neg': break;
+        default: fail(e,'invalid tensor expression');
+      }
+      for (const child of children(e)) expression(child,scope);
+    }
+    for (const d of fn.definitions) {
+      const scope=new Map(d.axes.map(a=>[a.id,a]));
+      if (scope.size!==d.axes.length || !equalShape(d.axes.map(a=>a.extent),d.shape)) fail(d,'invalid free axes');
+      d.shape.forEach(dimension);
+      expression(d.body,scope);
+      bind(d.name,d.shape);
+    }
+    const actual=tensors.get(fn.result);
+    if (!actual||!equalShape(actual,fn.resultShape)) fail(fn,'invalid return tensor shape');
+  }
+}
+export const TensorIR=defineIR<TensorModule>({
+  id:'tensor.indexed',version:'1',description:'Checked ordered tensor definitions and index folds',
+  validate(value:unknown): asserts value is TensorModule {checkModule(value as TensorModule);}
+});
+export const tensorId=(fn:string,name:string)=>fn+'/'+name;
+function entities(m:TensorModule):IREntity[] {
+  const out:IREntity[]=[];
+  for (const [order,f] of m.functions.entries()) {
+    out.push({id:f.name,kind:'function',attributes:{order,symbols:f.symbols,resultShape:f.resultShape}});
+    for (const p of f.params) out.push({id:tensorId(f.name,p.name),kind:'param',attributes:{...p}});
+    for (const d of f.definitions) out.push({id:tensorId(f.name,d.name),kind:'definition',attributes:{...d}});
+  }
+  return out;
+}
+export const tensorAdapter=defineAdapter<TensorModule>({
+  id:'tensor.indexed.adapter',version:'1',kind:TensorIR.id,schemaVersion:TensorIR.version,description:TensorIR.description,
+  validate:TensorIR.validate,relationKinds:{member:'containment',read:'dependency',result:'binding'},
+  entities,resolve:(m,id)=>entities(m).find(e=>e.id===id),describe:(_m,id)=>({label:id}),roots:m=>m.functions.map(f=>f.name),
+  relations(m) {
+    const edges:IRRelation[]=[];
+    for (const f of m.functions) {
+      for (const [order,d] of [...f.params,...f.definitions].entries()) {
+        const id=tensorId(f.name,d.name);
+        edges.push({id:'member:'+id,from:f.name,to:id,kind:'member',category:'containment',order});
+      }
+      for(const d of f.definitions) {
+        const from=tensorId(f.name,d.name), reads=new Set<string>();
+        walk(d.body,e=>{if(e.kind==='read') reads.add(e.tensor);});
+        for(const name of reads) edges.push({id:from+':read:'+name,from,to:tensorId(f.name,name),kind:'read',category:'dependency'});
+      }
+      edges.push({id:'return:'+f.name,from:f.name,to:tensorId(f.name,f.result),kind:'result',category:'binding'});
+    }
+    return edges;
+  },
+});
diff --git a/src/tensor/model.ts b/src/tensor/model.ts
new file mode 100644
index 0000000000000000000000000000000000000000..73d54deafbbe69f12cedc98395eca642b72210a8
--- /dev/null
+++ b/src/tensor/model.ts
@@ -0,0 +1,69 @@
+/** Normalized integer affine forms, shared by shapes and indexed reads. */
+export interface Affine {
+  constant: number;
+  terms: [string, number][];
+}
+export const constant = (n: number): Affine => ({ constant: n, terms: [] });
+export const variable = (id: string): Affine => ({ constant: 0, terms: [[id, 1]] });
+export function addScaled(a: Affine, b: Affine, scale = 1): Affine {
+  const coefficients = new Map(a.terms);
+  for (const [name, value] of b.terms) coefficients.set(name, (coefficients.get(name) ?? 0) + scale * value);
+  return { constant: a.constant + scale * b.constant,
+    terms: [...coefficients].filter(([, n]) => n !== 0).sort(([a], [b]) => a < b ? -1 : 1) };
+}
+export function substitute(a: Affine, lookup: (id: string) => Affine): Affine {
+  return a.terms.reduce((sum, [id, n]) => addScaled(sum, lookup(id), n), constant(a.constant));
+}
+export function valueOf(a: Affine, bindings: ReadonlyMap<string, number>): number {
+  let result = a.constant;
+  for (const [id, n] of a.terms) result += n * bindings.get(id)!;
+  return result;
+}
+export function singleName(a: Affine): string | undefined {
+  if (a.constant === 0 && a.terms.length === 1 && a.terms[0][1] === 1) return a.terms[0][0];
+}
+export const equalForm = (a: Affine, b: Affine) => a.constant === b.constant && a.terms.length === b.terms.length &&
+  a.terms.every(([id, n], i) => id === b.terms[i][0] && n === b.terms[i][1]);
+export const equalShape = (a: Affine[], b: Affine[]) => a.length === b.length && a.every((d,i) => equalForm(d,b[i]));
+
+export interface Axis { id: string; extent: Affine }
+export type Range = Axis & (
+  { kind: 'full' } | { kind: 'blocks'; size: number } | { kind: 'within'; size: number; outer: string }
+);
+export type Binary = '+' | '-' | '*' | '/';
+export type UnaryCall = 'exp' | 'log' | 'sqrt' | 'tanh';
+export type Expr =
+  | { kind: 'literal'; text: string }
+  | { kind: 'shape'; name: string }
+  | { kind: 'read'; tensor: string; indices: Affine[] }
+  | { kind: 'neg' | UnaryCall; arg: Expr }
+  | { kind: 'binary'; op: Binary | 'max' | 'min'; left: Expr; right: Expr }
+  | { kind: 'fold'; op: 'sum' | 'max'; axes: Range[]; body: Expr };
+export interface TensorDecl { name: string; shape: Affine[] }
+export interface Definition extends TensorDecl { axes: Axis[]; body: Expr }
+export interface TensorFn {
+  name: string;
+  symbols: string[];
+  params: TensorDecl[];
+  definitions: Definition[];
+  result: string;
+  resultShape: Affine[];
+}
+export interface TensorModule { functions: TensorFn[] }
+
+export function children(e: Expr): Expr[] {
+  if (e.kind === 'binary') return [e.left, e.right];
+  if (e.kind === 'fold') return [e.body];
+  return 'arg' in e ? [e.arg] : [];
+}
+export function walk(e: Expr, visit: (expr: Expr) => void): void {
+  visit(e);
+  for (const child of children(e)) walk(child, visit);
+}
+/** Bottom-up so inserted subtrees are not themselves rewritten on this visit. */
+export function rewrite(e: Expr, replace: (expr: Expr) => Expr): Expr {
+  if (e.kind === 'binary') e = { ...e, left: rewrite(e.left, replace), right: rewrite(e.right, replace) };
+  else if (e.kind === 'fold') e = { ...e, body: rewrite(e.body, replace) };
+  else if ('arg' in e) e = { ...e, arg: rewrite(e.arg, replace) };
+  return replace(e);
+}
diff --git a/src/tensor/parser.ts b/src/tensor/parser.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9d8deb0f7dc15489d3650702930158eeb8e87cdf
--- /dev/null
+++ b/src/tensor/parser.ts
@@ -0,0 +1,256 @@
+import {
+  addScaled, constant, equalForm, equalShape, variable,
+  type Affine, type Axis, type Binary, type Definition, type Expr, type TensorDecl,
+  type TensorFn, type TensorModule, type UnaryCall,
+} from './model.js';
+import { checkModule } from './ir.js';
+
+interface Token { text: string; line: number; col: number }
+const identifier = /^[A-Za-z_][A-Za-z_0-9]*$/;
+export const numericLiteral = /^(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?$/;
+function error(t: Token, message: string): never { throw new Error(`${t.line}:${t.col}: ${message}`); }
+function lex(source: string): Token[] {
+  const token = /(?:\/\/[^\r\n]*|\s+|[A-Za-z_][A-Za-z_0-9]*|(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[(){}\[\]:;,=+*\/-])/gy;
+  let line = 1, col = 1, pos = 0;
+  const out: Token[] = [];
+  while (pos < source.length) {
+    const text = token.exec(source)?.[0];
+    if (!text) error({text:'',line,col}, `unexpected character ${source[pos]}`);
+    if (!(text.startsWith('//') || /^\s/.test(text))) out.push({text,line,col});
+    const lines = text.split(/\r\n|[\r\n]/);
+    line += lines.length - 1;
+    col = lines.length === 1 ? col + text.length : 1 + lines[lines.length-1].length;
+    pos += text.length;
+  }
+  out.push({text:'<end>',line,col});
+  return out;
+}
+
+interface Binder { token: Token; id: string; extent?: Affine }
+type Scope = Map<string, Binder>;
+class Parser {
+  private at = 0;
+  private nextId = 0;
+  private shapes = new Map<string, Token>();
+  private anchors = new Set<string>();
+  private tensors = new Map<string, TensorDecl>();
+  private locations = new WeakMap<object, Token>();
+  // Only max(shape,shape) followed by minus has two syntactically viable readings.
+  private ambiguous: number[] = [];
+  private asReduction = new Set<number>();
+
+  constructor(private tokens: Token[]) {}
+  private get here(): Token { return this.tokens[this.at]; }
+  private take(text: string): boolean {
+    if (this.here.text !== text) return false;
+    this.at++;
+    return true;
+  }
+  private expect(text: string) { if (!this.take(text)) error(this.here,`expected '${text}'`); }
+  private name(): Token {
+    const t = this.here;
+    if (!identifier.test(t.text)) error(t,'expected a name');
+    this.at++;
+    return t;
+  }
+  private list<T>(item: () => T): T[] {
+    const result = [item()];
+    while (this.take(',')) result.push(item());
+    return result;
+  }
+  private located<T extends object>(value: T, t: Token): T { this.locations.set(value,t); return value; }
+
+  parse(): TensorModule {
+    const functions: TensorFn[] = [], names = new Set<string>();
+    do {
+      const t = this.here, fn = this.fn();
+      if (names.has(fn.name)) error(t,`duplicate function ${fn.name}`);
+      names.add(fn.name);
+      functions.push(fn);
+    } while (this.here.text !== '<end>');
+    const mod = {functions};
+    checkModule(mod,(node,why) => error(this.locations.get(node) ?? this.tokens[0],why));
+    return mod;
+  }
+  private fn(): TensorFn {
+    this.shapes.clear(); this.anchors.clear(); this.tensors.clear(); this.nextId=0;
+    this.expect('fn');
+    const t=this.name();
+    this.expect('(');
+    const params=this.list(() => {
+      const param=this.name();
+      this.expect(':');
+      const decl=this.located({name:param.text, shape:this.type(true)},param);
+      this.define(decl,param);
+      return decl;
+    });
+    this.expect(')');
+    for (const [name, token] of this.shapes) if (!this.anchors.has(name)) error(token,`no bare input axis binds ${name}`);
+    this.expect(':');
+    const resultShape=this.type(false);
+    this.expect('{');
+    const definitions: Definition[]=[];
+    while (!this.take('return')) {
+      const def=this.statement();
+      this.define(def,this.locations.get(def)!);
+      definitions.push(def);
+    }
+    const result=this.name(), decl=this.tensors.get(result.text);
+    if (!decl || !equalShape(decl.shape,resultShape)) error(result,'unknown return tensor or incompatible return shape');
+    this.expect(';'); this.expect('}');
+    return this.located({name:t.text,params,symbols:[...this.shapes.keys()],definitions,result:result.text,resultShape},t);
+  }
+  private define(d: TensorDecl,t:Token) {
+    if (this.tensors.has(d.name)) error(t,`tensor ${d.name} is already defined`);
+    this.tensors.set(d.name,d);
+  }
+  private type(param: boolean): Affine[] {
+    this.expect('f32'); this.expect('[');
+    const dims=this.list(() => {
+      const start=this.at,t=this.here;
+      const dim=this.affine(n => {
+        if (param && !this.shapes.has(n.text)) this.shapes.set(n.text,n);
+        if (!this.shapes.has(n.text)) error(n,`unknown shape ${n.text}`);
+        return n.text;
+      });
+      if (param && this.at === start+1 && identifier.test(t.text)) this.anchors.add(t.text);
+      return this.located(dim,t);
+    });
+    this.expect(']');
+    return dims;
+  }
+  private affine(resolve:(t:Token)=>string, precedence=0): Affine {
+    const t=this.here;
+    let value: Affine;
+    if (this.take('-')) value=addScaled(constant(0),this.affine(resolve,3),-1);
+    else if (this.take('(')) { value=this.affine(resolve); this.expect(')'); }
+    else if (/^\d+$/.test(t.text)) { this.at++; value=constant(Number(t.text)); }
+    else value=variable(resolve(this.name()));
+    for (;;) {
+      const op=this.here, level=op.text==='*'?2:['+','-'].includes(op.text)?1:0;
+      if (level<=precedence) break;
+      this.at++;
+      const right=this.affine(resolve,level);
+      if (op.text==='*') {
+        if (value.terms.length && right.terms.length) error(op,'non-affine multiplication');
+        value=value.terms.length ? addScaled(constant(0),value,right.constant) : addScaled(constant(0),right,value.constant);
+      } else value=addScaled(value,right,op.text==='-'?-1:1);
+    }
+    if (!Number.isSafeInteger(value.constant) || value.terms.some(([,n])=>!Number.isSafeInteger(n))) error(t,'affine integer out of range');
+    return value;
+  }
+  private binders(scope:Scope): Binder[] {
+    const local=new Set<string>();
+    return this.list(() => {
+      const t=this.name();
+      if (local.has(t.text)) error(t,`duplicate index ${t.text}`);
+      local.add(t.text);
+      const b={token:t,id:`i${this.nextId++}`};
+      scope.set(t.text,b);
+      return b;
+    });
+  }
+  private axis(b:Binder): Axis {
+    if (!b.extent) error(b.token,`cannot infer extent for ${b.token.text}`);
+    return {id:b.id,extent:b.extent};
+  }
+  private statement(): Definition {
+    const start=this.at, firstId=this.nextId;
+    this.asReduction.clear();
+    for (;;) {
+      this.at=start; this.nextId=firstId; this.ambiguous=[];
+      try {
+        const t=this.name(),scope:Scope=new Map();
+        this.expect('[');
+        const free=this.binders(scope);
+        this.expect(']');
+        if (this.take(':')) {
+          const shape=this.type(false);
+          if (shape.length!==free.length) error(t,'declared rank differs from LHS rank');
+          free.forEach((b,i)=>{ b.extent=shape[i]; });
+        }
+        this.expect('=');
+        const body=this.expression(scope);
+        this.expect(';');
+        const axes=free.map(b=>this.axis(b));
+        return this.located({name:t.text,shape:axes.map(a=>a.extent),axes,body},t);
+      } catch (e) {
+        const fallback=this.ambiguous.pop();
+        if (fallback===undefined) throw e;
+        for (const pos of this.asReduction) if (pos>fallback) this.asReduction.delete(pos);
+        this.asReduction.add(fallback);
+      }
+    }
+  }
+  private expression(scope:Scope, precedence=0): Expr {
+    let left=this.prefix(scope);
+    for (;;) {
+      const op=this.here.text, level=['*','/'].includes(op)?2:['+','-'].includes(op)?1:0;
+      if (level<=precedence) return left;
+      this.at++;
+      left={kind:'binary',op:op as Binary,left,right:this.expression(scope,level)};
+    }
+  }
+  private reductionHeader(): boolean {
+    let i=this.at;
+    const names:string[]=[];
+    while (identifier.test(this.tokens[i].text)) {
+      names.push(this.tokens[i++].text);
+      if (this.tokens[i].text!==',') break;
+      i++;
+    }
+    if (this.tokens[i].text!==')' || !names.length) return false;
+    const body=this.tokens[i+1].text;
+    if (!(identifier.test(body)||numericLiteral.test(body)||body==='('||body==='-')) return false;
+    if (body==='-' && names.length===2 && names.every(n=>this.shapes.has(n)) && !this.asReduction.has(this.at)) {
+      this.ambiguous.push(this.at);
+      return false;
+    }
+    return true;
+  }
+  private prefix(scope:Scope): Expr {
+    const t=this.here;
+    if (this.take('-')) return {kind:'neg',arg:this.expression(scope,3)};
+    if (this.take('(')) { const e=this.expression(scope); this.expect(')'); return e; }
+    if (numericLiteral.test(t.text)) { this.at++; return {kind:'literal',text:t.text}; }
+    const name=this.name().text;
+    if (this.take('[')) {
+      const tensor=this.tensors.get(name);
+      if (!tensor) error(t,`unknown tensor ${name}`);
+      let axis=0;
+      const indices=this.list(()=>{
+        const start=this.at, token=this.here, extent=tensor.shape[axis++];
+        if (!extent) error(token,`too many indices for ${name}`);
+        const sub=this.affine(n=>scope.get(n.text)?.id ?? error(n,`unbound index ${n.text}`));
+        if (this.at===start+1 && scope.has(token.text)) {
+          const b=scope.get(token.text)!;
+          if (b.extent && !equalForm(b.extent,extent)) error(token,`incompatible extents for ${token.text}`);
+          b.extent=extent;
+        }
+        return sub;
+      });
+      this.expect(']');
+      if (axis!==tensor.shape.length) error(t,`wrong rank for ${name}`);
+      return this.located({kind:'read' as const,tensor:name,indices},t);
+    }
+    if (!this.take('(')) {
+      if (!this.shapes.has(name)) error(t,`unknown shape value ${name}`);
+      return {kind:'shape',name};
+    }
+    if (name==='sum'||(name==='max' && this.reductionHeader())) {
+      const inner=new Map(scope), bound=this.binders(inner);
+      this.expect(')');
+      const body=this.expression(inner);
+      return {kind:'fold',op:name,axes:bound.map(b=>({...this.axis(b),kind:'full'})),body};
+    }
+    const arg=this.expression(scope);
+    if (name==='min'||name==='max') {
+      this.expect(','); const right=this.expression(scope); this.expect(')');
+      return {kind:'binary',op:name,left:arg,right};
+    }
+    if (!['exp','log','sqrt','tanh'].includes(name)) error(t,`unknown call ${name}`);
+    this.expect(')');
+    return {kind:name as UnaryCall,arg};
+  }
+}
+export const parseTix = (source:string):TensorModule => new Parser(lex(source)).parse();
