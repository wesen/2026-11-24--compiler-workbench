+fn conv2d(x: f32[N,C,H,W], w: f32[O,C,3,3]): f32[N,O,H-2,W-2] {
+  y[n,o,oy,ox]: f32[N,O,H-2,W-2] = sum(c,dy,dx) x[n,c,oy+dy,ox+dx] * w[o,c,dy,dx];
+  return y;
+}
