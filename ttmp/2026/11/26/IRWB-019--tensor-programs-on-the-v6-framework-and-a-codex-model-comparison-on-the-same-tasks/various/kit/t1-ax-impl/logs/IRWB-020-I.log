import { canonical, immutable } from '../core/data.js';
import type {
  CorrespondenceEntry,
  Reason,
  EntityCorrespondence,
  EntityTrace,
  IRRef,
  RevisionRef,
  TraceStep,
} from './types.js';
import { compareText, IRError, IRBudgetError, limit, refKey, requireText, sameRevision } from './common.js';
