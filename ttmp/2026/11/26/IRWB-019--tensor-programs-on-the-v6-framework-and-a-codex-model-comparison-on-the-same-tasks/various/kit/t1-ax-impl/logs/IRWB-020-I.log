+fn matmul(a: f32[M,K], b: f32[K,N]): f32[M,N] {
+  c[i,j] = sum(k) a[i,k] * b[k,j];
+  return c;
+}
diff --git a/src/tensor/contract.ts b/src/tensor/contract.ts
