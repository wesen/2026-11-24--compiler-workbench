index 0000000000000000000000000000000000000000..eca673d3aac54c1339d8e829a31c273f940b3f50
--- /dev/null
+++ b/corpus/tensor/matmul/main.tix
@@ -0,0 +1,4 @@
+fn matmul(a: f32[M,K], b: f32[K,N]): f32[M,N] {
+  c[i,j] = sum(k) a[i,k] * b[k,j];
+  return c;
+}
diff --git a/corpus/tensor/mlp/main.tix b/corpus/tensor/mlp/main.tix
new file mode 100644
index 0000000000000000000000000000000000000000..209abc0368856b4c99264f007429651065e1a6f4
--- /dev/null
+++ b/corpus/tensor/mlp/main.tix
@@ -0,0 +1,7 @@
+fn mlp(x: f32[N,I], w1: f32[I,H], b1: f32[H], w2: f32[H,O], b2: f32[O]): f32[N,O] {
+  h[n,j] = (sum(i) x[n,i] * w1[i,j]) + b1[j];
+  // tanh-GELU with sqrt(2/pi) rounded at the evaluating precision
+  g[n,j] = 0.5 * h[n,j] * (1 + tanh(0.7978845608028654 * (h[n,j] + 0.044715 * h[n,j] * h[n,j] * h[n,j])));
+  y[n,o] = (sum(j) g[n,j] * w2[j,o]) + b2[o];
+  return y;
+}
diff --git a/corpus/tensor/softmax/main.tix b/corpus/tensor/softmax/main.tix
