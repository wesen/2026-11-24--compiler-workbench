diff --git a/corpus/tensor/attention/main.tix b/corpus/tensor/attention/main.tix
new file mode 100644
index 0000000000000000000000000000000000000000..487a354912d202771f4a0fc6ab51b0caf5d3df26
--- /dev/null
+++ b/corpus/tensor/attention/main.tix
@@ -0,0 +1,9 @@
+fn attention(q: f32[Q,D], k: f32[K,D], v: f32[K,V]): f32[Q,V] {
+  score[i,j] = (sum(d) q[i,d] * k[j,d]) / sqrt(D);
+  peak[i] = max(j) score[i,j];
+  weight[i,j] = exp(score[i,j] - peak[i]);
+  total[i] = sum(j) weight[i,j];
+  prob[i,j] = weight[i,j] / total[i];
+  y[i,h] = sum(j) prob[i,j] * v[j,h];
+  return y;
+}
diff --git a/corpus/tensor/layernorm/main.tix b/corpus/tensor/layernorm/main.tix
new file mode 100644
index 0000000000000000000000000000000000000000..038c30c1fa15ee4cdd902c22bee040d63db55434
--- /dev/null
+++ b/corpus/tensor/layernorm/main.tix
@@ -0,0 +1,7 @@
+fn layernorm(x: f32[N,D], gamma: f32[D], beta: f32[D], eps: f32[1]): f32[N,D] {
+  mean[i] = (sum(d) x[i,d]) / D;
+  centered[i,d] = x[i,d] - mean[i];
+  variance[i] = (sum(d) centered[i,d] * centered[i,d]) / D;
+  y[i,d] = centered[i,d] / sqrt(variance[i] + eps[0]) * gamma[d] + beta[d];
+  return y;
+}
diff --git a/corpus/tensor/matmul/main.tix b/corpus/tensor/matmul/main.tix
