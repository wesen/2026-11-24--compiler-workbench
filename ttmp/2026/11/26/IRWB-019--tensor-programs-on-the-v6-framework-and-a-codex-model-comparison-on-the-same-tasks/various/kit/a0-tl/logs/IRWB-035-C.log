"'"'internal-caller'"'"', `     function read(code: buffer): i32 { return code.charCodeAt(0); }     function use(code: buffer): i32 { return read(code); }   `, tape);   await assert.rejects(caller.specialize(code), /internal caller/); });  test('"'"'VM dispatch becomes guest control flow, with both dynamic branch outcomes'"'"', async () => {   const ps = projectSource('"'"'bytecode-vm'"'"', projectFiles('"'"'bytecode-vm'"'"'));   const { code, n, seed } = ps.meta.inputs.runVm;   for (const entry of [0, 34]) {     const p = Program.fromProject(ps);     const art = facts([buffer('"'"'runVm'"'"', code.cells), { fn: '"'"'runVm'"'"', param: '"'"'entry'"'"', value: entry, entity: '"'"'entry'"'"' }]);     await assert.rejects(p.specialize(art, { maxVariants: 1 }), /block budget/);     assert.deepEqual(p.assumptions, {});     assert.equal(p.rev, 0);     assert.equal((await p.specialize(art)).check, '"'"'40/40'"'"');     const residual = Object.values(p.head.value.values);     assert.ok(residual.every(v => v.op !== '"'"'load16u'"'"' && v.op !== '"'"'caddr'"'"'));     assert.ok(Object.values(p.head.value.stmts).some(s => s.op === '"'"'br_if'"'"'));      const cleaned = await p.pipeline('"'"'speed'"'"');     assert.deepEqual(cleaned.steps.filter(s => s.rejected), []);     assert.equal((await p.apply('"'"'promote-frame'"'"')).check, '"'"'40/40'"'"');     assert.ok(!p.head.value.fns.runVm.arrayBytes);     assert.equal(p.check().status, '"'"'agree'"'"');     const r0 = Program.fromProject(ps);     for (const count of n) for (const initial of seed) {       const args = [code.cells, entry, count, initial];       assert.equal(p.exec('"'"'runVm'"'"', args).result, r0.exec('"'"'runVm'"'"', args).result);     }   } }); EOF tmux ls tmux capture-pane -pt irwb-036-a-build -S -100 | tail -70'
