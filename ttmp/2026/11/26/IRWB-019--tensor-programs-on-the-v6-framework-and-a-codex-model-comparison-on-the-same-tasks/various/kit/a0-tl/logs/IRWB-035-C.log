export class WorkbenchError extends Error {
  constructor(
    readonly code: string,
    message: string,
    readonly fix?: string,
  ) {
    super(`[${code}] ${message}${fix ? `\n  fix: ${fix}` : ''}`);
    this.name = 'WorkbenchError';
  }
}
const fail = (code: string, message: string, fix?: string): never => {
  throw new WorkbenchError(code, message, fix);
};

export interface Revision {
  readonly rev: number;
  readonly pass: string;
  readonly artifact: Artifact<TypedBlocks>;
  readonly edits: readonly Edit[];
  readonly correspondence?: EntityCorrespondence;
  readonly ms: number;
  readonly fns?: readonly string[];
  readonly note?: string;
  /** The assumptions in force when this revision was made (see `Program.assume`). */
  readonly assumptions?: Readonly<Record<string, Readonly<Record<string, number>>>>;
}

export interface ApplyResult {
  readonly pass: string;
  readonly rev: string;
  readonly edits: number;
  readonly changed: boolean;
  readonly kinds?: Readonly<Record<string, number>>;
  readonly ms: number;
  readonly check?: string;
}

const revNumber = (r: number | string) => (typeof r === 'string' ? +r.replace(/^r/, '') : r);
const now = () => (typeof performance !== 'undefined' ? performance.now() : Date.now());

export class Program {
  readonly manager = new AnalysisManager();
  readonly revisions: Revision[] = [];
  status: 'ok' | 'frontEndError' | 'unsupported' = 'ok';
  error: { message: string; line?: number; col?: number } | null = null;
  constructor(
    readonly name: string,
    readonly source: string,
    readonly options: {
      inputs?: ProgramInputs;
      fileMap?: ProjectSource['fileMap'];
      project?: string;
      /** How to ingest: from the tape (`{ tape: true, maxSourceLength }`, e.g. for Candela) or by default. */
      ingest?: IngestOptions;
      /**
       * The functions the host calls (Candela: the gallery slot's four). When given, checks compare only these, and
       * passes may change or remove functions only they call. Absent: every function is an entry.
       */
      entries?: readonly string[];
    } = {},
  ) {
    let r0: Artifact<TypedBlocks>;
    try {
      r0 = createIRArtifact(blocksAdapter, name, ingest(name, source, options.ingest).toNative());
    } catch (e) {
      if (!(e instanceof LiftError)) throw e;
      this.status = e.code === 'unsupportedOp' ? 'unsupported' : 'frontEndError';
      this.error = { message: e.message, ...(e.at ?? {}) };
      r0 = createIRArtifact(blocksAdapter, name, {
        formatVersion: 1,
        program: name,
        rev: 0,
        counters: {},
        fnOrder: [],
        fns: {},
        blocks: {},
        stmts: {},
        values: {},
        ops: {},
        frontEnd: { wasmBytes: 0, records: null, enums: null, signatures: null },
      });
    }
    this.revisions.push({
      rev: 0,
      pass: 'ingest',
      artifact: r0,
      edits: [],
      ms: 0,
      note: 'ingest from the typed front end',
    });
  }

  static fromProject(p: ProjectSource): Program {
    return new Program(p.name, p.source, {
      inputs: p.meta.inputs,
      fileMap: p.fileMap,
      project: p.id,
      ...(p.meta.ingest ? { ingest: p.meta.ingest } : {}),
      ...(p.meta.entries ? { entries: p.meta.entries } : {}),
    });
  }

  get id(): string {
    return `prog:${this.name}`;
  }
  /** Parameter values every check now assumes (set by `assume`, e.g. from a specialization's outer facts). */
  readonly assumptions: Record<string, Record<string, number>> = {};
  /** The case inputs checks use: the project's specifications, with assumed parameters fixed. */
  get inputs(): ProgramInputs {
    const base = this.options.inputs ?? {};
    const out: Record<string, Record<string, unknown>> = Object.fromEntries(
      Object.entries(base).map(([f, v]) => [f, { ...v }]),
    );
    for (const [f, params] of Object.entries(this.assumptions))
      for (const [k, v] of Object.entries(params)) {
        const dot = k.indexOf('.');
        if (dot < 0) {
          out[f] = { ...(out[f] ?? {}), [k]: v };
          continue;
        }
        // a record field: fix it inside the parameter's record specification
        const param = k.slice(0, dot),
          field = k.slice(dot + 1);
        const spec = ((out[f] ?? {})[param] ?? { record: {} }) as { record?: Record<string, unknown> };
        out[f] = { ...(out[f] ?? {}), [param]: { ...spec, record: { ...(spec.record ?? {}), [field]: { oneOf: [v] } } } };
      }
    return out as ProgramInputs;
  }
  /**
   * Restrict the program's meaning to inputs satisfying `bindings`: from now on the contract every pass must meet,
   * and every check, compares with r0 only on such inputs. Returns the previous assumptions (for `unassume`).
  });
  const exec = await execute(strategy, registry, p.head, opts.onEvent ? { onEvent: opts.onEvent } : {});
  const decisions = exec.records.flatMap(r =>
    r.evidence.filter(e => e.label === 'selection').map(e => e.data),
  );
  const summary = {
    id: exec.id,
    nodes: exec.records.length,
    ms: +(exec.endedAt - exec.startedAt).toFixed(1),
  };
  if (exec.status !== 'succeeded')
    return {
      status: exec.status,
      rev: `r${p.rev}`,
      published: [],
      decisions,
      error: exec.error,
      execution: summary,
      trace: traceRows(exec.records),
    };
  // walk back from the winner to the head through the pass results, then publish them in order
  const chain: PassResult<TypedBlocks>[] = [];
  for (let cur = exec.value as Artifact<TypedBlocks>; cur.revision !== p.head.revision; ) {
    const r = results.get(cur.revision);
    if (!r)
      throw new Error(`strategy result ${cur.revision} is not reachable from the head through pass results`);
    chain.unshift(r);
    cur = r.before;
  }
  for (const r of chain) {
    const report = r.report as RevisionReport;
    p.revisions.push({
      rev: p.rev + 1,
      pass: report.pass,
      artifact: r.artifact,
      edits: report.edits,
      correspondence: r.correspondence,
      ms: 0,
      fns: report.fns,
      assumptions: JSON.parse(JSON.stringify(p.assumptions)),
      note: `strategy ${strategy.id}`,
    });
  }
  return {
    status: exec.status,
    rev: `r${p.rev}`,
    published: chain.map(r => (r.report as RevisionReport).pass),
    decisions,
    execution: summary,
    trace: traceRows(exec.records),
  };
}

/**
 * Search per function: for each function in source order, run every candidate pass list restricted to that
 * function and keep the one that minimizes (or maximizes) the metric on that function's own cases. The choices
// Read corpus/projects/<id>/ into { files } maps for the typed domain (Node only).
import { readdirSync, readFileSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';

export const corpusDir = fileURLToPath(new URL('../corpus/projects/', import.meta.url));
export const projectIds = () => readdirSync(corpusDir).filter(d => statSync(join(corpusDir, d)).isDirectory()).sort();
export function projectFiles(id) {
  const dir = join(corpusDir, id), files = {};
  for (const f of readdirSync(dir)) if (f === 'project.json' || f.endsWith('.typed')) files[f] = readFileSync(join(dir, f), 'utf8');
  return files;
}

/** Every file of a project (project.json, sources, notes, scripts/, ui/), path -> text. */
export function projectAllFiles(id) {
  const out = {};
  const walk = (dir, prefix) => {
    for (const f of readdirSync(dir).sort()) {
      const p = join(dir, f);
      if (statSync(p).isDirectory()) walk(p, prefix + f + '/');
      else out[prefix + f] = readFileSync(p, 'utf8');
    }
  };
  walk(join(corpusDir, id), '');
  return out;
}

/** The built-in projects in the book's order (corpus/projects/index.json), as { id, files }. */
export function builtinProjects() {
  const order = JSON.parse(readFileSync(join(corpusDir, 'index.json'), 'utf8')).order;
  const ids = [...order, ...projectIds().filter(id => !order.includes(id))];
  return ids.map(id => ({ id, files: projectAllFiles(id) }));
}
