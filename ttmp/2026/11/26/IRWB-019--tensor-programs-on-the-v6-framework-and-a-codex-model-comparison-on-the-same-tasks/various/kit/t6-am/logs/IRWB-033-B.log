const fusePhases = rewrite(
  'fuse-phases',
  'Keep same-element epilogues in registers and intervening rows in one block',
  (fn, g) => (g.phases.length ? { ...g, phases: phasesFor(fn, g, true) } : g),
);

export function orderCheck(before: Artifact<Schedule>, after: Artifact<Schedule>) {
  // Layout primitives can only enumerate k as panel * depth + local, clipped at K.
  // Erase the layout and check that every algorithm, group and placement decision survives.
  const erase = (s: Schedule) => ({ fn: s.fn, groups: s.groups.map(({ tiles, phases, patch, ...g }) => g) });
  return sameCanonical(erase(before.value), erase(after.value))
    ? { ok: true, evidence: { order: 'lexicographic', initial: 'unchanged', accumulators: 'one per output' } }
    : { ok: false, reason: 'Scheduling changed the original computation or fusion group' };
}
export function initialSchedule(fn: Fn, plan: FusionPlan) {
  return createIRArtifact(adapter, 'schedule/' + fn.name, {
    fn,
    groups: plan.groups.map(g => importGroup(fn, g)),
  });
}
export function scheduleFunction(fn: Fn, fuse = true) {
  const initial = initialSchedule(fn, fuse ? planFusion(fn) : unfusedPlan(fn));
  let artifact = initial;
  const steps: ReturnType<typeof applyNativePassSync<Schedule, unknown>>[] = [];
  function apply(pass: typeof tile) {
    const applied = applyNativePassSync(pass, artifact);
    artifact = applied.artifact;
    steps.push(applied);
    return applied.changed;
  }
  if (fuse) {
    if (apply(tile))
      for (const pass of [register, stage, vectorize, fragments, wideTile, fusePhases, chooseShapes])
        apply(pass);
    if (fn.statements.some(s => s.axes.length >= 3)) apply(broadcast);
  }
  return { initial, artifact, steps };
}

export function cudaArtifact(fn: string, source: string, kernels: CudaKernel[] = []): Artifact<CudaUnit> {
  return createArtifact(CudaIR, 'tix-cuda/' + fn, { fn, source, kernels });
}

/** Both public execution and differential verification consume this exact artifact chain. */
export function compileCudaPipeline(baseline: Artifact<Module>, fn: string, fuse: boolean) {
  const f = selectFunction(baseline.value, fn);
  const { initial, artifact: schedule, steps } = scheduleFunction(f, fuse);
  const kernels = schedule.value.groups.map(g => ({
    name: g.kernel,
    mapping: g.mapping,
    statements: g.statements,
    ...(g.gated && { gated: true }),
  }));
  const cuda = cudaArtifact(fn, printSchedule(schedule.value), kernels);
  const ref = (a: Artifact) => ({ artifact: a.id, revision: a.revision });
  const fromTix = [],
    toCuda = [];
  for (const g of schedule.value.groups) {
    toCuda.push({ from: [g.kernel], to: [g.kernel], relation: 'prints' });
    for (const n of g.statements) {
      const folds = foldsOf(f.statements.find(s => s.name === n)!).map(r => r.id);
      fromTix.push({ from: [fn + '/' + n], to: [g.kernel, ...folds], relation: 'schedules' });
      if (folds.length) toCuda.push({ from: folds, to: [g.kernel], relation: 'ordered-folds-in' });
    }
  }
  return {
    f,
    initial,
    schedule,
    steps,
    cuda,
    correspondence: [
      makeCorrespondence(
        ref(baseline),
        ref(initial),
        TixIR.entities!(baseline.value),
        ScheduleIR.entities!(initial.value),
        fromTix,
      ),
      ...steps.flatMap(step => (step.correspondence ? [step.correspondence] : [])),
      makeCorrespondence(
        ref(schedule),
        ref(cuda),
        ScheduleIR.entities!(schedule.value),
        CudaIR.entities!(cuda.value),
        toCuda,
      ),
    ],
  };
}

