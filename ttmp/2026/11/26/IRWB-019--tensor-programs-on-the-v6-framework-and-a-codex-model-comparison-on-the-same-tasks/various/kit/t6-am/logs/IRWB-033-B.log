      kernels: kernelCount(cudaSource(program, fnName, { fuse })),
      ms: median(times),
      times,
      sha: sha.slice(0, 12),
    };
  }
  if (row.fused && row.unfused) {
    row.equal = row.fused.sha === row.unfused.sha;
    row.ratio = +(row.fused.ms / row.unfused.ms).toFixed(3);
  }
  return row;
}

