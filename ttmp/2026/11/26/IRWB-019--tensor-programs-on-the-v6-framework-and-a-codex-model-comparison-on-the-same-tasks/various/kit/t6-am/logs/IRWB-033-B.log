test('fuse: false is stage 2 byte for byte, and a one-statement program is the same either way', () => {
  const digests = JSON.parse(
    readFileSync(
      new URL(
        '../../ttmp/2026/11/26/IRWB-029-D--checked-fusion-of-tix-kernels-on-the-gpu/scripts/02-stage2-source-digests.json',
        import.meta.url,
      ),
      'utf8',
    ),
  );
  const sha = text => createHash('sha256').update(text).digest('hex');
  for (const name of ['matmul', 'softmax', 'layernorm', 'attention', 'mlp', 'conv2d']) {
    const program = corpus(name);
    assert.equal(sha(cudaSource(program, name, { fuse: false })), digests[name], name);
    const optimized = optimizeTix(program, ['inline', 'split-sum']).program;
    assert.equal(sha(cudaSource(optimized, name, { fuse: false })), digests[name + '+inline+split'], name);
  }
  for (const name of ['conv2d']) {
    const program = corpus(name);
    assert.equal(cudaSource(program, name), cudaSource(program, name, { fuse: false }));
  }
  assert.equal(kernels(cudaSource(corpus('softmax'), 'softmax', { fuse: false })), 4);
});

const broadcast = rewrite('broadcast-patch', 'Reuse an invariant operand across adjacent output channels', (fn,g) => {
  const patch = g.form === 'element' && broadcastAxis(fn.statements.find(s=>s.name===g.statements[0])!);
  return patch ? { ...g,patch } : g;
});
const register = rewrite('register-tile', 'Give each lane independent accumulators for a rectangle', (_,g) =>
  mapTiles(g,t => ({ ...t, registers:[4,4] })));
const stage = rewrite('stage-panels', 'Cooperatively stage the two operand panels between block barriers', (_,g) =>
  mapTiles(g,t => ({ ...t, shared:true })));

const vectorize = rewrite('vectorize', 'Load aligned panels four adjacent f32 words at a time', (_,g) =>
  mapTiles(g,t => t.shared && t.depth%4 === 0 && t.lanes[1]*t.registers[1]%4 === 0 ? { ...t, vector:4 } : t));
const fragments = rewrite('pack-registers', 'Read contiguous four-word fragments of each shared panel', (_,g) =>
  mapTiles(g,t => t.shared && t.registers.every(n => n%4 === 0) ? { ...t, fragment:4 } : t));
const wideTile = rewrite('wide-tile', 'Double panel reuse when a grid of larger blocks covers two blocks per SM', (_,g) =>
  mapTiles(g,t => t.fragment === 4 ? { ...t,wide:{registers:[8,8],minBlocks:96} } : t));
const fusePhases = rewrite('fuse-phases', 'Keep same-element epilogues in registers and intervening rows in one block', (fn,g) =>
  g.phases.length ? { ...g, phases:phasesFor(fn,g,true) } : g);

export function orderCheck(before: Artifact<Schedule>, after: Artifact<Schedule>) {
  // Layout primitives can only enumerate k as panel * depth + local, clipped at K.
  // Erase the layout and check that every algorithm, group and placement decision survives.
  const erase = (s: Schedule) => ({ fn:s.fn, groups:s.groups.map(({ tiles, phases, patch, ...g }) => g) });
  return { ok: sameCanonical(erase(before.value), erase(after.value)), reason: 'Scheduling changed the original computation or fusion group' };
}
export function scheduleFunction(fn: Fn, fuse = true) {
  const plan = fuse ? planFusion(fn) : unfusedPlan(fn);
  let artifact = createIRArtifact(adapter, 'schedule/' + fn.name, { fn, groups:plan.groups.map(g => importGroup(fn,g)) });
  const steps = [];
  if (fuse) for (const pass of [tile, register, stage, vectorize, fragments, wideTile, fusePhases, broadcast]) {
    const applied = applyNativePassSync(pass, artifact);
    artifact = applied.artifact;
    steps.push(applied);
  }
  return { artifact, steps };
}

