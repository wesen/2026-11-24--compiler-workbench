    #pragma unroll
    for (int x=0; x<${rx}; ++x) {
      const I col=baseX+${xIndex};
      if (full || (row<M && col<N)) {
        ${store}
      }
    }
  }
  };
  if ((M % ${bm}) == 0 && (N % ${bn}) == 0 && (K % ${bk}) == 0)
    compute(std::true_type{});
  else compute(std::false_type{});
  return;`;
}

