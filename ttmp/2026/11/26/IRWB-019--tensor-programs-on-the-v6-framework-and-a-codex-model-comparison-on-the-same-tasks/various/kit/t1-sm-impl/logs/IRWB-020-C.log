}

function inline(fn: TixFunction): TixFunction {
  const statements = [...fn.statements];
  let changed = false;
  for (let index = 0; index < statements.length; ) {
    const producer = statements[index]!;
    if (fn.returns === producer.name || !isPointwise(producer)) {
