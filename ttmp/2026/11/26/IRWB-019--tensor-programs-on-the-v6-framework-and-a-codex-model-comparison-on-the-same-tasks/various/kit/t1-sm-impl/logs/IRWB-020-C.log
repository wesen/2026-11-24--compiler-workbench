          break;
        case '"'zeros': data[i] = (i + inputIndex) % 2 ? -0 : 0; break;
        case 'ones': data[i] = 1; break;
        case 'signed': data[i] = ((i * 7 + inputIndex * 3) % 17 - 8) / 8; break;
        case 'positive': data[i] = 0.125 + random() * 0.875; break;
      }
