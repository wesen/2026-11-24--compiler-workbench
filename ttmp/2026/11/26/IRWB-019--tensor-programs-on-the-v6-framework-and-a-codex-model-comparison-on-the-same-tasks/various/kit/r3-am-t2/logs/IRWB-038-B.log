  | { readonly k: 'top' }
  | { readonly k: 'const'; readonly v: number; readonly t: 'i32' | 'f32' }
  | { readonly k: 'bot' };
const TOP: Lat = { k: 'top' },
  BOT: Lat = { k: 'bot' };
const same = (a: Lat, b: Lat) =>
  a.k === b.k && (a.k !== 'const' || (b.k === 'const' && a.v === b.v && a.t === b.t));
export const meet = (a: Lat, b: Lat): Lat =>
  a.k === 'top' ? b : b.k === 'top' ? a : a.k === 'const' && same(a, b) ? a : BOT;

