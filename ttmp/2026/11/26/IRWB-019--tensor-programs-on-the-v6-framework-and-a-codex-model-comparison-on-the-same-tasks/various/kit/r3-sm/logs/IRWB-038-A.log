   121	          n.input === undefined ? current : (resolveTemplate(n.input, input, current, scope) as T);
   122	        const context = {
   123	          record: (_kind: string, data: unknown) => void reports.push(data),
   124	          reject: (code: string, message: string, evidence?: unknown) => {
   125	            const error = new Error(message) as Error & { code?: string; evidence?: unknown };
   126	            error.code = code;
   127	            error.evidence = evidence;
   128	            throw error;
   129	          },
   130	        };
   131	        const next = (algorithm as StrategyAlgorithm).run(context as never, selected, args) as T;
   132	        if (next instanceof Promise)
   133	          throw new StrategySyncError(
   134	            'strategySyncUnsupported',
   135	            `${n.algorithm.id}@${n.algorithm.version} is asynchronous; use the strategy interpreter`,
   136	          );
   137	        steps.push({
   138	          node: n.id,
   139	          algorithm: { id: n.algorithm.id, version: n.algorithm.version },
   140	          ...(args === undefined ? {} : { args }),
   141	          changed: next !== selected,
   142	        });
   143	        return next;
   144	      }
   145	      default:
   146	        throw new StrategySyncError(
   147	          'strategySyncUnsupported',
   148	          `Node kind ${(n as StrategyNode).kind} needs the asynchronous interpreter`,
   149	        );
   150	    }
   151	  };
   152	  return { value: node(plan.root, input), steps, reports };
   153	}
