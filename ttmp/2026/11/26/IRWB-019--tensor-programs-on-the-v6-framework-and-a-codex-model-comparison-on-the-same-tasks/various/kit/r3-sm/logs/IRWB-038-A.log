   250	      return { accepted: true, relation };
   251	    } catch (error) {
   252	      const message = error instanceof Error ? error.message : String(error);
   253	      if (error instanceof ContractError && error.code === 'postcondition') {
   254	        const checks = manager.snapshot().executions.at(-1)?.checks;
