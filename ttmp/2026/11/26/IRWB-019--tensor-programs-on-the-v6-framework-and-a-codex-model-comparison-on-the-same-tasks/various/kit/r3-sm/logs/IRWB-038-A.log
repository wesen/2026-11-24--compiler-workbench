   235	  return async (
   236	    baseline: Artifact<Module>,
   237	    fn: string,
   238	    candidate?: Artifact<CudaUnit>,
   239	    options?: { fuse?: boolean; manager?: AnalysisManager },
   240	  ) => {
   241	    const relation = 'exact' as const;
   242	    const manager = options?.manager ?? new AnalysisManager();
   243	    const fuse = options?.fuse !== false;
   244	    try {
