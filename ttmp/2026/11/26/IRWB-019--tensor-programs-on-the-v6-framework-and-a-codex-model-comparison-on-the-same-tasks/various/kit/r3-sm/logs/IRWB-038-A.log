   210	    const current = spec.cases(inputs, (spec.random ?? seededRandom)(seed), spec.count);
   211	    if (reuse.caseDigest !== caseDigest(current))
   212	      throw new ContractError('baseline-key', `Differential baseline key ${bk} produced different cases`);
   213	    REUSE.delete(key);
