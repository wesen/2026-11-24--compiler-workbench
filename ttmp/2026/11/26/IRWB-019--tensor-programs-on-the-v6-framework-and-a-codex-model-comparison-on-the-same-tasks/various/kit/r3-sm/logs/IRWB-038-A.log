   148	const glob = (patterns: readonly string[], kind: string) =>
   149	  patterns.some(p => (p.endsWith('*') ? kind.startsWith(p.slice(0, -1)) : p === kind));
   150	
   151	/** The changes a pass made outside what it declared it writes. */
   152	export function undeclaredWrites(
   153	  writes: PassSpec<any, any>['writes'],
   154	  changes: ChangeSet,
   155	): readonly string[] {
   156	  const out = new Set<string>();
   157	  for (const c of changes.entities)
   158	    for (const e of [c.before, c.after])
   159	      if (e && !glob(writes.entities, e.kind)) out.add(`${c.kind} entity ${c.entity} (${e.kind})`);
   160	  for (const c of changes.relations)
   161	    for (const r of [c.before, c.after])
   162	      if (r && !glob(writes.relations, r.kind)) out.add(`${c.kind} relation ${c.relation} (${r.kind})`);
   163	  return [...out].sort();
   164	}
