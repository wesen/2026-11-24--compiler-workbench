    98	export function definePass<S, N extends Needs = {}, P = unknown>(spec: PassSpec<S, N, P>): Pass<S, N, P> {
    99	  if (!spec.id || !spec.version) throw new Error('A pass needs an id and a version');
   100	  if (typeof spec.run !== 'function') throw new Error(`Pass ${spec.id} needs run`);
   101	  if (!spec.writes || !Array.isArray(spec.writes.entities) || !Array.isArray(spec.writes.relations))
   102	    throw new Error(`Pass ${spec.id} must declare writes { entities, relations }`);
   103	  return Object.freeze({
   104	    ...spec,
   105	    needs: spec.needs ?? ({} as N),
   106	    preserves: spec.preserves ?? [],
   107	    category: 'pass' as const,
   108	  });
   109	}
