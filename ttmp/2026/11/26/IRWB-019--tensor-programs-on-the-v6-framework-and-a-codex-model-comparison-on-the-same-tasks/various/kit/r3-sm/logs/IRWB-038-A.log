   252	  if (spec.inconclusive?.(a) || spec.inconclusive?.(b)) return INCONCLUSIVE;
   253	  const c = spec.compare(a, b, kase);
   254	  const verdict = typeof c === 'boolean' ? { ok: c } : c;
   255	  return verdict.ok ? AGREE : Object.freeze({ v: 'disagree', reason: verdict.reason ?? 'outcomes differ' });
   256	}
