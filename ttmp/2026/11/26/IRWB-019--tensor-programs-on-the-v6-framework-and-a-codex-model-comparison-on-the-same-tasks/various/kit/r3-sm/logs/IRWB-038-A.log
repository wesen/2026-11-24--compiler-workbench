   267	export async function applyPass<S, N extends Needs, P>(
   268	  pass: Pass<S, N, P>,
   269	  before: Artifact<S>,
   270	  options: ApplyOptions<P>,
   271	): Promise<PassResult<S>> {
   272	  const { manager } = options;
   273	  const view = openIR(before, pass.adapter, options.store);
   274	  const facts: Record<string, unknown> = {},
   275	    records: Record<string, AnalysisRecord<unknown>> = {};
   276	  for (const [name, def] of Object.entries(pass.needs ?? {})) {
   277	    const record = await manager.analyse(def, before);
   278	    records[name] = record;
   279	    facts[name] = record.value;
   280	  }
   281	  // The edit opens on the first read of ctx.edit, so a pass that returns a native result works with an adapter that
   282	  // cannot rebuild (beginEdit throws ir.capability for one) (IRWB-019 F13).
   283	  let edit: IREdit<S> | undefined;
   284	  let produced: void | NativeResult<S>;
   285	  try {
   286	    produced = await pass.run({
   287	      before,
   288	      view,
   289	      facts: facts as FactValues<N>,
   290	      records: records as PassRunContext<S, N, P>['records'],
   291	      params: options.params as P,
   292	      get edit(): IREdit<S> {
   293	        return (edit ??= view.beginEdit());
   294	      },
   295	    });
   296	  } catch (e) {
   297	    if (edit?.state === 'open') edit.rollback('pass threw');
   298	    throw e;
   299	  }
   300	  let after: Artifact<S>, changes: ChangeSet, correspondence: EntityCorrespondence, edits: number;
   301	  let report: unknown;
   302	  if (produced && typeof produced === 'object' && 'native' in produced) {
   303	    if (edit?.state === 'open') edit.rollback('native result');
   304	    ({ after, changes, correspondence, edits } = prepareNative(
   305	      pass,
   306	      view,
   307	      produced,
   308	      options.outputId ?? before.id,
   309	      options.store,
   310	    ));
   311	    report = produced.report;
   312	  } else {
   313	    if (edit && edit.state !== 'open')
   314	      throw new PassError('badResult', `Pass ${pass.id} closed its edit itself`);
   315	    if (!edit || edit.operationCount === 0) {
   316	      // IRWB-004: an edit with no operations is the identity (the projection and rebuild are inverses), so preparing
   317	      // it would rebuild, re-create and re-diff the unchanged program only to find nothing changed
   318	      edit?.rollback('no operations');
   319	      return {
   320	        pass: { id: pass.id, version: pass.version },
   321	        changed: false,
   322	        before,
   323	        artifact: before,
   324	        edits: 0,
   325	        preserved: [],
   326	      };
   327	    }
   328	    const prepared = edit.prepare();
   329	    after = prepared.artifact;
   330	    changes = prepared.changes;
   331	    correspondence = prepared.correspondence;
   332	    edits = changes.operations.filter(o => o.kind !== 'correspond').length;
   333	    edit.rollback('applyPass publishes revisions itself');
   334	  }
   335	  if (after.revision === before.revision && !changes.entities.length && !changes.relations.length)
   336	    return {
   337	      pass: { id: pass.id, version: pass.version },
   338	      changed: false,
   339	      before,
   340	      artifact: before,
   341	      edits: 0,
   342	      preserved: [],
   343	    };
   344	
   345	  enforceWrites(pass, changes);
   346	
   347	  let contract: unknown;
   348	  const gate = options.contract ?? pass.contract;
   349	  if (gate) {
   350	    try {
   351	      const prepared = await manager.verifyTransformation(
   352	        { input: before, ...(options.contractInputs ?? {}) } as never,
   353	        { output: after } as never,
   354	        gate,
   355	        gate.correspondence.length
   356	          ? gate.correspondence.map(req => semanticCorrespondence(correspondence, req.id, req.relation))
   357	          : [semanticCorrespondence(correspondence)],
   358	      );
   359	      contract = prepared;
   360	    } catch (e) {
   361	      throw new PassError('contractRejected', `Pass ${pass.id} output rejected: ${(e as Error).message}`, {
   362	        cause: String(e),
   363	      });
   364	    }
   365	  }
   366	
   367	  const preserved: PreservationOutcome[] = [];
   368	  for (const def of pass.preserves ?? []) {
   369	    if (!manager.hasAnalysis(def, before)) {
   370	      if (!options.auditPreservation) continue; // nothing to keep
   371	      await manager.analyse(def, before);
   372	    }
   373	    try {
   374	      const record = await manager.preserve(def, before, after, semanticCorrespondence(correspondence));
   375	      preserved.push({ analysis: def.id, how: 'transferred', evidence: record.transfer?.evidence });
   376	    } catch {
   377	      const old = await manager.analyse(def, before),
   378	        fresh = await manager.analyse(def, after);
   379	      if (canonical(old.value) !== canonical(fresh.value))
   380	        throw new PassError(
   381	          'preserveViolated',
   382	          `Pass ${pass.id} claims to preserve ${def.id}, but it changed`,
   383	          {
   384	            analysis: def.id,
   385	          },
   386	        );
   387	      preserved.push({ analysis: def.id, how: 'confirmed-by-recompute', evidence: { equalValue: true } });
   388	    }
   389	  }
   390	  return {
   391	    pass: { id: pass.id, version: pass.version },
   392	    changed: true,
   393	    before,
   394	    artifact: after,
   395	    changes,
   396	    correspondence,
   397	    edits,
   398	    preserved,
   399	    contract,
   400	    report,
   401	  };
   402	}
     1	/**
     2	 * IRWB-001 E6: passes and analyses as Strategy IR algorithms.
     3	 *
     4	 * A strategy plan refers to algorithms by id and exact version. `passAlgorithm` registers a pass as a `transform`
     5	 * whose current value is an artifact: applying it returns the next revision (or the same artifact when nothing
     6	 * changed). `analysisAlgorithm` registers an analysis as an `analysis` algorithm, and `metricsAlgorithm` exposes a
     7	 * numeric summary for `chooseBest`. The strategy interpreter records the plan, branches and selections; the pass
     8	 * results themselves are reported through `onResult` so a host (the workbench's revision timeline) can keep them.
     9	 */
    10	import type { Artifact } from '../core/types.js';
    11	import type { AnalysisManager } from '../contracts/analysis-manager.js';
    12	import type { AnalysisDefinition } from '../contracts/types.js';
    13	import type { IRStore } from '../ir/index.js';
    14	import type { StrategyAlgorithm } from '../strategy/ir.js';
    15	import { applyPass, PassError, type Needs, type Pass, type PassResult } from './define-pass.js';
    16	
    17	export interface BridgeOptions {
    18	  readonly manager: AnalysisManager;
    19	  readonly store?: IRStore;
    20	  readonly contractInputs?: (input: Artifact<any>) => Readonly<Record<string, unknown>>;
    21	  /** A contract for every application, overriding the passes' own (see ApplyOptions.contract). */
    22	  readonly contract?: import('../contracts/types.js').TransformationDefinition<any, any>;
    23	  readonly onResult?: (result: PassResult<any>) => void;
    24	}
    25	
    26	const isArtifact = (x: unknown): x is Artifact<any> =>
    27	  !!x && typeof x === 'object' && typeof (x as Artifact).revision === 'string' && 'value' in (x as object);
    28	
    29	export function passAlgorithm<S>(pass: Pass<S, Needs, any>, options: BridgeOptions): StrategyAlgorithm {
    30	  return {
    31	    id: pass.id,
    32	    version: pass.version,
    33	    kind: 'transform',
    34	    description: pass.description,
    35	    async run(ctx, input, args) {
    36	      if (!isArtifact(input))
    37	        ctx.reject('not-an-artifact', `${pass.id} needs an artifact as its current value`);
    38	      try {
    39	        const result = await applyPass(pass, input as Artifact<S>, {
    40	          manager: options.manager,
    41	          store: options.store,
    42	          params: args,
    43	          contractInputs: options.contractInputs?.(input as Artifact<S>),
    44	          contract: options.contract,
    45	        });
    46	        options.onResult?.(result);
    47	        ctx.record('pass', {
    48	          pass: pass.id,
    49	          changed: result.changed,
    50	          edits: result.edits,
    51	          revision: result.artifact.revision,
    52	        });
    53	        return result.artifact;
    54	      } catch (e) {
    55	        // a rejected contract is an expected, recoverable outcome a strategy can handle (attempt, fork)
    56	        if (e instanceof PassError && e.code === 'contractRejected')
    57	          ctx.reject('contract-rejected', e.message, e.evidence);
    58	        throw e;
    59	      }
    60	    },
    61	  };
    62	}
    63	
    64	export function analysisAlgorithm<S, R>(
    65	  def: AnalysisDefinition<S, R>,
    66	  options: { manager: AnalysisManager },
    67	): StrategyAlgorithm {
    68	  return {
    69	    id: def.id,
    70	    version: def.version,
    71	    kind: 'analysis',
    72	    description: def.description,
    73	    async run(ctx, input) {
    74	      if (!isArtifact(input)) ctx.reject('not-an-artifact', `${def.id} needs an artifact`);
    75	      return (await options.manager.analyse(def, input as Artifact<S>)).value;
    76	    },
    77	  };
    78	}
    79	
    80	export function metricsAlgorithm(
    81	  id: string,
    82	  version: string,
    83	  description: string,
    84	  measure: (value: unknown) => Readonly<Record<string, number>> | Promise<Readonly<Record<string, number>>>,
    85	): StrategyAlgorithm {
    86	  return { id, version, kind: 'metrics', description, run: (_ctx, input) => measure(input) };
    87	}
{
  "name": "compiler-workbench",
