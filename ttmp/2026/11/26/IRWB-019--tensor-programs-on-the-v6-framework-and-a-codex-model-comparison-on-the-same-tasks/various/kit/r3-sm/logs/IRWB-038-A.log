   224	/** Run a synchronous native kernel; the caller supplies its synchronous semantic gate. */
   225	export function applyNativePassSync<S, P>(
   226	  pass: Pass<S, {}, P>,
   227	  before: Artifact<S>,
   228	  gate: (before: Artifact<S>, candidate: Artifact<S>) => CheckResult,
   229	  params?: P,
   230	): PassResult<S> {
   231	  if (Object.keys(pass.needs ?? {}).length || pass.preserves?.length || pass.contract)
   232	    throw new PassError('badResult', 'This pass requires the asynchronous analysis manager');
   233	  const view = openIR(before, pass.adapter);
   234	  const produced = pass.run({
   235	    before,
   236	    view,
   237	    params: params as P,
   238	    facts: {},
   239	    records: {},
   240	    get edit(): IREdit<S> {
   241	      throw new PassError('badResult', 'A native pass must return its native result');
   242	    },
   243	  });
   244	  if (!produced || !('native' in produced)) {
   245	    if (produced instanceof Promise) void produced.catch(() => {});
   246	    throw new PassError('badResult', 'Expected a synchronous native result');
   247	  }
   248	  const base = { pass: { id: pass.id, version: pass.version }, before, preserved: [] };
   249	  const { after, changes, correspondence, edits } = prepareNative(pass, view, produced, before.id);
   250	  if (after.revision === before.revision) return { ...base, changed: false, artifact: before, edits: 0 };
   251	  enforceWrites(pass, changes);
   252	  const contract = gate(before, after);
   253	  if (contract?.ok !== true)
   254	    throw new PassError('contractRejected', contract?.reason ?? 'Candidate rejected', contract?.evidence);
   255	  return {
   256	    ...base,
   257	    changed: true,
   258	    artifact: after,
   259	    edits,
   260	    changes,
   261	    correspondence,
   262	    contract,
   263	    report: produced.report,
   264	  };
   265	}
