   237	export function decideCase<P extends Ports, Case, Outcome>(
   238	  spec: DifferentialSpec<P, Case, Outcome>,
   239	  inputs: PortValues<P>,
   240	  kase: Case,
   241	  index: number,
   242	  outcomes?: unknown[],
   243	): Decided {
   244	  let a = outcomes?.[index] as Outcome | undefined;
