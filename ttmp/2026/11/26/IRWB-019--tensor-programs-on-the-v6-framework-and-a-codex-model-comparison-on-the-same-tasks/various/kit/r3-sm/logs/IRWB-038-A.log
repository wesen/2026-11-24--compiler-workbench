   200	function prepare<P extends Ports, Case, Outcome>(
   201	  spec: DifferentialSpec<P, Case, Outcome>,
   202	  inputs: PortValues<P>,
   203	  seed: number,
   204	): { cases: readonly Case[]; reuse?: Reuse } {
   205	  const bk = reuseEnabled ? spec.baselineKey?.(inputs) : undefined;
   206	  if (bk === undefined) return { cases: spec.cases(inputs, (spec.random ?? seededRandom)(seed), spec.count) };
   207	  const key = `${spec.id}@${spec.version}#${seed}#${spec.count}#${bk}`;
   208	  let reuse = REUSE.get(key);
