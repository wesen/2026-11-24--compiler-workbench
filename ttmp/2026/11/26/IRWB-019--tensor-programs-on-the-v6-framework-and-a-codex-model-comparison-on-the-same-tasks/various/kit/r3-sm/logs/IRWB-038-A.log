   175	/** Encode case values as canonical plain data, preserving typed-array bytes and special numbers. */
   176	function caseDigest(cases: readonly unknown[]): string {
   177	  function encode(value: unknown): unknown {
   178	    if (value === null) return ['null'];
   179	    if (typeof value === 'number')
   180	      return ['number', Object.is(value, -0) ? '-0' : String(value)];
   181	    if (typeof value === 'string' || typeof value === 'boolean' || typeof value === 'bigint' || value === undefined)
   182	      return [typeof value, String(value)];
   183	    if (ArrayBuffer.isView(value)) {
   184	      const bytes = new Uint8Array(value.buffer, value.byteOffset, value.byteLength);
   185	      return ['view', Object.getPrototypeOf(value).constructor.name, Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('')];
   186	    }
   187	    if (value instanceof ArrayBuffer)
   188	      return ['buffer', Array.from(new Uint8Array(value), b => b.toString(16).padStart(2, '0')).join('')];
   189	    if (Array.isArray(value)) return ['array', value.map(encode)];
   190	    if (value instanceof Date) return ['date', String(value.getTime())];
   191	    if (value instanceof Map) return ['map', [...value].map(([k, v]) => [encode(k), encode(v)])];
   192	    if (value instanceof Set) return ['set', [...value].map(encode)];
   193	    if (typeof value === 'object')
   194	      return ['object', Object.keys(value).sort().map(k => [k, encode((value as Record<string, unknown>)[k])])];
   195	    throw new Error('Unsupported differential case value');
   196	  }
   197	  return fingerprint(encode(cases));
   198	}
