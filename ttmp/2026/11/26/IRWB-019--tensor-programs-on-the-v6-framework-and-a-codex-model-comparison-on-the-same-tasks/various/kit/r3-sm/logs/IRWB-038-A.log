from functools import lru_cache
from pathlib import Path
import re
import subprocess
import sys

ticket = Path(sys.argv[1])
root = Path.cwd()
appendix = (ticket / 'analysis/01-cell-evidence.md').read_text()
lookup = {}
for cell, tree, head in re.findall(r'\\| ([A-J]) · ((?:t6|d1|a0|b1)-["'^| ]+) '"\\| "'`([a-f0-9]+)`'"', appendix):
    lookup[tree[:2].upper() + '-' + cell] = (root.parent / tree, head)

@lru_cache(None)
def lines(path, cell):
    if cell:
        tree, head = lookup[cell]
        return len(subprocess.check_output(
            ['git', '-C', str(tree), 'show', f'{head}:{path}'], text=True
        ).splitlines())
    return len((root / path).read_text().splitlines())

count = 0
errors = []
for doc in [ticket / 'index.md', *ticket.glob('design-doc/*.md'), *ticket.glob('analysis/*.md')]:
    current_cell = ''
    for row in doc.read_text().splitlines():
        matrix = re.search(r'\\| ([A-J]) · ((?:t6|d1|a0|b1)-["'^| ]+) '"\\|', row)
        current_cell = matrix[2][:2].upper() + '-' + matrix[1] if matrix else ''
        for cell, path, lineno in re.findall(
            r'"'`(?:(T6-[A-J]|D1-[A-G]|A0-[A-G]|B1-[A-G])/)?((?:(?:src|tests|ttmp)/[''^ :`]+)|BACKLOG'"\\.md):(\\d+)"'`'"', row
        ):
            cell = cell or current_cell
            try:
                assert 0 < int(lineno) <= lines(path, cell)
                count += 1
