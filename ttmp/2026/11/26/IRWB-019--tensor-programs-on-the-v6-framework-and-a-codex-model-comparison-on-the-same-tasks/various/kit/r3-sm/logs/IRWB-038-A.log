   316	export function runDifferential<P extends Ports, Case, Outcome>(
   317	  spec: DifferentialSpec<P, Case, Outcome>,
   318	  inputs: PortValues<P>,
   319	  seed = spec.seed ?? 1,
   320	  maxCounterexamples = spec.maxCounterexamples ?? 5,
   321	): DifferentialEvidence {
   322	  const { cases, reuse } = prepare(spec, inputs, seed);
   323	  const keys = memoKeys(spec, inputs, cases, reuse);
   324	  const verdicts: Decided[] = new Array(cases.length);
   325	  for (let i = 0; i < cases.length; i++) {
   326	    const known = keys[i] === undefined ? undefined : reuse!.verdicts.get(keys[i]!);
   327	    if (known) {
   328	      verdicts[i] = known;
   329	      STATS.replayed++;
   330	      continue;
   331	    }
   332	    verdicts[i] = decideCase(spec, inputs, cases[i], i, reuse?.outcomes);
   333	    if (keys[i] !== undefined) reuse!.verdicts.set(keys[i]!, verdicts[i]);
   334	  }
   335	  return tally(spec, seed, cases, verdicts, maxCounterexamples);
   336	}
