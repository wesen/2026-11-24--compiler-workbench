   166	/**
   167	 * v6's semantic correspondence record for an entity correspondence between two revisions. The analysis manager
   168	 * matches records to a contract's `correspondence` requirements by `id` and `relation`, so applyPass builds one
   169	 * record per requirement (default: `entities` / `generic-ir-edit`, as v6's own labs name it).
   170	 */
   171	export function semanticCorrespondence(
   172	  c: EntityCorrespondence,
   173	  id = 'entities',
   174	  relation = 'generic-ir-edit',
   175	): Correspondence {
   176	  return {
   177	    id,
   178	    from: { artifact: c.from.artifact, revision: c.from.revision },
   179	    to: { artifact: c.to.artifact, revision: c.to.revision },
   180	    relation,
   181	    sourceEntities: c.sourceEntities,
   182	    targetEntities: c.targetEntities,
   183	    entities: c.entries.map(e => ({ from: e.from, to: e.to })),
   184	    evidence: {
   185	      formatVersion: c.formatVersion,
   186	      relations: c.entries.map(e => e.relation),
   187	      sourceEntities: c.sourceEntities,
   188	      targetEntities: c.targetEntities,
   189	    },
   190	  };
   191	}
   192	
   193	function prepareNative<S, N extends Needs, P>(
   194	  pass: Pass<S, N, P>,
   195	  view: IRView<S>,
   196	  produced: NativeResult<S>,
   197	  id: string,
   198	  store?: IRStore,
   199	) {
   200	  const before = view.artifact;
   201	  const after = createIRArtifact(pass.adapter, id, produced.native);
   202	  const afterView = openIR(after, pass.adapter, store);
   203	  const changes = diff(view, afterView);
   204	  const correspondence = makeCorrespondence(
   205	    { artifact: before.id, revision: before.revision },
   206	    { artifact: after.id, revision: after.revision },
   207	    // the projections' entity ids, in order (what `view.entities()` names, without a reference per entity)
   208	    view.graph().entities.map(e => e.id),
   209	    afterView.graph().entities.map(e => e.id),
   210	    produced.correspondence ?? [],
   211	  );
   212	  const edits = produced.edits ?? changes.entities.length;
   213	  return { after, changes, correspondence, edits };
   214	}
   215	
   216	function enforceWrites(pass: Pick<PassSpec<unknown, Needs>, 'writes' | 'id'>, changes: ChangeSet) {
   217	  const undeclared = undeclaredWrites(pass.writes, changes);
   218	  if (undeclared.length)
   219	    throw new PassError('undeclaredWrite', `Pass ${pass.id} changed kinds it did not declare in writes`, {
   220	      undeclared: undeclared.slice(0, 20),
   221	    });
   222	}
