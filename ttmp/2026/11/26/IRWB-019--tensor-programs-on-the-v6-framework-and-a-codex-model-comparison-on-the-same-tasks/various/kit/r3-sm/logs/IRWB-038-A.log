   207	    inputs,
   208	    outputs,
   209	    cache: 'never',
   210	    correspondence: [{ id: 'kernels', from: 'baseline', to: 'subject', relation: 'statements-to-kernels' }],
   211	    ensures: [
   212	      {
   213	        invariant,
   214	        bindings: {
   215	          baseline: { from: 'inputs', port: 'baseline' },
   216	          fn: { from: 'inputs', port: 'fn' },
   217	          subject: { from: 'outputs', port: 'subject' },
   218	        },
   219	      },
   220	    ],
   221	    run(_ctx, { baseline, fn, fuse }) {
   222	      const f = selectFunction(baseline.value, fn);
   223	      const plan = fuse ? planFusion(f) : unfusedPlan(f);
   224	      const kernels = plan.groups.map(g => ({
   225	        name: g.kernel,
   226	        mapping: g.mapping,
   227	        statements: g.statements,
