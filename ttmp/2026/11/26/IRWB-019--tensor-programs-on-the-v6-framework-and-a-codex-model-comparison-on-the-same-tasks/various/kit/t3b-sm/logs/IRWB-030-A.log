+export function parallelTerms(statement: Statement, depth: number): Reduction[] {
+  if (statement.axes.length !== depth) return [];
+  const staged: Reduction[] = [];
+  function inspect(e: Expr) {
+    if (e.kind === 'op') {
+      e.args.forEach(inspect);
+    } else if (e.kind === 'reduce' && e.axes.length === 1 && e.axes[0].extent.kind === 'dim') {
