  `compiled=0; c0=$(date +%s%N)`,
  `if [ ! -x prog ]; then ${nvcc} -O3 -arch=${arch} -o prog main.cu 2> compile.err || { echo "@@compile-failed"; cat compile.err >&2; exit 97; }; compiled=1; fi`,
  `c1=$(date +%s%N); rm -rf out; mkdir -p out`,
