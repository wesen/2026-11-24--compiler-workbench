import {
  AnalysisManager,
  ContractError,
  createArtifact,
  defineIR,
  defineTransformation,
  defineType,
  differential,
  type Correspondence,
  type Decided,
  type DifferentialEvidence,
} from '../framework/contracts/index.js';
import type { Artifact } from '../framework/core/types.js';
import { coordinate, cudaCases, seed } from './contract.js';
import { runCudaBatch } from './cuda-runtime.js';
import { emitCuda, takesGate } from './cuda-source.js';
import { planFusion, unfusedPlan } from './fusion.js';
import type { BufferValue } from './evaluate.js';
import { TixIR } from './ir.js';
import { selectFunction, type Module } from './model.js';

interface CudaKernel {
  name: string;
  mapping: 'thread' | 'block';
  statements: string[];
  /** The host decides at launch between this kernel's block mode and its statements one by one (IRWB-030-E). */
  gated?: boolean;
}
interface CudaUnit {
  fn: string;
  source: string;
  /** The fusion plan the source follows: which statements each kernel computes (IRWB-029-D). */
  kernels: CudaKernel[];
}

const CudaIR = defineIR<CudaUnit>({
  id: 'tensor.cuda-source',
  version: '2',
  description: "Standalone CUDA translation unit for a Tix function, with its kernels' statements",
  validate(value) {
    const unit = value as Partial<CudaUnit> | null;
    if (typeof unit?.fn !== 'string' || !unit.fn || typeof unit.source !== 'string' || !unit.source)
      throw Error('Invalid CUDA translation unit');
    if (
      !Array.isArray(unit.kernels) ||
      unit.kernels.some(
        k =>
          typeof k?.name !== 'string' ||
          !['thread', 'block'].includes(k.mapping) ||
          !['boolean', 'undefined'].includes(typeof k.gated) ||
          !Array.isArray(k.statements) ||
          !k.statements.length ||
          k.statements.some(s => typeof s !== 'string'),
      )
    )
      throw Error('Invalid CUDA kernel list');
  },
});
const FunctionName = defineType<string>({
  id: 'tensor.function-name',
  version: '1',
  description: 'Name of the Tix function to lower',
  validate(name) {
    if (typeof name !== 'string' || !name) throw Error('Invalid Tix function name');
  },
});

const Fuse = defineType<boolean>({
  id: 'tensor.fuse',
  version: '1',
  description: 'Whether the lowering fuses statements into fewer kernels',
  validate(fuse) {
    if (typeof fuse !== 'boolean') throw Error('Invalid fuse flag');
  },
});

export function cudaArtifact(fn: string, source: string, kernels: CudaKernel[] = []): Artifact<CudaUnit> {
  return createArtifact(CudaIR, 'tix-cuda/' + fn, { fn, source, kernels });
}

/** The lowering as a framework correspondence: each kernel and the Tix statement entities it computes. */
export function kernelCorrespondence(
  baseline: Artifact<Module>,
  subject: Artifact<CudaUnit>,
): Correspondence {
  const { fn, kernels } = subject.value;
  return {
    id: 'kernels',
    from: { artifact: baseline.id, revision: baseline.revision },
    to: { artifact: subject.id, revision: subject.revision },
    relation: 'statements-to-kernels',
    entities: kernels.map(k => ({ from: k.statements.map(s => fn + '/' + s), to: [k.name] })),
    evidence: { mappings: kernels.map(k => k.mapping), gated: kernels.map(k => k.gated === true) },
  };
}

// The relation is exact: the lowered function must give the current revision's f32 meaning bit for bit, signed
// zeros and infinities included (IRWB-019 F17). The emitter makes that possible: explicit round-to-nearest
// arithmetic, so nothing contracts, and exp, log and tanh in double, rounded, which equal Math.fround(Math.exp(x))
// and so on for all 2^32 f32 inputs on the GB10 (IRWB-019 diary step 23). NaN is compared as a class, because the
// GPU and V8 produce different NaN words (sqrt of -2^-149: 0x7fffffff against 0xffc00000).
function compare(expected: BufferValue, got: BufferValue) {
  if (expected.shape.length !== got.shape.length || expected.shape.some((n, i) => n !== got.shape[i]))
    return { ok: false, reason: 'Output shape differs' };
  if (expected.data.length !== got.data.length) return { ok: false, reason: 'Output length differs' };
  const f32 = (d: ArrayLike<number>) => (d instanceof Float32Array ? d : Float32Array.from(d));
  const a = f32(expected.data),
    b = f32(got.data);
  const wa = new Uint32Array(a.buffer, a.byteOffset, a.length),
    wb = new Uint32Array(b.buffer, b.byteOffset, b.length);
  const hex = (w: number) => '0x' + w.toString(16).padStart(8, '0');
  for (let i = 0; i < a.length; i++) {
    if (wa[i] === wb[i] || (Number.isNaN(a[i]) && Number.isNaN(b[i]))) continue;
    const at = coordinate(expected.shape, i);
    return { ok: false, reason: `At [${at}], expected ${a[i]} (${hex(wa[i])}), got ${b[i]} (${hex(wb[i])})` };
  }
  return { ok: true };
}

// A fused kernel in block mode has a gate: at launch the host runs it fused, or its statements one by one, by the
// shapes (fusion.ts). The recipe's shapes are small, so the rule alone would show little of one side. For a
// program with a gate, every sample is therefore a case on each side, and the program is run once with each side
// forced. A program without a gate has one case per sample.
type Gate = 'fused' | 'unfused';
const sides: readonly Gate[] = ['fused', 'unfused'];
type CudaSample = ReturnType<typeof cudaCases>[number] & { gate?: Gate };

export function createCudaLowering(profile: string, executeBatch: typeof runCudaBatch = runCudaBatch) {
  const inputs = { baseline: TixIR, fn: FunctionName, fuse: Fuse };
  const outputs = { subject: CudaIR };
  const ports = { baseline: TixIR, fn: FunctionName, ...outputs };
  const invariant = differential<typeof ports, CudaSample, BufferValue>({
    id: 'tensor.cuda-meaning',
    version: '2',
    description:
      'Compare the lowered CUDA function to its current Tix f32 meaning, bit for bit (NaN as a class)',
    inputs: ports,
    baseline: 'baseline',
    subject: 'subject',
    // The recipe is shape-dependent and supplies its whole eligible case set.
    count: 1,
    seed,
    cases: ({ baseline, fn, subject }, random): CudaSample[] => {
      const samples = cudaCases(selectFunction(baseline.value, fn), random);
      if (!samples.length) throw Error('No eligible CUDA check cases for ' + fn);
      return takesGate(subject.value.source)
        ? samples.flatMap(s => sides.map(gate => ({ ...s, gate })))
        : samples;
    },
    run: (side, _artifact, sample) => {
      if (side === 'baseline') return sample.reference;
      throw Error('CUDA checks require the batch executor');
    },
    compare,
    describeCase: ({ fn, shapeValues, stream, gate }) => ({
      fn,
      shapeValues,
      stream,
      seed,
      ...(gate && { gate }),
    }),
    // The case list depends on the subject only through whether it has a gate.
    baselineKey: ({ baseline, fn, subject }) =>
      JSON.stringify([baseline.revision, fn, takesGate(subject.value.source)]),
    subjectKey: (_artifact, _case, { subject }) => JSON.stringify([subject.revision, profile]),
    async decide({ baseline, fn, subject }, cases, todo) {
      if (subject.value.fn !== fn)
        return todo.map(() => ({ v: 'disagree', reason: 'CUDA function differs' }));
      const pending = todo.map(i => cases[i]);
      const f = selectFunction(baseline.value, fn);
      const { source } = subject.value;
      const results = new Map<CudaSample, BufferValue>();
      const run = async (batch: CudaSample[], gate?: Gate) => {
        if (!batch.length) return;
        const out = await executeBatch(
          source,
          f,
          batch.map(c => c.inputs),
          { gate },
        );
        if (out.length !== batch.length) throw Error('Wrong CUDA response case count');
        batch.forEach((c, i) => results.set(c, out[i]));
      };
      if (takesGate(source))
        await Promise.all(
          sides.map(g =>
            run(
              pending.filter(c => c.gate === g),
              g,
            ),
          ),
        );
      else await run(pending);
      return pending.map((sample): Decided => {
        const result = compare(sample.reference, results.get(sample)!);
        return result.ok ? { v: 'agree' } : { v: 'disagree', reason: result.reason! };
      });
    },
  });
  const pass = defineTransformation({
    id: 'tensor.lower-cuda',
    version: '2',
    description: 'Lower a Tix function to CUDA, fused or one kernel per statement, and check it on the GPU',
    inputs,
    outputs,
    cache: 'never',
    correspondence: [{ id: 'kernels', from: 'baseline', to: 'subject', relation: 'statements-to-kernels' }],
    ensures: [
      {
        invariant,
        bindings: {
          baseline: { from: 'inputs', port: 'baseline' },
          fn: { from: 'inputs', port: 'fn' },
          subject: { from: 'outputs', port: 'subject' },
        },
      },
    ],
    run(_ctx, { baseline, fn, fuse }) {
      const f = selectFunction(baseline.value, fn);
      const plan = fuse ? planFusion(f) : unfusedPlan(f);
      const kernels = plan.groups.map(g => ({
        name: g.kernel,
        mapping: g.mapping,
        statements: g.statements,
        ...(g.gated && { gated: true }),
      }));
      const subject = cudaArtifact(fn, emitCuda(f, plan), kernels);
      return { outputs: { subject }, correspondence: [kernelCorrespondence(baseline, subject)] };
    },
  });

  return async (
    baseline: Artifact<Module>,
    fn: string,
    candidate?: Artifact<CudaUnit>,
    options?: { fuse?: boolean; manager?: AnalysisManager },
  ) => {
    const relation = 'exact' as const;
    const manager = options?.manager ?? new AnalysisManager();
    const fuse = options?.fuse !== false;
    try {
      if (candidate)
        await manager.verifyTransformation({ baseline, fn, fuse }, { subject: candidate }, pass, [
          kernelCorrespondence(baseline, candidate),
        ]);
      else await manager.execute(pass, { baseline, fn, fuse });
      return { accepted: true, relation };
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      if (error instanceof ContractError && error.code === 'postcondition') {
        const checks = manager.snapshot().executions.at(-1)?.checks;
        const evidence = checks?.find(check => check.phase === 'ensures')?.evidence as
          | DifferentialEvidence
          | undefined;
        const first = evidence?.counterexamples[0];
        const reason = first ? `${JSON.stringify(first.case)}: ${first.reason}` : message;
        return { accepted: false, relation, reason };
      }
      return { accepted: false, relation, reason: 'CUDA evidence unavailable: ' + message };
    }
  };
}

export const checkCudaLowering = createCudaLowering('cuda-remote:sm_121:-O3');
import { defineIR } from '../framework/contracts/index.js';
import { defineAdapter, type IREntity, type IRRelation } from '../framework/ir/index.js';
import { plain, visit, type Affine, type Axis, type Expr, type Fn, type Module } from './model.js';

function requireIR(condition: unknown, reason: string): asserts condition {
  if (!condition) throw Error(reason);
}
function same(a: unknown, b: unknown) {
  return JSON.stringify(a) === JSON.stringify(b);
}
function checkForm(a: Affine, names: Set<string>) {
  requireIR(
    Number.isSafeInteger(a.constant) && a.terms.every(([n, k]) => names.has(n) && Number.isSafeInteger(k)),
    'Invalid affine form',
  );
}
function validateFn(fn: Fn) {
  const shapes = new Set(fn.params.flatMap(p => p.shape.map(plain).filter((s): s is string => !!s)));
  const tensors = new Map<string, Affine[]>();
  const declare = (t: { name: string; shape: Affine[] }) => {
    requireIR(!tensors.has(t.name) && t.shape.length, 'Invalid tensor definition');
    for (const d of t.shape) {
      checkForm(d, shapes);
      requireIR(d.terms.length || d.constant >= 0, 'Negative dimension');
    }
    tensors.set(t.name, t.shape);
  };
  fn.params.forEach(declare);
  function bind(axes: Axis[], outer: Set<string>) {
    const scope = new Set(outer);
    requireIR(axes.length, 'Missing axes');
    for (const a of axes) {
      requireIR(!scope.has(a.id), 'Duplicate binder');
      const e = a.extent;
      checkForm(e.dim, shapes);
      requireIR(
        e.kind === 'dim' ||
          (e.kind === 'blocks' && ['ceil', 'floor'].includes(e.rounding)) ||
          (e.kind === 'tail' && scope.has(e.block)),
        'Invalid reduction bound',
      );
      scope.add(a.id);
    }
    return scope;
  }
  function expr(e: Expr, scope: Set<string>) {
    switch (e.kind) {
      case 'literal':
        requireIR(!Number.isNaN(Number(e.text)), 'Invalid literal');
        break;
      case 'shape':
        requireIR(shapes.has(e.name), 'Unknown shape');
        break;
      case 'load':
        requireIR(tensors.get(e.name)?.length === e.indices.length, 'Invalid tensor read');
        e.indices.forEach(a => checkForm(a, scope));
        break;
      case 'op':
        requireIR(
          (['neg', 'exp', 'log', 'tanh', 'sqrt'].includes(e.op) && e.args.length === 1) ||
            (['+', '-', '*', '/', 'min', 'max'].includes(e.op) && e.args.length === 2),
          'Invalid operation',
        );
        e.args.forEach(x => expr(x, scope));
        break;
      case 'reduce':
        requireIR(e.op === 'sum' || e.op === 'max', 'Invalid reduction');
        expr(e.body, bind(e.axes, scope));
        break;
      default:
        throw Error('Invalid expression');
    }
  }
  for (const s of fn.statements) {
    requireIR(
      s.axes.length === s.shape.length &&
        s.axes.every((a, i) => a.extent.kind === 'dim' && same(a.extent.dim, s.shape[i])),
      'Invalid result axes',
    );
    expr(s.expr, bind(s.axes, new Set()));
    declare(s);
  }
  requireIR(same(tensors.get(fn.result), fn.shape), 'Invalid result');
}
function validate(value: unknown) {
  const m = value as Module;
  requireIR(
    Array.isArray(m.functions) &&
      m.functions.length &&
      new Set(m.functions.map(f => f.name)).size === m.functions.length,
    'Invalid functions',
  );
  m.functions.forEach(validateFn);
}
export const TixIR = defineIR<Module>({
  id: 'tensor.tix',
  version: '1',
  description: 'Ordered tensor definitions with affine reads',
  validate,
});
function* entities(m: Module): Generator<IREntity> {
  for (const { name, statements, params, shape, result } of m.functions) {
    yield { id: name, kind: 'function', attributes: { shape, result } };
    for (const t of [...params, ...statements])
      yield { id: name + '/' + t.name, kind: 'tensor', attributes: { ...t } };
  }
}
function* relations(m: Module): Generator<IRRelation> {
  for (const f of m.functions) {
    let order = 0;
    for (const t of [...f.params, ...f.statements]) {
      const to = f.name + '/' + t.name;
      yield {
        id: 'contains/' + to,
        from: f.name,
        to,
        kind: 'contains',
        category: 'containment',
        order: order++,
      };
    }
    for (const s of f.statements) {
      const from = f.name + '/' + s.name;
      const reads = new Set<string>();
      visit(s.expr, e => {
        if (e.kind === 'load') reads.add(e.name);
      });
      for (const n of reads)
        yield {
          id: 'reads/' + from + '/' + n,
          from,
          to: f.name + '/' + n,
          kind: 'reads',
          category: 'dependency',
        };
    }
  }
}
export const adapter = defineAdapter<Module>({
  id: 'tensor.adapter',
  version: '1',
  description: 'Functions, tensor definitions and reads',
  kind: TixIR.id,
  schemaVersion: TixIR.version,
  validate,
  relationKinds: { contains: 'containment', reads: 'dependency' },
  entities,
  relations,
  resolve: (m, id) => [...entities(m)].find(e => e.id === id),
  describe: (_, id) => ({ label: id }),
});
/**
 * IRWB-001 E5: differential checkers as v6 invariants.
 *
 * Compiler Workbench checks meaning by running two artifacts on the same generated inputs and comparing results,
 * traps and memory. v6 knows only exact checkers. `differential()` packages the sampled method as an ordinary
 * `InvariantDefinition`, so a transformation contract can `ensure` it like any other invariant. Its evidence records
 * the method (`sampled`), the case count and seed, how many cases agreed, disagreed or were inconclusive, and the
 * first counterexamples. Inconclusive cases (for example a step limit hit by either side) are counted and never
 * treated as a verdict; a check with no decided case fails, because it has established nothing.
 */
import { defineInvariant } from './definitions.js';
import type { CheckResult, InvariantDefinition, PortValue, PortValues, Ports } from './types.js';

/** A small deterministic generator (mulberry32), so a reported counterexample can be run again from its seed. */
export function seededRandom(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

export interface CaseComparison {
  readonly ok: boolean;
  readonly reason?: string;
}

export interface DifferentialSpec<P extends Ports, Case, Outcome> {
  readonly id: string;
  readonly version: string;
  readonly description: string;
  readonly inputs: P;
  /** The port whose behaviour defines the expected meaning (e.g. `origin`, r0). */
  readonly baseline: keyof P & string;
  /** The port being checked against it (e.g. `candidate`). */
  readonly subject: keyof P & string;
  readonly count: number;
  readonly seed?: number;
  /** The generator to seed (default `seededRandom`, mulberry32); a port may supply its tool's own generator. */
  readonly random?: (seed: number) => () => number;
  /** Generate the cases, deterministically from `random` and the inputs. */
  cases(inputs: PortValues<P>, random: () => number, count: number): readonly Case[];
  /** Run one side on one case. `side` names which port `value` came from. */
  run(side: 'baseline' | 'subject', value: PortValue<P[keyof P]>, kase: Case, inputs: PortValues<P>): Outcome;
  compare(baseline: Outcome, subject: Outcome, kase: Case): CaseComparison | boolean;
  inconclusive?(outcome: Outcome): boolean;
  describeCase?(kase: Case): unknown;
  readonly maxCounterexamples?: number;
  /**
   * IRWB-004 D1: a key such that the cases, and the baseline's outcome on each, are a function of this spec (its id,
   * version, seed and count) and the key alone; for a check against a fixed origin, the origin's revision. With a
   * key, both are computed once per key and reused by every later check.
   */
  readonly baselineKey?: (inputs: PortValues<P>) => string | undefined;
  /**
   * IRWB-004 D1: a key such that the subject's outcome on a case is a function of the case and the key alone (for a
   * program, a hash of the code the case can reach). Used only together with `baselineKey`: a decided verdict is
   * kept under (baseline key, case index, subject key) and replayed instead of evaluating the case again.
   */
  readonly subjectKey?: (subject: PortValue<P[keyof P]>, kase: Case, inputs: PortValues<P>) => string | undefined;
  /**
   * IRWB-004 F4: decide the cases at the indices `todo` elsewhere (e.g. on worker threads), returning one verdict
   * per index, in the order of `todo`, exactly as `run`, `inconclusive` and `compare` would decide them; or
   * `undefined` to decide them here. The check's evidence is assembled in case order, whoever decided a case.
   */
  readonly decide?: (
    inputs: PortValues<P>,
    cases: readonly Case[],
    todo: readonly number[],
  ) => Promise<readonly Decided[]> | undefined;
}

/** One decided case: what `compare` (or `inconclusive`) concluded. */
export type Decided =
  | { readonly v: 'agree' }
  | { readonly v: 'inconclusive' }
  | { readonly v: 'disagree'; readonly reason: string };

export interface DifferentialEvidence {
  readonly method: 'sampled';
  readonly invariant: string;
  readonly seed: number;
  readonly total: number;
  readonly agree: number;
  readonly disagree: number;
  readonly inconclusive: number;
  readonly status: 'agree' | 'disagree' | 'inconclusive';
  readonly counterexamples: readonly { readonly case: unknown; readonly reason: string }[];
}

export type DifferentialInvariant<P extends Ports> = InvariantDefinition<P> & {
  readonly method: 'sampled';
};

export function differential<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
): DifferentialInvariant<P> {
  if (!(spec.count > 0 && Number.isInteger(spec.count)))
    throw new Error('Differential check needs a positive case count');
  if (!(spec.baseline in spec.inputs) || !(spec.subject in spec.inputs) || spec.baseline === spec.subject)
    throw new Error('Differential check needs distinct baseline and subject ports');
  const seed = spec.seed ?? 1,
    maxCx = spec.maxCounterexamples ?? 5;
  const result = (evidence: DifferentialEvidence): CheckResult => ({
    ok: evidence.status === 'agree',
    reason:
      evidence.status === 'agree'
        ? `${evidence.agree}/${evidence.total} sampled cases agree (${evidence.inconclusive} inconclusive)`
        : evidence.status === 'disagree'
          ? `${evidence.disagree}/${evidence.total} sampled cases disagree`
          : `no decided case among ${evidence.total} (all inconclusive)`,
    evidence,
  });
  const inv = defineInvariant<P>({
    id: spec.id,
    version: spec.version,
    description: spec.description,
    inputs: spec.inputs,
    check(_ctx, inputs): CheckResult | Promise<CheckResult> {
      if (spec.decide) return runDifferentialAsync(spec, inputs, seed, maxCx).then(result);
      return result(runDifferential(spec, inputs, seed, maxCx));
    },
  });
  const out = Object.assign(Object.create(null), inv, { method: 'sampled' as const }) as DifferentialInvariant<P>;
  SPECS.set(out, spec as DifferentialSpec<any, any, any>);
  return out;
}

const SPECS = new WeakMap<object, DifferentialSpec<any, any, any>>();
/** IRWB-004 F4: the specification a differential invariant was made from (a worker decides cases with it). */
export function differentialSpec<P extends Ports>(inv: DifferentialInvariant<P>): DifferentialSpec<P, any, any> {
  const spec = SPECS.get(inv);
  if (!spec) throw new Error(`${inv.id} is not a differential invariant of this realm`);
  return spec;
}

/**
 * IRWB-004 D1: what a check against a baseline key keeps. The cases and the baseline's outcomes (computed as cases
 * are first evaluated) are fixed by the key; `verdicts` maps `index \0 subject key` to the decided verdict. A few
 * keys are kept, least recently used first out.
 */
interface Reuse {
  readonly key: string;
  readonly cases: readonly unknown[];
  readonly outcomes: unknown[];
  readonly verdicts: Map<string, Decided>;
}
const REUSE = new Map<string, Reuse>();
// A running batch can outlive its baseline's entry in the bounded verdict cache.
const IN_FLIGHT = new Map<string, Promise<readonly Decided[]>>();
const REUSE_MAX = 4;
let reuseEnabled = true;
/** Turn the reuse of cases, baseline outcomes and verdicts on or off (tests and measurements compare both). */
export function setDifferentialReuse(enabled: boolean): void {
  reuseEnabled = enabled;
  if (!enabled) {
    REUSE.clear();
    IN_FLIGHT.clear();
  }
}
/** Counts since the last reset: sides run here, verdicts replayed from the memo, cases decided by `decide`. */
const STATS = { baselineRuns: 0, subjectRuns: 0, replayed: 0, delegated: 0 };
export function differentialStats(reset = false): Readonly<typeof STATS> {
  const out = { ...STATS };
  if (reset) for (const k of Object.keys(STATS) as (keyof typeof STATS)[]) STATS[k] = 0;
  return out;
}

function prepare<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  seed: number,
): { cases: readonly Case[]; reuse?: Reuse } {
  const bk = reuseEnabled ? spec.baselineKey?.(inputs) : undefined;
  if (bk === undefined) return { cases: spec.cases(inputs, (spec.random ?? seededRandom)(seed), spec.count) };
  const key = `${spec.id}@${spec.version}#${seed}#${spec.count}#${bk}`;
  let reuse = REUSE.get(key);
  if (reuse) REUSE.delete(key);
  else
    reuse = {
      key,
      cases: spec.cases(inputs, (spec.random ?? seededRandom)(seed), spec.count),
      outcomes: [],
      verdicts: new Map(),
    };
  REUSE.set(key, reuse);
  while (REUSE.size > REUSE_MAX) REUSE.delete(REUSE.keys().next().value!);
  return { cases: reuse.cases as readonly Case[], reuse };
}

const AGREE: Decided = Object.freeze({ v: 'agree' }),
  INCONCLUSIVE: Decided = Object.freeze({ v: 'inconclusive' });
/**
 * Decide one case: run both sides, then `inconclusive`, then `compare`, as a check always has. `outcomes`, when
 * given, keeps the baseline's outcome by case index (it is fixed by the baseline key); a worker deciding cases for a
 * check (IRWB-004 F4) calls this too, with its own `outcomes`.
 */
export function decideCase<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  kase: Case,
  index: number,
  outcomes?: unknown[],
): Decided {
  let a = outcomes?.[index] as Outcome | undefined;
  if (a === undefined) {
    a = spec.run('baseline', inputs[spec.baseline] as PortValue<P[keyof P]>, kase, inputs);
    STATS.baselineRuns++;
    if (outcomes) outcomes[index] = a;
  }
  STATS.subjectRuns++;
  const b = spec.run('subject', inputs[spec.subject] as PortValue<P[keyof P]>, kase, inputs);
  if (spec.inconclusive?.(a) || spec.inconclusive?.(b)) return INCONCLUSIVE;
  const c = spec.compare(a, b, kase);
  const verdict = typeof c === 'boolean' ? { ok: c } : c;
  return verdict.ok ? AGREE : Object.freeze({ v: 'disagree', reason: verdict.reason ?? 'outcomes differ' });
}

/** The evidence of decided cases, counted in case order (so counterexamples come in case order). */
function tally<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  seed: number,
  cases: readonly Case[],
  verdicts: readonly Decided[],
  maxCounterexamples: number,
): DifferentialEvidence {
  let agree = 0,
    disagree = 0,
    inconclusive = 0;
  const counterexamples: { case: unknown; reason: string }[] = [];
  for (let i = 0; i < cases.length; i++) {
    const d = verdicts[i];
    if (d.v === 'inconclusive') inconclusive++;
    else if (d.v === 'agree') agree++;
    else {
      disagree++;
      if (counterexamples.length < maxCounterexamples)
        counterexamples.push({
          case: spec.describeCase ? spec.describeCase(cases[i]) : cases[i],
          reason: d.reason,
        });
    }
  }
  return {
    method: 'sampled',
    invariant: spec.id,
    seed,
    total: cases.length,
    agree,
    disagree,
    inconclusive,
    status: disagree ? 'disagree' : agree ? 'agree' : 'inconclusive',
    counterexamples,
  };
}

/** The memo keys of the cases (undefined where a case has no subject key or nothing is reused). */
function memoKeys<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  cases: readonly Case[],
  reuse: Reuse | undefined,
): (string | undefined)[] {
  if (!reuse || !spec.subjectKey) return new Array(cases.length).fill(undefined);
  const subject = inputs[spec.subject] as PortValue<P[keyof P]>;
  return cases.map((c, i) => {
    const sk = spec.subjectKey!(subject, c, inputs);
    return sk === undefined ? undefined : `${i}\u0000${sk}`;
  });
}

/**
 * Run a differential specification directly (tools, the workbench's Checks view) without a manager. IRWB-004: with
 * `baselineKey`, the cases and baseline outcomes are kept and reused; with `subjectKey` too, a case whose verdict is
 * known for its subject key is not evaluated again. The evidence is the same either way.
 */
export function runDifferential<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  seed = spec.seed ?? 1,
  maxCounterexamples = spec.maxCounterexamples ?? 5,
): DifferentialEvidence {
  const { cases, reuse } = prepare(spec, inputs, seed);
  const keys = memoKeys(spec, inputs, cases, reuse);
  const verdicts: Decided[] = new Array(cases.length);
  for (let i = 0; i < cases.length; i++) {
    const known = keys[i] === undefined ? undefined : reuse!.verdicts.get(keys[i]!);
    if (known) {
      verdicts[i] = known;
      STATS.replayed++;
      continue;
    }
    verdicts[i] = decideCase(spec, inputs, cases[i], i, reuse?.outcomes);
    if (keys[i] !== undefined) reuse!.verdicts.set(keys[i]!, verdicts[i]);
  }
  return tally(spec, seed, cases, verdicts, maxCounterexamples);
}

/** `runDifferential`, with the cases nobody decided yet handed to `spec.decide` (IRWB-004 F4). */
export async function runDifferentialAsync<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  seed = spec.seed ?? 1,
  maxCounterexamples = spec.maxCounterexamples ?? 5,
): Promise<DifferentialEvidence> {
  const { cases, reuse } = prepare(spec, inputs, seed);
  const keys = memoKeys(spec, inputs, cases, reuse);
  const verdicts: Decided[] = new Array(cases.length);
  const todo: number[] = [];
  for (let i = 0; i < cases.length; i++) {
    const known = keys[i] === undefined ? undefined : reuse!.verdicts.get(keys[i]!);
    if (known) {
      verdicts[i] = known;
      STATS.replayed++;
    } else todo.push(i);
  }
  const batchKey = spec.decide && reuse && todo.length && todo.every(i => keys[i] !== undefined)
    ? JSON.stringify([reuse.key, todo.map(i => keys[i])])
    : undefined;
  const pending = batchKey === undefined ? undefined : IN_FLIGHT.get(batchKey);
  const elsewhere = pending ?? (todo.length ? spec.decide?.(inputs, cases, todo) : undefined);
  if (elsewhere) {
    if (batchKey !== undefined && !pending) IN_FLIGHT.set(batchKey, elsewhere);
    try {
      const decided = await elsewhere;
      if (decided.length !== todo.length) throw new Error(`${spec.id}: decide returned ${decided.length} of ${todo.length}`);
      todo.forEach((i, k) => (verdicts[i] = decided[k]));
      if (pending) STATS.replayed += todo.length;
      else STATS.delegated += todo.length;
    } finally {
      if (batchKey !== undefined && IN_FLIGHT.get(batchKey) === elsewhere) IN_FLIGHT.delete(batchKey);
    }
  } else for (const i of todo) verdicts[i] = decideCase(spec, inputs, cases[i], i, reuse?.outcomes);
  for (const i of todo) if (keys[i] !== undefined) reuse!.verdicts.set(keys[i]!, verdicts[i]);
  return tally(spec, seed, cases, verdicts, maxCounterexamples);
}

/** The assurance a check's evidence supports: sampled differential testing is weaker than an exact checker. */
export function assuranceOf(evidence: unknown): 'checked-sampled' | 'checked-exact' {
  return (evidence as { method?: string } | null)?.method === 'sampled' ? 'checked-sampled' : 'checked-exact';
}

