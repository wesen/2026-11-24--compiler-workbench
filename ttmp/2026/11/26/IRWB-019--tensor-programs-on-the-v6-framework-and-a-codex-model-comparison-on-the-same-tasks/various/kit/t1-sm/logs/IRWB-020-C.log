/**
 * IRWB-001 E5: differential checkers as v6 invariants.
 *
 * Compiler Workbench checks meaning by running two artifacts on the same generated inputs and comparing results,
 * traps and memory. v6 knows only exact checkers. `differential()` packages the sampled method as an ordinary
 * `InvariantDefinition`, so a transformation contract can `ensure` it like any other invariant. Its evidence records
 * the method (`sampled`), the case count and seed, how many cases agreed, disagreed or were inconclusive, and the
 * first counterexamples. Inconclusive cases (for example a step limit hit by either side) are counted and never
 * treated as a verdict; a check with no decided case fails, because it has established nothing.
 */
import { defineInvariant } from './definitions.js';
import type { CheckResult, InvariantDefinition, PortValue, PortValues, Ports } from './types.js';

/** A small deterministic generator (mulberry32), so a reported counterexample can be run again from its seed. */
export function seededRandom(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

export interface CaseComparison {
  readonly ok: boolean;
  readonly reason?: string;
}

export interface DifferentialSpec<P extends Ports, Case, Outcome> {
  readonly id: string;
  readonly version: string;
  readonly description: string;
  readonly inputs: P;
  /** The port whose behaviour defines the expected meaning (e.g. `origin`, r0). */
  readonly baseline: keyof P & string;
  /** The port being checked against it (e.g. `candidate`). */
  readonly subject: keyof P & string;
  readonly count: number;
  readonly seed?: number;
  /** The generator to seed (default `seededRandom`, mulberry32); a port may supply its tool's own generator. */
  readonly random?: (seed: number) => () => number;
  /** Generate the cases, deterministically from `random` and the inputs. */
  cases(inputs: PortValues<P>, random: () => number, count: number): readonly Case[];
  /** Run one side on one case. `side` names which port `value` came from. */
  run(side: 'baseline' | 'subject', value: PortValue<P[keyof P]>, kase: Case, inputs: PortValues<P>): Outcome;
  compare(baseline: Outcome, subject: Outcome, kase: Case): CaseComparison | boolean;
  inconclusive?(outcome: Outcome): boolean;
  describeCase?(kase: Case): unknown;
  readonly maxCounterexamples?: number;
  /**
   * IRWB-004 D1: a key such that the cases, and the baseline's outcome on each, are a function of this spec (its id,
   * version, seed and count) and the key alone; for a check against a fixed origin, the origin's revision. With a
   * key, both are computed once per key and reused by every later check.
   */
  readonly baselineKey?: (inputs: PortValues<P>) => string | undefined;
  /**
   * IRWB-004 D1: a key such that the subject's outcome on a case is a function of the case and the key alone (for a
   * program, a hash of the code the case can reach). Used only together with `baselineKey`: a decided verdict is
   * kept under (baseline key, case index, subject key) and replayed instead of evaluating the case again.
   */
  readonly subjectKey?: (subject: PortValue<P[keyof P]>, kase: Case, inputs: PortValues<P>) => string | undefined;
  /**
   * IRWB-004 F4: decide the cases at the indices `todo` elsewhere (e.g. on worker threads), returning one verdict
   * per index, in the order of `todo`, exactly as `run`, `inconclusive` and `compare` would decide them; or
   * `undefined` to decide them here. The check's evidence is assembled in case order, whoever decided a case.
   */
  readonly decide?: (
    inputs: PortValues<P>,
    cases: readonly Case[],
    todo: readonly number[],
  ) => Promise<readonly Decided[]> | undefined;
}

/** One decided case: what `compare` (or `inconclusive`) concluded. */
export type Decided =
  | { readonly v: 'agree' }
  | { readonly v: 'inconclusive' }
  | { readonly v: 'disagree'; readonly reason: string };

export interface DifferentialEvidence {
  readonly method: 'sampled';
  readonly invariant: string;
  readonly seed: number;
  readonly total: number;
  readonly agree: number;
  readonly disagree: number;
  readonly inconclusive: number;
  readonly status: 'agree' | 'disagree' | 'inconclusive';
  readonly counterexamples: readonly { readonly case: unknown; readonly reason: string }[];
}

export type DifferentialInvariant<P extends Ports> = InvariantDefinition<P> & {
  readonly method: 'sampled';
};

export function differential<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
): DifferentialInvariant<P> {
  if (!(spec.count > 0 && Number.isInteger(spec.count)))
    throw new Error('Differential check needs a positive case count');
  if (!(spec.baseline in spec.inputs) || !(spec.subject in spec.inputs) || spec.baseline === spec.subject)
    throw new Error('Differential check needs distinct baseline and subject ports');
  const seed = spec.seed ?? 1,
    maxCx = spec.maxCounterexamples ?? 5;
  const result = (evidence: DifferentialEvidence): CheckResult => ({
    ok: evidence.status === 'agree',
    reason:
      evidence.status === 'agree'
        ? `${evidence.agree}/${evidence.total} sampled cases agree (${evidence.inconclusive} inconclusive)`
        : evidence.status === 'disagree'
          ? `${evidence.disagree}/${evidence.total} sampled cases disagree`
          : `no decided case among ${evidence.total} (all inconclusive)`,
    evidence,
  });
  const inv = defineInvariant<P>({
    id: spec.id,
    version: spec.version,
    description: spec.description,
    inputs: spec.inputs,
    check(_ctx, inputs): CheckResult | Promise<CheckResult> {
      if (spec.decide) return runDifferentialAsync(spec, inputs, seed, maxCx).then(result);
      return result(runDifferential(spec, inputs, seed, maxCx));
    },
  });
  const out = Object.assign(Object.create(null), inv, { method: 'sampled' as const }) as DifferentialInvariant<P>;
  SPECS.set(out, spec as DifferentialSpec<any, any, any>);
  return out;
}

const SPECS = new WeakMap<object, DifferentialSpec<any, any, any>>();
/** IRWB-004 F4: the specification a differential invariant was made from (a worker decides cases with it). */
export function differentialSpec<P extends Ports>(inv: DifferentialInvariant<P>): DifferentialSpec<P, any, any> {
  const spec = SPECS.get(inv);
  if (!spec) throw new Error(`${inv.id} is not a differential invariant of this realm`);
  return spec;
}

/**
 * IRWB-004 D1: what a check against a baseline key keeps. The cases and the baseline's outcomes (computed as cases
 * are first evaluated) are fixed by the key; `verdicts` maps `index \0 subject key` to the decided verdict. A few
 * keys are kept, least recently used first out.
 */
interface Reuse {
  readonly cases: readonly unknown[];
  readonly outcomes: unknown[];
  readonly verdicts: Map<string, Decided>;
}
const REUSE = new Map<string, Reuse>();
const REUSE_MAX = 4;
let reuseEnabled = true;
/** Turn the reuse of cases, baseline outcomes and verdicts on or off (tests and measurements compare both). */
export function setDifferentialReuse(enabled: boolean): void {
  reuseEnabled = enabled;
  if (!enabled) REUSE.clear();
}
/** Counts since the last reset: sides run here, verdicts replayed from the memo, cases decided by `decide`. */
const STATS = { baselineRuns: 0, subjectRuns: 0, replayed: 0, delegated: 0 };
export function differentialStats(reset = false): Readonly<typeof STATS> {
  const out = { ...STATS };
  if (reset) for (const k of Object.keys(STATS) as (keyof typeof STATS)[]) STATS[k] = 0;
  return out;
}

function prepare<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  seed: number,
): { cases: readonly Case[]; reuse?: Reuse } {
  const bk = reuseEnabled ? spec.baselineKey?.(inputs) : undefined;
  if (bk === undefined) return { cases: spec.cases(inputs, (spec.random ?? seededRandom)(seed), spec.count) };
  const key = `${spec.id}@${spec.version}#${seed}#${spec.count}#${bk}`;
  let reuse = REUSE.get(key);
  if (reuse) REUSE.delete(key);
  else
    reuse = {
      cases: spec.cases(inputs, (spec.random ?? seededRandom)(seed), spec.count),
      outcomes: [],
      verdicts: new Map(),
    };
  REUSE.set(key, reuse);
  while (REUSE.size > REUSE_MAX) REUSE.delete(REUSE.keys().next().value!);
  return { cases: reuse.cases as readonly Case[], reuse };
}

const AGREE: Decided = Object.freeze({ v: 'agree' }),
  INCONCLUSIVE: Decided = Object.freeze({ v: 'inconclusive' });
/**
 * Decide one case: run both sides, then `inconclusive`, then `compare`, as a check always has. `outcomes`, when
 * given, keeps the baseline's outcome by case index (it is fixed by the baseline key); a worker deciding cases for a
 * check (IRWB-004 F4) calls this too, with its own `outcomes`.
 */
export function decideCase<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  kase: Case,
  index: number,
  outcomes?: unknown[],
): Decided {
  let a = outcomes?.[index] as Outcome | undefined;
  if (a === undefined) {
    a = spec.run('baseline', inputs[spec.baseline] as PortValue<P[keyof P]>, kase, inputs);
    STATS.baselineRuns++;
    if (outcomes) outcomes[index] = a;
  }
  STATS.subjectRuns++;
  const b = spec.run('subject', inputs[spec.subject] as PortValue<P[keyof P]>, kase, inputs);
  if (spec.inconclusive?.(a) || spec.inconclusive?.(b)) return INCONCLUSIVE;
  const c = spec.compare(a, b, kase);
  const verdict = typeof c === 'boolean' ? { ok: c } : c;
  return verdict.ok ? AGREE : Object.freeze({ v: 'disagree', reason: verdict.reason ?? 'outcomes differ' });
}

/** The evidence of decided cases, counted in case order (so counterexamples come in case order). */
function tally<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  seed: number,
  cases: readonly Case[],
  verdicts: readonly Decided[],
  maxCounterexamples: number,
): DifferentialEvidence {
  let agree = 0,
    disagree = 0,
    inconclusive = 0;
  const counterexamples: { case: unknown; reason: string }[] = [];
  for (let i = 0; i < cases.length; i++) {
    const d = verdicts[i];
    if (d.v === 'inconclusive') inconclusive++;
    else if (d.v === 'agree') agree++;
    else {
      disagree++;
      if (counterexamples.length < maxCounterexamples)
        counterexamples.push({
          case: spec.describeCase ? spec.describeCase(cases[i]) : cases[i],
          reason: d.reason,
        });
    }
  }
  return {
    method: 'sampled',
    invariant: spec.id,
    seed,
    total: cases.length,
    agree,
    disagree,
    inconclusive,
    status: disagree ? 'disagree' : agree ? 'agree' : 'inconclusive',
    counterexamples,
  };
}

/** The memo keys of the cases (undefined where a case has no subject key or nothing is reused). */
function memoKeys<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  cases: readonly Case[],
  reuse: Reuse | undefined,
): (string | undefined)[] {
  if (!reuse || !spec.subjectKey) return new Array(cases.length).fill(undefined);
  const subject = inputs[spec.subject] as PortValue<P[keyof P]>;
  return cases.map((c, i) => {
    const sk = spec.subjectKey!(subject, c, inputs);
    return sk === undefined ? undefined : `${i}\u0000${sk}`;
  });
}

/**
 * Run a differential specification directly (tools, the workbench's Checks view) without a manager. IRWB-004: with
 * `baselineKey`, the cases and baseline outcomes are kept and reused; with `subjectKey` too, a case whose verdict is
 * known for its subject key is not evaluated again. The evidence is the same either way.
 */
export function runDifferential<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  seed = spec.seed ?? 1,
  maxCounterexamples = spec.maxCounterexamples ?? 5,
): DifferentialEvidence {
  const { cases, reuse } = prepare(spec, inputs, seed);
  const keys = memoKeys(spec, inputs, cases, reuse);
  const verdicts: Decided[] = new Array(cases.length);
  for (let i = 0; i < cases.length; i++) {
    const known = keys[i] === undefined ? undefined : reuse!.verdicts.get(keys[i]!);
    if (known) {
      verdicts[i] = known;
      STATS.replayed++;
      continue;
    }
    verdicts[i] = decideCase(spec, inputs, cases[i], i, reuse?.outcomes);
    if (keys[i] !== undefined) reuse!.verdicts.set(keys[i]!, verdicts[i]);
  }
  return tally(spec, seed, cases, verdicts, maxCounterexamples);
}

/** `runDifferential`, with the cases nobody decided yet handed to `spec.decide` (IRWB-004 F4). */
export async function runDifferentialAsync<P extends Ports, Case, Outcome>(
  spec: DifferentialSpec<P, Case, Outcome>,
  inputs: PortValues<P>,
  seed = spec.seed ?? 1,
  maxCounterexamples = spec.maxCounterexamples ?? 5,
): Promise<DifferentialEvidence> {
  const { cases, reuse } = prepare(spec, inputs, seed);
  const keys = memoKeys(spec, inputs, cases, reuse);
  const verdicts: Decided[] = new Array(cases.length);
  const todo: number[] = [];
  for (let i = 0; i < cases.length; i++) {
    const known = keys[i] === undefined ? undefined : reuse!.verdicts.get(keys[i]!);
    if (known) {
      verdicts[i] = known;
      STATS.replayed++;
    } else todo.push(i);
  }
  const elsewhere = todo.length ? spec.decide?.(inputs, cases, todo) : undefined;
  if (elsewhere) {
    const decided = await elsewhere;
    if (decided.length !== todo.length) throw new Error(`${spec.id}: decide returned ${decided.length} of ${todo.length}`);
    todo.forEach((i, k) => (verdicts[i] = decided[k]));
    STATS.delegated += todo.length;
  } else for (const i of todo) verdicts[i] = decideCase(spec, inputs, cases[i], i, reuse?.outcomes);
  for (const i of todo) if (keys[i] !== undefined) reuse!.verdicts.set(keys[i]!, verdicts[i]);
  return tally(spec, seed, cases, verdicts, maxCounterexamples);
}

/** The assurance a check's evidence supports: sampled differential testing is weaker than an exact checker. */
export function assuranceOf(evidence: unknown): 'checked-sampled' | 'checked-exact' {
  return (evidence as { method?: string } | null)?.method === 'sampled' ? 'checked-sampled' : 'checked-exact';
}
import {
  canonical,
  fingerprint,
  immutable,
  isCanonical,
  revisionOf,
  sameCanonical,
  validateOnce,
} from '../core/data.js';
import type { Artifact } from '../core/types.js';
import type { AdapterDescriptor, Capability, IRAdapter, IREntity, IRGraph, IRRelation } from './types.js';
import { compareText, IRError, requireRecord, requireText, synchronous, syncFunction } from './common.js';
const categories = new Set(['containment', 'dependency', 'binding', 'adjacency', 'provenance', 'control']);
const captured = new WeakSet<object>();
const requiredFunctions = ['entities', 'resolve', 'relations', 'describe'] as const;
const optionalFunctions = [
  'roots',
  'validate',
  'rebuild',
  'operation',
  'serialize',
  'deserialize',
  'visualize',
] as const;
/** Snapshot metadata and callable identities; native storage is never converted in place. */
export function defineAdapter<T>(definition: IRAdapter<T>): IRAdapter<T> {
  if (captured.has(definition)) return definition;
  if (!definition || typeof definition !== 'object')
    throw new IRError('ir.adapter', 'Expected an adapter definition');
  const prototype = Object.getPrototypeOf(definition);
  if (prototype !== Object.prototype && prototype !== null)
    throw new IRError(
      'ir.adapter',
      'Adapter definitions must be plain records with own callback properties; wrap class methods explicitly',
    );
  for (const key of Reflect.ownKeys(definition)) {
    if (typeof key !== 'string' || !('value' in Object.getOwnPropertyDescriptor(definition, key)!))
      throw new IRError('ir.adapter', 'Adapter definitions require own data properties');
  }
  for (const key of ['id', 'version', 'kind', 'schemaVersion', 'description'] as const)
    requireText(definition[key], `Adapter ${key}`);
  requireRecord(definition.relationKinds, 'Adapter relation kinds');
  for (const [name, category] of Object.entries(definition.relationKinds)) {
    requireText(name, 'Relation name');
    if (!categories.has(category)) throw new IRError('ir.adapter', `Unknown relation category ${category}`);
  }
  for (const name of requiredFunctions)
    if (typeof definition[name] !== 'function') throw new IRError('ir.adapter', `Adapter requires ${name}`);
  for (const name of [...requiredFunctions, ...optionalFunctions]) {
    if (definition[name] !== undefined && typeof definition[name] !== 'function')
      throw new IRError('ir.adapter', `Adapter ${name} must be callable`);
    // Entity/relation enumerators may be synchronous generators.
    if (definition[name] && !['entities', 'relations'].includes(name))
      syncFunction(definition[name]!, `Adapter ${name}`);
  }
  if (definition.rebuild && !definition.validate)
    throw new IRError('ir.adapter', 'Rewritable adapters require a native value validator');
  if (Boolean(definition.serialize) !== Boolean(definition.deserialize))
    throw new IRError('ir.adapter', 'Serializable adapters require serialize and deserialize together');
  const result = Object.freeze({
    ...definition,
    relationKinds: immutable(definition.relationKinds),
  });
  captured.add(result);
  return result;
}
export function describeAdapter(adapter: IRAdapter<any>): AdapterDescriptor {
  const a = defineAdapter(adapter);
  const capabilities: Capability[] = ['Traversable', 'Queryable', 'Diffable'];
  if (a.rebuild) capabilities.push('Rewritable');
  if (a.validate) capabilities.push('Verifiable');
  if (a.serialize) capabilities.push('Serializable');
  if (a.visualize) capabilities.push('Visualizable');
  if (a.operation) capabilities.push('Operations');
  return immutable({
    id: a.id,
    version: a.version,
    kind: a.kind,
    schemaVersion: a.schemaVersion,
    description: a.description,
    relationKinds: a.relationKinds,
    capabilities,
  });
}
export class AdapterRegistry {
  #adapters = new Map<string, IRAdapter<any>>();
  register<T>(definition: IRAdapter<T>): IRAdapter<T> {
    const adapter = defineAdapter(definition),
      key = canonical([adapter.id, adapter.version]);
    const old = this.#adapters.get(key);
    if (old && old !== adapter) {
      const same =
        canonical(describeAdapter(old)) === canonical(describeAdapter(adapter)) &&
        [...requiredFunctions, ...optionalFunctions].every(k => old[k] === adapter[k]);
      if (!same)
        throw new IRError(
          'ir.adapter-version',
          `Adapter ${adapter.id}@${adapter.version} is already registered with another definition`,
        );
      return old;
    }
    this.#adapters.set(key, adapter);
    return adapter;
  }
  get<T = unknown>(id: string, version: string): IRAdapter<T> {
    const result = this.#adapters.get(canonical([id, version]));
    if (!result) throw new IRError('ir.adapter-missing', `Unknown adapter ${id}@${version}`);
    return result;
  }
  describe(): readonly AdapterDescriptor[] {
    return immutable(
      [...this.#adapters.values()]
        .map(describeAdapter)
        .sort((a, b) => compareText(a.id, b.id) || compareText(a.version, b.version)),
    );
  }
}
/**
 * Artifacts whose hashes this module computed or checked. An artifact is deep-frozen, so the relation between its
 * value and its hashes cannot change afterwards; checking it again would recompute the same SHA-256.
 */
const VERIFIED = new WeakSet<object>();
/**
 * Projections by adapter and canonical value. A captured adapter is frozen and a canonical value is deep-frozen;
 * projecting is a deterministic function of the two, and it already validated the graph and every resolve.
 */
const PROJECTED = new WeakMap<object, WeakMap<object, IRGraph>>();
export function createIRArtifact<T>(definition: IRAdapter<T>, id: string, value: T): Artifact<T> {
  const adapter = defineAdapter(definition);
  requireText(id, 'Artifact ID');
  const snapshot = immutable(value);
  if (adapter.validate)
    validateOnce(adapter.validate, snapshot, r => synchronous(r, 'Adapter validation'), adapter);
  const artifact = immutable({
    id,
    kind: adapter.kind,
    schemaVersion: adapter.schemaVersion,
    value: snapshot,
    contentHash: fingerprint(snapshot),
    revision: revisionOf(adapter.kind, adapter.schemaVersion, snapshot),
  });
  project(adapter, artifact.value);
  VERIFIED.add(artifact);
  return artifact;
}
export function validateIRArtifact<T>(definition: IRAdapter<T>, artifact: Artifact<T>): Artifact<T> {
  const adapter = defineAdapter(definition),
    snapshot = immutable(artifact);
  requireText(snapshot.id, 'Artifact ID');
  if (snapshot.kind !== adapter.kind || snapshot.schemaVersion !== adapter.schemaVersion)
    throw new IRError('ir.kind', `Adapter ${adapter.id} requires ${adapter.kind}@${adapter.schemaVersion}`);
  if (
    !VERIFIED.has(snapshot) &&
    (snapshot.contentHash !== fingerprint(snapshot.value) ||
      snapshot.revision !== revisionOf(snapshot.kind, snapshot.schemaVersion, snapshot.value))
  )
    throw new IRError('ir.revision', 'Artifact content/revision hash does not match its value');
  VERIFIED.add(snapshot);
  if (adapter.validate)
    validateOnce(adapter.validate, snapshot.value, r => synchronous(r, 'Adapter validation'), adapter);
  return snapshot;
}
export function validateEntity(entity: IREntity): IREntity {
  const e = immutable(entity);
  requireText(e.id, 'Entity ID');
  requireText(e.kind, 'Entity kind');
  requireRecord(e.attributes, 'Entity attributes');
  if (Object.keys(e).some(k => !['id', 'kind', 'attributes'].includes(k)))
    throw new IRError('ir.entity', 'Entity projection permits only id, kind and attributes');
  return e;
}
/**
 * IRWB-004: frozen entities `validateEntity` accepted, and, per captured adapter, frozen relations whose own fields
 * were checked against its relation kinds. Both checks are functions of the frozen object (and the frozen adapter),
 * so a projection that shares most of them with the previous revision checks only the new ones. What depends on the
 * whole graph (dangling ends, duplicate ids, roots) is checked every time.
 */
const VALID_ENTITIES = new WeakSet<object>();
const VALID_RELATIONS = new WeakMap<object, WeakSet<object>>();
export function validateGraph(adapter: IRAdapter<any>, input: IRGraph): IRGraph {
  const graph = immutable(input);
  if (!Array.isArray(graph.entities) || !Array.isArray(graph.relations) || !Array.isArray(graph.roots))
    throw new IRError('ir.graph', 'Expected entities, relations and roots arrays');
  const entities = new Set<string>(),
    relations = new Set<string>();
  for (const e of graph.entities) {
    if (!VALID_ENTITIES.has(e)) {
      validateEntity(e);
      VALID_ENTITIES.add(e); // `graph` is canonical, so `e` is frozen
    }
    if (entities.has(e.id)) throw new IRError('ir.entity', `Duplicate entity ${e.id}`);
    entities.add(e.id);
  }
  let shaped = captured.has(adapter) ? VALID_RELATIONS.get(adapter) : undefined;
  if (!shaped && captured.has(adapter)) VALID_RELATIONS.set(adapter, (shaped = new WeakSet()));
  for (const r of graph.relations) {
    const known = !!shaped?.has(r);
    if (!known) {
      requireText(r.id, 'Relation ID');
      requireText(r.kind, 'Relation kind');
      if (!Object.hasOwn(adapter.relationKinds, r.kind) || adapter.relationKinds[r.kind] !== r.category)
        throw new IRError('ir.relation', `Undeclared or mistyped relation ${r.kind}`);
    }
    if (!entities.has(r.from) || !entities.has(r.to))
      throw new IRError('ir.relation', `Dangling relation ${r.id}: ${r.from} -> ${r.to}`);
    if (relations.has(r.id)) throw new IRError('ir.relation', `Duplicate relation ${r.id}`);
    if (!known) {
      if (r.order !== undefined && (!Number.isSafeInteger(r.order) || r.order < 0))
        throw new IRError('ir.relation', `Invalid order on ${r.id}`);
      if (r.attributes !== undefined) requireRecord(r.attributes, 'Relation attributes');
      if (
        Object.keys(r).some(k => !['id', 'kind', 'category', 'from', 'to', 'order', 'attributes'].includes(k))
      )
        throw new IRError('ir.relation', `Unknown relation field on ${r.id}`);
      shaped?.add(r);
    }
    relations.add(r.id);
  }
  if (new Set(graph.roots).size !== graph.roots.length || graph.roots.some(r => !entities.has(r)))
    throw new IRError('ir.roots', 'Roots must be unique existing entity IDs');
  return immutable({
    entities: [...graph.entities].sort((a, b) => compareText(a.id, b.id)),
    relations: [...graph.relations].sort(compareRelations),
    roots: graph.roots,
  });
}
export function compareRelations(a: IRRelation, b: IRRelation): number {
  return (
    compareText(a.from, b.from) ||
    compareText(a.kind, b.kind) ||
    (a.order ?? 0) - (b.order ?? 0) ||
    compareText(a.id, b.id)
  );
}
export function project<T>(adapter: IRAdapter<T>, value: T): IRGraph {
  const cacheable = isCanonical(value) && captured.has(adapter);
  const cached = cacheable ? PROJECTED.get(adapter)?.get(value as object) : undefined;
  if (cached) return cached;
  const graph = projectUncached(adapter, value);
  if (cacheable) {
    let m = PROJECTED.get(adapter);
    if (!m) PROJECTED.set(adapter, (m = new WeakMap()));
    m.set(value as object, graph);
  }
  return graph;
}
function projectUncached<T>(adapter: IRAdapter<T>, value: T): IRGraph {
  const entities = [...synchronous(adapter.entities(value), 'Entity enumeration')];
  const relations = [...synchronous(adapter.relations(value), 'Relation enumeration')];
  const incoming = new Set(relations.filter(r => r.category === 'containment').map(r => r.to));
  const roots = adapter.roots
    ? synchronous(adapter.roots(value), 'Root enumeration')
    : entities
        .filter(e => !incoming.has(e.id))
        .map(e => e.id)
        .sort(compareText);
  const graph = validateGraph(adapter, {
    entities,
    relations,
    roots,
  });
  for (const entity of graph.entities) {
    const resolved = synchronous(adapter.resolve(value, entity.id), 'Entity resolution');
    if (!resolved || !sameCanonical(validateEntity(resolved), entity))
      throw new IRError('ir.resolve', `Adapter resolve disagrees with enumeration for ${entity.id}`);
  }
  return graph;
}
export function deserializeIR<T>(adapter: IRAdapter<T>, id: string, text: string): Artifact<T> {
  const a = defineAdapter(adapter);
  if (!a.deserialize) throw new IRError('ir.capability', `Adapter ${a.id} is not Serializable`);
  return createIRArtifact(a, id, synchronous(a.deserialize(text), 'IR deserialization'));
}

