  const program = compileTix("'`
    fn shadow(x:f32[N,K], z:f32[N,L]):f32[N] { y[i] = sum(j) x[i,j] + sum(j) z[i,j]; return y; }
    fn empty(x:f32[N,K]):f32[N,2] { 
