    const start = performance.now();
    result = runTix(program, name, inputs);
    ms = performance.now() - start;
  } else {
    [result] = await runCudaBatch(cudaSource(program, name), fn, [inputs], { benchmark: true });
    ms = result.gpuMs;
  }
