from pathlib import Path
import json
p=Path('ttmp/2026/11/26/IRWB-022-I--lowering-tix-to-cuda-with-checked-execution-on-the-gpu-machine/reference/02-cuda-lowering-verification-and-corpus-timings.md')
cpu = {}
for source in ('short', 'conv', 'mlp', ''):
    f = Path('/tmp/irwb-022-i-bench-cpu' + ('-' + source if source else '') + '.jsonl')
    if f.exists():
        for line in f.read_text().splitlines():
            row = json.loads(line)
            cpu[row['name']] = row
gpu = [json.loads(line) for line in Path('/tmp/irwb-022-i-bench-gpu.jsonl').read_text().splitlines()]
lines = ['## Results', '', '| Program | Output shape | Interpreter wall ms | GB10 kernel ms | f32 output bytes |',
         '| --- | --- | ---: | ---: | --- |']
for row in gpu:
    name = row['name']
    shape = ' × '.join(map(str, row['shape']))
    baseline = cpu.get(name)
    elapsed = f\"{baseline['ms']:,.3f}\" if baseline else 'running'
    equal = 'equal' if baseline and baseline['outputSha256'] == row['outputSha256'] and baseline['shape'] == row['shape'] else 'pending'
    lines.append(f\"| {name} | {shape} | {elapsed} | {row['ms']:.6f} | {equal} |\")
s = p.read_text()
s = s.replace('## Method\\n', '\\n'.join(lines) + '\\n\\n## Method\\n')
p.write_text(s)
