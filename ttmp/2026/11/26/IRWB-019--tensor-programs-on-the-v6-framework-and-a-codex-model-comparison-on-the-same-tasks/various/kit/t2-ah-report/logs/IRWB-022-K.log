    `cd ~/${job}`,
    `cache=~/${remote}`,
    `compiled=0; c0=$(date +%s%N)`,
    `exec 9>"$cache/compile.lock"; flock 9`,
    `if [ ! -x "$cache/prog" ]; then ${q(nvcc)} -O3 -arch=${q(arch)} -o prog main.cu || exit 97; mv prog "$cache/prog"; compiled=1; fi`,
    `ln "$cache/prog" prog; flock -u 9; exec 9>&-`,
    `c1=$(date +%s%N); mkdir -p out; set +e`,
    `r0=$(date +%s%N); ${lock} ./prog ${progArgs.map(q).join(' ')}; status=$?; r1=$(date +%s%N)`,
