#include <cuda_runtime.h>
#include <cmath>
#include <cstdio>

// Isolated numerical experiment. All inputs are exactly representable in f32.
constexpr int count = 32769;
constexpr int columns = 6;

__global__ void probe(float *out) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i >= count) return;
  float x = (i - 16384) / 4096.0f;
  float p = __fadd_rn(fabsf(x), 0.125f);
  float *row = out + i * columns;
  row[0] = expf(x);
  row[1] = logf(p);
  row[2] = __fsqrt_rn(p);
  row[3] = tanhf(x);
  float acc = 0;
  for (int j = 0; j < 7; ++j) {
    float w = __fdiv_rn(float(j - 2), 7.0f);
    acc = __fadd_rn(acc, __fmul_rn(x, w));
  }
  row[4] = acc;
  row[5] = __fdiv_rn(__fsub_rn(x, p), p);
}

#define CUDA(call) do { auto err = (call); if (err != cudaSuccess) { \
  fprintf(stderr, "%s: %s\n", #call, cudaGetErrorString(err)); return 1; } } while (0)

int main() {
  cudaDeviceProp dev;
  CUDA(cudaGetDeviceProperties(&dev, 0));
  printf("%s sm_%d%d nvcc %d.%d.%d\n", dev.name, dev.major, dev.minor,
         __CUDACC_VER_MAJOR__, __CUDACC_VER_MINOR__, __CUDACC_VER_BUILD__);
  static float host[count * columns];
  float *data;
  CUDA(cudaMalloc(&data, sizeof(host)));
  cudaEvent_t begin, end;
  CUDA(cudaEventCreate(&begin));
  CUDA(cudaEventCreate(&end));
  CUDA(cudaEventRecord(begin));
  probe<<<(count + 127) / 128, 128>>>(data);
  CUDA(cudaGetLastError());
  CUDA(cudaEventRecord(end));
  CUDA(cudaEventSynchronize(end));
  float elapsed;
  CUDA(cudaEventElapsedTime(&elapsed, begin, end));
  CUDA(cudaMemcpy(host, data, sizeof(host), cudaMemcpyDeviceToHost));
  FILE *f = fopen("out/values.f32", "wb");
  if (!f || fwrite(host, sizeof(host), 1, f) != 1 || fclose(f)) return 2;
  return 0;
}
// Run from any directory after npm run build and the untimed GB10 probe.
import { readFileSync } from 'node:fs';
import { compileTix, runTix } from '../../../../../../dist/tensor/index.js';

const file = readFileSync(new URL('./01-gb10/out/values.f32', import.meta.url));
const n = 32769;
const ops = ['exp', 'log', 'sqrt', 'tanh', 'fold', 'div'];
if (file.length !== n * ops.length * 4) throw Error('Unexpected probe output length');
const tensor = (shape, f) => ({ shape, data: Float32Array.from({ length: shape[0] }, (_, i) => f(i)) });
const inputs = {
  x: tensor([n], i => (i - 16384) / 4096),
  w: tensor([7], j => j - 2),
};
const exprs = [
  'exp(x[i])', 'log(p[i])', 'sqrt(p[i])', 'tanh(x[i])',
  'sum(j) x[i] * (w[j] / 7)', '(x[i] - p[i]) / p[i]',
];
for (const [op, name] of ops.entries()) {
  const program = compileTix(`fn f(x:f32[N],w:f32[K]):f32[N]{
    p[i] = max(x[i],-x[i]) + 0.125;
    y[i] = ${exprs[op]};
    return y;}`);
  const f32 = runTix(program, 'f', inputs).data;
  const words = new Uint32Array(f32.buffer, f32.byteOffset, f32.length);
  const f64 = runTix(program, 'f', inputs, { precision: 'f64' }).data;
  let different = 0, first, maxError = 0, maxFraction = 0;
  for (let i = 0; i < n; i++) {
    const at = (i * ops.length + op) * 4;
    const gpu = file.readUInt32LE(at);
    if (words[i] !== gpu) {
      different++;
      first ??= { x: inputs.x.data[i], cpu: words[i].toString(16), gpu: gpu.toString(16) };
    }
    const error = Math.abs(file.readFloatLE(at) - f64[i]);
    if (!Number.isFinite(error)) throw Error('Nonfinite probe output');
    maxError = Math.max(maxError, error);
    maxFraction = Math.max(maxFraction, error / (2e-6 + 2e-5 * Math.abs(f64[i])));
  }
  console.log(JSON.stringify({ name, different, first, maxError, maxFraction }));
}
// Execute from the worktree root with cpu or gpu. Emit one JSON record per program.
import { readFileSync } from 'node:fs';
import { compileTix, runTix } from '../../../../../../dist/tensor/index.js';
import { seededRandom } from '../../../../../../dist/framework/contracts/index.js';
import { value } from '../../../../../../dist/tensor/model.js';

const dimensions = {
  matmul: { M: 512, K: 512, N: 512 },
  softmax: { N: 4096, C: 1024 },
  layernorm: { N: 4096, D: 1024 },
  attention: { Q: 1024, K: 1024, D: 64, V: 64 },
  mlp: { N: 1024, D: 256, H: 1024, O: 256 },
  conv2d: { N: 8, C: 16, H: 64, W: 64, O: 32 },
};
function inputsFor(fn, dims) {
  const random = seededRandom(20);
  return Object.fromEntries(
    fn.params.map(p => {
      const shape = p.shape.map(d => value(d, dims));
      const data = Float32Array.from({ length: shape.reduce((a, b) => a * b, 1) }, () =>
        p.name === 'eps' ? 1e-5 : 2 * random() - 1,
      );
      return [p.name, { shape, data }];
    }),
  );
}
for (const [name, sizes] of Object.entries(dimensions)) {
  const program = compileTix(readFileSync(`corpus/tensor/${name}/main.tix`, 'utf8'));
  const fn = program.current.value.functions[0];
  const inputs = inputsFor(fn, new Map(Object.entries(sizes)));
  if (process.argv[2] === 'cpu') {
    runTix(program, name, inputsFor(fn, new Map(Object.keys(sizes).map(n => [n, 4]))));
    const start = performance.now();
    const result = runTix(program, name, inputs, { precision: 'f32' });
    console.log(
      JSON.stringify({ name, shape: result.shape, cpuMs: performance.now() - start, first: result.data[0] }),
    );
  } else if (process.argv[2] === 'gpu') {
    const { cudaSource } = await import('../../../../../../dist/tensor/index.js');
    const { runCudaBatch } = await import('../../../../../../dist/tensor/cuda-run.js');
    const { results } = await runCudaBatch(cudaSource(program, name), fn, Array(4).fill(inputs), {
      timed: true,
    });
    const times = results.slice(1).map(r => r.gpuMs);
    console.log(
      JSON.stringify({
        name,
        shape: results[0].shape,
        warmupMs: results[0].gpuMs,
        times,
        gpuMs: times.toSorted((a, b) => a - b)[1],
        first: results[0].data[0],
      }),
    );
  } else throw Error('Use cpu or gpu');
}
