    33	    if (sampling && ++work > 1e6) throw new OutsideSample('Sample work limit');
    34	  }
    35	  for (const p of fn.params) {
    36	    const input = inputs[p.name];
    37	    p.shape.forEach((a, i) => {
    38	      const n = plain(a);
    39	      if (n) shapes.set(n, input.shape[i]);
    40	    });
    41	    tensors.set(p.name, { shape: input.shape, data: ArrayType.from(input.data) });
    42	  }
    43	  function loop(axes: Axis[], i: number, body: () => void) {
    44	    if (i === axes.length) {
    45	      body();
    46	      return;
    47	    }
    48	    const { id, extent } = axes[i],
    49	      dim = value(extent.dim, shapes);
