export function applyNativePassSync<S, N extends Needs, P>(
  pass: Pass<S, N, P>,
  input: Artifact<S>,
  check: (before: Artifact<S>, after: Artifact<S>) => CheckResult,
  params?: P,
): PassResult<S> {
