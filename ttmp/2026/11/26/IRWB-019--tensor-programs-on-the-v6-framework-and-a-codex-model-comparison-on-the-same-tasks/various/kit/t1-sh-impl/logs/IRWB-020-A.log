    throw new PassError(
      '"'contractRejected',
      "'`Pass ${pass.id} output rejected: ${contract.reason ?? '"'check failed'}"'`,
      contract.evidence,
    );
  return {
    ...prepared,
    pass: { id: pass.id, version: pass.version },
    changed: true,
    before,
    preserved: [],
    contract,
    report: produced.report,
  };
}

