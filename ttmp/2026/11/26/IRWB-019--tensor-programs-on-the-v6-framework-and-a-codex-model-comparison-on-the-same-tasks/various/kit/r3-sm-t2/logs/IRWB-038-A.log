    40	/** Basic blocks of machine code: a label or the instruction after a branch or terminal starts one. */
    41	export function machineBlocks(code: readonly MInsn[]): MachineBlock[] {
    42	  const blocks: MachineBlock[] = [],
    43	    at = new Map<string, number>();
    44	  let cur: MachineBlock | null = null;
    45	  code.forEach((m, i) => {
    46	    if (m.op === 'label' || !cur) {
    47	      cur = { start: i, end: i, labels: [], succ: [] };
    48	      blocks.push(cur);
    49	    }
    50	    if (m.op === 'label') {
    51	      cur.labels.push(m.name!);
    52	      at.set(m.name!, blocks.length - 1);
    53	    }
    54	    cur.end = i;
    55	    if (isBranch(m.op) || isTerminal(m.op)) cur = null;
    56	  });
    57	  blocks.forEach((b, k) => {
    58	    const last = code[b.end];
    59	    if (isBranch(last.op)) b.succ.push(at.get(last.target!)!);
    60	    if (last.op === 'j') b.succ.push(at.get(last.target!)!);
    61	    if (!isTerminal(last.op) && k + 1 < blocks.length) b.succ.push(k + 1);
    62	  });
    63	  return blocks;
    64	}
