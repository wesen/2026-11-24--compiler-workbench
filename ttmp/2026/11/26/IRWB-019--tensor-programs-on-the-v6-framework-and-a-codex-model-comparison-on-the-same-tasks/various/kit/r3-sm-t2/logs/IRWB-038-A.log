    85	export function intervals(code: readonly MInsn[]): Intervals {
    86	  const blocks = machineBlocks(code);
    87	  const use = blocks.map(() => new Set<number>()),
    88	    def = blocks.map(() => new Set<number>());
    89	  blocks.forEach((b, k) => {
    90	    for (let i = b.start; i <= b.end; i++) {
    91	      for (const r of usesOf(code[i])) if (!def[k].has(r)) use[k].add(r);
    92	      for (const r of defsOf(code[i])) def[k].add(r);
    93	    }
    94	  });
    95	  const IN = blocks.map(() => new Set<number>()),
    96	    OUT = blocks.map(() => new Set<number>());
    97	  for (let changed = true; changed; ) {
    98	    changed = false;
    99	    for (let k = blocks.length - 1; k >= 0; k--) {
   100	      const out = new Set<number>();
   101	      for (const s of blocks[k].succ) for (const r of IN[s]) out.add(r);
   102	      const inn = new Set(use[k]);
   103	      for (const r of out) if (!def[k].has(r)) inn.add(r);
   104	      if (inn.size !== IN[k].size || out.size !== OUT[k].size) {
   105	        IN[k] = inn;
   106	        OUT[k] = out;
   107	        changed = true;
   108	      }
   109	    }
   110	  }
   111	  const iv = new Map<number, Interval>();
   112	  const touch = (r: number, i: number) => {
   113	    const x = iv.get(r);
   114	    if (!x) iv.set(r, { reg: r, start: i, end: i, uses: 1, crossesCall: false });
   115	    else {
   116	      x.start = Math.min(x.start, i);
   117	      x.end = Math.max(x.end, i);
   118	      x.uses++;
   119	    }
   120	  };
   121	  blocks.forEach((b, k) => {
   122	    for (const r of IN[k]) touch(r, b.start);
   123	    for (const r of OUT[k]) touch(r, b.end + 0.5);
   124	    for (let i = b.start; i <= b.end; i++) {
   125	      for (const r of usesOf(code[i])) touch(r, i);
   126	      for (const r of defsOf(code[i])) touch(r, i);
   127	    }
   128	  });
