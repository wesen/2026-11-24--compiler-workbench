   209	/**
   210	 * One natural loop per header: the union of the bodies of the header's back edges (IRWB-034-G). A loop with a
   211	 * `continue`, or a dispatch loop whose every arm jumps back, has several back edges to one header; one loop per
   212	 * back edge gave them one id and bodies that exclude each other's latches, so a preheader made for one of them
   213	 * sat on the others' back edges and ran every iteration.
   214	 */
   215	export function loopsOf(st: Store, f: WorkFn): Loop[] {
   216	  const dom = domView(dominatorsOf(f)),
   217	    cfg = cfgOf(f),
   218	    latchesOf = new Map<string, string[]>();
   219	  for (const b of f.blocks)
   220	    for (const s of b.succ)
   221	      if (dom.dominates(s, b.id)) {
   222	        const latches = latchesOf.get(s) ?? [];
   223	        if (!latches.length) latchesOf.set(s, latches);
   224	        if (!latches.includes(b.id)) latches.push(b.id);
   225	      }
   226	  const out: Loop[] = [];
   227	  for (const [s, latches] of latchesOf) {
   228	    const body = new Set([s]),
   229	      work = [...latches];
   230	    while (work.length) {
   231	      const x = work.pop()!;
   232	      if (body.has(x)) continue;
   233	      body.add(x);
   234	      work.push(...cfg.preds[x]);
   235	    }
   236	    const outside = cfg.preds[s].filter(q => !body.has(q));
   237	    const pre = outside.length === 1 && cfg.succ[outside[0]].length === 1 ? outside[0] : null;
   238	    const exits = [...body].flatMap(x => cfg.succ[x].filter(y => !body.has(y)));
   239	    const assigned = new Set<number>();
   240	    for (const x of body)
   241	      for (const sid of (st.get(x) as BlockRec).stmts) {
   242	        const t = st.get(sid) as StmtRec;
   243	        if (t.op === 'set') assigned.add(t.local!);
   244	      }
   245	    out.push({
   246	      id: `loop:${f.name}@${s}`,
   247	      head: s,
   248	      latch: latches[0],
   249	      latches,
   250	      body: [...body],
   251	      preheader: pre,
   252	      exits: [...new Set(exits)],
   253	      assigned: [...assigned],
   254	    });
   255	  }
   256	  return out;
   257	}
