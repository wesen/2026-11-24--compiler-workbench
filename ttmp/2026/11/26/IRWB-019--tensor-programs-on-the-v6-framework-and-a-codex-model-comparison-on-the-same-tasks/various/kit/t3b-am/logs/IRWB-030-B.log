test('every corpus program is one kernel; the row programs run one block per row', () => {
  const expected = {
    matmul: [['thread', 2, 'y', 'y']],
    softmax: [['block', 1, 'm,e,s,y', 'y']],
    layernorm: [['block', 1, 'mean,centered,variance,y', 'y']],
    attention: [['block', 1, 'score,shift,e,z,weight,out', 'out']],
    mlp: [['block', 1, 'h,g,y', 'y']],
