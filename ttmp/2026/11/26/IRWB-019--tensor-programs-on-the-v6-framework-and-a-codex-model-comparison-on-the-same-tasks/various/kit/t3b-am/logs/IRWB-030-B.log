    a[n,c,y,w] = x[n,c,y,w] * 2;
    b[n,c,y,w]: f32[N,C,H-2,W-2] = a[n,c,y+1,w+1] + a[n,c,y+2,w+2] - a[n,c,y+0,w+0];
