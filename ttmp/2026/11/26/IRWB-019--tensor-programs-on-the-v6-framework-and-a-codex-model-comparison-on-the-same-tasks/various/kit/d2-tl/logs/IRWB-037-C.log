function regexMatch(pattern: buffer, text: buffer): i32 {
    const RANGE: i32 = 1;
    const SPLIT: i32 = 2;
    const ACCEPT: i32 = 3;
    const nfa = new Int32Array(45);

    // Each state occupies five words: kind, low, high, out, out2.
    let p = 0;
    let s = 0;
    while (p < pattern.length) {
        let low = pattern.charCodeAt(p);
        let high = low;
        if (low === 91) {
            low = pattern.charCodeAt(p + 1);
            high = pattern.charCodeAt(p + 3);
            p = p + 5;
        } else {
            p = p + 1;
        }

        let out = s + 1;
        if (p < pattern.length && pattern.charCodeAt(p) === 42) {
            const split = 5 * s;
            nfa[split] = SPLIT;
            nfa[split + 3] = s + 1;
            nfa[split + 4] = s + 2;
            out = s;
            s = s + 1;
            p = p + 1;
        }

        const range = 5 * s;
        nfa[range] = RANGE;
        nfa[range + 1] = low;
        nfa[range + 2] = high;
        nfa[range + 3] = out;
        s = s + 1;
    }

    const accept = s;
    nfa[5 * accept] = ACCEPT;
    const stateCount = accept + 1;
    const current = new Int32Array(9);
    const next = new Int32Array(9);
    const queue = new Int32Array(9);
    current[0] = 1;

    let i = 0;
    while (true) {
        // Mark successors before enqueueing so each state is queued once.
        let head = 0;
        let tail = 0;
        for (let state = 0; state < stateCount; state = state + 1) {
            if (current[state] === 1) {
                queue[tail] = state;
                tail = tail + 1;
            }
        }
        while (head < tail) {
            const row = 5 * queue[head];
            head = head + 1;
            if (nfa[row] === SPLIT) {
                const first = nfa[row + 3];
                const second = nfa[row + 4];
                if (current[first] === 0) {
                    current[first] = 1;
                    queue[tail] = first;
                    tail = tail + 1;
                }
                if (current[second] === 0) {
                    current[second] = 1;
                    queue[tail] = second;
                    tail = tail + 1;
                }
            }
        }

        if (i === text.length) {
            break;
        }
        const code = text.charCodeAt(i);
        for (let state = 0; state < stateCount; state = state + 1) {
            const row = 5 * state;
            if (current[state] === 1 && nfa[row] === RANGE) {
                if (inRange(code, nfa[row + 1], nfa[row + 2])) {
                    next[nfa[row + 3]] = 1;
                }
            }
        }
        for (let state = 0; state < stateCount; state = state + 1) {
            current[state] = next[state];
            next[state] = 0;
        }
        i = i + 1;
    }
    return current[accept];
}

function inRange(code: i32, low: i32, high: i32): bool {
    return code >= low && code <= high;
}
/**
 * simplify's algebraic identities as a rule table (IRWB-006, B1). The order inside each root operator is the order
 * of the return sites of the hand-written pass (handwritten.ts), which the compiled visitor tries first to last.
 * Every rule is an i32 identity; none holds for f32 (x + 0 is not x for x = -0; x * 0 is not 0 for NaN or ∞;
 * x - x is not 0 for ∞; !(a < b) is not a >= b for NaN), and the f32 operators have their own names, so no rule
 * has an f32 root operator.
 */
import { c, COMPARE_INVERSE, inversionNote, kv, op, rule, ruleSet, same, v } from './form.js';

const X = { x: 'i32' } as const;
const zeroRight = (o: 'or' | 'xor' | 'shl' | 'shr' | 'shru') =>
  rule(`${o}-zero`, X, op(o, v('x'), c(0)), v('x'));

export const SIMPLIFY_RULES = ruleSet(
  'simplify',
  'algebraic identities: x+0, x*1, x*2^k, x-x, !!x and inverted comparisons',
  [
    rule('add-zero', X, op('add', v('x'), c(0)), v('x')),
    rule('zero-add', X, op('add', c(0), v('x')), v('x')),
    rule('sub-zero', X, op('sub', v('x'), c(0)), v('x')),
    rule('sub-self', X, op('sub', v('x'), same('x')), c(0), {
      where: [{ pure: 'x' }],
      because: 'const-args',
      note: 'x - x',
    }),
    rule('mul-one', X, op('mul', v('x'), c(1)), v('x')),
    rule('one-mul', X, op('mul', c(1), v('x')), v('x')),
    rule('mul-zero', X, op('mul', v('x'), c(0)), c(0), {
      where: [{ pure: 'x' }],
      because: 'const-args',
      note: 'x * 0',
    }),
    rule('zero-mul', X, op('mul', c(0), v('x')), c(0), {
      where: [{ pure: 'x' }],
      because: 'const-args',
      note: '0 * x',
    }),
    rule(
      'mul-pow2',
      { x: 'i32', k: 'i32' },
      op('mul', v('x'), kv('k')),
      op('shl', v('x'), c({ log2: 'k' })),
      {
        where: [{ pow2: 'k' }],
        because: 'const-args',
        note: 'x * {k} = x << {log2 k}',
      },
    ),
    rule(
      'pow2-mul',
      { k: 'i32', x: 'i32' },
      op('mul', kv('k'), v('x')),
      op('shl', v('x'), c({ log2: 'k' })),
      {
        where: [{ pow2: 'k' }],
        because: 'const-args',
        note: '{k} * x = x << {log2 k}',
      },
    ),
    rule('div-one', X, op('div', v('x'), c(1)), v('x')),
    zeroRight('or'),
    zeroRight('xor'),
    zeroRight('shl'),
    zeroRight('shr'),
    zeroRight('shru'),
    rule('and-zero', X, op('and', v('x'), c(0)), c(0), {
      where: [{ pure: 'x' }],
      because: 'const-args',
      note: 'x & 0',
    }),
    rule('and-ones', X, op('and', v('x'), c(-1)), v('x')),
    ...COMPARE_INVERSE.map(([a, b]) =>
      rule(`not-${a}`, { a: 'i32', b: 'i32' }, op('eqz', op(a, v('a'), v('b'))), op(b, v('a'), v('b')), {
        note: inversionNote(a, b),
      }),
    ),
    rule('not-not', { x: 'bool' }, op('eqz', op('eqz', v('x'))), v('x'), { where: [{ boolean: 'x' }] }),
  ],
  { property: 'no rule has an f32 root operator (simplify leaves f32 operators alone)' },
);

