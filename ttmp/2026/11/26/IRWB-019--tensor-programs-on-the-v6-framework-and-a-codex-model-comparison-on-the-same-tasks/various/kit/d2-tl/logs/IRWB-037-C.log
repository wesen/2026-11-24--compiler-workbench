  /**
   * O2 followed by one subst: after O2's final dce and cfg, a copy such as `t3 = i` has a single reader and subst
   * removes it. Found by the ordering search (diary step 9): 11 of the 12 projects that beat O2 do so this way.
   * O2 itself stays as Compiler Workbench defines it, for parity with the book.
   */
  'O2+': [
    'cfg',
    'fold',
    'simplify',
    'constprop',
    'fold',
    'simplify',
    'dce',
    'cfg',
    'licm',
    'lvn',
    'strength',
      )
    );
  }
  /** Apply one pass as one revision; checked against r0 unless `check: false`. Nothing changes on rejection. */
  async apply(
    x: string | TypedPass,
    opts: { params?: Record<string, unknown>; check?: boolean; count?: number; seed?: number } = {},
  ): Promise<ApplyResult> {
    this.requireOk();
    const pass = this.resolvePass(x),
      t0 = now();
    const contract =
      opts.check === false
        ? undefined
        : optimizationContract({
            inputs: this.inputs,
            count: opts.count ?? 40,
            seed: opts.seed ?? 7,
            ...(this.options.entries ? { roots: this.options.entries } : {}),
          });
    const r = await applyPass(pass, this.head, {
      manager: this.manager,
      params: opts.params,
      contract,
      contractInputs: { origin: this.origin },
    });
    const ms = +(now() - t0).toFixed(2);
    if (!r.changed) return { pass: pass.typed.name, rev: `r${this.rev}`, edits: 0, changed: false, ms };
    const report = r.report as RevisionReport;
    this.revisions.push({
      rev: this.rev + 1,
      pass: pass.typed.name,
      artifact: r.artifact,
      edits: report.edits,
      correspondence: r.correspondence,
      ms,
      fns: report.fns,
      assumptions: JSON.parse(JSON.stringify(this.assumptions)),
    });
    const checks =
      (r.contract as { execution?: { checks?: { phase: string; evidence?: any }[] } } | undefined)?.execution
