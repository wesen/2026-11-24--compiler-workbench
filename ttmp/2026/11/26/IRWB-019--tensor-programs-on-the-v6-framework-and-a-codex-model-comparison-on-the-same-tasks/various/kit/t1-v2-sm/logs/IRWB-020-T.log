import assert from 'node:assert/strict';
const u = 2 ** -24;
const errorBound = r => 4 * u * Math.max(1, Math.abs(r));
const fold = (xs, round = Math.fround) => xs.reduce((a, x) => round(a + x), 0);
const run = (xs, drop = false) => fold(Array.from({length:(drop ? Math.floor : Math.ceil)(xs.length/2)}, (_,i) => fold(xs.slice(2*i, 2*i+2))));
const xs = Float32Array.of(1, 0, u, u, 0), ones = Float32Array.of(1, 1, 1, 1, 1);
assert.notEqual(fold(xs), run(xs));
assert.ok(Math.abs(run(xs) - fold(xs, Number)) <= errorBound(fold(xs, Number)));
assert.ok(Math.abs(run(ones, true) - fold(ones, Number)) > errorBound(fold(ones, Number)));
console.log({f32:fold(xs), split:run(xs), f64:fold(xs, Number), bound:errorBound(fold(xs, Number)), tailMutant:run(ones, true), tailBound:errorBound(5)});
EOF
