 * `typed.meaning-kept`: every function of `candidate` agrees with `origin` (normally r0) on `count` generated
 * cases per function. The case parameters are part of the definition (its version carries their hash), and one
 * definition object exists per parameter set, as the contract registry requires.
 */
export function meaningKept(
  params: MeaningParams = {},
): DifferentialInvariant<{ origin: typeof BlocksIR; candidate: typeof BlocksIR }> {
  const count = params.count ?? 40,
    seed = params.seed ?? 7,
    inputs = params.inputs ?? {},
    limit = params.limit ?? 2e4,
    roots = params.roots ? [...params.roots].sort() : null;
  const key = canonicalJson(roots ? { count, seed, inputs, limit, roots } : { count, seed, inputs, limit });
  let check = meaningChecks.get(key);
  if (!check) {
    check = differential<{ origin: typeof BlocksIR; candidate: typeof BlocksIR }, Case, RunResult>({
      id: 'typed.meaning-kept',
      version: `1+${hash(key)}`,
      description: `${roots ? `the entries ${roots.join(', ')} agree` : 'every function agrees'} with the origin on ${count} generated cases (seed ${seed})`,
      inputs: { origin: BlocksIR, candidate: BlocksIR },
      baseline: 'origin',
      subject: 'candidate',
      count,
      seed,
      random: rng,
      cases: ({ origin }) => {
        const st = storeOf(origin.value);
        return (roots ?? [...st.fns.keys()]).flatMap(fn => casesFrom(st, fn, { count, seed, inputs: inputs[fn] ?? {} }));
      },
      run: (_side, art, c) =>
        evaluate(storeOf((art as Artifact<TypedBlocks>).value), c.fn, c.args, c.memory, { limit }),
      inconclusive: r => r.limit,
      compare: (expected, got, c) =>
        agrees(expected, got)
          ? true
          : {
              ok: false,
              reason: `${c.fn}#${c.n}: expected ${String(outcome(expected))}, got ${String(outcome(got))}`,
            },
      describeCase: c => ({ fn: c.fn, n: c.n, args: c.args }),
      maxCounterexamples: 5,
      // IRWB-004 D1: the cases and the origin's outcomes are a function of the origin's value (and of the parameters,
      // which the version carries); a case's outcome on the candidate is a function of the case and the code the case
      // can reach (closureKey). See src/typed/parts.ts.
      baselineKey: ({ origin }) => `${origin.kind}@${origin.schemaVersion}:${origin.revision}`,
      subjectKey: (art, c) => closureKey((art as Artifact<TypedBlocks>).value, c.fn),
      // IRWB-004 F4: an installed executor (worker threads) decides the cases; without one, they are decided here
      decide: (ports, cases, todo) =>
        meaningExecutor()?.decide({ params, origin: ports.origin, candidate: ports.candidate, cases, todo }),
    });
    meaningChecks.set(key, check);
  }
  return check;
}
    ...d,
    category: 'effect',
  });
};
export const defineAnalysis = <S, R>(
  d: Omit<AnalysisDefinition<S, R>, 'category' | 'effects'> & {
    effects?: readonly EffectDefinition[];
  },
): AnalysisDefinition<S, R> => {
  portType(d.input, 'ir');
  portType(d.output, 'type');
  if (typeof d.run !== 'function') throw new Error('Analysis needs run');
  if (
    d.transfer &&
    (!nonempty(d.transfer.id) || !nonempty(d.transfer.version) || typeof d.transfer.verify !== 'function')
  )
    throw new Error('Analysis transfer needs exact rule identity and verifier');
  if (d.effects?.some(e => e.access === 'write')) throw new Error('Analyses cannot declare write effects');
  return base({
    ...d,
    effects: d.effects ?? [],
    category: 'analysis',
  });
};
export const defineProperty = <S>(d: Omit<PropertyDefinition<S>, 'category'>): PropertyDefinition<S> => {
  portType(d.subject, 'ir');
  if (!d.check || d.check.category !== 'analysis') throw new Error('Property needs an analysis checker');
  if (
    d.proofVerifier &&
    (d.proofVerifier.input.id !== d.subject.id || d.proofVerifier.input.version !== d.subject.version)
  )
    throw new Error('Proof verifier input must match property subject IR');
  if (d.subject.id !== d.check.input.id || d.subject.version !== d.check.input.version)
    throw new Error('Property checker input must match its subject IR');
  return base({
    ...d,
    category: 'property',
  });
};
export const defineInvariant = <P extends Ports>(
  d: Omit<InvariantDefinition<P>, 'category' | 'effects'> & {
    effects?: readonly EffectDefinition[];
  },
): InvariantDefinition<P> => {
  ports(d.inputs);
  if (typeof d.check !== 'function') throw new Error('Invariant needs a checker');
  if (d.effects?.some(e => e.access === 'write')) throw new Error('Invariants cannot declare write effects');
  return base({
    ...d,
    effects: d.effects ?? [],
    category: 'invariant',
  });
};
export const defineObjective = <S>(d: Omit<ObjectiveDefinition<S>, 'category'>): ObjectiveDefinition<S> => {
  if (!['min', 'max'].includes(d.direction)) throw new Error('Objective direction must be min/max');
  return base({
    ...d,
    category: 'objective',
  });
};
export function defineTransformation<I extends Ports, O extends Ports>(
  d: Omit<
    TransformationDefinition<I, O>,
    'category' | 'requires' | 'preserves' | 'ensures' | 'establishes' | 'effects' | 'cache' | 'correspondence'
  > &
    Partial<
      Pick<
        TransformationDefinition<I, O>,
        'requires' | 'preserves' | 'ensures' | 'establishes' | 'effects' | 'cache' | 'correspondence'
      >
    >,
