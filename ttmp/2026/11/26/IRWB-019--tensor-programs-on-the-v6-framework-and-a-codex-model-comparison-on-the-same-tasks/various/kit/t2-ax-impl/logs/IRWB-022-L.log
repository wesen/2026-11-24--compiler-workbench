diff --git a/src/tensor/cuda-contract.ts b/src/tensor/cuda-contract.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0f294313a129cae04627e844bafedd10d011a498
--- /dev/null
+++ b/src/tensor/cuda-contract.ts
@@ -0,0 +1,62 @@
+import { createHash } from 'node:crypto';
+import { AnalysisManager, defineTransformation, defineType, differential, type DifferentialEvidence } from '../framework/contracts/index.js';
+import { cases, compare, type Sample } from './contract.js';
+import { cudaSource, functionNamed } from './cuda-source.js';
+import { runBatch } from './cuda-run.js';
+import type { BufferValue } from './evaluate.js';
+import type { TixProgram } from './index.js';
+import { TixIR } from './ir.js';
+
+const text = defineType<string>({
+  id:'tensor.cuda.text',version:'1',description:'Function name or CUDA translation unit',
+  validate(value) { if (typeof value !== 'string') throw Error('Expected text'); },
+});
+const ports = { origin:TixIR, fn:text, source:text };
+const seed = 20;
+const meaning = differential<typeof ports, Sample, BufferValue>({
+  id:'tensor.cuda.meaning',version:'1', description:'Returned tensor agrees with the origin f64 evaluator',
+  inputs:ports, baseline:'origin', subject:'source', seed, count:15,
+  cases:({origin,fn},random) => {
+    const baseline = functionNamed(origin.value,fn);
+    return cases(baseline,baseline,'tolerance',random);
+  },
+  baselineKey:({origin,fn}) => JSON.stringify([origin.revision,fn,process.version]),
+  // Version 1 assumes the same GB10 installation, compiler flags, driver and wire format throughout this process.
+  subjectKey:(_subject,_sample,{source}) => createHash('sha256').update(source).digest('hex'),
+  run() { throw Error('CUDA evidence requires asynchronous batch execution'); },
+  compare:(a,b) => compare(a,b,'tolerance'),
+  describeCase:({fn,shapeValues,stream}) => ({fn,shapeValues,stream,seed}),
+  async decide({origin,fn,source},samples,todo) {
+    const batch = todo.map(id => ({id,inputs:samples[id].inputs}));
+    const results = await runBatch(source,functionNamed(origin.value,fn),batch,0,'manuel@bling');
+    return results.map((r,k) => {
+      const result = compare(samples[todo[k]].reference,r,'tolerance');
+      return result.ok ? {v:'agree'} : {v:'disagree',reason:result.reason!};
+    });
+  },
+});
+const lowering = defineTransformation({
+  id:'tensor.cuda.lower',version:'1',description:'Lower one Tix function to CUDA C',
+  inputs:{origin:TixIR,current:TixIR,fn:text},outputs:{source:text},
+  ensures:[{invariant:meaning,bindings:{
+    origin:{from:'inputs',port:'origin'}, fn:{from:'inputs',port:'fn'}, source:{from:'outputs',port:'source'}
+  }}],
+});
+
+interface Verdict { accepted:boolean; relation:'exact'|'tolerance'; reason?:string }
+export async function checkCandidate(program:TixProgram, fn:string, source:string):Promise<Verdict> {
+  const manager = new AnalysisManager();
+  try {
+    await manager.verifyTransformation({origin:program.origin,current:program.current,fn},{source},lowering);
+    return {accepted:true,relation:'tolerance'};
+  } catch (e) {
+    const check = manager.snapshot().executions[0]?.checks.find(c => !c.ok);
+    const evidence = check?.evidence as DifferentialEvidence | undefined;
+    const example = evidence?.counterexamples[0];
+    const reason = example ? JSON.stringify(example.case) + ': ' + example.reason : fn + ': ' + String(e);
+    return {accepted:false,relation:'tolerance',reason};
+  }
+}
+export function checkLowering(program:TixProgram, fn:string):Promise<Verdict> {
+  return checkCandidate(program,fn,cudaSource(program,fn));
+}
diff --git a/src/tensor/cuda-run.ts b/src/tensor/cuda-run.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9177b715830ebb6548ea6a66c27b39da563d4bac
--- /dev/null
+++ b/src/tensor/cuda-run.ts
@@ -0,0 +1,96 @@
+import { execFile } from 'node:child_process';
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { promisify } from 'node:util';
+import { size } from './evaluate.js';
+import { cudaSource, functionNamed } from './cuda-source.js';
+import type { TixProgram } from './index.js';
+import type { Fn } from './model.js';
+
+export type CudaInputs = Record<string, {shape:number[]; data:Float32Array}>;
+export interface CudaCase { id: number; inputs: CudaInputs }
+interface Output { shape: number[]; data: Float32Array; times: number[] }
+const tool = fileURLToPath(new URL('../../tools/cuda-remote.mjs', import.meta.url));
+const exec = promisify(execFile);
+const version = 1;
+
+function words(...values: number[]) {
+  const buffer = Buffer.alloc(4 * values.length);
+  values.forEach((v,i) => buffer.writeUInt32LE(v,4*i));
+  return buffer;
+}
+export function encodeCases(fn: Fn, cases: readonly CudaCase[], repeats: number): Buffer {
+  const chunks: Buffer[] = [words(version,cases.length,repeats)];
+  for (const {id,inputs} of cases) {
+    chunks.push(words(id));
+    for (const p of fn.params) {
+      const {shape,data} = inputs[p.name];
+      if (shape.length !== p.shape.length || size(shape) !== data.length) throw Error('Invalid tensor ' + p.name);
+      const dims = Buffer.alloc(8 * shape.length);
+      shape.forEach((n,i) => dims.writeBigUInt64LE(BigInt(n), 8*i));
+      chunks.push(dims, Buffer.from(data.buffer, data.byteOffset, data.byteLength));
+    }
+  }
+  return Buffer.concat(chunks);
+}
+export function decodeResults(bytes: Buffer, fn: Fn, cases: readonly CudaCase[], repeats: number): Output[] {
+  let pos = 0;
+  function u32() {
+    const n = bytes.readUInt32LE(pos);
+    pos += 4;
+    return n;
+  }
+  if (u32() !== version || u32() !== cases.length || u32() !== repeats) throw Error('Bad CUDA result header');
+  const results = cases.map(({id}) => {
+    if (u32() !== id || u32() !== fn.shape.length) throw Error('Unexpected CUDA result ID or rank');
+    const shape = fn.shape.map(() => {
+      const n = Number(bytes.readBigUInt64LE(pos));
+      pos += 8;
+      return n;
+    });
+    const times = Array.from({length:repeats},() => {
+      const ms = bytes.readFloatLE(pos);
+      pos += 4;
+      if (!Number.isFinite(ms) || ms < 0) throw Error('Invalid GPU time');
+      return ms;
+    });
+    const n = size(shape);
+    if (!Number.isSafeInteger(n) || pos + 4*n > bytes.length) throw Error('Incomplete CUDA result');
+    const data = new Float32Array(n);
+    new Uint8Array(data.buffer).set(bytes.subarray(pos,pos+4*n));
+    pos += 4*n;
+    return { shape,data,times };
+  });
+  if (pos !== bytes.length) throw Error('Extra CUDA result bytes');
+  return results;
+}
+
+export async function runBatch(source:string, fn:Fn, cases:readonly CudaCase[], repeats:0|1|3, host?:string) {
+  const payload = encodeCases(fn,cases,repeats);
+  const dir = await mkdtemp(join(tmpdir(),'tix-cuda-'));
+  try {
+    await writeFile(join(dir,'main.cu'),source);
+    await writeFile(join(dir,'cases.bin'),payload);
+    const args = [tool,dir];
+    if (host) args.push('--host',host);
+    if (repeats === 3) args.push('--timed');
+    let stdout: string;
+    try {
+      ({stdout} = await exec(process.execPath,args));
+    } catch (e) {
+      const error = e as Error & {stdout?:string};
+      throw Error(error.stdout?.trim() || error.message, {cause:e});
+    }
+    const receipt = JSON.parse(stdout);
+    if (receipt.exit !== 0 || !receipt.outputs.includes('results.bin')) throw Error('Missing CUDA output: ' + stdout);
+    return decodeResults(await readFile(join(dir,'out','results.bin')), fn,cases,repeats);
+  } finally {
+    await rm(dir,{recursive:true,force:true});
+  }
+}
+export async function runTixCuda(program:TixProgram, fn:string, inputs:CudaInputs, options?:{host?:string}) {
+  const [result] = await runBatch(cudaSource(program,fn),functionNamed(program.current.value,fn),[{id:0,inputs}],1,options?.host);
+  return {shape:result.shape,data:result.data,gpuMs:result.times[0]};
+}
diff --git a/src/tensor/cuda-runtime.ts b/src/tensor/cuda-runtime.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f181792e9f495179b4d8df409613f22e50f130f2
--- /dev/null
+++ b/src/tensor/cuda-runtime.ts
@@ -0,0 +1,124 @@
+// Host and device helpers included in each standalone translation unit.
+export const cudaRuntime = String.raw`#include <cuda_runtime.h>
+#include <math_constants.h>
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <fstream>
+#include <stdexcept>
+#include <vector>
+
+using Index = long long;
+using Shape = std::vector<uint64_t>;
+
+static void check(cudaError_t status) {
+  if (status != cudaSuccess) throw std::runtime_error(cudaGetErrorString(status));
+}
+
+template<class T> static T read(std::istream& in) {
+  T value;
+  in.read(reinterpret_cast<char*>(&value), sizeof(value));
+  return value;
+}
+template<class T> static void write(std::ostream& out, T value) {
+  out.write(reinterpret_cast<const char*>(&value), sizeof(value));
+}
+static Index elements(const Shape& shape) {
+  if (std::find(shape.begin(), shape.end(), 0) != shape.end()) return 0;
+  Index count = 1;
+  for (auto dim : shape) count *= dim;
+  return count;
+}
+
+struct Tensor {
+  Shape shape;
+  Index count = 0;
+  float* data = nullptr;
+
+  void allocate(Shape dims) {
+    shape = std::move(dims);
+    count = elements(shape);
+    if (count) check(cudaMalloc(&data, count * sizeof(float)));
+  }
+  void load(std::istream& in, unsigned rank) {
+    Shape dims(rank);
+    for (auto& dim : dims) dim = read<uint64_t>(in);
+    allocate(std::move(dims));
+    if (!count) return;
+    std::vector<float> host(count);
+    in.read(reinterpret_cast<char*>(host.data()), count * sizeof(float));
+    check(cudaMemcpy(data, host.data(), count * sizeof(float), cudaMemcpyHostToDevice));
+  }
+  void store(std::ostream& out, const std::vector<float>& times) const {
+    write(out, static_cast<uint32_t>(shape.size()));
+    for (auto dim : shape) write(out, dim);
+    for (auto ms : times) write(out, ms);
+    if (!count) return;
+    std::vector<float> host(count);
+    check(cudaMemcpy(host.data(), data, count * sizeof(float), cudaMemcpyDeviceToHost));
+    out.write(reinterpret_cast<const char*>(host.data()), count * sizeof(float));
+  }
+  ~Tensor() { if (data) cudaFree(data); }
+};
+
+__device__ float tixMax(float a, float b) {
+  if (isnan(a) || isnan(b)) return CUDART_NAN_F;
+  if (a == 0 && b == 0) return __uint_as_float(__float_as_uint(a) & __float_as_uint(b));
+  return a > b ? a : b;
+}
+__device__ float tixMin(float a, float b) {
+  if (isnan(a) || isnan(b)) return CUDART_NAN_F;
+  if (a == 0 && b == 0) return __uint_as_float(__float_as_uint(a) | __float_as_uint(b));
+  return a < b ? a : b;
+}
+
+// Enqueue one complete function before recording any event (initial loads and warm-up).
+template<class Launch> static std::vector<float> execute(Launch launch, uint32_t repeats, bool hasWork) {
+  std::vector<float> times(repeats, 0);
+  if (!hasWork) return times;
+  launch();
+  check(cudaGetLastError());
+  check(cudaDeviceSynchronize());
+  if (repeats) {
+    cudaEvent_t start, stop;
+    check(cudaEventCreate(&start));
+    check(cudaEventCreate(&stop));
+    for (float& ms : times) {
+      check(cudaEventRecord(start));
+      launch();
+      check(cudaEventRecord(stop));
+      check(cudaGetLastError());
+      check(cudaEventSynchronize(stop));
+      check(cudaEventElapsedTime(&ms, start, stop));
+    }
+    check(cudaEventDestroy(start));
+    check(cudaEventDestroy(stop));
+  }
+  return times;
+}
+`;
+
+export const cudaMain = String.raw`
+int main() {
+  try {
+    std::ifstream in("cases.bin", std::ios::binary);
+    std::ofstream out("out/results.bin", std::ios::binary);
+    in.exceptions(std::ios::failbit | std::ios::badbit);
+    out.exceptions(std::ios::failbit | std::ios::badbit);
+    auto version = read<uint32_t>(in), count = read<uint32_t>(in), repeats = read<uint32_t>(in);
+    if (version != 1) throw std::runtime_error("Unknown cases.bin version");
+    write(out, version);
+    write(out, count);
+    write(out, repeats);
+    for (uint32_t i = 0; i < count; ++i) {
+      write(out, read<uint32_t>(in));
+      runCase(in, out, repeats);
+    }
+    out.close();
+    return 0;
+  } catch (const std::exception& e) {
+    std::fprintf(stderr, "%s\n", e.what());
+    return 1;
+  }
+}
+`;
diff --git a/src/tensor/cuda-source.ts b/src/tensor/cuda-source.ts
new file mode 100644
index 0000000000000000000000000000000000000000..131dbe4801eb709c69907d5e9660b33d7ae7e47c
--- /dev/null
+++ b/src/tensor/cuda-source.ts
@@ -0,0 +1,144 @@
+import { cudaMain, cudaRuntime } from './cuda-runtime.js';
+import type { TixProgram } from './index.js';
+import { plain, width, type Affine, type Axis, type Expr, type Fn, type Module, type Op, type Statement } from './model.js';
+
+export function functionNamed(module: Module, name: string): Fn {
+  const fn = module.functions.find(f => f.name === name);
+  if (!fn) throw Error('Unknown function ' + name);
+  return fn;
+}
+
+type Names = Map<string, string>;
+function affine(a: Affine, names: Names): string {
+  const parts = [a.constant + 'LL', ...a.terms.map(([n,k]) => k + 'LL * ' + names.get(n)!)];
+  return '(' + parts.join(' + ') + ')';
+}
+function bound({extent}: Axis, dims: Names, indices: Names): string {
+  const dim = affine(extent.dim, dims);
+  if (extent.kind === 'dim') return dim;
+  if (extent.kind === 'blocks') {
+    const quotient = dim + ' / ' + width;
+    return extent.rounding === 'ceil' ? '(' + quotient + ' + (' + dim + ' % ' + width + ' != 0))' : quotient;
+  }
+  return `min(${width}LL, ${dim} - ${width}LL * ${indices.get(extent.block)})`;
+}
+
+const ops: Record<Exclude<Op,'neg'>,string> = {
+  '+':'__fadd_rn','-':'__fsub_rn','*':'__fmul_rn','/':'__fdiv_rn',
+  exp:'expf', log:'logf', sqrt:'__fsqrt_rn', tanh:'tanhf', max:'tixMax', min:'tixMin'
+};
+
+function kernel(stmt: Statement, id: number, tensors: Map<string,number>, shapes: Affine[][], dims: Names) {
+  const lines: string[] = [];
+  let depth = 1, temps = 0, binders = 0;
+  const line = (s: string) => lines.push('  '.repeat(depth) + s);
+  const indices: Names = new Map();
+  const bind = (axis: Axis) => {
+    const name = 'i' + binders++;
+    indices.set(axis.id,name);
+    return name;
+  };
+  function scalar(e: Expr): string {
+    const name = 'v' + temps++;
+    let rhs: string;
+    switch (e.kind) {
+      case 'literal': {
+        const bits = new Uint32Array(Float32Array.of(Number(e.text)).buffer)[0];
+        rhs = `__uint_as_float(0x${bits.toString(16)}u)`;
+        break;
+      }
+      case 'shape': rhs = `__ll2float_rn(${dims.get(e.name)})`; break;
+      case 'load': {
+        const t = tensors.get(e.name)!;
+        const offset = e.indices.map(a => affine(a,indices)).reduce((off,ix,j) =>
+          `(${off} * ${affine(shapes[t][j],dims)} + ${ix})`);
+        rhs = `a->tensor[${t}][${offset}]`;
+        break;
+      }
+      case 'op': {
+        const args = e.args.map(scalar);
+        rhs = e.op === 'neg' ? '-' + args[0] : ops[e.op] + '(' + args.join(', ') + ')';
+        break;
+      }
+      case 'reduce': {
+        line(`float ${name} = ${e.op === 'sum' ? '0.0f' : '-CUDART_INF_F'};`);
+        for (const axis of e.axes) {
+          const limit = bound(axis,dims,indices);
+          const i = bind(axis);
+          line(`for (Index ${i} = 0; ${i} < ${limit}; ++${i}) {`);
+          depth++;
+        }
+        const body = scalar(e.body);
+        line(`${name} = ${e.op === 'sum' ? '__fadd_rn' : 'tixMax'}(${name}, ${body});`);
+        for (const axis of e.axes) {
+          indices.delete(axis.id);
+          depth--;
+          line('}');
+        }
+        return name;
+      }
+    }
+    line(`const float ${name} = ${rhs};`);
+    return name;
+  }
+  line('const Index p = Index(blockIdx.x) * blockDim.x + threadIdx.x;');
+  line('if (p >= count) return;');
+  line('Index coordinate = p;');
+  for (let j=stmt.axes.length-1;j>=0;j--) {
+    const dim = affine(stmt.shape[j],dims);
+    const i = bind(stmt.axes[j]);
+    // No thread enters an empty output. Avoid emitting division by a literal zero.
+    line(`const Index ${i} = coordinate % max(1LL, ${dim});`);
+    line(`coordinate /= max(1LL, ${dim});`);
+  }
+  const result = scalar(stmt.expr);
+  line(`a->tensor[${tensors.get(stmt.name)}][p] = ${result};`);
+  return `__global__ void kernel${id}(const Args* a, Index count) {\n${lines.join('\n')}\n}\n`;
+}
+
+export function cudaSource(program: TixProgram, name: string): string {
+  const fn = functionNamed(program.current.value,name);
+  const all = [...fn.params,...fn.statements];
+  const tensors = new Map(all.map((t,i) => [t.name,i]));
+  const shapes = all.map(t => t.shape);
+  const dims: Names = new Map();
+  const setup: string[] = [];
+  for (const [i,p] of fn.params.entries()) {
+    setup.push(`t[${i}].load(in, ${p.shape.length});`);
+    p.shape.forEach((axis,j) => {
+      const n = plain(axis);
+      if (n && !dims.has(n)) {
+        const binding = `a->dim[${dims.size}]`;
+        dims.set(n,binding);
+        setup.push(`${binding} = t[${i}].shape[${j}];`);
+      }
+    });
+  }
+  const launches: string[] = [];
+  for (const [k,s] of fn.statements.entries()) {
+    const id = tensors.get(s.name)!;
+    const shape = s.shape.map(a => `uint64_t(${affine(a,dims)})`).join(', ');
+    setup.push(`t[${id}].allocate({${shape}});`, `hasWork |= t[${id}].count != 0;`);
+    launches.push(`if (t[${id}].count) kernel${k}<<<(t[${id}].count + 127) / 128, 128>>>(device, t[${id}].count);`);
+  }
+  return `${cudaRuntime}
+struct Args { Index dim[${Math.max(1,dims.size)}]; float* tensor[${all.length}]; };
+${fn.statements.map((s,i) => kernel(s,i,tensors,shapes,dims)).join('\n')}
+static void runCase(std::istream& in, std::ostream& out, uint32_t repeats) {
+  Tensor t[${all.length}];
+  Args args{}, *a = &args, *device = nullptr;
+  bool hasWork = false;
+  ${setup.join('\n  ')}
+  if (hasWork) {
+    for (size_t i = 0; i < ${all.length}; ++i) a->tensor[i] = t[i].data;
+    check(cudaMalloc(&device, sizeof(args)));
+    check(cudaMemcpy(device, a, sizeof(args), cudaMemcpyHostToDevice));
+  }
+  auto times = execute([&]() {
+    ${launches.join('\n    ')}
+  }, repeats, hasWork);
+  t[${tensors.get(fn.result)}].store(out, times);
+  if (device) check(cudaFree(device));
+}
+${cudaMain}`;
+}
