    return [json.loads(line) for line in (ticket/'scripts'/f).read_text().splitlines()]
cpu, gpu = rows('06-cpu.jsonl'), rows('07-gpu.jsonl')
shapes = {'matmul':[512,512], 'softmax':[4096,1024], 'layernorm':[4096,1024],
          'attention':[1024,64], 'mlp':[1024,256], 'conv2d':[8,32,62,62]}
doc = next((ticket/'reference').glob('02-*.md')).read_text()
assert len(cpu) == len(gpu) == len(shapes)
for c,g,(name,shape) in zip(cpu,gpu,shapes.items(), strict=True):
    assert c['name'] == g['name'] == name and c['shape'] == g['shape'] == shape
    assert len(c['inputs']) == 64 and c['inputs'] == g['inputs']
    assert len(c['ms']) == 1 and len(g['ms']) == 3 and all(math.isfinite(ms) and ms>0 for ms in c['ms']+g['ms'])
    interval = statistics.median(g['ms'])
    line = next(l for l in doc.splitlines() if l.startswith('| '+name+','))
    assert f'| {interval:.6f} | {c[\"ms\"][0]:,.3f} |' in line
    print(f'{name}: matched inputs and shape; {interval:.6f} ms GPU, {c[\"ms\"][0]/1000:.3f} s interpreter')
