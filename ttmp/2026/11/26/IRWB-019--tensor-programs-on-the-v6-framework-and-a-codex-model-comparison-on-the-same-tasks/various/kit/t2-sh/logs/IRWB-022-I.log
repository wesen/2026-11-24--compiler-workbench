    for (const a of axes) {
      requireIR(!scope.has(a.id), 'Duplicate binder');
      const e = a.extent;
      checkForm(e.dim, shapes);
      requireIR(
        e.kind === 'dim' ||
          (e.kind === 'blocks' && ['ceil', 'floor'].includes(e.rounding)) ||
          (e.kind === 'tail' && scope.has(e.block)),
