+struct KernelData {
+  const float *in;
+  float *out;
+  int64_t count;
+};
+
+constexpr int stride = 18;
+__global__ void atoms(const float *in, float *out, int count) {
+  int i = blockDim.x * blockIdx.x + threadIdx.x;
+  if (i >= count) return;
