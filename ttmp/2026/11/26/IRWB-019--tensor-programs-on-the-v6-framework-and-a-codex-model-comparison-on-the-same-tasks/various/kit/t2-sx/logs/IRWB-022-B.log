+__device__ float js_min(float a, float b) {
+  if (isnan(a) || isnan(b)) return __int_as_float(0x7fc00000);
+  if (a == 0 && b == 0) return __int_as_float(__float_as_int(a) | __float_as_int(b));
+  return a < b ? a : b;
+}
