export interface Axis {
  id: string;
  extent: Extent;
}
export type Op = '+' | '-' | '*' | '/' | 'neg' | 'exp' | 'log' | 'sqrt' | 'tanh' | 'max' | 'min';
export type Expr =
  | { kind: 'literal'; text: string }
  | { kind: 'shape'; name: string }
  | { kind: 'load'; name: string; indices: Affine[] }
