+import { createHash } from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { copyFileSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+const count = 65536;
+const stride = 16;
+const width = 32;
+const input = new Float32Array(count * 4);
+const scratch = new DataView(new ArrayBuffer(4));
+function float(word) {
+  scratch.setUint32(0, word, true);
+  return scratch.getFloat32(0, true);
+}
+function bits(value) {
+  scratch.setFloat32(0, value, true);
+  return scratch.getUint32(0, true);
+}
+let state = 20;
+function word() {
+  state ^= state << 13;
+  state ^= state >>> 17;
+  state ^= state << 5;
+  return state >>> 0;
+}
+function finite() {
+  return float(word() % 0xff000000 + 0x00800000 >>> 0);
+}
+for (let i = 0; i < count; i++) {
+  const finiteWord = () => {
+    const v = finite();
+    return Number.isFinite(v) ? v : 0;
+  };
+  input.set([finiteWord(), finiteWord(), float(1 + word() % 0x7f7fffff), word() / 2 ** 27 - 16], i * 4);
+}
+const a = 1 + 2 ** -23;
+input.set([a, -(1 + 2 ** -22), 2 ** -149, -0], 0);
+input.set([-0, 0, 1, 0], 4);
+input.set([0, -0, 1, 0], 8);
+input.set([NaN, 1, 0, 0], 12); // Synthetic intermediate NaN, matching finite-input 0/0 by class.
+input.set([1, NaN, -1, 0], 16);
+input.set([-0, -0, 1, 0], 20);
+input.set([2 ** -126, 0.5, 1, 0], 24);
+input.set([1, 2, 1, -0], 28);
+input.set([1, 2, 1, 100], 32); // JS exp is finite in f64 but rounds to infinity in f32.
+input.set([1, 2, 1, -100], 36);
+const witness = [1, 0, 0, 0, 2 ** -24, 2 ** -24, 2 ** -24];
+for (let i = 0; i < width; i++) input[(width + i) * 4 + 3] = witness[i] ?? 0;
+
+const sha = bytes => createHash('sha256').update(bytes).digest('hex');
+const dir = mkdtempSync('/tmp/irwb-022-b-probe-');
+try {
+  const source = new URL('./main.cu', import.meta.url);
+  copyFileSync(source, join(dir, 'main.cu'));
+  const inputBytes = Buffer.from(input.buffer);
+  writeFileSync(join(dir, 'input.bin'), inputBytes);
+  const run = spawnSync(
+    process.execPath,
+    ['tools/cuda-remote.mjs', dir, '--host', 'manuel@bling', '--', String(count)],
+    { encoding: 'utf8' },
+  );
+  if (run.error) throw run.error;
+  if (run.status !== 0) throw Error(run.stdout + run.stderr);
+  const remote = JSON.parse(run.stdout);
+  const data = readFileSync(join(dir, 'out', 'observations.bin'));
+  if (data.length !== (count * stride + (count / width) * 3) * 4) throw Error('Unexpected output length');
+  const get = i => data.readFloatLE(i * 4);
+  const labels = [
+    'add', 'sub', 'mul', 'div', 'neg', 'sqrt', 'max', 'min',
+    'expf', 'logf', 'tanhf', 'exp(double)', 'log(double)', 'tanh(double)',
+    'default mul-add', 'separate mul-add', 'ordered sum', 'ordered tanh sum', 'width-4 split sum',
+  ];
+  const stats = Object.fromEntries(
+    labels.map(label => [label, { f32Mismatches: 0, f64Comparable: 0, worstBudgetFraction: 0 }]),
+  );
+  function record(label, actual, expected, f64) {
+    const s = stats[label];
+    if (Number.isNaN(expected) ? !Number.isNaN(actual) : bits(expected) !== bits(actual)) {
+      s.f32Mismatches++;
+      s.firstMismatch ??= [bits(expected).toString(16), bits(actual).toString(16)];
+    }
+    if (!Number.isFinite(expected) || !Number.isFinite(f64)) return;
+    s.f64Comparable++;
+    const budget = 2e-6 + 2e-5 * Math.abs(f64);
+    s.worstBudgetFraction = Math.max(s.worstBudgetFraction, Math.abs(actual - f64) / budget);
+  }
+  const f = Math.fround;
+  for (let i = 0; i < count; i++) {
+    const [a, b, p, x] = input.subarray(i * 4, i * 4 + 4);
+    const refs = [
+      a + b, a - b, a * b, a / b, -a, Math.sqrt(p), Math.max(a, b), Math.min(a, b),
+      Math.exp(x), Math.log(p), Math.tanh(x), Math.exp(x), Math.log(p), Math.tanh(x),
+      a * a + b, a * a + b,
+    ];
+    refs.forEach((r, j) => record(labels[j], get(i * stride + j), j >= 14 ? f(f(a * a) + b) : f(r), r));
+  }
+  for (let row = 0; row < count / width; row++) {
+    let sum = 0, sum64 = 0, composed = 0, composed64 = 0, blocked = 0, part = 0;
+    for (let i = 0; i < width; i++) {
+      const x = input[(row * width + i) * 4 + 3];
+      sum = f(sum + x);
+      sum64 += x;
+      composed = f(composed + f(Math.tanh(x)));
+      composed64 += Math.tanh(x);
+      part = f(part + x);
+      if (i % 4 === 3) {
+        blocked = f(blocked + part);
+        part = 0;
+      }
+    }
+    const offset = count * stride + row * 3;
+    record(labels[16], get(offset), sum, sum64);
+    record(labels[17], get(offset + 1), composed, composed64);
+    record(labels[18], get(offset + 2), blocked, sum64);
+  }
+  console.log(JSON.stringify({
+    node: process.version,
+    remote,
+    sha256: { source: sha(readFileSync(source)), inputs: sha(inputBytes), outputs: sha(data) },
+    count,
+    width,
+    stats,
