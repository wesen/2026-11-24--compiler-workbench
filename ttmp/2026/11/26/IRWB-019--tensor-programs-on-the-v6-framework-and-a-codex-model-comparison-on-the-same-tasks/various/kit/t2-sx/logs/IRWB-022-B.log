+  r[9] = logf(positive);
+  r[10] = tanhf(bounded);
+  r[11] = __double2float_rn(exp((double)bounded));
+  r[12] = __double2float_rn(log((double)positive));
+  r[13] = __double2float_rn(tanh((double)bounded));
+  r[14] = a * a + b;
+  r[15] = __fadd_rn(__fmul_rn(a, a), b);
