    const walk = (vid: string): string => {
      const v = this.st.get(vid) as ValueRec;
      const args = v.args.map(walk);
      let cur = vid;
      if (args.some((a, i) => a !== v.args[i])) {
        this.may('values', 'rebuilt a value');
        const rec: ValueRec = {
