export type TypedPass = Pass<TypedBlocks, Record<string, any>, Record<string, unknown>> & {
  readonly typed: TypedPassSpec;
};

export function typedPass(spec: TypedPassSpec): TypedPass {
  const needs = Object.fromEntries(
    Object.entries(spec.needs ?? {}).map(([alias, name]) => [alias, ANALYSES[name]]),
  );
  const writes = { entities: new Set<string>(), relations: new Set<string>() };
  for (const k of spec.writes) {
    ENTITY_WRITES[k].entities.forEach(e => writes.entities.add(e));
    ENTITY_WRITES[k].relations.forEach(r => writes.relations.add(r));
  }
  const pass = definePass<TypedBlocks, Record<string, any>, Record<string, unknown>>({
    id: `typed.${spec.name}`,
    version: '1',
    description: spec.about,
    ir: BlocksIR,
    adapter: blocksAdapter,
    needs,
    writes: { entities: [...writes.entities], relations: [...writes.relations] },
    preserves: (spec.preserves ?? []).map(n => ANALYSES[n]),
    run({ before, facts, params }) {
      const st = Store.from(before.value),
        rev = before.value.rev + 1;
      const edits: Edit[] = [],
        touched: string[] = [];
      for (const f of st.fns.values()) {
        const views: FactViews = {};
        for (const [alias, name] of Object.entries(spec.needs ?? {}))
          views[alias] = view(name, facts[alias], st, f.name);
        const tx = new Tx(st, f, { name: spec.name, writes: spec.writes }, rev);
        spec.body({ st, f, tx, facts: views, params: (params ?? {}) as Record<string, unknown> });
        tx.commit();
        if (tx.edits.length) {
          edits.push(...tx.edits);
          touched.push(f.name);
        }
      }
      if (!edits.length) return;
      st.rev = rev;
      const native = st.toNative();
      const kinds = edits.reduce<Record<string, number>>(
        (m, e) => ((m[e.kind] = (m[e.kind] || 0) + 1), m),
        {},
      );
      const report: RevisionReport = { pass: spec.name, rev, edits, fns: touched, kinds };
      return {
        native,
        correspondence: revisionCorrespondence(before.value, native, edits),
        edits: edits.length,
        report,
      };
    },
  });
  return Object.freeze({ ...pass, typed: spec }) as TypedPass;
}

const contracts = new Map<string, TransformationDefinition<any, any>>();
/** The gate every optimization passes: the output still agrees with the origin (r0) on generated cases. */
export function optimizationContract(params: MeaningParams = {}): TransformationDefinition<any, any> {
  const check = meaningKept(params);
  let c = contracts.get(check.version);
  if (!c) {
    c = defineTransformation({
      id: 'typed.optimization',
      version: check.version,
      description: 'an optimization keeps the meaning of the original program',
      inputs: { input: BlocksIR, origin: BlocksIR },
      outputs: { output: BlocksIR },
      ensures: [
        {
          invariant: check,
          bindings: {
            origin: { from: 'inputs', port: 'origin' },
            candidate: { from: 'outputs', port: 'output' },
          },
        },
      ],
    });
    contracts.set(check.version, c);
  }
  return c;
}

export const outcome = (r: RunResult): number | readonly number[] | 'trap' => (r.trap ? 'trap' : r.result!);
const sameResult = (a: RunResult['result'], b: RunResult['result']): boolean =>
  typeof a === 'number' || typeof b === 'number' || a === undefined || b === undefined
    ? a === b
    : a.length === b.length && a.every((x, i) => x === b[i]);
const sameBytes = (a: Uint8Array, b: Uint8Array) => {
  if (a.length !== b.length) return false;
  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
  return true;
};

/**
 * Compiler Workbench's verdict for one case: `expected` is the meaning, `got` the run under test. A fault (a
 * calling-convention violation the emulator detects) never agrees; a trap agrees with any trap; otherwise
 * results and the memory both wrote must match.
 */
export function agrees(expected: RunResult, got: RunResult): boolean {
  if (got.fault) return false;
  if (expected.trap) return !!got.trap;
  if (got.trap || !sameResult(got.result, expected.result)) return false;
  const n = Math.min(expected.bytes.length, got.bytes.length);
  return sameBytes(got.bytes.subarray(0, expected.bytes.length), expected.bytes.subarray(0, n));
}

export interface MeaningParams {
  readonly count?: number;
  readonly seed?: number;
  readonly inputs?: ProgramInputs;
  readonly limit?: number;
  /**
   * The functions the program's host calls. When given, only they are compared: the program's meaning is what its
   * entries compute, and functions only they call may change or disappear (dead-function elimination).
   */
  readonly roots?: readonly string[];
}

const meaningChecks = new Map<string, DifferentialInvariant<any>>();
const canonicalJson = (x: unknown): string =>
  JSON.stringify(x, (_k, v) =>
    v && typeof v === 'object' && !Array.isArray(v)
      ? Object.fromEntries(Object.entries(v).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)))
      : v,
  );

/**
 * `typed.meaning-kept`: every function of `candidate` agrees with `origin` (normally r0) on `count` generated
 * cases per function. The case parameters are part of the definition (its version carries their hash), and one
 * definition object exists per parameter set, as the contract registry requires.
 */
export function meaningKept(
  params: MeaningParams = {},
): DifferentialInvariant<{ origin: typeof BlocksIR; candidate: typeof BlocksIR }> {
  const count = params.count ?? 40,
    seed = params.seed ?? 7,
    inputs = params.inputs ?? {},
    limit = params.limit ?? 2e4,
    roots = params.roots ? [...params.roots].sort() : null;
  const key = canonicalJson(roots ? { count, seed, inputs, limit, roots } : { count, seed, inputs, limit });
  let check = meaningChecks.get(key);
  if (!check) {
    check = differential<{ origin: typeof BlocksIR; candidate: typeof BlocksIR }, Case, RunResult>({
      id: 'typed.meaning-kept',
      version: `1+${hash(key)}`,
      description: `${roots ? `the entries ${roots.join(', ')} agree` : 'every function agrees'} with the origin on ${count} generated cases (seed ${seed})`,
      inputs: { origin: BlocksIR, candidate: BlocksIR },
      baseline: 'origin',
      subject: 'candidate',
      count,
      seed,
      random: rng,
      cases: ({ origin }) => {
        const st = storeOf(origin.value);
        return (roots ?? [...st.fns.keys()]).flatMap(fn => casesFrom(st, fn, { count, seed, inputs: inputs[fn] ?? {} }));
      },
      run: (_side, art, c) =>
        evaluate(storeOf((art as Artifact<TypedBlocks>).value), c.fn, c.args, c.memory, { limit }),
      inconclusive: r => r.limit,
      compare: (expected, got, c) =>
        agrees(expected, got)
          ? true
          : {
              ok: false,
              reason: `${c.fn}#${c.n}: expected ${String(outcome(expected))}, got ${String(outcome(got))}`,
            },
      describeCase: c => ({ fn: c.fn, n: c.n, args: c.args }),
      maxCounterexamples: 5,
      // IRWB-004 D1: the cases and the origin's outcomes are a function of the origin's value (and of the parameters,
      // which the version carries); a case's outcome on the candidate is a function of the case and the code the case
      // can reach (closureKey). See src/typed/parts.ts.
      baselineKey: ({ origin }) => `${origin.kind}@${origin.schemaVersion}:${origin.revision}`,
      subjectKey: (art, c) => closureKey((art as Artifact<TypedBlocks>).value, c.fn),
      // IRWB-004 F4: an installed executor (worker threads) decides the cases; without one, they are decided here
      decide: (ports, cases, todo) =>
        meaningExecutor()?.decide({ params, origin: ports.origin, candidate: ports.candidate, cases, todo }),
    });
    meaningChecks.set(key, check);
  }
  return check;
}

