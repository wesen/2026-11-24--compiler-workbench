import { coordinate, cudaCases, seed } from './contract.js';
import { runCudaBatch } from './cuda-runtime.js';
import { emitCuda } from './cuda-source.js';
import type { BufferValue } from './evaluate.js';
import { TixIR } from './ir.js';
import { selectFunction, type Module } from './model.js';

interface CudaUnit {
  fn: string;
  source: string;
}

const CudaIR = defineIR<CudaUnit>({
  id: 'tensor.cuda-source',
  version: '1',
  description: 'Standalone CUDA translation unit for a Tix function',
  validate(value) {
    const unit = value as Partial<CudaUnit> | null;
    if (typeof unit?.fn !== 'string' || !unit.fn || typeof unit.source !== 'string' || !unit.source)
      throw Error('Invalid CUDA translation unit');
  },
});
const FunctionName = defineType<string>({
  id: 'tensor.function-name',
  version: '1',
  description: 'Name of the Tix function to lower',
  validate(name) {
    if (typeof name !== 'string' || !name) throw Error('Invalid Tix function name');
  },
});

export function cudaArtifact(fn: string, source: string): Artifact<CudaUnit> {
  return createArtifact(CudaIR, 'tix-cuda/' + fn, { fn, source });
}

// The relation is exact: the lowered function must give the current revision's f32 meaning bit for bit, signed
// zeros and infinities included (IRWB-019 F17). The emitter makes that possible: explicit round-to-nearest
// arithmetic, so nothing contracts, and exp, log and tanh in double, rounded, which equal Math.fround(Math.exp(x))
// and so on for all 2^32 f32 inputs on the GB10 (IRWB-019 diary step 23). NaN is compared as a class, because the
// GPU and V8 produce different NaN words (sqrt of -2^-149: 0x7fffffff against 0xffc00000).
function compare(expected: BufferValue, got: BufferValue) {
  if (expected.shape.length !== got.shape.length || expected.shape.some((n, i) => n !== got.shape[i]))
    return { ok: false, reason: 'Output shape differs' };
  if (expected.data.length !== got.data.length) return { ok: false, reason: 'Output length differs' };
  const f32 = (d: ArrayLike<number>) => (d instanceof Float32Array ? d : Float32Array.from(d));
  const a = f32(expected.data),
    b = f32(got.data);
  const wa = new Uint32Array(a.buffer, a.byteOffset, a.length),
    wb = new Uint32Array(b.buffer, b.byteOffset, b.length);
  const hex = (w: number) => '0x' + w.toString(16).padStart(8, '0');
  for (let i = 0; i < a.length; i++) {
    if (wa[i] === wb[i] || (Number.isNaN(a[i]) && Number.isNaN(b[i]))) continue;
    const at = coordinate(expected.shape, i);
    return { ok: false, reason: `At [${at}], expected ${a[i]} (${hex(wa[i])}), got ${b[i]} (${hex(wb[i])})` };
  }
  return { ok: true };
}

type CudaSample = ReturnType<typeof cudaCases>[number];

export function createCudaLowering(profile: string, executeBatch: typeof runCudaBatch = runCudaBatch) {
  const inputs = { baseline: TixIR, fn: FunctionName };
  const outputs = { subject: CudaIR };
  const ports = { ...inputs, ...outputs };
  const invariant = differential<typeof ports, CudaSample, BufferValue>({
    id: 'tensor.cuda-meaning',
    version: '2',
    description:
      'Compare the lowered CUDA function to its current Tix f32 meaning, bit for bit (NaN as a class)',
    inputs: ports,
    baseline: 'baseline',
    subject: 'subject',
    // The recipe is shape-dependent and supplies its whole eligible case set.
    count: 1,
    seed,
    cases: ({ baseline, fn }, random) => {
      const samples = cudaCases(selectFunction(baseline.value, fn), random);
      if (!samples.length) throw Error('No eligible CUDA check cases for ' + fn);
      return samples;
    },
    run: (side, _artifact, sample) => {
      if (side === 'baseline') return sample.reference;
      throw Error('CUDA checks require the batch executor');
    },
    compare,
    describeCase: ({ fn, shapeValues, stream }) => ({ fn, shapeValues, stream, seed }),
    baselineKey: ({ baseline, fn }) => JSON.stringify([baseline.revision, fn]),
    subjectKey: (_artifact, _case, { subject }) => JSON.stringify([subject.revision, profile]),
    async decide({ baseline, fn, subject }, cases, todo) {
      if (subject.value.fn !== fn)
        return todo.map(() => ({ v: 'disagree', reason: 'CUDA function differs' }));
      const pending = todo.map(i => cases[i]);
      const results = await executeBatch(
        subject.value.source,
        selectFunction(baseline.value, fn),
        pending.map(c => c.inputs),
      );
      if (results.length !== pending.length) throw Error('Wrong CUDA response case count');
      return pending.map((sample, i): Decided => {
        const result = compare(sample.reference, results[i]);
        return result.ok ? { v: 'agree' } : { v: 'disagree', reason: result.reason! };
      });
    },
  });
  const pass = defineTransformation({
    id: 'tensor.lower-cuda',
    version: '1',
    description: 'Lower a Tix function to CUDA and check the candidate on the GPU',
    inputs,
    outputs,
    cache: 'never',
    ensures: [
      {
        invariant,
        bindings: {
          baseline: { from: 'inputs', port: 'baseline' },
          fn: { from: 'inputs', port: 'fn' },
          subject: { from: 'outputs', port: 'subject' },
        },
      },
    ],
    run(_ctx, { baseline, fn }) {
      return { outputs: { subject: cudaArtifact(fn, emitCuda(selectFunction(baseline.value, fn))) } };
    },
  });

  return async (baseline: Artifact<Module>, fn: string, candidate?: Artifact<CudaUnit>) => {
    const relation = 'exact' as const;
    const manager = new AnalysisManager();
    try {
      if (candidate) await manager.verifyTransformation({ baseline, fn }, { subject: candidate }, pass);
      else await manager.execute(pass, { baseline, fn });
      return { accepted: true, relation };
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      if (error instanceof ContractError && error.code === 'postcondition') {
        const checks = manager.snapshot().executions.at(-1)?.checks;
        const evidence = checks?.find(check => check.phase === 'ensures')?.evidence as
          | DifferentialEvidence
          | undefined;
        const first = evidence?.counterexamples[0];
        const reason = first ? `${JSON.stringify(first.case)}: ${first.reason}` : message;
        return { accepted: false, relation, reason };
      }
      return { accepted: false, relation, reason: 'CUDA evidence unavailable: ' + message };
    }
  };
}

export const checkCudaLowering = createCudaLowering('cuda-remote:sm_121:-O3');
// Compile and run a CUDA program on the GPU machine over ssh, and bring its outputs back.
//
//   node tools/cuda-remote.mjs <dir> [--timed] [--host user@host] [--arch sm_121]
//     [--runtime-input relative-path ...] [-- program args...]
//
// <dir> holds main.cu and any input files. Each invocation uploads to its own remote working directory.
// `nvcc -O3 -arch=<arch> -o prog main.cu` is cached by compiler path, architecture and build files.
// Each --runtime-input path marks an uploaded file that does not affect compilation. Files under out/
// are copied back to <dir>/out/ after running ./prog from the working directory.
// --timed takes an exclusive lock on the GPU (flock ~/irwb-cuda/.gpu.lock) for the run, so concurrent timed
// users do not disturb each other's timings. Untimed runs do not wait for it.
// Prints one JSON object: { host, hash, compiled, compileMs, runMs, exit, stdout, stderr, outputs }.
// Environment: CUDA_REMOTE_HOST (default manuel@bling, the Tailscale name; bling.local resolves only on the home
// LAN), CUDA_REMOTE_NVCC (default /usr/local/cuda-13.0/bin/nvcc).
// Inside the Codex sandbox, ssh needs network access (-c sandbox_workspace_write.network_access=true); without it,
// agents request escalation instead.
import { createHash, randomUUID } from 'node:crypto';
import { execFileSync, spawnSync } from 'node:child_process';
import { readdirSync, readFileSync, statSync, mkdirSync } from 'node:fs';
import { join, relative } from 'node:path';

const argv = process.argv.slice(2);
const sep = argv.indexOf('--');
const opts = sep < 0 ? argv : argv.slice(0, sep);
const progArgs = sep < 0 ? [] : argv.slice(sep + 1);
const valued = ['--host', '--arch', '--runtime-input'];
const dir = opts.find((a, i) => !a.startsWith('--') && !valued.includes(opts[i - 1]));
if (!dir)
  throw new Error(
    'usage: node tools/cuda-remote.mjs <dir> [--timed] [--host h] [--arch a] [--runtime-input path ...] [-- args]',
  );
for (const [i, opt] of opts.entries())
  if (valued.includes(opt) && (!opts[i + 1] || opts[i + 1].startsWith('--')))
    throw new Error('Missing argument to ' + opt);
const value = (name, fallback) => (opts.includes(name) ? opts[opts.indexOf(name) + 1] : fallback);
const host = value('--host', process.env.CUDA_REMOTE_HOST ?? 'manuel@bling');
const arch = value('--arch', 'sm_121');
const nvcc = process.env.CUDA_REMOTE_NVCC ?? '/usr/local/cuda-13.0/bin/nvcc';

const files = [];
function walk(d) {
  for (const entry of readdirSync(d).sort()) {
    const p = join(d, entry);
    if (relative(dir, p) === 'out') continue;
    if (statSync(p).isDirectory()) walk(p);
    else files.push(relative(dir, p));
  }
}
walk(dir);
if (!files.includes('main.cu')) throw new Error(dir + ': no main.cu');
const runtime = new Set(opts.flatMap((arg, i) => (arg === '--runtime-input' ? [opts[i + 1]] : [])));
for (const path of runtime)
  if (path === 'main.cu' || !files.includes(path)) throw new Error('Invalid runtime input: ' + path);
const h = createHash('sha256').update(JSON.stringify([nvcc, '-O3', arch]));
for (const f of files) {
  if (runtime.has(f)) continue;
  const bytes = readFileSync(join(dir, f));
  h.update(JSON.stringify([f, bytes.length])).update(bytes);
}
const hash = h.digest('hex');
const remote = 'irwb-cuda/run/' + randomUUID();
const ssh = ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', '--', host];
const q = s => "'" + String(s).replaceAll("'", "'\\''") + "'";

const tar = spawnSync('tar', ['-C', dir, '-cf', '-', '--', ...files], { maxBuffer: 1 << 30 });
if (tar.status !== 0) throw new Error('tar: ' + (tar.error ?? tar.stderr));
let cleaned = false;
try {
  const put = spawnSync('ssh', [...ssh, `mkdir -p ~/${remote} && tar -C ~/${remote} -xf -`], {
    input: tar.stdout,
  });
  if (put.status !== 0) throw new Error('ssh copy: ' + (put.error ?? put.stderr));

  // Hold the compile lock until the cached binary is linked into this job.
  const lock = opts.includes('--timed') ? 'flock ~/irwb-cuda/.gpu.lock ' : '';
  const script = [
    'set -e',
    `cd ~/${remote}`,
    `cache=~/irwb-cuda/build/${hash}`,
    'compiled=0; c0=$(date +%s%N)',
    'mkdir -p "$cache"',
    'exec 9>"$cache/.lock"',
    'flock 9',
    'if [ ! -x "$cache/prog" ]; then',
    `  ${q(nvcc)} -O3 ${q('-arch=' + arch)} -o prog.tmp main.cu || exit 97`,
    '  mv prog.tmp "$cache/prog"',
    '  compiled=1',
    'fi',
    'ln "$cache/prog" prog',
    'exec 9>&-',
    'c1=$(date +%s%N); mkdir -p out',
    `r0=$(date +%s%N); status=0; ${lock}./prog ${progArgs.map(q).join(' ')} || status=$?; r1=$(date +%s%N)`,
    'printf "\\n@@meta %s %s %s %s\\n" "$compiled" "$(( (c1 - c0) / 1000000 ))" "$(( (r1 - r0) / 1000000 ))" "$status"',
  ].join('\n');
  const run = spawnSync('ssh', [...ssh, 'bash -s'], { input: script, maxBuffer: 1 << 28, encoding: 'utf8' });
  const meta = run.status === 0 && /\n@@meta (\d) (\d+) (\d+) (\d+)\n?$/.exec(run.stdout ?? '');
  const result = {
    host,
    hash,
    compiled: meta ? meta[1] === '1' : false,
    compileMs: meta ? Number(meta[2]) : null,
    runMs: meta ? Number(meta[3]) : null,
    exit: meta ? Number(meta[4]) : run.status || 1,
    stdout: meta ? run.stdout.slice(0, meta.index) : (run.stdout ?? ''),
    stderr: run.error?.message ?? run.stderr ?? '',
    outputs: [],
  };

  if (meta) {
    const get = spawnSync('ssh', [...ssh, `tar -C ~/${remote}/out -cf - . && rm -rf ~/${remote}`], {
      maxBuffer: 1 << 30,
    });
    if (get.status !== 0) throw new Error('ssh fetch: ' + (get.error ?? get.stderr));
    cleaned = true;
    const out = join(dir, 'out');
    mkdirSync(out, { recursive: true });
    execFileSync('tar', ['-C', out, '-xf', '-'], { input: get.stdout });
    const collect = d => {
      for (const entry of readdirSync(d)) {
        const p = join(d, entry);
        if (statSync(p).isDirectory()) collect(p);
        else result.outputs.push(relative(out, p));
      }
    };
    collect(out);
    result.outputs.sort();
  }
  process.stdout.write(JSON.stringify(result) + '\n');
  if (result.exit !== 0) process.exitCode = 1;
} finally {
  if (!cleaned) spawnSync('ssh', [...ssh, `rm -rf ~/${remote}`], { stdio: 'ignore' });
}

