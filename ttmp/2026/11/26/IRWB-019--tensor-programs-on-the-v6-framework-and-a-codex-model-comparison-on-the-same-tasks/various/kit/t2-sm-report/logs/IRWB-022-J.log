      let k = i;
      const coord = ref.shape.map(() => 0);
      for (let j = coord.length - 1; j >= 0; j--) {
        coord[j] = k % ref.shape[j];
        k = Math.floor(k / ref.shape[j]);
      }
      return {
        ok: false,

