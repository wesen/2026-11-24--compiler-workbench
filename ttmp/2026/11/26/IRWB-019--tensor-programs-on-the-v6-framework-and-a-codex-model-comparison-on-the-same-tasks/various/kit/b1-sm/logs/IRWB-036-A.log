const MASK = 31;
export function binop(op: string, a: number, b: number): number {
  switch (op) {
    case 'add':
      return (a + b) | 0;
    case 'sub':
      return (a - b) | 0;
    case 'mul':
      return Math.imul(a, b);
    case 'div':
      if (b === 0) throw new Trap('division by zero');
      if (a === -2147483648 && b === -1) throw new Trap('division overflow');
      return (a / b) | 0;
    case 'rem':
      if (b === 0) throw new Trap('division by zero');
      if (b === -1) return 0;
      return a % b | 0;
    case 'and':
      return a & b;
    case 'or':
      return a | b;
    case 'xor':
      return a ^ b;
    case 'shl':
      return a << (b & MASK);
    case 'shr':
      return a >> (b & MASK);
    case 'shru':
      return (a >>> (b & MASK)) | 0;
    case 'eq':
      return +(a === b);
    case 'ne':
      return +(a !== b);
    case 'lt':
      return +(a < b);
    case 'gt':
      return +(a > b);
    case 'le':
      return +(a <= b);
    case 'ge':
      return +(a >= b);
    case 'ltu':
      return +(a >>> 0 < b >>> 0);
    case 'geu':
      return +(a >>> 0 >= b >>> 0);
  }
  throw new Error('evaluator: unknown operator ' + op);
}

