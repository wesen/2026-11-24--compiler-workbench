diff --git a/src/tensor/samples.ts b/src/tensor/samples.ts
new file mode 100644
index 0000000000000000000000000000000000000000..74e985ba7aeb9bedb18acfecf85db0d191c879ad
--- /dev/null
+++ b/src/tensor/samples.ts
@@ -0,0 +1,50 @@
+import { size } from './evaluate.js';
+import { plain, value, type Fn } from './model.js';
+
+export const sampleSeed = 20;
+export const tolerance = (reference: number) => 2e-6 + 2e-5 * Math.abs(reference);
+export type F32Inputs = Record<string, { shape: number[]; data: Float32Array }>;
+
+const half = [1, 0, 0, 0, 2 ** -24, 2 ** -24, 2 ** -24];
+
+export function* sampleInputs(
+  fn: Fn,
+  random: () => number,
+  options: { signedZero: boolean; zeroShape?: boolean },
+) {
+  const symbols = [
+    ...new Set(fn.params.flatMap(p => p.shape.map(plain).filter((n): n is string => !!n))),
+  ].sort();
+  const seen = new Set<string>();
+  const assignments = [1, 3, 4, 7, 'mixed', ...(options.zeroShape ? [0] : [])] as const;
+  const streams = ['signed', 'positive', 'half-ulp', ...(options.signedZero ? ['zero'] : [])];
+  for (const n of assignments) {
+    const shapeValues = symbols.map((_, i) => (n === 'mixed' ? [3, 5, 7][i % 3] : n));
+    const key = JSON.stringify(shapeValues);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    const dims = new Map(symbols.map((s, i) => [s, shapeValues[i]]));
+    const shapes = fn.params.map(p => p.shape.map(d => value(d, dims)));
+    if (shapes.some(shape => shape.some(x => x < 0) || size(shape) > 4096)) continue;
+    for (const stream of streams) {
+      const inputs: F32Inputs = Object.create(null);
+      fn.params.forEach((p, j) => {
+        const shape = shapes[j];
+        const data = Float32Array.from({ length: size(shape) }, (_, i) => {
+          switch (stream) {
+            case 'signed':
+              return 2 * random() - 1;
+            case 'positive':
+              return 0.25 + 0.75 * random();
+            case 'zero':
+              return i % 2 ? -0 : 0;
+            default:
+              return half[i % half.length];
+          }
+        });
+        inputs[p.name] = { shape, data };
+      });
+      yield { fn: fn.name, shapeValues, stream, inputs };
+    }
+  }
+}
diff --git a/tests/tensor/cuda-gpu.test.mjs b/tests/tensor/cuda-gpu.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..03c01c9427f0f996bfa740ddee22541d63f1963d
--- /dev/null
+++ b/tests/tensor/cuda-gpu.test.mjs
@@ -0,0 +1,172 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+import { AnalysisManager, createArtifact, differentialStats } from '../../dist/framework/contracts/index.js';
+import { cudaLowering } from '../../dist/tensor/cuda.js';
+import { runCudaBatch } from '../../dist/tensor/cuda-io.js';
+import {
+  checkLowering,
+  compileTix,
+  cudaSource,
+  optimizeTix,
+  runTix,
+  runTixCuda,
+} from '../../dist/tensor/index.js';
+
+const tensor = (shape, ...values) => ({ shape, data: Float32Array.from(values) });
+const corpus = ['matmul', 'softmax', 'layernorm', 'attention', 'mlp', 'conv2d'];
+
+test('GPU lowering checks the original and optimized corpus through the public API', async () => {
+  for (const name of corpus) {
+    const program = compileTix(
+      readFileSync(new URL(`../../corpus/tensor/${name}/main.tix`, import.meta.url), 'utf8'),
+    );
+    const optimized = optimizeTix(program, ['inline', 'split-sum']).program;
+    for (const variant of [program, optimized]) {
+      const result = await checkLowering(variant, name);
+      assert.deepEqual(result, { accepted: true, relation: 'tolerance' }, `${name}: ${result.reason}`);
+    }
+  }
+});
+
+test('GPU preserves explicit rounding, ordered multi-index folds and split tails', async () => {
+  const program = compileTix(`
+    fn separated(x:f32[N], y:f32[N]):f32[N] {
+      out[i] = x[i] * x[i] + y[i];
+      return out;
+    }
+    fn ordered(x:f32[N,K,L]):f32[N] {
+      out[i] = sum(k,l) x[i,k,l];
+      return out;
+    }
+    fn blocked(x:f32[N,K]):f32[N] {
+      out[i] = sum(k) x[i,k];
+      return out;
+    }
+  `);
+  const separated = await runTixCuda(program, 'separated', {
+    x: tensor([1], 1 + 2 ** -23),
+    y: tensor([1], -(1 + 2 ** -22)),
+  });
+  assert.deepEqual([...separated.data], [0]);
+  assert.ok(Number.isFinite(separated.gpuMs) && separated.gpuMs >= 0);
+  const ordered = await runTixCuda(program, 'ordered', { x: tensor([1, 2, 2], 1e10, 1, -1e10, 1) });
+  assert.deepEqual([...ordered.data], [1]);
+  const optimized = optimizeTix(program, ['split-sum']).program;
+  const input = { x: tensor([1, 7], 1, 0, 0, 0, 2 ** -24, 2 ** -24, 2 ** -24) };
+  const blocked = await runTixCuda(optimized, 'blocked', input);
+  assert.deepEqual([...blocked.data], [1.000000238418579]);
+});
+
+test('GPU handles empty domains and parameter returns', async () => {
+  const program = compileTix(`
+    fn empty(x:f32[N,K]):f32[N] {
+      out[i] = max(k) x[i,k];
+      return out;
+    }
+    fn identity(x:f32[N]):f32[N] { return x; }
+  `);
+  const result = await runTixCuda(program, 'empty', { x: tensor([2, 0]) });
+  assert.deepEqual(result.shape, [2]);
+  assert.deepEqual([...result.data], [-Infinity, -Infinity]);
+  const noThreads = await runTixCuda(program, 'empty', { x: tensor([0, 0]) });
+  assert.deepEqual(noThreads, { shape: [0], data: new Float32Array(), gpuMs: 0 });
+  const copied = await runTixCuda(program, 'identity', { x: tensor([2], -0, 9) });
+  assert.deepEqual(copied, { shape: [2], data: Float32Array.of(-0, 9), gpuMs: 0 });
+});
+
+test('GPU respects shadowing, transposed inline loads and JS extrema', async () => {
+  const program = compileTix(`
+    fn nested(x:f32[N,A], y:f32[N,B]):f32[N] {
+      out[i] = sum(j) (x[i,j] + (sum(j) y[i,j]));
+      return out;
+    }
+    fn permute(x:f32[N,N]):f32[N,N] {
+      p[i,j] = x[i,j] + 1;
+      out[i,j] = p[j,i];
+      return out;
+    }
+    fn extrema(x:f32[N], y:f32[N]):f32[N] {
+      a[i] = min(x[i], y[i]);
+      out[i] = max(a[i], x[i] / x[i] * -0);
+      return out;
+    }
+    fn zeros(x:f32[N], y:f32[N]):f32[N] {
+      out[i] = min(x[i], y[i]);
+      return out;
+    }
+  `);
+  const nested = await runTixCuda(program, 'nested', {
+    x: tensor([1, 2], 1, 2),
+    y: tensor([1, 3], 3, 4, 5),
+  });
+  assert.deepEqual([...nested.data], [27]);
+  const permuted = await runTixCuda(optimizeTix(program, ['inline']).program, 'permute', {
+    x: tensor([2, 2], 1, 2, 3, 4),
+  });
+  assert.deepEqual([...permuted.data], [2, 4, 3, 5]);
+  const zeros = { x: tensor([2], 0, -0), y: tensor([2], -0, 0) };
+  assert.deepEqual([...(await runTixCuda(program, 'zeros', zeros)).data], [-0, -0]);
+  assert.ok((await runTixCuda(program, 'extrema', zeros)).data.every(Number.isNaN));
+});
+
+test('GPU check replays decisions and rejects changed kernel code', async () => {
+  const program = compileTix('fn replay(x:f32[N]):f32[N] { out[i] = x[i] + 23; return out; }');
+  const before = differentialStats();
+  assert.equal((await checkLowering(program, 'replay')).accepted, true);
+  const cold = differentialStats();
+  assert.equal(cold.delegated - before.delegated, 20);
+  assert.equal((await checkLowering(program, 'replay')).accepted, true);
+  const warm = differentialStats();
+  assert.equal(warm.delegated, cold.delegated);
+  assert.equal(warm.replayed - cold.replayed, 20);
+  const source = cudaSource(program, 'replay');
+  const broken = source.replace(/tensor1\[element\] = value\d+;/, 'tensor1[element] = 0.0f;');
+  assert.notEqual(broken, source);
+  const candidate = createArtifact(cudaLowering.outputs.output, 'tix-cuda', {
+    fn: 'replay',
+    protocol: 1,
+    source: broken,
+  });
+  await assert.rejects(
+    new AnalysisManager().verifyTransformation(
+      { input: program.current, fn: 'replay' },
+      { output: candidate },
+      cudaLowering,
+    ),
+    /sampled cases disagree/,
+  );
+});
+
+test('GPU check rejects a lowering outside the f64 budget even when f32 rounds the same way', async () => {
+  const program = compileTix(`
+    fn cancellation(x: f32[N]): f32[N] {
+      y[i] = (16777216 + 1) - 16777216 + x[i] * 0;
+      return y;
+    }
+  `);
+  assert.deepEqual([...runTix(program, 'cancellation', { x: tensor([1], 3) }).data], [0]);
+  const result = await checkLowering(program, 'cancellation');
+  assert.equal(result.accepted, false);
+  assert.equal(result.relation, 'tolerance');
+  assert.match(result.reason, /f64 expected 1, GPU got 0/);
+});
+
+test('remote work directories isolate concurrent jobs using the same binary', async () => {
+  const program = compileTix('fn isolated(x:f32[N]):f32[N] { out[i] = x[i] + 107; return out; }');
+  const [fn] = program.current.value.functions;
+  const source = cudaSource(program, fn.name);
+  const inputs = [{ x: tensor([2], 1, 2) }, { x: tensor([3], 5, 7, 9) }];
+  const results = await Promise.all(inputs.map(input => runCudaBatch(fn, source, [input])));
+  assert.equal(results[0].remote.hash, results[1].remote.hash);
+  assert.ok(results.filter(result => result.remote.compiled).length <= 1);
+  assert.deepEqual(
+    results.map(result => [...result.outputs[0].data]),
+    [
+      [108, 109],
+      [112, 114, 116],
+    ],
+  );
+  for (let i = 0; i < inputs.length; i++)
+    assert.deepEqual(results[i].outputs[0].data, runTix(program, fn.name, inputs[i]).data);
+});
diff --git a/tests/tensor/cuda.test.mjs b/tests/tensor/cuda.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..06d8f0a5d82f68933ce1cab9212757ee7f0a66d3
--- /dev/null
+++ b/tests/tensor/cuda.test.mjs
@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { checkLowering, compileTix, cudaSource, optimizeTix } from '../../dist/tensor/index.js';
+import { encodeCases, decodeResults } from '../../dist/tensor/cuda-io.js';
+import { inputMagic, resultMagic, protocolVersion } from '../../dist/tensor/cuda-source.js';
+
+test('CUDA source follows the chosen function and its executable revision', () => {
+  const program = compileTix(`
+    fn other(x: f32[N]): f32[N] { return x; }
+    fn choose(x: f32[N,K]): f32[N] {
+      p[i,k] = x[i,k] + 0.125;
+      y[i] = sum(k) p[i,k];
+      return y;
+    }
+  `);
+  const source = cudaSource(program, 'choose');
+  assert.equal(source, cudaSource(program, 'choose'));
+  assert.equal(source.match(/__global__ void statement/g).length, 2);
+  assert.equal(cudaSource(program, 'other').match(/__global__ void statement/g), null);
+  assert.match(source, /__uint_as_float\(0x3e000000U\)/);
+  assert.match(source, /cudaFuncGetAttributes/);
+  assert.ok(source.indexOf('cudaFuncGetAttributes') < source.indexOf('cudaEventRecord(start)'));
+  const optimized = optimizeTix(program, ['inline', 'split-sum']).program;
+  assert.notEqual(optimized.current.revision, program.current.revision);
+  const lowered = cudaSource(optimized, 'choose');
+  assert.equal(lowered.match(/__global__ void statement/g).length, 1);
+  assert.match(lowered, /% 4LL != 0/);
+  assert.match(lowered, /min\(4LL,/);
+});
+
+test('CUDA binary protocol follows parameter order and keeps signed zeros', () => {
+  const program = compileTix('fn pair(left:f32[N], right:f32[N]):f32[N] { return left; }');
+  const [fn] = program.current.value.functions;
+  const bytes = encodeCases(fn, [{
+    right: { shape: [2], data: Float32Array.of(1, 3) },
+    left: { shape: [2], data: Float32Array.of(-0, 2) },
+  }]);
+  assert.equal(bytes.readUInt32LE(), inputMagic);
+  assert.equal(bytes.readUInt32LE(4), protocolVersion);
+  assert.equal(bytes.readUInt32LE(8), 1);
+  assert.equal(bytes.readBigUInt64LE(12), 2n);
+  assert.equal(bytes.readUInt32LE(20), 0x80000000);
+  assert.equal(bytes.readFloatLE(24), 2);
+  assert.equal(bytes.readFloatLE(36), 1);
+  const result = Buffer.alloc(32);
+  result.writeUInt32LE(resultMagic);
+  result.writeUInt32LE(protocolVersion, 4);
+  result.writeUInt32LE(1, 8);
+  result.writeBigUInt64LE(2n, 12);
+  result.writeFloatLE(0.25, 20);
+  result.writeUInt32LE(0x80000000, 24);
+  result.writeFloatLE(6, 28);
+  const [output] = decodeResults(result, 1, 1, 1);
+  assert.deepEqual(output.shape, [2]);
+  assert.deepEqual([...output.data], [-0, 6]);
+  assert.equal(output.gpuMs, 0.25);
+  assert.throws(() => decodeResults(result.subarray(0, -1), 1, 1, 1), /Truncated/);
+  assert.throws(() => decodeResults(Buffer.concat([result, Buffer.alloc(1)]), 1, 1, 1), /Trailing/);
+});
+
+test('CUDA check requires an eligible f64 reference', async () => {
+  const program = compileTix('fn large(x:f32[4097]):f32[4097] { return x; }');
+  assert.deepEqual(await checkLowering(program, 'large'), {
+    accepted: false, relation: 'tolerance', reason: 'No comparable case for large',
+  });
+});
