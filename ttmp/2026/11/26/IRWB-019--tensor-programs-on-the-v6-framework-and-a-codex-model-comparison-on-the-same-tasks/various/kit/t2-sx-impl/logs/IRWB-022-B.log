+import { execFile } from 'node:child_process';
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { promisify } from 'node:util';
+import { inputMagic, protocolVersion, resultMagic } from './cuda-source.js';
+import { plain, value, type Fn } from './model.js';
+import type { F32Inputs } from './samples.js';
+
+const launchTool = promisify(execFile);
+const tool = fileURLToPath(new URL('../../tools/cuda-remote.mjs', import.meta.url));
+const defaultHost = 'manuel@bling';
+const inputFile = 'cases.bin';
+
+export interface CudaResult {
+  shape: number[];
+  data: Float32Array;
+  gpuMs: number;
+}
+
+interface RemoteResult {
+  host: string;
+  hash: string;
+  compiled: boolean;
+  compileMs: number;
+  runMs: number;
+  exit: number;
+  stdout: string;
+  stderr: string;
+  outputs: string[];
+}
+
+function countElements(shape: number[]): number {
+  if (shape.some(extent => !Number.isSafeInteger(extent) || extent < 0))
+    throw Error('Unsupported tensor extent');
+  if (shape.includes(0)) return 0;
+  const length = shape.reduce((n, extent) => n * extent, 1);
+  if (!Number.isSafeInteger(length)) throw Error('Unsupported tensor size');
+  return length;
+}
+
+function header(magic: number, count: number): Buffer {
+  const bytes = Buffer.alloc(12);
+  bytes.writeUInt32LE(magic, 0);
+  bytes.writeUInt32LE(protocolVersion, 4);
+  bytes.writeUInt32LE(count, 8);
+  return bytes;
+}
+
+export function encodeCases(fn: Fn, cases: readonly F32Inputs[]): Buffer {
+  const parts = [header(inputMagic, cases.length)];
+  for (const inputs of cases) {
+    const shapes = new Map<string, number>();
+    for (const p of fn.params) {
+      const input = Object.hasOwn(inputs, p.name) ? inputs[p.name] : undefined;
+      if (!input || input.shape.length !== p.shape.length || input.data.length !== countElements(input.shape))
+        throw Error('Invalid input tensor ' + p.name);
+      p.shape.forEach((form, axis) => {
+        const name = plain(form);
+        if (name === undefined) return;
+        const extent = input.shape[axis];
+        if (shapes.has(name) && shapes.get(name) !== extent) throw Error('Inconsistent shape ' + name);
+        shapes.set(name, extent);
+      });
+    }
+    for (const p of fn.params) {
+      const { shape, data } = inputs[p.name];
+      const extents = Buffer.alloc(shape.length * 8);
+      shape.forEach((extent, axis) => {
+        if (value(p.shape[axis], shapes) !== extent) throw Error('Inconsistent input shape for ' + p.name);
+        extents.writeBigUInt64LE(BigInt(extent), 8 * axis);
+      });
+      parts.push(extents, Buffer.from(data.buffer, data.byteOffset, data.byteLength));
+    }
+  }
+  return Buffer.concat(parts);
+}
+
+export function decodeResults(bytes: Buffer, cases: number, rank: number, repetitions: number) {
+  if (bytes.length < 12 || bytes.readUInt32LE(0) !== resultMagic ||
+      bytes.readUInt32LE(4) !== protocolVersion || bytes.readUInt32LE(8) !== cases)
+    throw Error('Invalid CUDA result header');
+  let pos = 12;
+  function take(size: number) {
+    const end = pos + size;
+    if (end > bytes.length) throw Error('Truncated CUDA result');
+    const value = bytes.subarray(pos, end);
+    pos = end;
+    return value;
+  }
+  const outputs = [];
+  for (let i = 0; i < cases; i++) {
+    const shape = Array.from({ length: rank }, () => Number(take(8).readBigUInt64LE()));
+    const length = countElements(shape);
+    const samples = Array.from({ length: repetitions }, () => take(4).readFloatLE());
+    if (samples.some(time => !Number.isFinite(time) || time < 0)) throw Error('Invalid CUDA event time');
+    const payload = take(length * 4);
+    const data = new Float32Array(length);
+    payload.copy(Buffer.from(data.buffer));
+    const measured = (repetitions === 1 ? samples : samples.slice(1)).toSorted((a, b) => a - b);
+    const gpuMs = measured[Math.floor(measured.length / 2)];
+    outputs.push({ shape, data, gpuMs, samples });
+  }
+  if (pos !== bytes.length) throw Error('Trailing bytes in CUDA result');
+  return outputs;
+}
+
+export async function runCudaBatch(
+  fn: Fn,
+  source: string,
+  cases: readonly F32Inputs[],
+  options: { host?: string; timed?: boolean; repetitions?: number } = {},
+) {
+  const repetitions = options.repetitions ?? 1;
+  const bytes = encodeCases(fn, cases);
+  const dir = await mkdtemp('/tmp/irwb-tix-cuda-');
+  try {
+    await Promise.all([
+      writeFile(join(dir, 'main.cu'), source),
+      writeFile(join(dir, inputFile), bytes),
+    ]);
+    const args = [tool, dir, '--host', options.host ?? defaultHost, '--input', inputFile];
+    if (options.timed) args.push('--timed');
+    args.push('--', String(repetitions));
+    let remote: RemoteResult;
+    try {
+      const { stdout } = await launchTool(process.execPath, args);
+      remote = JSON.parse(stdout) as RemoteResult;
+      if (remote.exit !== 0 || !remote.outputs?.includes('results.bin')) throw Error('Missing CUDA result');
+    } catch (error) {
+      const failure = error as Error & { stdout?: string; stderr?: string };
+      throw Error('Remote CUDA job failed: ' + (failure.stdout?.trim() || failure.stderr?.trim() || failure.message));
+    }
+    const output = await readFile(join(dir, 'out', 'results.bin'));
+    return { outputs: decodeResults(output, cases.length, fn.shape.length, repetitions), remote };
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
diff --git a/src/tensor/cuda-source.ts b/src/tensor/cuda-source.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a0cf7a41bc069d006834e2417e341da659a6ed92
--- /dev/null
+++ b/src/tensor/cuda-source.ts
@@ -0,0 +1,327 @@
+import { width, plain, visit, type Affine, type Expr, type Extent, type Fn, type Op, type Statement } from './model.js';
+
+export const inputMagic = 0x31584954;
+export const resultMagic = 0x31524954;
+export const protocolVersion = 1;
+
+const scalarOps: Record<Exclude<Op, 'neg'>, string> = {
+  '+': '__fadd_rn',
+  '-': '__fsub_rn',
+  '*': '__fmul_rn',
+  '/': '__fdiv_rn',
+  exp: 'expf',
+  log: 'logf',
+  sqrt: '__fsqrt_rn',
+  tanh: 'tanhf',
+  max: 'tix_max',
+  min: 'tix_min',
+};
+
+const header = `
+#include <cuda_runtime.h>
+#include <math_constants.h>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <vector>
+
+static_assert(__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__ && sizeof(float) == 4,
+              "Tix I/O requires a little-endian f32 host");
+
+__device__ float tix_max(float a, float b) {
+  if (isnan(a) || isnan(b)) return CUDART_NAN_F;
+  if (a == 0 && b == 0) return __uint_as_float(__float_as_uint(a) & __float_as_uint(b));
+  return a > b ? a : b;
+}
+
+__device__ float tix_min(float a, float b) {
+  if (isnan(a) || isnan(b)) return CUDART_NAN_F;
+  if (a == 0 && b == 0) return __uint_as_float(__float_as_uint(a) | __float_as_uint(b));
+  return a < b ? a : b;
+}
+
+static void fail(const char *message) {
+  std::fprintf(stderr, "%s\\n", message);
+  std::exit(1);
+}
+
+static void check(cudaError_t status) {
+  if (status != cudaSuccess) fail(cudaGetErrorString(status));
+}
+
+template <class T> static T read(FILE *file) {
+  T value;
+  if (std::fread(&value, sizeof(T), 1, file) != 1) fail("Truncated input");
+  return value;
+}
+
+template <class T> static void write(FILE *file, T value) {
+  if (std::fwrite(&value, sizeof(T), 1, file) != 1) fail("Could not write output");
+}
+
+template <size_t Rank> static std::array<long long, Rank> read_shape(FILE *in) {
+  std::array<long long, Rank> shape;
+  for (auto &extent : shape) {
+    auto value = read<uint64_t>(in);
+    if (value > std::numeric_limits<long long>::max()) fail("Unsupported input extent");
+    extent = static_cast<long long>(value);
+  }
+  return shape;
+}
+
+template <size_t Rank> static size_t elements(const std::array<long long, Rank> &shape) {
+  for (auto extent : shape) {
+    if (extent < 0) fail("Negative extent");
+  }
+  for (auto extent : shape) {
+    if (extent == 0) return 0;
+  }
+  size_t count = 1;
+  for (auto extent : shape) {
+    if (uint64_t(extent) > std::numeric_limits<size_t>::max() / sizeof(float) / count)
+      fail("Tensor size exceeds device address space");
+    count *= extent;
+  }
+  return count;
+}
+
+struct DeviceBuffer {
+  float *ptr = nullptr;
+  size_t count;
+  explicit DeviceBuffer(size_t n) : count(n) {
+    if (count) check(cudaMalloc(&ptr, count * sizeof(float)));
+  }
+  ~DeviceBuffer() {
+    if (ptr) check(cudaFree(ptr));
+  }
+};
+
+static void read_tensor(FILE *in, DeviceBuffer &tensor) {
+  if (!tensor.count) return;
+  std::vector<float> data(tensor.count);
+  if (std::fread(data.data(), sizeof(float), tensor.count, in) != tensor.count)
+    fail("Truncated input tensor");
+  check(cudaMemcpy(tensor.ptr, data.data(), tensor.count * sizeof(float), cudaMemcpyHostToDevice));
+}
+
+template <size_t Rank> static void write_tensor(
+    FILE *out, const std::array<long long, Rank> &shape, const DeviceBuffer &tensor,
+    const std::vector<float> &times) {
+  for (auto extent : shape) write<uint64_t>(out, extent);
+  for (auto time : times) write(out, time);
+  if (!tensor.count) return;
+  std::vector<float> data(tensor.count);
+  check(cudaMemcpy(data.data(), tensor.ptr, tensor.count * sizeof(float), cudaMemcpyDeviceToHost));
+  if (std::fwrite(data.data(), sizeof(float), tensor.count, out) != tensor.count)
+    fail("Could not write output tensor");
+}
+
+static constexpr unsigned threads = 128;
+
+static unsigned blocks(size_t count, unsigned limit) {
+  size_t n = count / threads + (count % threads != 0);
+  if (n > limit) fail("Output does not fit CUDA grid");
+  return static_cast<unsigned>(n);
+}
+`;
+
+function affine(form: Affine, names: ReadonlyMap<string, string>): string {
+  const terms = form.terms.map(([name, scale]) =>
+    scale === 1 ? names.get(name)! : `(${scale}LL * ${names.get(name)})`,
+  );
+  if (form.constant || terms.length === 0) terms.unshift(`${form.constant}LL`);
+  return terms.length === 1 ? terms[0] : `(${terms.join(' + ')})`;
+}
+
+function literal(text: string) {
+  const storage = new Float32Array([Number(text)]);
+  return `__uint_as_float(0x${new Uint32Array(storage.buffer)[0].toString(16)}U)`;
+}
+
+export function emitCuda(fn: Fn): string {
+  const lines: string[] = [header];
+  let indent = 0;
+  const line = (text: string) => lines.push('  '.repeat(indent) + text);
+  const block = (text: string, body: () => void) => {
+    line(text + ' {');
+    indent++;
+    body();
+    indent--;
+    line('}');
+  };
+
+  const tensors = new Map([...fn.params, ...fn.statements].map((t, i) => [t.name, { ...t, slot: i }]));
+  const shapeVars = new Map<string, string>();
+  const shapeBindings: string[] = [];
+  fn.params.forEach((p, slot) => p.shape.forEach((form, axis) => {
+    const name = plain(form);
+    if (name && !shapeVars.has(name)) {
+      const variable = `dim${shapeVars.size}`;
+      shapeVars.set(name, variable);
+      shapeBindings.push(`const long long ${variable} = shape${slot}[${axis}];`);
+    }
+  }));
+  const dims = [...shapeVars.values()];
+  const reads = (s: Statement) => {
+    const names = new Set<string>();
+    visit(s.expr, e => { if (e.kind === 'load') names.add(e.name); });
+    return [...names].map(name => tensors.get(name)!.slot);
+  };
+  const dependencies = fn.statements.map(reads);
+
+  fn.statements.forEach((s, i) => {
+    const slot = tensors.get(s.name)!.slot;
+    const params = [
+      'size_t count',
+      ...dims.map(d => `long long ${d}`),
+      ...dependencies[i].map(n => `const float *tensor${n}`),
+      `float *tensor${slot}`,
+    ];
+    block(`__global__ void statement${i}(${params.join(', ')})`, () => {
+      if (s.shape.some(d => !d.terms.length && d.constant === 0)) return;
+      line('const size_t element = size_t(blockIdx.x) * blockDim.x + threadIdx.x;');
+      line('if (element >= count) return;');
+      if (s.axes.length > 1) line('long long remaining = element;');
+      const indices = new Map<string, string>();
+      let next = 0;
+      for (let k = s.axes.length - 1; k >= 0; k--) {
+        const name = `index${next++}`;
+        indices.set(s.axes[k].id, name);
+        const extent = affine(s.shape[k], shapeVars);
+        if (s.axes.length === 1) line(`const long long ${name} = element;`);
+        else if (k === 0) line(`const long long ${name} = remaining;`);
+        else {
+          line(`const long long ${name} = remaining % ${extent};`);
+          line(`remaining /= ${extent};`);
+        }
+      }
+      function extent(e: Extent) {
+        const dim = affine(e.dim, shapeVars);
+        if (e.kind === 'dim') return dim;
+        if (e.kind === 'blocks')
+          return e.rounding === 'ceil'
+            ? `${dim} / ${width}LL + (${dim} % ${width}LL != 0)`
+            : `${dim} / ${width}LL`;
+        return `min(${width}LL, ${dim} - ${width}LL * ${indices.get(e.block)})`;
+      }
+      function scalar(e: Expr): string {
+        if (e.kind === 'reduce') {
+          const acc = `value${next++}`;
+          line(`float ${acc} = ${e.op === 'sum' ? '0.0f' : '-CUDART_INF_F'};`);
+          function loops(k: number) {
+            if (k === e.axes.length) {
+              const term = scalar(e.body);
+              line(`${acc} = ${e.op === 'sum' ? '__fadd_rn' : 'tix_max'}(${acc}, ${term});`);
+              return;
+            }
+            const axis = e.axes[k];
+            const index = `index${next++}`;
+            const end = extent(axis.extent);
+            block(`for (long long ${index} = 0, end = ${end}; ${index} < end; ++${index})`, () => {
+              indices.set(axis.id, index);
+              loops(k + 1);
+              indices.delete(axis.id);
+            });
+          }
+          loops(0);
+          return acc;
+        }
+        let expression: string;
+        switch (e.kind) {
+          case 'literal':
+            expression = literal(e.text);
+            break;
+          case 'shape':
+            expression = `__ll2float_rn(${shapeVars.get(e.name)})`;
+            break;
+          case 'load': {
+            const t = tensors.get(e.name)!;
+            const addresses = e.indices.map(a => affine(a, indices));
+            const offset = addresses.slice(1).reduce(
+              (result, address, j) => `(${result} * ${affine(t.shape[j + 1], shapeVars)} + ${address})`,
+              addresses[0],
+            );
+            expression = `tensor${t.slot}[${offset}]`;
+            break;
+          }
+          case 'op': {
+            const args = e.args.map(scalar);
+            expression = e.op === 'neg' ? `-${args[0]}` : `${scalarOps[e.op]}(${args.join(', ')})`;
+            break;
+          }
+        }
+        const name = `value${next++}`;
+        line(`const float ${name} = ${expression};`);
+        return name;
+      }
+      const result = scalar(s.expr);
+      line(`tensor${slot}[element] = ${result};`);
+    });
+    line('');
+  });
+
+  block('int main(int argc, char **argv)', () => {
+    line('const int repeats = argc == 2 ? std::atoi(argv[1]) : 1;');
+    line('if (argc > 2 || repeats < 1) fail("Expected a positive repetition count");');
+    line('FILE *in = std::fopen("cases.bin", "rb");');
+    line('FILE *out = std::fopen("out/results.bin", "wb");');
+    line('if (!in || !out) fail("Could not open case or result file");');
+    line(`if (read<uint32_t>(in) != ${inputMagic}U || read<uint32_t>(in) != ${protocolVersion}U)`);
+    line('  fail("Unsupported input format");');
+    line('const auto count = read<uint32_t>(in);');
+    line(`write<uint32_t>(out, ${resultMagic}U);`);
+    line(`write<uint32_t>(out, ${protocolVersion}U);`);
+    line('write(out, count);');
+    if (fn.statements.length) {
+      line('cudaDeviceProp properties;');
+      line('check(cudaGetDeviceProperties(&properties, 0));');
+      line('cudaFuncAttributes attributes;');
+      fn.statements.forEach((_, i) => line(`check(cudaFuncGetAttributes(&attributes, statement${i}));`));
+      line('cudaEvent_t start, end;');
+      line('check(cudaEventCreate(&start));');
+      line('check(cudaEventCreate(&end));');
+    }
+    block('for (uint32_t c = 0; c < count; ++c)', () => {
+      fn.params.forEach((p, slot) => {
+        line(`const auto shape${slot} = read_shape<${p.shape.length}>(in);`);
+        line(`DeviceBuffer tensor${slot}(elements(shape${slot}));`);
+        line(`read_tensor(in, tensor${slot});`);
+      });
+      shapeBindings.forEach(line);
+      fn.statements.forEach((s, i) => {
+        const slot = tensors.get(s.name)!.slot;
+        line(`const std::array<long long, ${s.shape.length}> shape${slot} = {${s.shape.map(d => affine(d, shapeVars)).join(', ')}};`);
+        line(`DeviceBuffer tensor${slot}(elements(shape${slot}));`);
+        line(`const unsigned grid${i} = blocks(tensor${slot}.count, properties.maxGridSize[0]);`);
+      });
+      line('std::vector<float> times(repeats, 0.0f);');
+      if (fn.statements.length)
+        block(`if (${fn.statements.map((_, i) => `grid${i}`).join(' || ')})`, () => {
+          block('for (auto &time : times)', () => {
+            line('check(cudaEventRecord(start));');
+            fn.statements.forEach((s, i) => {
+              const slot = tensors.get(s.name)!.slot;
+              const args = [`tensor${slot}.count`, ...dims, ...dependencies[i].map(n => `tensor${n}.ptr`), `tensor${slot}.ptr`];
+              line(`if (grid${i}) statement${i}<<<grid${i}, threads>>>(${args.join(', ')});`);
+            });
+            line('check(cudaGetLastError());');
+            line('check(cudaEventRecord(end));');
+            line('check(cudaEventSynchronize(end));');
+            line('check(cudaEventElapsedTime(&time, start, end));');
+          });
+        });
+      const result = tensors.get(fn.result)!.slot;
+      line(`write_tensor(out, shape${result}, tensor${result}, times);`);
+    });
+    if (fn.statements.length) {
+      line('check(cudaEventDestroy(start));');
+      line('check(cudaEventDestroy(end));');
+    }
+    line('if (std::fgetc(in) != EOF || std::fclose(in) || std::fclose(out)) fail("Invalid case file or output");');
+    line('return 0;');
+  });
+  return lines.join('\n') + '\n';
+}
diff --git a/src/tensor/cuda.ts b/src/tensor/cuda.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f01313047343376b735af3da76a833eaf77a0456
--- /dev/null
+++ b/src/tensor/cuda.ts
@@ -0,0 +1,180 @@
+import {
+  AnalysisManager,
+  createArtifact,
+  defineIR,
+  defineTransformation,
+  defineType,
+  differential,
+  type Decided,
+  type DifferentialEvidence,
+} from '../framework/contracts/index.js';
+import type { Artifact } from '../framework/core/types.js';
+import type { TixProgram } from './index.js';
+import { runCudaBatch, type CudaResult } from './cuda-io.js';
+import { emitCuda, protocolVersion } from './cuda-source.js';
+import { evaluate, OutsideSample, type BufferValue } from './evaluate.js';
+import { TixIR } from './ir.js';
+import type { Module } from './model.js';
+import { sampleInputs, sampleSeed, tolerance, type F32Inputs } from './samples.js';
+
+export function functionNamed(module: Module, name: string) {
+  const fn = module.functions.find(f => f.name === name);
+  if (!fn) throw Error('Unknown function ' + name);
+  return fn;
+}
+
+interface TranslationUnit {
+  fn: string;
+  protocol: number;
+  source: string;
+}
+
+const CudaSourceIR = defineIR<TranslationUnit>({
+  id: 'tensor.cuda-source',
+  version: '1',
+  description: 'CUDA translation unit with the Tix case-file protocol',
+  validate(value) {
+    const unit = value as TranslationUnit;
+    if (!unit || typeof unit.fn !== 'string' || typeof unit.source !== 'string' ||
+        !unit.source || unit.protocol !== protocolVersion)
+      throw Error('Expected a Tix CUDA translation unit');
+  },
+});
+
+const FunctionName = defineType<string>({
+  id: 'tensor.function-name',
+  version: '1',
+  description: 'Tix function to lower',
+  validate(name) {
+    if (typeof name !== 'string' || !name) throw Error('Expected a function name');
+  },
+});
+
+export function lowerCuda(input: Artifact<Module>, name: string): Artifact<TranslationUnit> {
+  return createArtifact(CudaSourceIR, 'tix-cuda', {
+    fn: name,
+    protocol: protocolVersion,
+    source: emitCuda(functionNamed(input.value, name)),
+  });
+}
+
+export function cudaSource(program: TixProgram, fn: string): string {
+  return lowerCuda(program.current, fn).value.source;
+}
+
+export async function runTixCuda(
+  program: TixProgram,
+  fn: string,
+  inputs: F32Inputs,
+  options?: { host?: string },
+): Promise<CudaResult> {
+  const source = cudaSource(program, fn);
+  const { outputs: [{ shape, data, gpuMs }] } = await runCudaBatch(
+    functionNamed(program.current.value, fn), source, [inputs], options,
+  );
+  return { shape, data, gpuMs };
+}
+
+export function* loweringCases(fn: ReturnType<typeof functionNamed>, random: () => number) {
+  for (const sample of sampleInputs(fn, random, { signedZero: true, zeroShape: true })) {
+    try {
+      const reference = evaluate(fn, sample.inputs, 'f64', true);
+      if (reference.data.every(Number.isFinite)) yield { ...sample, reference };
+    } catch (error) {
+      if (!(error instanceof OutsideSample)) throw error;
+    }
+  }
+}
+
+function compare(ref: BufferValue, got: BufferValue): Decided {
+  if (ref.shape.length !== got.shape.length || ref.shape.some((n, i) => n !== got.shape[i]) ||
+      ref.data.length !== got.data.length)
+    return { v: 'disagree', reason: `Output shape or length differs: expected [${ref.shape}], got [${got.shape}]` };
+  for (let i = 0; i < ref.data.length; i++) {
+    const r = ref.data[i];
+    const g = got.data[i];
+    const limit = tolerance(r);
+    if (!Number.isFinite(g) || Math.abs(g - r) > limit) {
+      let at = i;
+      const coord = ref.shape.map(() => 0);
+      for (let j = coord.length - 1; j >= 0; j--) {
+        coord[j] = at % ref.shape[j];
+        at = Math.floor(at / ref.shape[j]);
+      }
+      return { v: 'disagree', reason: `at [${coord}] f64 expected ${r}, GPU got ${g}, allowed ${limit}` };
+    }
+  }
+  return { v: 'agree' };
+}
+
+const ports = { baseline: TixIR, subject: CudaSourceIR, fn: FunctionName };
+const meaning = differential<typeof ports, ReturnType<typeof loweringCases> extends Generator<infer Case> ? Case : never, BufferValue>({
+  id: 'tensor.cuda.meaning',
+  version: '1',
+  description: 'CUDA keeps the selected Tix function within the sampled f64 tolerance',
+  inputs: ports,
+  baseline: 'baseline',
+  subject: 'subject',
+  seed: sampleSeed,
+  count: 24,
+  cases({ baseline, fn }, random) {
+    const cases = [...loweringCases(functionNamed(baseline.value, fn), random)];
+    if (!cases.length) throw Error('No comparable case for ' + fn);
+    return cases;
+  },
+  run() {
+    throw Error('CUDA comparison requires a GPU batch');
+  },
+  compare(baseline, subject) {
+    const result = compare(baseline, subject);
+    return result.v === 'disagree' ? { ok: false, reason: result.reason } : result.v === 'agree';
+  },
+  baselineKey: ({ baseline, fn }) => baseline.revision + '/' + fn,
+  subjectKey: candidate => candidate.revision,
+  describeCase: ({ fn, shapeValues, stream }) => ({ fn, shapeValues, stream, seed: sampleSeed }),
+  async decide({ baseline, subject, fn }, cases, todo) {
+    const { outputs } = await runCudaBatch(
+      functionNamed(baseline.value, fn),
+      subject.value.source,
+      todo.map(i => cases[i].inputs),
+    );
+    return todo.map((i, j) => compare(cases[i].reference, outputs[j]));
+  },
+});
+
+export const cudaLowering = defineTransformation({
+  id: 'tensor.cuda.lowering',
+  version: '1',
+  description: 'Lower Tix to checked CUDA C',
+  inputs: { input: TixIR, fn: FunctionName },
+  outputs: { output: CudaSourceIR },
+  cache: 'never',
+  ensures: [{
+    invariant: meaning,
+    bindings: {
+      baseline: { from: 'inputs', port: 'input' },
+      subject: { from: 'outputs', port: 'output' },
+      fn: { from: 'inputs', port: 'fn' },
+    },
+  }],
+  run: (_, { input, fn }) => ({ outputs: { output: lowerCuda(input, fn) } }),
+});
+
+export async function checkLowering(
+  program: TixProgram,
+  fn: string,
+): Promise<{ accepted: boolean; relation: 'exact' | 'tolerance'; reason?: string }> {
+  const manager = new AnalysisManager();
+  try {
+    await manager.execute(cudaLowering, { input: program.current, fn });
+    return { accepted: true, relation: 'tolerance' };
+  } catch (error) {
+    const checked = manager.snapshot().executions[0]?.checks[0];
+    const evidence = checked?.evidence as DifferentialEvidence | undefined;
+    const mismatch = evidence?.counterexamples[0];
+    const reason = mismatch
+      ? `${JSON.stringify(mismatch.case)}: ${mismatch.reason}`
+      : (error as Error).message;
+    return { accepted: false, relation: 'tolerance', reason };
+  }
+}
