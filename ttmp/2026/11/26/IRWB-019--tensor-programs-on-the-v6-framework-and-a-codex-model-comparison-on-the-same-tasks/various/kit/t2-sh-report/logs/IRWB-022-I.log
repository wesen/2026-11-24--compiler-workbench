    71	  const outputs = { subject: CudaIR };
    72	  const ports = { ...inputs, ...outputs };
    73	  const invariant = differential<typeof ports, CudaSample, BufferValue>({
    74	    id: 'tensor.cuda-meaning',
    75	    version: '1',
    76	    description: 'Compare the lowered CUDA function to its current Tix f64 meaning',
    77	    inputs: ports,
    78	    baseline: 'baseline',
    79	    subject: 'subject',
    80	    // The recipe is shape-dependent and supplies its whole eligible case set.
    81	    count: 1,
    82	    seed,
    83	    cases: ({ baseline, fn }, random) => {
    84	      const samples = cudaCases(selectFunction(baseline.value, fn), random);
    85	      if (!samples.length) throw Error('No eligible CUDA check cases for ' + fn);
    86	      return samples;
    87	    },
    88	    run: (side, _artifact, sample) => {
    89	      if (side === 'baseline') return sample.reference;
    90	      throw Error('CUDA checks require the batch executor');
    91	    },
    92	    compare,
    93	    describeCase: ({ fn, shapeValues, stream }) => ({ fn, shapeValues, stream, seed }),
    94	    baselineKey: ({ baseline, fn }) => JSON.stringify([baseline.revision, fn]),
    95	    subjectKey: (_artifact, _case, { subject }) => JSON.stringify([subject.revision, profile]),
    96	    async decide({ baseline, fn, subject }, cases, todo) {
    97	      if (subject.value.fn !== fn)
    98	        return todo.map(() => ({ v: 'disagree', reason: 'CUDA function differs' }));
    99	      const pending = todo.map(i => cases[i]);
   100	      const results = await executeBatch(
   101	        subject.value.source,
   102	        selectFunction(baseline.value, fn),
   103	        pending.map(c => c.inputs),
   104	      );
   105	      if (results.length !== pending.length) throw Error('Wrong CUDA response case count');
   106	      return pending.map((sample, i): Decided => {
   107	        const result = compare(sample.reference, results[i]);
   108	        return result.ok ? { v: 'agree' } : { v: 'disagree', reason: result.reason! };
   109	      });
