    48	function compare(expected: BufferValue, got: BufferValue) {
    49	  if (expected.shape.length !== got.shape.length || expected.shape.some((n, i) => n !== got.shape[i]))
    50	    return { ok: false, reason: 'Output shape differs' };
    51	  if (expected.data.length !== got.data.length) return { ok: false, reason: 'Output length differs' };
    52	  for (const [i, ref] of expected.data.entries()) {
    53	    const actual = got.data[i];
    54	    const tolerance = 2e-6 + 2e-5 * Math.abs(ref);
    55	    const agrees = Number.isFinite(ref)
    56	      ? Number.isFinite(actual) && Math.abs(actual - ref) <= tolerance
    57	      : Object.is(actual, ref);
    58	    if (!agrees) {
    59	      const at = coordinate(expected.shape, i);
    60	      const budget = Number.isFinite(ref) ? ` (tolerance ${tolerance})` : '';
    61	      return { ok: false, reason: `At [${at}], expected ${ref}, got ${actual}${budget}` };
    62	    }
    63	  }
    64	  return { ok: true };
    65	}
