  assert.doesNotMatch(b.listing('total'), /t3 = i/);
  assert.equal(S.measure(a, a.head).instructions, 1410);
  assert.equal(S.measure(b, b.head).instructions, 1260);
  assert.equal(b.check().status, 'agree');
});

