All shapes matched the requested computations. Both endpoints agreed within the chosen numeric allowance in every run. The small-case check uses f64 as its reference; these large-case spot checks use local f32.
import { readFileSync } from 'node:fs';

const data = readFileSync(new URL('./01-gb10/out/results.bin', import.meta.url));
const names = ['add','sub','mul','div','neg','exp','log','sqrt','tanh','max','min','sum7'];
const round = Math.fround;
const rows = names.map(op => ({ op, bitDifferences: 0, worstBudgetFraction: 0, first: null }));
if (data.length !== 8192 * names.length * 4) throw Error('Incomplete result');
for (let i = 0; i < 8192; i++) {
  const x = (i - 4096) / 1024, y = (i + 1) / 1024;
  let sum = 0, sum32 = 0;
  for (let j = 1; j <= 7; j++) {
    sum += x * (y / j);
    sum32 = round(sum32 + round(x * round(y / j)));
  }
  const ref = [x+y,x-y,x*y,x/y,-x,Math.exp(x),Math.log(y),Math.sqrt(y),Math.tanh(x),
    Math.max(x,y),Math.min(x,y),sum];
  for (const [k, r] of ref.entries()) {
    const gpu = data.readFloatLE((i * names.length + k) * 4);
    const expected = k === names.length - 1 ? sum32 : round(r);
    const row = rows[k];
    if (!Object.is(gpu, expected)) {
      row.bitDifferences++;
      row.first ??= { i, x, y, expected, gpu };
    }
    const fraction = Math.abs(gpu - r) / (2e-6 + 2e-5 * Math.abs(r));
    if (!(fraction <= 1)) throw Error(JSON.stringify({ i, k, gpu, r }));
    row.worstBudgetFraction = Math.max(row.worstBudgetFraction, fraction);
  }
}
console.log(JSON.stringify(rows, null, 2));
import { readFileSync } from 'node:fs';
import { compileTix, runTix } from '../../../../../../dist/tensor/index.js';
import { value } from '../../../../../../dist/tensor/model.js';
import { seededRandom } from '../../../../../../dist/framework/contracts/index.js';
const shapes = {
  matmul: { M: 512, K: 512, N: 512 },
  softmax: { N: 4096, C: 1024 },
  layernorm: { N: 4096, D: 1024 },
  attention: { Q: 1024, K: 1024, D: 64, V: 64 },
  mlp: { N: 1024, D: 256, H: 1024, O: 256 },
  conv2d: { N: 8, C: 16, H: 64, W: 64, O: 32 },
};
for (const [fn, dimensions] of Object.entries(shapes)) {
  const p = compileTix(readFileSync('corpus/tensor/' + fn + '/main.tix', 'utf8'));
  const f = p.current.value.functions[0];
  function inputsFor(dims) {
    const random = seededRandom(20);
    return Object.fromEntries(
      f.params.map(param => {
        const shape = param.shape.map(a => value(a, new Map(Object.entries(dims))));
        const data = Float32Array.from({ length: shape.reduce((a, b) => a * b, 1) }, () =>
          param.name === 'eps' ? 1e-5 : random() * 2 - 1,
        );
        return [param.name, { shape, data }];
      }),
    );
  }
  const inputs = inputsFor(dimensions);
  let result, ms;
  if (process.argv[2] === 'gpu') {
    const { runBatch } = await import('../../../../../../dist/tensor/cuda-run.js');
    const { cudaSource } = await import('../../../../../../dist/tensor/index.js');
    [result] = await runBatch(cudaSource(p, fn), f, [inputs], { benchmark: true });
    ms = result.gpuMs;
  } else {
    runTix(p, fn, inputsFor(Object.fromEntries(Object.keys(dimensions).map(k => [k, 4]))));
    const start = performance.now();
    result = runTix(p, fn, inputs);
    ms = performance.now() - start;
  }
  console.log(
    JSON.stringify({ fn, ms, shape: result.shape, first: result.data[0], last: result.data.at(-1) }),
  );
}
