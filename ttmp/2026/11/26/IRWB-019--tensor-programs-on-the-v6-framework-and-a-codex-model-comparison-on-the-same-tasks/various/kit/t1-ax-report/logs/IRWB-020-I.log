   193	function identity<S>(pass: { id: string; version: string }, before: Artifact<S>): PassResult<S> {
   194	  return {
   195	    pass: { id: pass.id, version: pass.version },
   196	    changed: false,
   197	    before,
   198	    artifact: before,
   199	    edits: 0,
   200	    preserved: [],
   201	  };
   202	}
   203	
   204	function checkedChanges<S>(
   205	  pass: PassSpec<S, any, any>,
   206	  before: Artifact<S>,
   207	  after: Artifact<S>,
   208	  changes: ChangeSet,
   209	  correspondence: EntityCorrespondence,
   210	  edits: number,
   211	  report?: unknown,
   212	): PassResult<S> {
   213	  if (after.revision === before.revision && !changes.entities.length && !changes.relations.length)
   214	    return identity(pass, before);
   215	  const undeclared = undeclaredWrites(pass.writes, changes);
   216	  if (undeclared.length)
   217	    throw new PassError('undeclaredWrite', `Pass ${pass.id} changed kinds it did not declare in writes`, {
   218	      undeclared: undeclared.slice(0, 20),
   219	    });
   220	  return {
   221	    pass: { id: pass.id, version: pass.version },
   222	    changed: true,
   223	    before,
   224	    artifact: after,
   225	    changes,
   226	    correspondence,
   227	    edits,
   228	    preserved: [],
   229	    report,
   230	  };
   231	}
