fn matmul(a: f32[M,K], b: f32[K,N]): f32[M,N] {
  c[i,j] = sum(k) a[i,k] * b[k,j];
  return c;
}
fn conv2d(x: f32[N,C,H,W], w: f32[O,C,3,3]): f32[N,O,H-2,W-2] {
  y[n,o,oy,ox]: f32[N,O,H-2,W-2] = sum(c,dy,dx) x[n,c,oy+dy,ox+dx] * w[o,c,dy,dx];
  return y;
}
fn attention(q: f32[Q,D], k: f32[K,D], v: f32[K,V]): f32[Q,V] {
  score[i,j] = (sum(d) q[i,d] * k[j,d]) / sqrt(D);
  peak[i] = max(j) score[i,j];
  weight[i,j] = exp(score[i,j] - peak[i]);
  total[i] = sum(j) weight[i,j];
  prob[i,j] = weight[i,j] / total[i];
  y[i,h] = sum(j) prob[i,j] * v[j,h];
  return y;
}
fn mlp(x: f32[N,I], w1: f32[I,H], b1: f32[H], w2: f32[H,O], b2: f32[O]): f32[N,O] {
  h[n,j] = (sum(i) x[n,i] * w1[i,j]) + b1[j];
  // tanh-GELU with sqrt(2/pi) rounded at the evaluating precision
  g[n,j] = 0.5 * h[n,j] * (1 + tanh(0.7978845608028654 * (h[n,j] + 0.044715 * h[n,j] * h[n,j] * h[n,j])));
  y[n,o] = (sum(j) g[n,j] * w2[j,o]) + b2[o];
  return y;
}
fn layernorm(x: f32[N,D], gamma: f32[D], beta: f32[D], eps: f32[1]): f32[N,D] {
  mean[i] = (sum(d) x[i,d]) / D;
  centered[i,d] = x[i,d] - mean[i];
  variance[i] = (sum(d) centered[i,d] * centered[i,d]) / D;
  y[i,d] = centered[i,d] / sqrt(variance[i] + eps[0]) * gamma[d] + beta[d];
  return y;
}
