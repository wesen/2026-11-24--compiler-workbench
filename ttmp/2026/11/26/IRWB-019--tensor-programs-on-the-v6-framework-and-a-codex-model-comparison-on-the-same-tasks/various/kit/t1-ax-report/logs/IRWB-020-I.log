   262	/** Synchronous native kernels with a caller-supplied meaning invariant and no managed analysis clauses. */
   263	export function applyNativePassSync<S>(
   264	  pass: Pass<S, {}, void>,
   265	  before: Artifact<S>,
   266	  verify: (before: Artifact<S>, after: Artifact<S>) => CheckResult,
   267	): PassResult<S> {
   268	  if (Object.keys(pass.needs ?? {}).length || pass.preserves?.length || pass.contract)
   269	    throw new PassError('badResult', 'Managed pass clauses require applyPass');
   270	  const view = openIR(before, pass.adapter);
   271	  const result = synchronous(
   272	    pass.run({
   273	      before,
   274	      view,
   275	      facts: {},
   276	      records: {},
   277	      params: undefined,
   278	      get edit(): IREdit<S> {
   279	        throw new PassError('badResult', 'Synchronous native passes return a native result');
   280	      },
   281	    }),
   282	    'Native pass',
   283	  );
   284	  if (result === undefined) return identity(pass, before);
   285	  if (!result || !('native' in result))
   286	    throw new PassError('badResult', 'Expected a synchronous native result');
   287	  const candidate = prepareNative(pass, before, view, result);
   288	  if (!candidate.changed) return candidate;
   289	  const check = synchronous(verify(before, candidate.artifact), 'Native pass verifier');
   290	  Check.validate(check);
   291	  if (!check.ok)
   292	    throw new PassError('contractRejected', check.reason ?? 'Native pass rejected', check.evidence);
   293	  return { ...candidate, contract: check };
   294	}
