   296	export async function applyPass<S, N extends Needs, P>(
   297	  pass: Pass<S, N, P>,
   298	  before: Artifact<S>,
   299	  options: ApplyOptions<P>,
   300	): Promise<PassResult<S>> {
   301	  const { manager } = options;
   302	  const view = openIR(before, pass.adapter, options.store);
   303	  const facts: Record<string, unknown> = {},
   304	    records: Record<string, AnalysisRecord<unknown>> = {};
   305	  for (const [name, def] of Object.entries(pass.needs ?? {})) {
   306	    const record = await manager.analyse(def, before);
   307	    records[name] = record;
   308	    facts[name] = record.value;
   309	  }
   310	  options.store?.assertHead(before);
   311	  const generation = options.store?.generation(before.id);
   312	  let edit: IREdit<S> | undefined;
   313	  let running = true;
   314	  let produced: void | NativeResult<S>;
   315	  try {
   316	    produced = await pass.run({
   317	      before,
   318	      view,
   319	      facts: facts as FactValues<N>,
   320	      records: records as PassRunContext<S, N, P>['records'],
   321	      params: options.params as P,
   322	      get edit() {
   323	        if (!edit) {
   324	          if (!running) throw new PassError('badResult', 'Pass body has returned');
   325	          options.store?.assertHead(before, generation);
   326	          edit = view.beginEdit();
   327	        }
   328	        return edit;
   329	      },
   330	    });
   331	  } catch (e) {
   332	    if (edit?.state === 'open') edit.rollback('pass threw');
   333	    throw e;
   334	  } finally {
   335	    running = false;
   336	  }
   337	  let candidate: PassResult<S>;
   338	  if (produced && typeof produced === 'object' && 'native' in produced) {
   339	    if (edit?.state === 'open') edit.rollback('native result');
   340	    candidate = prepareNative(pass, before, view, produced, options.outputId, options.store);
   341	  } else {
   342	    if (!edit) return identity(pass, before);
   343	    if (edit.state !== 'open') throw new PassError('badResult', `Pass ${pass.id} closed its edit itself`);
   344	    if (edit.operationCount === 0) {
   345	      edit.rollback('no operations');
   346	      return identity(pass, before);
   347	    }
   348	    const prepared = edit.prepare();
   349	    edit.rollback('applyPass publishes revisions itself');
   350	    candidate = checkedChanges(
   351	      pass,
   352	      before,
   353	      prepared.artifact,
   354	      prepared.changes,
   355	      prepared.correspondence,
   356	      prepared.changes.operations.filter(o => o.kind !== 'correspond').length,
   357	    );
   358	  }
   359	  if (!candidate.changed) return candidate;
   360	  const after = candidate.artifact,
   361	    correspondence = candidate.correspondence!;
   362	  let contract: unknown;
   363	  const gate = options.contract ?? pass.contract;
   364	  if (gate) {
   365	    try {
   366	      const prepared = await manager.verifyTransformation(
   367	        { input: before, ...(options.contractInputs ?? {}) } as never,
   368	        { output: after } as never,
   369	        gate,
   370	        gate.correspondence.length
   371	          ? gate.correspondence.map(req => semanticCorrespondence(correspondence, req.id, req.relation))
   372	          : [semanticCorrespondence(correspondence)],
   373	      );
   374	      contract = prepared;
   375	    } catch (e) {
   376	      throw new PassError('contractRejected', `Pass ${pass.id} output rejected: ${(e as Error).message}`, {
   377	        cause: String(e),
   378	      });
   379	    }
   380	  }
   381	
   382	  const preserved: PreservationOutcome[] = [];
   383	  for (const def of pass.preserves ?? []) {
   384	    if (!manager.hasAnalysis(def, before)) {
   385	      if (!options.auditPreservation) continue; // nothing to keep
   386	      await manager.analyse(def, before);
   387	    }
   388	    try {
   389	      const record = await manager.preserve(def, before, after, semanticCorrespondence(correspondence));
   390	      preserved.push({ analysis: def.id, how: 'transferred', evidence: record.transfer?.evidence });
   391	    } catch {
   392	      const old = await manager.analyse(def, before),
   393	        fresh = await manager.analyse(def, after);
   394	      if (canonical(old.value) !== canonical(fresh.value))
   395	        throw new PassError(
   396	          'preserveViolated',
   397	          `Pass ${pass.id} claims to preserve ${def.id}, but it changed`,
   398	          {
   399	            analysis: def.id,
   400	          },
   401	        );
   402	      preserved.push({ analysis: def.id, how: 'confirmed-by-recompute', evidence: { equalValue: true } });
   403	    }
   404	  }
   405	  return { ...candidate, preserved, contract };
   406	}
