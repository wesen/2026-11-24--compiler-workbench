   233	function prepareNative<S>(
   234	  pass: PassSpec<S, any, any>,
   235	  before: Artifact<S>,
   236	  view: IRView<S>,
   237	  produced: NativeResult<S>,
   238	  outputId = before.id,
   239	  store?: IRStore,
   240	): PassResult<S> {
   241	  const after = createIRArtifact(pass.adapter, outputId, produced.native);
   242	  const afterView = openIR(after, pass.adapter, store);
   243	  const changes = diff(view, afterView);
   244	  const correspondence = makeCorrespondence(
   245	    { artifact: before.id, revision: before.revision },
   246	    { artifact: after.id, revision: after.revision },
   247	    view.graph().entities.map(e => e.id),
   248	    afterView.graph().entities.map(e => e.id),
   249	    produced.correspondence ?? [],
   250	  );
   251	  return checkedChanges(
   252	    pass,
   253	    before,
   254	    after,
   255	    changes,
   256	    correspondence,
   257	    produced.edits ?? changes.entities.length,
   258	    produced.report,
   259	  );
   260	}
