fn attention(q: f32[Q,D], k: f32[K,D], v: f32[K,V]): f32[Q,V] {
  logits[i,j] = (sum(d) q[i,d] * k[j,d]) / sqrt(D);
  m[i] = max(j) logits[i,j];
  e[i,j] = exp(logits[i,j] - m[i]);
  total[i] = sum(j) e[i,j];
  weights[i,j] = e[i,j] / total[i];
  y[i,c] = sum(j) weights[i,j] * v[j,c];
  return y;
}
fn conv2d(x: f32[N,C,H,W], w: f32[O,C,3,3]): f32[N,O,H-2,W-2] {
  y[n,o,y,xpos]: f32[N,O,H-2,W-2] = sum(c,dy,dx) x[n,c,y+dy,xpos+dx] * w[o,c,dy,dx];
  return y;
}
fn layernorm(x: f32[N,D], gamma: f32[D], beta: f32[D]): f32[N,D] {
  mean[i] = (sum(j) x[i,j]) / D;
  centered[i,j] = x[i,j] - mean[i];
  variance[i] = (sum(j) centered[i,j] * centered[i,j]) / D;
  y[i,j] = gamma[j] * (centered[i,j] / sqrt(variance[i] + 1e-5)) + beta[j];
  return y;
}
fn matmul(a: f32[M,K], b: f32[K,N]): f32[M,N] {
  y[i,j] = sum(k) a[i,k] * b[k,j];
