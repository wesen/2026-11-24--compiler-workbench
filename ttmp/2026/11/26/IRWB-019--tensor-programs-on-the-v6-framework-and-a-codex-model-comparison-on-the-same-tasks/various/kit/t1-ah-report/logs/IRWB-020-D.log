export type Affine = { constant: number; terms: [string, number][] };
export type Axis = { id: string; extent: Affine };
export type Unary = '-' | 'exp' | 'log' | 'sqrt' | 'tanh';
export type Binary = '+' | '-' | '*' | '/' | 'min' | 'max';
export type Expr = { at: string } & (
  | { kind: 'literal'; value: string }
  | { kind: 'shape'; name: string }
  | { kind: 'load'; tensor: string; indices: Affine[] }
  | { kind: 'unary'; op: Unary; arg: Expr }
  | { kind: 'binary'; op: Binary; left: Expr; right: Expr }
  | { kind: 'reduce'; op: 'sum' | 'max'; axes: Axis[]; body: Expr }
  | { kind: 'blocked'; size: number; axes: [Axis]; body: Expr }
);
export type Param = { name: string; shape: Affine[] };
export type Statement = { name: string; axes: Axis[]; expr: Expr };
export type Fn = { name: string; params: Param[]; statements: Statement[]; result: string; shape: Affine[] };
export type Module = { functions: Fn[] };
export type Bindings = Map<string, number>;

export const constant = (n: number): Affine => ({ constant: n, terms: [] });
export const variable = (name: string): Affine => ({ constant: 0, terms: [[name, 1]] });
export function plain(a: Affine): string | undefined {
  if (a.constant === 0 && a.terms.length === 1 && a.terms[0][1] === 1) return a.terms[0][0];
}
export function scale(a: Affine, k: number): Affine {
  return { constant: a.constant * k, terms: k === 0 ? [] : a.terms.map(([n, v]) => [n, v * k]) };
}
export function add(a: Affine, b: Affine): Affine {
  const terms = new Map(a.terms);
  for (const [name, v] of b.terms) terms.set(name, (terms.get(name) ?? 0) + v);
  return {
    constant: a.constant + b.constant,
    terms: [...terms].filter(([, v]) => v !== 0).sort(([a], [b]) => (a < b ? -1 : 1)),
  };
}
export function substitute(a: Affine, bindings: Map<string, Affine>): Affine {
  return a.terms.reduce(
    (acc, [n, k]) => add(acc, scale(bindings.get(n) ?? variable(n), k)),
    constant(a.constant),
  );
}
export function same(a: Affine, b: Affine): boolean {
  return (
    a.constant === b.constant &&
    a.terms.length === b.terms.length &&
    a.terms.every(([n, k], i) => n === b.terms[i][0] && k === b.terms[i][1])
  );
}
export function sameShape(a: Affine[], b: Affine[]): boolean {
  return a.length === b.length && a.every((d, i) => same(d, b[i]));
}
  '+': (x, y) => x + y,
  '-': (x, y) => x - y,
  '*': (x, y) => x * y,
  '/': (x, y) => x / y,
  min: Math.min,
  max: Math.max,
};
export const volume = (shape: number[]) => shape.reduce((n, d) => n * d, 1);
export function evaluate(fn: Fn, inputs: Inputs, precision: Precision): Tensor {
  const round = precision === 'f32' ? Math.fround : Number;
  const Buffer = precision === 'f32' ? Float32Array : Float64Array;
  const shapes: Bindings = new Map(),
    coords: Bindings = new Map();
  const tensors = new Map<string, { tensor: Tensor; strides: number[] }>();
  function store(name: string, tensor: Tensor) {
    let stride = 1;
    const strides = tensor.shape.map(() => 0);
    for (let i = strides.length - 1; i >= 0; i--) {
      strides[i] = stride;
      stride *= tensor.shape[i];
    }
    tensors.set(name, { tensor, strides });
  }
  for (const p of fn.params) {
    const input = inputs[p.name];
    p.shape.forEach((a, i) => {
      const n = plain(a);
      if (n !== undefined) shapes.set(n, input.shape[i]);
    });
    store(p.name, { shape: [...input.shape], data: new Buffer(input.data) });
  }
  const dims = new Map<Affine, number>();
  function extent(d: Affine) {
    let n = dims.get(d);
    if (n === undefined) {
      n = value(d, shapes);
      dims.set(d, n);
    }
    return n;
  }
  function loop(axes: Axis[], body: () => void, depth = 0): void {
    if (depth === axes.length) {
      body();
      return;
    }
    const axis = axes[depth],
      n = extent(axis.extent);
    for (let i = 0; i < n; i++) {
      coords.set(axis.id, i);
      loop(axes, body, depth + 1);
    }
  }
  function scalar(e: Expr): number {
    switch (e.kind) {
      case 'literal':
        return round(Number(e.value));
      case 'shape':
        return round(shapes.get(e.name)!);
      case 'load': {
        const { tensor, strides } = tensors.get(e.tensor)!;
        const offset = e.indices.reduce((acc, idx, i) => acc + value(idx, coords) * strides[i], 0);
        return tensor.data[offset];
      }
      case 'unary':
        return round(unary[e.op](scalar(e.arg)));
      case 'binary':
        return round(binary[e.op](scalar(e.left), scalar(e.right)));
      case 'reduce': {
        const max = e.op === 'max';
        let acc = max ? -Infinity : 0;
        loop(e.axes, () => {
          const x = scalar(e.body);
          acc = round(max ? Math.max(acc, x) : acc + x);
        });
        return acc;
      }
      case 'blocked': {
        const axis = e.axes[0],
          n = extent(axis.extent);
        let total = 0;
        for (let start = 0; start < n; start += e.size) {
          let partial = 0;
          for (let k = start; k < Math.min(start + e.size, n); k++) {
            coords.set(axis.id, k);
            partial = round(partial + scalar(e.body));
          }
          total = round(total + partial);
        }
        return total;
      }
    }
  }
  for (const s of fn.statements) {
    const shape = s.axes.map(a => extent(a.extent)),
      data = new Buffer(volume(shape));
    let offset = 0;
    loop(s.axes, () => {
      data[offset++] = scalar(s.expr);
    });
    store(s.name, { shape, data });
  }
  return tensors.get(fn.result)!.tensor;
}

