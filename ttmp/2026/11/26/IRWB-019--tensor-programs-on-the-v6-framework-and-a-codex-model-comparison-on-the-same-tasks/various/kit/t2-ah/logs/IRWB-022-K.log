  const p = compileTix('fn f(x:f32[1,K]):f32[1]{y[i]=sum(k)x[i,k];return y;}' + never);
  const r = optimizeTix(p, ['split-sum', 'inline']);
  assert.deepEqual(
    r.steps.map(s => s.accepted),
    [false, true],
