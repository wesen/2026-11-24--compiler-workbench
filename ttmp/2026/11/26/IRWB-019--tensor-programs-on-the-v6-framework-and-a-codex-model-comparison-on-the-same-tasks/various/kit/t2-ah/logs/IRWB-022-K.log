});
// wrong: 2*x*x + y
const wrong = () => ({ ...rewritten(), nodes: { ...rewritten().nodes, sum: { op: 'add', args: ['a', 'y'] } } });

test('E5: the seeded generator is deterministic', () => {
  const a = seededRandom(3), b = seededRandom(3);
