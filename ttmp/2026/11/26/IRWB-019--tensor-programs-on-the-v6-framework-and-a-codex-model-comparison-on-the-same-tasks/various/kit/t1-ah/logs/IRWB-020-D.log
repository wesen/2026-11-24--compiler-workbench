          const r = ev(v.args[0]),
            p = ev(v.args[1]);
          check(r, 4);
          if (p >>> 0 >= mem.getInt32(r, true) >>> 0) throw new Trap('checked address out of range', id);
          return (r + (p << 1)) | 0;
        }
