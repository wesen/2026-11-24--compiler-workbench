  } catch (e) {
    if (e instanceof Trap)
      return {
        kind: 'run',
        engine: 'evaluator',
        trap: e.trap,
        at: e.at,
        limit: e.limit,
        steps,
        unit: 'statements',
        counts,
        bytes: image(),
