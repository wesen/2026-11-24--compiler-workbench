            throw t;
          }
          if (counts) counts.set(sid, (counts.get(sid) || 0) + 1);
          if (observe) observe(name, sid, L);
          const s = st.get(sid) as StmtRec;
          switch (s.op) {
            case 'set':
              L[s.local!] = ev(s.value!);
              break;
            case 'eval':
              ev(s.value!);
              break;
            case 'store': {
              const a = ev(s.addr!) + s.offset!,
