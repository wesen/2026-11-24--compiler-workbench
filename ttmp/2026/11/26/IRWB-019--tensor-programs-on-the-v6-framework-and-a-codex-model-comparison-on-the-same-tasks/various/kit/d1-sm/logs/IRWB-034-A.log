const sameTree = (st: Store, a: string, b: string): boolean => {
  const x = st.get(a) as ValueRec,
    y = st.get(b) as ValueRec;
  return (
    x.op === y.op &&
    x.imm === y.imm &&
    x.type === y.type &&
    x.args.length === y.args.length &&
    x.args.every((u, i) => sameTree(st, u, y.args[i]))
  );
};

