+    let index = i;
+    if (choose) {
+        cells[index] = 7;
+        cells[index] = 8;
+    }
+    const value = cells[index];
+    index = j;
+    return value + cells[index];
+}
+`,
+    'project.json': JSON.stringify({
+      ingest: { tape: true },
