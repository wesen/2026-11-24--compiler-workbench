  const params = [
    ...Array.from(dimensions.values(), d => `I ${d}`),
    ...Array.from(reads, t => `const float* ${tensorName(t)}`),
    'float* result',
    'U count',
  ];
  if (group.kind === 'row') params.push('float* spill');
  const lines = statements.length > 1 ? [`// Tix statements: ${statements.map(s => s.name).join(', ')}`] : [];
