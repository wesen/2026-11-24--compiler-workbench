        best = { statements: fn.statements.slice(start, end + 1), rowInput: !element && rowLoad ? rowLoad.name : undefined };
      }
      escape = Math.max(escape, lastUse.get(s.name) ?? -1);
      internal.add(s.name);
    }
    groups.push(best);
    start += best.statements.length;
  }
  return groups;
}
