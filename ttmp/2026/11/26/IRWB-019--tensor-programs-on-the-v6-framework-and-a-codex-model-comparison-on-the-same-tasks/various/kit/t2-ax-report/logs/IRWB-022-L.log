    77	  std::vector<float> times(repeats, 0);
    78	  if (!hasWork) return times;
    79	  launch();
    80	  check(cudaGetLastError());
    81	  check(cudaDeviceSynchronize());
    82	  if (repeats) {
    83	    cudaEvent_t start, stop;
    84	    check(cudaEventCreate(&start));
    85	    check(cudaEventCreate(&stop));
    86	    for (float& ms : times) {
    87	      check(cudaEventRecord(start));
    88	      launch();
    89	      check(cudaEventRecord(stop));
    90	      check(cudaGetLastError());
    91	      check(cudaEventSynchronize(stop));
    92	      check(cudaEventElapsedTime(&ms, start, stop));
    93	    }
    94	    check(cudaEventDestroy(start));
    95	    check(cudaEventDestroy(stop));
    96	  }
    97	  return times;
    98	}
