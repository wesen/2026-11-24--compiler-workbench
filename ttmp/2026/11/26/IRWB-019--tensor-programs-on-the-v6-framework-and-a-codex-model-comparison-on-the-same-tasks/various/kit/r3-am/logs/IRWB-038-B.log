   320	  maxCounterexamples = spec.maxCounterexamples ?? 5,
   321	): DifferentialEvidence {
   322	  const { cases, reuse } = prepare(spec, inputs, seed);
   323	  const keys = memoKeys(spec, inputs, cases, reuse);
   324	  const verdicts: Decided[] = new Array(cases.length);
   325	  for (let i = 0; i < cases.length; i++) {
   326	    const known = keys[i] === undefined ? undefined : reuse!.verdicts.get(keys[i]!);
   327	    if (known) {
   328	      verdicts[i] = known;
   329	      STATS.replayed++;
   330	      continue;
   331	    }
   332	    verdicts[i] = decideCase(spec, inputs, cases[i], i, reuse?.outcomes);
   333	    if (keys[i] !== undefined) reuse!.verdicts.set(keys[i]!, verdicts[i]);
   334	  }
   335	  return tally(spec, seed, cases, verdicts, maxCounterexamples);
   336	}
   337	
   338	/** `runDifferential`, with the cases nobody decided yet handed to `spec.decide` (IRWB-004 F4). */
   339	export async function runDifferentialAsync<P extends Ports, Case, Outcome>(
   340	  spec: DifferentialSpec<P, Case, Outcome>,
   341	  inputs: PortValues<P>,
   342	  seed = spec.seed ?? 1,
   343	  maxCounterexamples = spec.maxCounterexamples ?? 5,
   344	): Promise<DifferentialEvidence> {
   345	  const { cases, reuse } = prepare(spec, inputs, seed);
   346	  const keys = memoKeys(spec, inputs, cases, reuse);
   347	  const verdicts: Decided[] = new Array(cases.length);
   348	  const todo: number[] = [];
   349	  for (let i = 0; i < cases.length; i++) {
   350	    const known = keys[i] === undefined ? undefined : reuse!.verdicts.get(keys[i]!);
   351	    if (known) {
   352	      verdicts[i] = known;
   353	      STATS.replayed++;
   354	    } else todo.push(i);
   355	  }
   356	  const batchKey = spec.decide && reuse && todo.length && todo.every(i => keys[i] !== undefined)
   357	    ? JSON.stringify([reuse.key, todo.map(i => keys[i])])
   358	    : undefined;
   359	  const pending = batchKey === undefined ? undefined : IN_FLIGHT.get(batchKey);
   360	  const elsewhere = pending ?? (todo.length ? spec.decide?.(inputs, cases, todo) : undefined);
   361	  if (elsewhere) {
   362	    if (batchKey !== undefined && !pending) IN_FLIGHT.set(batchKey, elsewhere);
   363	    try {
   364	      const decided = await elsewhere;
   365	      if (decided.length !== todo.length) throw new Error(`${spec.id}: decide returned ${decided.length} of ${todo.length}`);
   366	      todo.forEach((i, k) => (verdicts[i] = decided[k]));
   367	      if (pending) STATS.replayed += todo.length;
   368	      else STATS.delegated += todo.length;
   369	    } finally {
   370	      if (batchKey !== undefined && IN_FLIGHT.get(batchKey) === elsewhere) IN_FLIGHT.delete(batchKey);
   371	    }
   372	  } else for (const i of todo) verdicts[i] = decideCase(spec, inputs, cases[i], i, reuse?.outcomes);
   373	  for (const i of todo) if (keys[i] !== undefined) reuse!.verdicts.set(keys[i]!, verdicts[i]);
   374	  return tally(spec, seed, cases, verdicts, maxCounterexamples);
   375	}
   376	
   377	/** The assurance a check's evidence supports: sampled differential testing is weaker than an exact checker. */
   378	export function assuranceOf(evidence: unknown): 'checked-sampled' | 'checked-exact' {
   379	  return (evidence as { method?: string } | null)?.method === 'sampled' ? 'checked-sampled' : 'checked-exact';
   380	}

