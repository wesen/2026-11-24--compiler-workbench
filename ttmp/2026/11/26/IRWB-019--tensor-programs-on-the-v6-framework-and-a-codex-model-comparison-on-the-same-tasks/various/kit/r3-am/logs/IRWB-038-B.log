   429	            ok: false,
   430	            reason: `${where}: at offset ${i}, expected ${sample.reference.data[i]}, the schedule gives ${got.data[i]}`,
   431	          };
   432	    }
   433	  return { ok: true, evidence: { samples: samples.length, sides: sides.length, runs } };
