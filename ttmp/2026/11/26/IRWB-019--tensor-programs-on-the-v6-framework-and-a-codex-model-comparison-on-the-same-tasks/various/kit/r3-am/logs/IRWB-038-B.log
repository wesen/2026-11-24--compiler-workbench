   258	/** The evidence of decided cases, counted in case order (so counterexamples come in case order). */
   259	function tally<P extends Ports, Case, Outcome>(
   260	  spec: DifferentialSpec<P, Case, Outcome>,
   261	  seed: number,
   262	  cases: readonly Case[],
   263	  verdicts: readonly Decided[],
   264	  maxCounterexamples: number,
   265	): DifferentialEvidence {
   266	  let agree = 0,
   267	    disagree = 0,
   268	    inconclusive = 0;
   269	  const counterexamples: { case: unknown; reason: string }[] = [];
   270	  for (let i = 0; i < cases.length; i++) {
   271	    const d = verdicts[i];
   272	    if (d.v === 'inconclusive') inconclusive++;
   273	    else if (d.v === 'agree') agree++;
   274	    else {
   275	      disagree++;
   276	      if (counterexamples.length < maxCounterexamples)
   277	        counterexamples.push({
   278	          case: spec.describeCase ? spec.describeCase(cases[i]) : cases[i],
   279	          reason: d.reason,
   280	        });
   281	    }
   282	  }
