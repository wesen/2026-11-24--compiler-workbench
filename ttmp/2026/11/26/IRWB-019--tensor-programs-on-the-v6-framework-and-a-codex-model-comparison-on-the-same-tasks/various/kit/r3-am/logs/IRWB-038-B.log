    83	export function kernelCorrespondence(
    84	  baseline: Artifact<Module>,
    85	  subject: Artifact<CudaUnit>,
    86	): Correspondence {
    87	  const { fn, kernels } = subject.value;
    88	  return {
    89	    id: 'kernels',
    90	    from: { artifact: baseline.id, revision: baseline.revision },
    91	    to: { artifact: subject.id, revision: subject.revision },
    92	    relation: 'statements-to-kernels',
    93	    sourceEntities: baseline.value.functions.flatMap(f => f.statements.map(s => f.name + '/' + s.name)),
    94	    targetEntities: kernels.map(k => k.name),
    95	    entities: kernels.map(k => ({ from: k.statements.map(s => fn + '/' + s), to: [k.name] })),
    96	    evidence: { mappings: kernels.map(k => k.mapping), gated: kernels.map(k => k.gated === true) },
    97	  };
    98	}
    99	
   100	// The relation is exact: the lowered function must give the current revision's f32 meaning bit for bit, signed
   101	// zeros and infinities included (IRWB-019 F17). The emitter makes that possible: explicit round-to-nearest
   102	// arithmetic, so nothing contracts, and exp, log and tanh in double, rounded, which equal Math.fround(Math.exp(x))
   103	// and so on for all 2^32 f32 inputs on the GB10 (IRWB-019 diary step 23). NaN is compared as a class, because the
   104	// GPU and V8 produce different NaN words (sqrt of -2^-149: 0x7fffffff against 0xffc00000).
   105	function compare(expected: BufferValue, got: BufferValue) {
   106	  if (expected.shape.length !== got.shape.length || expected.shape.some((n, i) => n !== got.shape[i]))
   107	    return { ok: false, reason: 'Output shape differs' };
   108	  if (expected.data.length !== got.data.length) return { ok: false, reason: 'Output length differs' };
   109	  const f32 = (d: ArrayLike<number>) => (d instanceof Float32Array ? d : Float32Array.from(d));
   110	  const a = f32(expected.data),
   111	    b = f32(got.data);
   112	  const wa = new Uint32Array(a.buffer, a.byteOffset, a.length),
   113	    wb = new Uint32Array(b.buffer, b.byteOffset, b.length);
   114	  const hex = (w: number) => '0x' + w.toString(16).padStart(8, '0');
   115	  for (let i = 0; i < a.length; i++) {
   116	    if (wa[i] === wb[i] || (Number.isNaN(a[i]) && Number.isNaN(b[i]))) continue;
   117	    const at = coordinate(expected.shape, i);
   118	    return { ok: false, reason: `At [${at}], expected ${a[i]} (${hex(wa[i])}), got ${b[i]} (${hex(wb[i])})` };
   119	  }
   120	  return { ok: true };
