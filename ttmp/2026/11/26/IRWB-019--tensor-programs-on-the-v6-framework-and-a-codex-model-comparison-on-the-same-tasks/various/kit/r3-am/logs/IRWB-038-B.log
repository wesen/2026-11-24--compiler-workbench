   422	      }
   423	      const a = new Uint32Array(sample.reference.data.buffer, 0, sample.reference.data.length),
   424	        b = new Uint32Array(got.data.buffer, 0, got.data.length);
   425	      if (a.length !== b.length) return { ok: false, reason: `${where}: output length differs` };
   426	      for (let i = 0; i < a.length; i++)
