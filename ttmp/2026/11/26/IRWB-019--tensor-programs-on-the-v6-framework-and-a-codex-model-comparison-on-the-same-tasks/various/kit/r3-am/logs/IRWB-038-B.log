/**
 * IRWB-001 E4: dataflow problems as v6 analyses.
 *
 * `dataflow()` turns a lattice, a transfer function and a description of the flow regions of an IR into a v6
 * `AnalysisDefinition`. The analysis manager then caches the solved facts per exact artifact revision, like any
 * other analysis.
 *
 * Checked transfer (Compiler Workbench's `preserves`, made checkable): the definition declares which entity and
 * relation kinds its result is a function of (`reads`). Its transfer verifier diffs the two revisions through the
 * adapter and accepts the transfer only when no entity or relation of a read kind changed. A pass that claims to
 * preserve a fact therefore cannot keep a stale one: the claim is checked against the actual change set.
 */
import type { Artifact, Json } from '../core/types.js';
import { immutable } from '../core/data.js';
import { defineAnalysis, defineType } from '../contracts/definitions.js';
import type { AnalysisDefinition, CheckResult, IRType } from '../contracts/types.js';
import { openIR } from '../ir/view.js';
import { diff } from '../ir/diff.js';
import type { ChangeSet, IRAdapter, IRView } from '../ir/types.js';
import type { Lattice } from './lattices.js';
import { solve, type FlowGraph, type Solution } from './solver.js';

/** One independently solved region of an IR, usually a function. */
export interface FlowRegion {
  readonly id: string;
  readonly graph: FlowGraph;
}

/** Kinds the analysis reads. A trailing `*` matches a prefix (`stmt.*`). */
export interface ReadSet {
  readonly entities: readonly string[];
  readonly relations: readonly string[];
}

export interface DataflowSpec<S, V, C = unknown> {
  readonly id: string;
  readonly version: string;
  readonly description: string;
  readonly input: IRType<S>;
  readonly adapter: IRAdapter<S>;
  readonly direction: 'forward' | 'backward';
  readonly lattice: Lattice<V>;
  /** Flow regions of one revision, and per-region context handed to transfer (e.g. the function's locals). */
  regions(view: IRView<S>, params: unknown): readonly (FlowRegion & { readonly context: C })[];
  transfer(block: string, input: V, context: C, region: FlowRegion): V;
  boundary?(region: FlowRegion, context: C): V;
  widen?(previous: V, next: V, block: string): V;
  readonly widenAfter?: number;
  edge?(from: string, to: string, value: V, context: C, region: FlowRegion): V;
  readonly strategy?: 'worklist' | 'round-robin';
  readonly reads: ReadSet;
  readonly maxIterations?: number;
}

/** The persisted result: per region, the encoded in/out facts of every block. */
export interface DataflowResult {
  readonly analysis: string;
  readonly direction: 'forward' | 'backward';
  readonly regions: Readonly<
    Record<
      string,
      {
        readonly in: Readonly<Record<string, Json>>;
        readonly out: Readonly<Record<string, Json>>;
        readonly iterations: number;
        readonly rounds: number;
        readonly loopHeads: readonly string[];
      }
    >
  >;
}

const finiteJson = (value: unknown, path = '$'): void => {
  if (value === null || typeof value === 'string' || typeof value === 'boolean') return;
  if (typeof value === 'number') {
    if (!Number.isFinite(value)) throw new Error(`Dataflow result ${path} is not finite`);
    return;
  }
  if (Array.isArray(value)) return value.forEach((v, i) => finiteJson(v, `${path}[${i}]`));
  if (typeof value === 'object')
    return Object.entries(value).forEach(([k, v]) => finiteJson(v, `${path}.${k}`));
  throw new Error(`Dataflow result ${path} is not JSON`);
};

const matches = (patterns: readonly string[], kind: string) =>
  patterns.some(p => (p.endsWith('*') ? kind.startsWith(p.slice(0, -1)) : p === kind));

/** The changes in `changes` that touch what an analysis reads. */
export function readsTouched(reads: ReadSet, changes: ChangeSet): readonly string[] {
  const touched = new Set<string>();
  for (const c of changes.entities) {
    for (const e of [c.before, c.after])
      if (e && matches(reads.entities, e.kind)) touched.add(`entity ${c.entity} (${e.kind})`);
  }
  for (const c of changes.relations) {
    for (const r of [c.before, c.after])
      if (r && matches(reads.relations, r.kind)) touched.add(`relation ${c.relation} (${r.kind})`);
  }
  return [...touched].sort();
}

export type DataflowAnalysis<S, V> = AnalysisDefinition<S, DataflowResult> & {
  readonly spec: DataflowSpec<S, V, any>;
  /** Decode one region's solved facts back into lattice values. */
  decode(result: DataflowResult, region: string): Solution<V>;
  /** Solve directly, without the analysis manager (tools, tests). */
  solveArtifact(subject: Artifact<S>, params?: unknown): DataflowResult;
};

export function dataflow<S, V, C = unknown>(spec: DataflowSpec<S, V, C>): DataflowAnalysis<S, V> {
  const output = defineType<DataflowResult>({
    id: `${spec.id}.result`,
    version: spec.version,
    description: `Solved ${spec.direction} ${spec.lattice.name} facts of ${spec.id}`,
    validate(value: unknown): asserts value is DataflowResult {
      finiteJson(value);
      const v = value as DataflowResult;
      if (!v || v.analysis !== spec.id || typeof v.regions !== 'object')
        throw new Error(`Not a ${spec.id} result`);
    },
  <h2>Where the framework's promises have not held up</h2>
  <p>Most of what the framework promises held under two domains. The places where it did not are listed here, because they set the next stages' work.</p>
  <div class="two">
    <div>
      <h3>Checks are sampled, not proven</h3>
      <p>Every meaning check that guards a pass is a differential test on generated cases. Its evidence is labelled <code>checked-sampled</code>. The <code>proof</code> assurance exists only as a slot for an external certificate verifier, and the README says so: "This framework does not contain a theorem prover." The case generator carries the strength, and it has been wrong twice: equal shape sizes before F21, and a tolerance whose absolute term accepts an all-zero output below 2e-6 (F22, open). Exact relations and verified rules are the way out, and that is where programme A (A0, running now) starts.</p>
    </div>
    <div>
      <h3>Lowering decisions bypass the pass machinery</h3>
      <p>Fusion groups, thread or block mode, staged terms and the launch gate are decided by <code>planFusion</code> and the emitter, in plain TypeScript. The CUDA artifact is a source string whose only entities are kernel names (F24). The framework checks the meaning of the result, but none of the individual decisions, and none of them is composable as a pass. Stage 6 exists to fix this: a schedule IR whose every scheduling step is a checked pass.</p>
    </div>
    <div>
      <h3>Correspondence and keys were trusted</h3>
      <p>Correspondence promised traceability, but its entity lists were whatever the caller declared, until F23. Verdict reuse promised safety, but it trusted the spec's key, until F26. Both were found by agents comparing their own results, not by design review. Tix passes still declare coarse writes (all <code>tensor</code> entities) and return a whole new module, so their correspondence is no finer than "the module changed".</p>
    </div>
    <div>
      <h3>The rewrite engine and the strategy IR are barely used by Tix</h3>
      <p>The IR layer has a pattern matcher with seven rewrite schedules, scoped edit authority and failure statuses. No Tix pass uses it, because whole-function rewrites were simpler. The strategy IR runs every Typed pipeline but no Tix one. A framework whose second domain skips two of its layers has not yet shown those layers are general.</p>
    </div>
    <div>
      <h3>Two runners with different powers</h3>
      <p><code>applyPass</code> is asynchronous and supports analysis needs, preservation claims and manager-dependent contracts. <code>applyNativePassSync</code>, added for Tix, refuses all three. Simple passes are easier this way, but a domain has to choose between simplicity and the framework's checking of preservation.</p>
    </div>
    <div>
      <h3>Measured choice is not a cost model</h3>
      <p><code>chooseBest</code> picks the pipeline that measures best per project, and that works. A fixed preset does not. <code>speed</code> takes the bytecode VM from 7,678 to 9,286 executed instructions, the only one of six corpus programs it makes worse. Nothing in the framework predicts cost from the IR; D1, running now, is finding out why from the correspondence records.</p>
    </div>
  </div>
  <p class="muted">Trust boundaries, from the READMEs: adapter callbacks, predicates, rewrite bodies and verifiers are trusted TypeScript; read-only facades constrain capabilities but are not a sandbox; <code>cache: 'pure'</code> is not a security boundary; the revision store is in memory.</p>
  <div class="label">Further reading</div>
  <ul class="refs"><li><a href="https://doi.org/10.1007/BFb0054170">Pnueli, Siegel, Singerman: Translation Validation (TACAS 1998, LNCS 1384)</a><span class="what">DOI of the original translation-validation paper (Springer page blocks bots; metadata confirmed via Crossref and BibSLEIGH).</span></li><li><a href="https://people.eecs.berkeley.edu/~necula/Papers/tv_pldi00.pdf">Necula: Translation Validation for an Optimizing Compiler (PLDI 2000)</a><span class="what">Author-hosted PDF of Necula&#x27;s PLDI 2000 paper.</span></li><li><a href="https://web.ist.utl.pt/nuno.lopes/pubs/alive-pldi15.pdf">Provably Correct Peephole Optimizations with Alive (PLDI 2015)</a><span class="what">Author-hosted PDF introducing the Alive DSL for verifying LLVM peepholes.</span></li><li><a href="https://web.ist.utl.pt/nuno.lopes/pubs/alive2-pldi21.pdf">Alive2: Bounded Translation Validation for LLVM (PLDI 2021)</a><span class="what">Author-hosted PDF of the Alive2 translation validator for LLVM.</span></li><li><a href="https://arxiv.org/abs/2002.11054">MLIR: A Compiler Infrastructure for the End of Moore&#x27;s Law</a><span class="what">arXiv page of the MLIR paper (CGO 2021).</span></li><li><a href="https://salsa-rs.github.io/salsa/">Salsa: a generic framework for on-demand, incrementalized computation</a><span class="what">Official Salsa book (rust-analyzer&#x27;s query system).</span></li><li><a href="https://www.cs.umd.edu/~mwh/papers/hammer13adapton.html">Adapton: Composable, Demand-Driven Incremental Computation (PLDI 2014)</a><span class="what">Author page for the Adapton paper.</span></li></ul>
