   284	    method: 'sampled',
   285	    invariant: spec.id,
   286	    seed,
   287	    total: cases.length,
   288	    agree,
   289	    disagree,
   290	    inconclusive,
   291	    status: disagree ? 'disagree' : agree ? 'agree' : 'inconclusive',
   292	    counterexamples,
   293	  };
   294	}
