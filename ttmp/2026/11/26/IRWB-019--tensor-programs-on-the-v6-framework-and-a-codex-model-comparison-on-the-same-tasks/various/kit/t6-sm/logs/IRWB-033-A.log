s=s[:pos]+\"\"\"function emitRowPatch(
  w: ReturnType<typeof kernelWriter>, statement: Statement, depth: number, domain: Contraction,
  layout: RowPatch, reduction: Reduce, length: string, store: (value: string) => void,
  replace: (value?: string) => void,
) {
  const { columns, minTerms, minColumns } = layout;
  const binder = statement.axes[depth].id;
  const variant = domain.row.includes(depth) ? 0 : 1;
  const open = (code: string) => { w.line(code + ' {'); w.enter(); };
  const close = () => { w.leave(); w.line('}'); };
  const extent = product(reduction.axes.map(a => w.bound(a.extent)));
  // Mode 3b testing forces the block mapping using the host flag, but the patch selector
  // is local. The same loop covers both complete packets and a remainder.
  open("'`if (${length} >= ${minColumns} && ${extent} >= ${minTerms})`);
  open(`for (U first = threadIdx.x; first < ${length}; first += ${columns} * blockDim.x)`);
  w.line(`float patch_acc[${columns}] = {};`);
  for (const { id, extent } of reduction.axes) {
    const axis = w.bind(id);
    open(`for (I ${axis} = 0, end = ${w.bound(extent)}; ${axis} < end; ++${axis})`);
  }
  w.line(`const float fixed_word = ${w.scalar(domain.operands[1 - variant])};`);
  w.line('"'#pragma unroll');
  open("'`for (unsigned c = 0; c < ${columns}; ++c)`);
  w.line('"'const U e = first + c * blockDim.x;');
  open("'`if (e < ${length})`);
  w.alias(binder, '"'e');
  const word = w.scalar(domain.operands[variant]);
  const args = variant === 0 ? "'`${word}, fixed_word` : `fixed_word, ${word}`;
  w.line(`patch_acc[c] = __fadd_rn(patch_acc[c], __fmul_rn(${args}));`);
  close();
