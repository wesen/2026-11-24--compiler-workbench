  const epilogue = plan(
    'fn f(a:f32[M,K], b:f32[K,N], c:f32[N]):f32[M,N] { y[i,j] = sum(k) a[i,k]*b[k,j]; z[i,j] = tanh(y[i,j] + c[j]) * y[i,j]; return z; }',
    'f',
  );
  assert.deepEqual(summary(epilogue), [['thread', 2, 'y,z', 'z']]);
