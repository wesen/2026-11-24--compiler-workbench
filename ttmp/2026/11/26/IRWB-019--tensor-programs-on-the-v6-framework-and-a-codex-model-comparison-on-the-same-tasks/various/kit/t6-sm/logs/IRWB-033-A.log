    contractions: [],
  };
}

const entities = (schedule: Schedule) => [
  { id: 'function/' + schedule.fn.name, kind: 'function', attributes: { fn: schedule.fn } },
  ...schedule.groups.map(group => {
    const { contractions, ...mapping } = group;
