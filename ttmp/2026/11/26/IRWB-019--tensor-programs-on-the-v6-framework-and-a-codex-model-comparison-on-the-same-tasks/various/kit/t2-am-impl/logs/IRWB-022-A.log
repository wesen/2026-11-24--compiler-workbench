        for (const e of readdirSync(d)) {
          const p = join(d, e);
          statSync(p).isDirectory() ? w2(p) : outs.push(relative(join(dir, 'out'), p));
        }
      };
      w2(join(dir, 'out'));
      result.outputs = outs.sort();
    }
  }
  process.stdout.write(JSON.stringify(result) + '\n');
  if (result.exit !== 0) process.exitCode = 1;
} finally {
