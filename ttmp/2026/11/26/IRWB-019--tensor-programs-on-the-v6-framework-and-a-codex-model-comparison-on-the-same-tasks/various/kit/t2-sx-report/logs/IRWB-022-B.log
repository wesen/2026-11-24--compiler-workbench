    52	        : extent.kind === 'tail'
    53	          ? Math.min(width, dim - width * indices.get(extent.block)!)
    54	          : dim;
    55	    for (let j = 0; j < n; j++) {
    56	      tick();
    57	      indices.set(id, j);
    58	      loop(axes, i + 1, body);
    59	    }
    60	  }
    61	  function scalar(e: Expr): number {
    62	    tick();
    63	    switch (e.kind) {
    64	      case 'literal':
    65	        return round(Number(e.text));
    66	      case 'shape':
    67	        return round(shapes.get(e.name)!);
    68	      case 'load': {
    69	        const t = tensors.get(e.name)!;
    70	        let offset = 0;
    71	        for (let i = 0; i < e.indices.length; i++) {
    72	          const ix = value(e.indices[i], indices);
    73	          if (sampling && (ix < 0 || ix >= t.shape[i]))
    74	            throw new OutsideSample('Sample outside address domain');
    75	          offset = offset * t.shape[i] + ix;
    76	        }
    77	        return t.data[offset];
    78	      }
    79	      case 'op':
    80	        return round(operations[e.op](scalar(e.args[0]), e.args.length === 2 ? scalar(e.args[1]) : 0));
    81	      case 'reduce': {
    82	        let acc = e.op === 'sum' ? 0 : -Infinity;
    83	        loop(e.axes, 0, () => {
    84	          const x = scalar(e.body);
    85	          acc = round(e.op === 'sum' ? acc + x : Math.max(acc, x));
    86	        });
    87	        return acc;
    88	      }
    89	    }
    90	  }
    91	  for (const s of fn.statements) {
    92	    const shape = s.shape.map(a => value(a, shapes));
    93	    if (sampling && (shape.some(n => n < 0) || size(shape) > 4096))
    94	      throw new OutsideSample('Sample shape limit');
    95	    const data = new ArrayType(size(shape));
    96	    let offset = 0;
    97	    loop(s.axes, 0, () => {
    98	      data[offset++] = scalar(s.expr);
    99	    });
   100	    tensors.set(s.name, { shape, data });
   101	  }
   102	  return tensors.get(fn.result)!;
   103	}

