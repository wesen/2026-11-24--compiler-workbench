          } else env.set(s.local!, v);
          break;
        }
        case 'store': {
          if (s.width !== 32) unsupported(`store at ${sid} may write the bound buffer`);
          const addr = value(s.addr!);
          if (typeof addr !== 'object' || !('frame' in addr))
