enum Shape { Circle, Square = 4, Tri }
record Point { x: i32; y: i32; }
function area(s: Shape, k: i32): i32 {
    let r = 0;
    match (s) {
        Circle: { r = 3 * k * k; }
        Square: { r = k * k; }
        Tri: { r = k * k / 2; }
