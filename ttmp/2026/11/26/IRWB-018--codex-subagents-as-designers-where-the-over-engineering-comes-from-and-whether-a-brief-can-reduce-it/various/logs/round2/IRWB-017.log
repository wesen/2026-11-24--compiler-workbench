scripts
function sort(work: buffer): i32 {
    let swaps = 0;
    for (let i = 1; i < work.length; i = i + 1) {
        let j = i;
        while (j > 0 && work.charCodeAt(j - 1) > work.charCodeAt(j)) {
            const t = work.charCodeAt(j);
            work.setCharCodeAt(j, work.charCodeAt(j - 1));
            work.setCharCodeAt(j - 1, t);
            swaps = swaps + 1;
            j = j - 1;
        }
    }
    return swaps;
}
{
  "title": "Insertion sort",
  "about": [
    "Nested loops with loads and stores into one buffer. The checks",
    "compare the sorted cells."
  ],
  "group": "Programs",
  "pipeline": "O2",
  "inputs": {
    "sort": { "work": { "buffer": [0, 12], "cell": [0, 99] } }
  },
  "chapter": "checks",
  "focus": 6,
  "try": [
    [
      "Which bounds checks stay in sort, and which facts would remove",
      "each?"
    ],
    [
      "Where does sort spend its instructions on a reversed buffer of",
      "10?"
    ]
  ]
}
j - 1 is not the loop variable, so bce keeps those checks: it needs j -
1 >= 0, which the && test does prove. A smarter bce could use it.
