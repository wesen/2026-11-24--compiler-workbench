console.log('shim ingest',q.status,q.error);
const ss=storeOf(q.head.value);
const offsets=Object.fromEntries(Object.entries(ss.frontEnd.records.WorldState).map(([k,v])=>[k,v.offset]));
function outcome(res,k) {
