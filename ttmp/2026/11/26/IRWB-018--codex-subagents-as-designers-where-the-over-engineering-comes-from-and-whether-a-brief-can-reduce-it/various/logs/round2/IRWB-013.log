}

/** One concrete call: `{ name: number | {cells} | {buffer} | {string} }`. */
export function benchCase(st: Store, fname: string, bench: Readonly<Record<string, unknown>> = {}): Case {
  const f = st.fn(fname),
    mem = new Memory(),
    rnd = rng(1);
