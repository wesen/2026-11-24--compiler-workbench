      meaningKept({
        inputs: this.inputs,
        count: opts.count ?? 100,
        seed: opts.seed ?? 7,
        ...(this.options.entries ? { roots: this.options.entries } : {}),
      }),
      { origin: this.origin, candidate: this.head },
