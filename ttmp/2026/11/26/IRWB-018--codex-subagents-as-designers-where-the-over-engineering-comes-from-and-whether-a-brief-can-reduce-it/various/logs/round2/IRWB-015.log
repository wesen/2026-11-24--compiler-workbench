/**
 * Projects: a directory of Typed sources plus `project.json` (title, pipeline, per-function input specs). A port
 * of Compiler Workbench's projects.js source assembly: the sources named in `project.json` come first, then the
 * remaining `.typed` files in name order; they are concatenated (each ending in a newline) into one program whose
 * name is the project id with `-` replaced by `_`, and a file map records where each file starts.
 */
import { applyPass, type PassResult } from '../framework/passes/define-pass.js';
import type { AnalysisManager } from '../framework/contracts/analysis-manager.js';
import type { Artifact } from '../framework/core/types.js';
import { createIRArtifact } from '../framework/ir/adapters.js';
import type { ProgramInputs } from './evaluate.js';
import { blocksAdapter } from './ir.js';
import { ingest } from './lift.js';
import type { TypedBlocks } from './model.js';
import { joinText } from './format.js';
import { optimizationContract, PASSES, PIPELINES, type RevisionReport } from './passes.js';

export interface ProjectMeta {
  readonly title: string;
  readonly about: string;
  readonly group: string;
  readonly pipeline: string;
  readonly inputs: ProgramInputs;
  readonly sources: readonly string[];
  readonly [field: string]: unknown;
}

export interface ProjectSource {
  readonly id: string;
  readonly name: string;
  readonly meta: ProjectMeta;
  readonly source: string;
  readonly fileMap: readonly { readonly file: string; readonly start: number; readonly lines: number }[];
}

export function projectSource(id: string, files: Readonly<Record<string, string>>): ProjectSource {
  let m: Record<string, unknown> = {};
  if (files['project.json']) m = JSON.parse(files['project.json']);
  const typed = Object.keys(files)
    .filter(f => f.endsWith('.typed'))
    .sort();
  const named = Array.isArray(m.sources) ? (m.sources as string[]) : [];
  const sources = named.filter(f => files[f] !== undefined).concat(typed.filter(f => !named.includes(f)));
  // prose fields may be written as arrays of lines, so project.json stays narrow; they mean the joined text
  if (m.about !== undefined) m.about = joinText(m.about);
  if (Array.isArray(m.try)) m.try = m.try.map(x => joinText(x));
  if (m.scripts && typeof m.scripts === 'object')
    for (const sc of Object.values(m.scripts as Record<string, Record<string, unknown>>))
      if (sc && sc.about !== undefined) sc.about = joinText(sc.about);
  const meta = {
    title: id,
    about: '',
    group: 'Mine',
    pipeline: 'O2',
    inputs: {},
    ...m,
    sources,
  } as ProjectMeta;
  let source = '',
    line = 1;
  const fileMap: { file: string; start: number; lines: number }[] = [];
  for (const f of sources) {
    let t = files[f];
    if (!t.endsWith('\n')) t += '\n';
    const n = t.split('\n').length - 1;
    fileMap.push({ file: f, start: line, lines: n });
    source += t;
    line += n;
  }
  return { id, name: id.replace(/-/g, '_'), meta, source, fileMap };
}

/** r0 of a project as a v6 artifact. */
export function ingestProject(p: ProjectSource): Artifact<TypedBlocks> {
  return createIRArtifact(blocksAdapter, p.name, ingest(p.name, p.source).toNative());
}

export interface PipelineStep {
  readonly pass: string;
  readonly changed: boolean;
  readonly rev: number;
  readonly edits: number;
  readonly report?: RevisionReport;
  readonly result?: PassResult<TypedBlocks>;
  readonly rejected?: string;
}

/**
 * Run a named pipeline (or a list of pass names), checking each changed revision against `origin` with the
 * optimization contract, as Compiler Workbench's `p.pipeline(x)` does with checkEach. A rejected pass leaves the
 * program as it was and is reported; the pipeline continues.
 */
export async function runPipeline(
  origin: Artifact<TypedBlocks>,
  pipeline: string | readonly string[],
  options: {
    manager: AnalysisManager;
    inputs?: ProgramInputs;
    count?: number;
    seed?: number;
    /** The step limit of each case of the meaning check (default the check's 2e4 statements). */
    limit?: number;
    start?: Artifact<TypedBlocks>;
  },
): Promise<{ artifact: Artifact<TypedBlocks>; steps: PipelineStep[] }> {
  const names = typeof pipeline === 'string' ? PIPELINES[pipeline] : pipeline;
  if (!names)
    throw new Error(
      `unknownPipeline: no pipeline "${pipeline}"; pipelines: ${Object.keys(PIPELINES).join(', ')}`,
    );
  const contract = optimizationContract({
    inputs: options.inputs ?? {},
    count: options.count ?? 40,
    seed: options.seed ?? 7,
    ...(options.limit === undefined ? {} : { limit: options.limit }),
  });
  let cur = options.start ?? origin;
  const steps: PipelineStep[] = [];
  for (const name of names) {
    const pass = PASSES[name];
    if (!pass) throw new Error(`unknownPass: no pass named "${name}"`);
    try {
      const r = await applyPass(pass, cur, {
        manager: options.manager,
        contract,
        contractInputs: { origin },
      });
      steps.push({
        pass: name,
        changed: r.changed,
        rev: r.artifact.value.rev,
        edits: r.edits,
        report: r.report as RevisionReport,
        result: r,
      });
      cur = r.artifact;
    } catch (e) {
      if ((e as { code?: string }).code !== 'contractRejected') throw e;
      steps.push({
        pass: name,
        changed: false,
        rev: cur.value.rev,
        edits: 0,
        rejected: (e as Error).message,
      });
    }
  }
  return { artifact: cur, steps };
}
/**
 * Specialization on facts from an outer artifact (design-doc 03).
 *
 * A front end above Typed (Candela, for the gallery) knows facts that Typed code cannot see: the scene index a
 * kernel instance will always be called with, the layout of a scene's packed rows. Such facts travel as a
 * `typed.bindings` artifact: for a function and one of its parameters, the value it will have, and the entity of
 * the outer artifact that says so.
 *
 * The `specialize` pass replaces each read of a bound parameter whose only reaching definition is the parameter
 * itself by the constant, and records `because: fact:<artifact>@<revision>#<entity>`. The ordinary passes then do
 * the rest (fold the comparisons, cfg the constant branches, dce the dead code), and `why` on anything they removed
 * reaches the outer fact through the because-chain.
 *
 * Specialization changes what the program means for inputs that violate the bindings, so the contract changes
 * with it: the program is checked against r0 only on cases that satisfy the bindings (`Program.assume`), and every
 * later pass is held to the same restricted contract.
 */
import { defineIR } from '../framework/contracts/definitions.js';
import type { Artifact } from '../framework/core/types.js';
import { TxError } from './tx.js';
import { typedPass } from './passes.js';

/**
 * A parameter binding (`fn`, `param`): that parameter's value. A field binding (`record`, `field`): that field of
 * every record of the type a function receives as a parameter (Candela: `K.scene`), in every function.
 */
export interface Binding {
  /** The function whose parameter is bound. */
  readonly fn?: string;
  /** The parameter's name. */
  readonly param?: string;
  /** The record type whose field is bound (field form). */
  readonly record?: string;
  /** The field's name (field form). */
  readonly field?: string;
  /** Its value (an enum case's value for enum parameters). */
  readonly value: number;
  /** The entity of the outer artifact that establishes the fact (e.g. `candela:scene/cornell#K.scene`). */
  readonly entity: string;
  readonly note?: string;
}
export interface Bindings {
  readonly formatVersion: 1;
  /** What produced the facts (e.g. `candela`). */
  readonly source: string;
  readonly bindings: readonly Binding[];
}

export const BindingsIR = defineIR<Bindings>({
  id: 'typed.bindings',
  version: '1',
  description:
    'parameter values a program will always be called with, and the outer entities that establish them',
  validate(value) {
    const v = value as Bindings;
    if (!v || v.formatVersion !== 1 || typeof v.source !== 'string' || !Array.isArray(v.bindings))
      throw new Error('typed.bindings: formatVersion 1, source and bindings required');
    for (const b of v.bindings) {
      const param = typeof b.fn === 'string' && typeof b.param === 'string';
      const field = typeof b.record === 'string' && typeof b.field === 'string';
      if (param === field || !Number.isInteger(b.value) || typeof b.entity !== 'string')
        throw new Error(`typed.bindings: malformed binding ${JSON.stringify(b)}`);
    }
  },
});

/** The reason a specialization cites: the outer artifact, its exact revision, and the entity. */
export const factRef = (art: Artifact<Bindings>, b: Binding) =>
  `fact:${art.kind}:${art.id}@${art.revision.slice(0, 12)}#${b.entity}`;

export const specialize = typedPass({
  name: 'specialize',
  about: 'specialization: reads of a parameter bound by an outer fact become that constant',
  needs: { reach: 'reaching' },
  writes: ['values'],
  preserves: ['cfg', 'dominators', 'loops'],
  body({ st, f, tx, facts, params }) {
    const art = params.bindings as Artifact<Bindings> | undefined;
    if (!art || art.kind !== BindingsIR.id)
      throw new TxError('unsupported', 'specialize needs params.bindings: a typed.bindings artifact');
    // only the parameter's own value: a read whose single reaching definition is the parameter
    const own = (v: { statement?: string | null }, i: number) => {
      const defs = facts.reach!.reachingAt(v.statement!, i);
      return defs.length === 1 && defs[0] === `param:${i}`;
    };
    for (const b of art.value.bindings) {
      if (b.record && b.field) {
        const layout = (
          st.frontEnd.records as Record<string, Record<string, { type: string; offset: number }>> | null
        )?.[b.record];
        const fld = layout?.[b.field];
        if (!fld)
          throw new TxError('unsupported', `no field ${b.record}.${b.field} in the program's records`);
        if (fld.type === 'f32')
          throw new TxError('unsupported', `${b.record}.${b.field} is an f32; bind an integer field`);
