function manhattan(p: Point, q: Point): i32 {
    const dx = p.x - q.x;
    const dy = p.y - q.y;
    return Math.max(dx, 0 - dx) + Math.max(dy, 0 - dy);
}
function nudge(p: Point, dx: i32): i32 {
    p.x = p.x + dx;
    p.y = p.y - dx;
    return p.x * p.y;
}
