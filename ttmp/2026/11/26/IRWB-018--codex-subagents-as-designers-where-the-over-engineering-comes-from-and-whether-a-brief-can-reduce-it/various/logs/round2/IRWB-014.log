function bits(a: i32, b: i32, c: i32): i32 { return ((a * 31 + b) * 31 + c) & 15; }
function probe(input: buffer, output: buffer, cap: i32): i32 {
  const head = new Int32Array(16);
  const prev = new Int32Array(24);
  let total = 0;
  for (let i = 0; i < cap && i + 1 <= input.length; i = i + 1) {
    const b = input.charCodeAt(i);
