from pathlib import Path
import re

ticket = next(Path('ttmp/2026/11/26').glob('IRWB-012--*'))
doc = next((ticket / 'design-doc').glob('*.md'))
body = doc.read_text()
listing = re.search(r'"'```text'"\\nFibonacci["'^'"\\n]*\\n(.*?)\\n"'```'"', body, re.S)[1]
programs = [[], []]
for line in listing.splitlines():
    for column, (address, opcode, operand) in enumerate(re.findall(r'(?<"'!'"\\S)(\\d\\d) ([A-Z])(?: (\\d+))?(?=\\s|"'$)'"', line)):
        assert int(address) == len(programs[column])
        programs[column].append((opcode, int(operand or '0')))

# Check static stack shape and branch targets from the listing.
effects = dict(P=(0,1), L=(0,1), S=(1,0), A=(2,1), D=(2,1),
               M=(2,1), J=(0,0), Z=(1,0), I=(1,1), N=(0,1), H=(1,0))
for program in programs:
    pending = [(0,0)]
    visited = {}
    peak = 0
    while pending:
        pc, depth = pending.pop()
        assert 0 <= pc < len(program)
        if pc in visited:
            assert visited[pc] == depth
            continue
        visited[pc] = depth
        opcode, operand = program[pc]
        assert 0 <= operand <= 65535
        assert opcode not in 'LS' or operand < 4
        pop, push = effects[opcode]
        assert depth >= pop
        new_depth = depth - pop + push
        peak = max(peak, depth, new_depth)
        if opcode in 'JZ':
            pending.append((operand, new_depth))
        if opcode not in 'JH':
            pending.append((pc + 1, new_depth))
    assert len(visited) == len(program)
    assert peak == 2
assert [(len(p), p[-1][0]) for p in programs] == [(22, 'H'), (18, 'H')]
for program, start, branch, end, max_n, expected in zip(programs, (5,2), (6,3), (19,15), (10,12), (159,174)):
    assert program[end] == ('J', start)
    assert program[branch] == ('Z', end + 1)
    assert start + (end-start+1)*max_n + 2 + len(program)-(end+1) == expected
assert 6+14*16 > 192 and 80*192+256 == 15616 < 20000
assert sum(31**i for i in range(16)) % 2**32
assert 65535**2 - 2**32 == -131071
assert ((3*31 + 2)*31 + 1) == 2946
for path in re.findall(r'\\]\\((["'^)]+)'"\\)', body):
    assert (doc.parent / path.split('#')[0]).is_file(), path
assert len(body.split('## Cuts from the original design\\n')[1].strip().splitlines()) == 10
print('Passed: fixture layout, branch targets, stack depths, guest counts, budget and golden arithmetic, relative links, and cut list')
