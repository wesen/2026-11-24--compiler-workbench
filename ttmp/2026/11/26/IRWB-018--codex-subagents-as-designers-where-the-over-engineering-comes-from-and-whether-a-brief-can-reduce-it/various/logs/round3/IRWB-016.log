      "config": { "buffer": [1, 1], "cell": [3, 5] }
    },
    "biquadBank": {
      "signal": { "floats": [0, 32], "range": [-1, 1] },
      "coeff": { "floats": [15, 15], "range": [-0.25, 0.25] },
      "out": { "buffer": [192, 192], "cell": [42405, 42405] }
    },
