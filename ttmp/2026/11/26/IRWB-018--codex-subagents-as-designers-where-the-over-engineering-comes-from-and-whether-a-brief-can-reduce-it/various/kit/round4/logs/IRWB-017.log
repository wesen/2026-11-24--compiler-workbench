);

export function evaluate(
  st: Store,
  fname: string,
  args: readonly number[],
  memBytes: Uint8Array,
  opts: {
    limit?: number;
    counts?: boolean;
    /** IRWB-005 C5: called before each executed statement with the frame's locals (read only; facts checking). */
    observe?: (fn: string, stmt: string, locals: Int32Array) => void;
  } = {},
): RunResult {
  const limit = opts.limit ?? 2e5,
    counts = opts.counts ? new Map<string, number>() : null,
    observe = opts.observe;
  // frame arrays live in a stack area above the guest memory, as on the target; programs without them get none, so
  // an access past the memory image still traps
  let frames = hasFrames.get(st);
  if (frames === undefined) hasFrames.set(st, (frames = [...st.fns.values()].some(f => f.arrayBytes)));
  const size = frames ? (memBytes.length + STACK_BYTES + 15) & -16 : memBytes.length;
  // IRWB-004: with a stack area, the working memory is a zeroed prefix of one reused buffer (the result gets a copy
  // of the guest part, as before), instead of a new 64 KiB ArrayBuffer per call, whose external memory made the
  // collector mark the whole heap about once a second during a meaning check
  let bytes: Uint8Array;
  if (frames) {
  if (spec.choose)
    return choosePlan(
      name,
      spec.choose,
      { metric: spec.by ?? 'instructions', direction: spec.direction ?? 'min' },
      (spec.constraints ?? []).map(([metric, op, value]) => ({ metric, op, value })),
    );
  if (spec.repeat) return untilStablePlan(name, spec.repeat, spec.max ?? 8);
  return plan(`typed.strategy.${name}`, passesNode(name, spec.passes!));
}

