Each arm of the match tests the enum value: Circle against 0 on line 6,
Square against its explicit 4 on line 7. Records are pointers: p.x is a
load at offset 0, p.y at offset 4.
explore.js
function vowels(s: string): i32 {
    let n = 0;
    for (let i = 0; i < s.length; i = i + 1) {
        const c = s.charCodeAt(i);
        if (c === 97 || c === 101 || c === 105 ||
            c === 111 || c === 117) {
            n = n + 1;
        }
    }
    return n;
}
function digits(s: string): i32 {
    let v = 0;
    for (let i = 0; i < s.length; i = i + 1) {
        const c = s.charCodeAt(i);
        if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); }
    }
    return v;
}
{
  "title": "Strings: vowels and digits",
  "about": [
    "A string is a buffer of 16-bit code units. Two loops over",
    "s.length, a chain of || and a range test."
  ],
  "group": "Bounds",
  "pipeline": "O2",
  "inputs": {
    "vowels": {
      "s": { "string": "the quick brown fox jumps over a lazy dog" }
    }
  },
