## Runs and checks

```js
// the evaluator: { result, trap, steps, buffers }
p.exec('blend', [[1, 2, 3, 4], 4, 3, 5]);
// the emulator, on a fresh image
p.exec('blend', [[1, 2, 3, 4], 4, 3, 5], { engine: 'rv32' });
p.check(); // head against r0, every function, 100 cases
p.check({ fn: 'blend', against: 'image', count: 300 });
// against the reference compiler's image (built-in projects, unedited)
p.check({ against: 'reference' });
p.cases('blend', { count: 5, seed: 1 }); // the generated inputs
```

Arguments: a number for i32 and bool; an array of cells for a buffer;
text for a string; `{ x: 1, y: 2 }` for a record; a case name for an
enum. Inputs for generated cases, per parameter: `[lo, hi]`, a number,
`{ buffer: [minLen, maxLen], cell: [lo, hi] }`, `{ cells: [...] }`, `{
string: 'text' }`, `{ record: { x: [lo, hi] } }`, `{ oneOf: [...] }`.

A check compares result, trap and memory. A trap must match a trap. A
case that hits the step limit in either engine is inconclusive, not a
verdict. A result: `{ status, fns: [{ fn, agree, total, bothTrap,
inconclusive, counterexamples }] }`.

## The backend and images
## The backend and images

```js
p.pipeline('O2', { checkEach: false }); // on Blend: r1 … r6
const img = p.compile({
  registers: 4,
  fuse: true,
  immediates: true,
  divmagic: true,
  useRanges: true,
});
img.id;
img.bytes;
img.fns.blend; // { bytes, insns, frame, saved, spills, regs, leaf }
// offset, instruction, the statement it covers, the line
img.listing('blend');
img.insns('blend'); // the same as rows, with ids
// on the emulator: steps are instructions
img.run('blend', [[1, 2, 3], 3, 2, 2]);
// instructions executed per source line, and the hottest
img.heat('blend', [[1, 2, 3], 3, 2, 2]);
img.check({ count: 200 });
// the stages: selected code on virtual registers, intervals, spills
p.machine('blend');
p.reference(); // the reference compiler's image size per function
// an image of an earlier revision; the head is left as it is
p.compile({ rev: 'r2' });
// two revisions compiled and compared instruction by instruction
p.asmDiff('r0', 'r6', { fn: 'blend' });
// or two option sets at one revision
p.asmDiff('r6', 'r6', { fn: 'blend', optionsB: { registers: 4 } });
```

Options: `registers` ('all' or a count), `fuse`, `immediates`,
`divmagic`, `useRanges` for instruction selection; `order` ('caller':
try t0–t4 and the a-registers first, or 'callee': s1–s11 first), `spill`
('furthest': spill whichever interval ends last, or 'current': spill the
one that found no register) and `hints` (parameters prefer their
a-register, returned values a0) for register allocation. An asmDiff
result has both sides' bytes, frame, spills and the instructions run on
20 generated cases, and rows `{ op: '=' | '-' | '+', a, b, text, covers
}` with branch targets written as block names, so code that only moved
compares equal.

Instruction selection tiles value trees; the register allocator is a
linear scan with callee-saved registers for values that live across
calls; the encoders, the division magic numbers, the disassembler and
the emulator are reused from the repo's compiler. An image is an entity
of its program and records the revision it was made from; its status is
current, older, or stale.

## Parameters
/**
 * Projects: a directory of Typed sources plus `project.json` (title, pipeline, per-function input specs). A port
 * of Compiler Workbench's projects.js source assembly: the sources named in `project.json` come first, then the
 * remaining `.typed` files in name order; they are concatenated (each ending in a newline) into one program whose
 * name is the project id with `-` replaced by `_`, and a file map records where each file starts.
 */
import { applyPass, type PassResult } from '../framework/passes/define-pass.js';
import type { AnalysisManager } from '../framework/contracts/analysis-manager.js';
import type { Artifact } from '../framework/core/types.js';
import { createIRArtifact } from '../framework/ir/adapters.js';
import type { ProgramInputs } from './evaluate.js';
import { blocksAdapter } from './ir.js';
import { ingest } from './lift.js';
import type { TypedBlocks } from './model.js';
import { joinText } from './format.js';
import { optimizationContract, PASSES, PIPELINES, type RevisionReport } from './passes.js';

export interface ProjectMeta {
  readonly title: string;
  readonly about: string;
  readonly group: string;
  readonly pipeline: string;
  readonly inputs: ProgramInputs;
  readonly sources: readonly string[];
  readonly [field: string]: unknown;
}

export interface ProjectSource {
  readonly id: string;
  readonly name: string;
  readonly meta: ProjectMeta;
  readonly source: string;
  readonly fileMap: readonly { readonly file: string; readonly start: number; readonly lines: number }[];
}

export function projectSource(id: string, files: Readonly<Record<string, string>>): ProjectSource {
  let m: Record<string, unknown> = {};
  if (files['project.json']) m = JSON.parse(files['project.json']);
  const typed = Object.keys(files)
    .filter(f => f.endsWith('.typed'))
    .sort();
  const named = Array.isArray(m.sources) ? (m.sources as string[]) : [];
  const sources = named.filter(f => files[f] !== undefined).concat(typed.filter(f => !named.includes(f)));
  // prose fields may be written as arrays of lines, so project.json stays narrow; they mean the joined text
  if (m.about !== undefined) m.about = joinText(m.about);
  if (Array.isArray(m.try)) m.try = m.try.map(x => joinText(x));
  if (m.scripts && typeof m.scripts === 'object')
    for (const sc of Object.values(m.scripts as Record<string, Record<string, unknown>>))
      if (sc && sc.about !== undefined) sc.about = joinText(sc.about);
  const meta = {
    title: id,
    about: '',
    group: 'Mine',
    pipeline: 'O2',
    inputs: {},
    ...m,
    sources,
  } as ProjectMeta;
  let source = '',
    line = 1;
  const fileMap: { file: string; start: number; lines: number }[] = [];
  for (const f of sources) {
    let t = files[f];
    if (!t.endsWith('\n')) t += '\n';
    const n = t.split('\n').length - 1;
    fileMap.push({ file: f, start: line, lines: n });
    source += t;
    line += n;
  }
  return { id, name: id.replace(/-/g, '_'), meta, source, fileMap };
}

/** r0 of a project as a v6 artifact. */
export function ingestProject(p: ProjectSource): Artifact<TypedBlocks> {
  return createIRArtifact(blocksAdapter, p.name, ingest(p.name, p.source).toNative());
}

export interface PipelineStep {
  readonly pass: string;
  readonly changed: boolean;
  readonly rev: number;
  readonly edits: number;
  readonly report?: RevisionReport;
  readonly result?: PassResult<TypedBlocks>;
  readonly rejected?: string;
}

/**
 * Run a named pipeline (or a list of pass names), checking each changed revision against `origin` with the
 * optimization contract, as Compiler Workbench's `p.pipeline(x)` does with checkEach. A rejected pass leaves the
 * program as it was and is reported; the pipeline continues.
 */
export async function runPipeline(
  origin: Artifact<TypedBlocks>,
  pipeline: string | readonly string[],
  options: {
    manager: AnalysisManager;
    inputs?: ProgramInputs;
    count?: number;
    seed?: number;
    /** The step limit of each case of the meaning check (default the check's 2e4 statements). */
    limit?: number;
    start?: Artifact<TypedBlocks>;
  },
): Promise<{ artifact: Artifact<TypedBlocks>; steps: PipelineStep[] }> {
  const names = typeof pipeline === 'string' ? PIPELINES[pipeline] : pipeline;
  if (!names)
    throw new Error(
      `unknownPipeline: no pipeline "${pipeline}"; pipelines: ${Object.keys(PIPELINES).join(', ')}`,
    );
  const contract = optimizationContract({
    inputs: options.inputs ?? {},
    count: options.count ?? 40,
    seed: options.seed ?? 7,
    ...(options.limit === undefined ? {} : { limit: options.limit }),
  });
  let cur = options.start ?? origin;
  const steps: PipelineStep[] = [];
  for (const name of names) {
    const pass = PASSES[name];
    if (!pass) throw new Error(`unknownPass: no pass named "${name}"`);
    try {
      const r = await applyPass(pass, cur, {
        manager: options.manager,
        contract,
        contractInputs: { origin },
      });
      steps.push({
        pass: name,
        changed: r.changed,
        rev: r.artifact.value.rev,
        edits: r.edits,
        report: r.report as RevisionReport,
        result: r,
      });
      cur = r.artifact;
    } catch (e) {
      if ((e as { code?: string }).code !== 'contractRejected') throw e;
      steps.push({
        pass: name,
        changed: false,
        rev: cur.value.rev,
        edits: 0,
        rejected: (e as Error).message,
      });
    }
  }
  return { artifact: cur, steps };
}
