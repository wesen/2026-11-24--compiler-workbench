 * `typed.meaning-kept`: every function of `candidate` agrees with `origin` (normally r0) on `count` generated
 * cases per function. The case parameters are part of the definition (its version carries their hash), and one
 * definition object exists per parameter set, as the contract registry requires.
 */
export function meaningKept(
  params: MeaningParams = {},
): DifferentialInvariant<{ origin: typeof BlocksIR; candidate: typeof BlocksIR }> {
  const count = params.count ?? 40,
    seed = params.seed ?? 7,
    inputs = params.inputs ?? {},
    limit = params.limit ?? 2e4,
    roots = params.roots ? [...params.roots].sort() : null;
  const key = canonicalJson(roots ? { count, seed, inputs, limit, roots } : { count, seed, inputs, limit });
  let check = meaningChecks.get(key);
  if (!check) {
    check = differential<{ origin: typeof BlocksIR; candidate: typeof BlocksIR }, Case, RunResult>({
      id: 'typed.meaning-kept',
      version: `1+${hash(key)}`,
      description: `${roots ? `the entries ${roots.join(', ')} agree` : 'every function agrees'} with the origin on ${count} generated cases (seed ${seed})`,
      inputs: { origin: BlocksIR, candidate: BlocksIR },
      baseline: 'origin',
      subject: 'candidate',
      count,
      seed,
      random: rng,
      cases: ({ origin }) => {
        const st = storeOf(origin.value);
        return (roots ?? [...st.fns.keys()]).flatMap(fn => casesFrom(st, fn, { count, seed, inputs: inputs[fn] ?? {} }));
      },
      run: (_side, art, c) =>
        evaluate(storeOf((art as Artifact<TypedBlocks>).value), c.fn, c.args, c.memory, { limit }),
      inconclusive: r => r.limit,
      compare: (expected, got, c) =>
        agrees(expected, got)
          ? true
          : {
              ok: false,
              reason: `${c.fn}#${c.n}: expected ${String(outcome(expected))}, got ${String(outcome(got))}`,
            },
      describeCase: c => ({ fn: c.fn, n: c.n, args: c.args }),
      maxCounterexamples: 5,
      // IRWB-004 D1: the cases and the origin's outcomes are a function of the origin's value (and of the parameters,
      // which the version carries); a case's outcome on the candidate is a function of the case and the code the case
      // can reach (closureKey). See src/typed/parts.ts.
      baselineKey: ({ origin }) => `${origin.kind}@${origin.schemaVersion}:${origin.revision}`,
      subjectKey: (art, c) => closureKey((art as Artifact<TypedBlocks>).value, c.fn),
      // IRWB-004 F4: an installed executor (worker threads) decides the cases; without one, they are decided here
      decide: (ports, cases, todo) =>
        meaningExecutor()?.decide({ params, origin: ports.origin, candidate: ports.candidate, cases, todo }),
    });
    meaningChecks.set(key, check);
  }
  return check;
}
// The evaluator at r0 against the reference compiler's images (typed-rv32.js, default policy), 100 cases per
// function, as the book's chapter 13 reports it: node tools/reference-check.mjs [--o2]
import { installVendor } from './node-vendor.mjs';
import { projectIds, projectFiles } from './corpus.mjs';
await installVendor({ reference: true });
const { Program } = await import('../dist/typed/program.js');
const { projectSource } = await import('../dist/typed/project.js');
const B = await import('../dist/typed/backend/index.js');
const o2 = process.argv.includes('--o2');
let fns = 0, agree = 0, decided = 0, inconclusive = 0; const bad = [];
for (const id of projectIds()) {
  const ps = projectSource(id, projectFiles(id)), p = Program.fromProject(ps);
  let image;
  if (o2) { await p.pipeline('O2'); image = B.lowerToImage(p.head).image; }       // our O2 image vs the evaluator
  else { const r = globalThis.typedRv32.compile(ps.source, [], undefined); image = B.imageFromCode(id, r.image, r.entries); }
  const c = p.check({ count: 100, against: (fn, k) => B.runImage(image, fn, k.args, k.memory, { limit: 2e5 }) });
  for (const f of c.fns) { fns++; agree += f.agree; decided += f.total; inconclusive += f.inconclusive; if (f.status === 'disagree') bad.push(`${id}.${f.fn}: ${JSON.stringify(f.counterexamples[0])}`); }
}
console.log(JSON.stringify({ against: o2 ? 'our O2 images' : 'reference images', functions: fns, decided, agree, inconclusive }));
if (bad.length) console.log(bad.join('\n'));
