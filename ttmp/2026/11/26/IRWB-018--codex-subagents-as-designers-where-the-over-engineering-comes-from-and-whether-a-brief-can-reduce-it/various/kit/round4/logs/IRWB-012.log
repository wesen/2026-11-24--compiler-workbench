        fn: f,
        rev: `r${this.rev}`,
        agree,
        total: decided,
        bothTrap,
        inconclusive,
        status: decided === 0 ? 'inconclusive' : agree === decided ? 'agree' : 'disagree',
        counterexamples,
      };
    });
    return {
      kind: 'check',
      program: this.id,
      rev: `r${this.rev}`,
