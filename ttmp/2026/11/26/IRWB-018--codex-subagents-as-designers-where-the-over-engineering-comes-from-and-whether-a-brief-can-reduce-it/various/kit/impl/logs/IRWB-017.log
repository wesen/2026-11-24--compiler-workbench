// Each rank occupies 16 units. Files a through h occupy its first eight.
// Position metadata uses units 128–134. Search and undo storage starts at 160.
function chessOnBoard(square: i32): bool {
    return square >= 0 && square < 128 && square % 16 < 8;
}

function chessSquare(dense: i32): i32 {
    return dense + (dense / 8) * 8;
}

function chessDense(square: i32): i32 {
    return square - (square / 16) * 8;
}

function chessMove(from: i32, to: i32, promotion: i32): i32 {
    return promotion * 4096 + chessDense(from) * 64 + chessDense(to);
}

function chessFrom(move: i32): i32 { return chessSquare((move / 64) % 64); }
function chessTo(move: i32): i32 { return chessSquare(move % 64); }
function chessPromotion(move: i32): i32 { return move / 4096; }
function chessSide(board: buffer): i32 { return board.charCodeAt(128); }
function chessPawnStep(side: i32): i32 { return side * 32 - 16; }

function chessRearPiece(file: i32): i32 {
    if (file === 0 || file === 7) return 4;
    if (file === 1 || file === 6) return 2;
    if (file === 2 || file === 5) return 3;
    if (file === 3) return 5;
    return 6;
}

function chessResetPosition(board: buffer): i32 {
    for (let i = 0; i < 128; i = i + 1) { board.setCharCodeAt(i, 0); }
    for (let file = 0; file < 8; file = file + 1) {
        const piece = chessRearPiece(file);
        board.setCharCodeAt(file, piece + 8);
        board.setCharCodeAt(16 + file, 9);
        board.setCharCodeAt(96 + file, 1);
        board.setCharCodeAt(112 + file, piece);
    }
    board.setCharCodeAt(128, 0);
    board.setCharCodeAt(129, 15);
    board.setCharCodeAt(130, 128);
    board.setCharCodeAt(131, 116);
    board.setCharCodeAt(132, 4);
    board.setCharCodeAt(133, 0);
    board.setCharCodeAt(134, 1);
    return 0;
}

function chessCopyPosition(source: buffer, dest: buffer): i32 {
    for (let i = 0; i < 135; i = i + 1) { dest.setCharCodeAt(i, source.charCodeAt(i)); }
    return 0;
}

function chessRay(direction: i32): i32 {
    if (direction < 2) return 1 - direction * 2;
    if (direction < 4) return 16 - (direction - 2) * 32;
    if (direction < 6) return 15 - (direction - 4) * 30;
    return 17 - (direction - 6) * 34;
}

function chessKnight(direction: i32): i32 {
    if (direction < 2) return 14 - direction * 28;
    if (direction < 4) return 18 - (direction - 2) * 36;
    if (direction < 6) return 31 - (direction - 4) * 62;
    return 33 - (direction - 6) * 66;
}


