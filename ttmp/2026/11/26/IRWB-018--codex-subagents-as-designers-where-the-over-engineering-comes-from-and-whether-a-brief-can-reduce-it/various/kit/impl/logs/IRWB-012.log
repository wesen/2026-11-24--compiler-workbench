    }
    return {
      kind: 'pipelineRun',
      pipeline: typeof x === 'string' ? x : 'adhoc',
      program: this.id,
      rev: `r${this.rev}`,
      steps,
    };
  }
  undo(): string {
    if (this.rev === 0) fail('noRevision', 'nothing to undo: this is r0');
    return this.checkout(this.rev - 1);
  }
  checkout(rev: number | string): string {
    const n = revNumber(rev);
    if (!(n >= 0 && n <= this.rev)) fail('noRevision', `${this.id} has revisions r0 to r${this.rev}`);
    this.revisions.length = n + 1;
    // the head's assumptions: a specialization undone takes its restriction with it
    for (const k of Object.keys(this.assumptions)) delete this.assumptions[k];
    Object.assign(this.assumptions, JSON.parse(JSON.stringify(this.revisions[n].assumptions ?? {})));
    return `r${this.rev}`;
  }
  revisionList() {
    return this.revisions.map(r => ({
      rev: `r${r.rev}`,
      pass: r.pass,
      edits: r.edits.length,
      ms: r.ms,
      revision: r.artifact.revision,
      ...(r.note ? { note: r.note } : {}),
      ...(r.fns ? { fns: r.fns } : {}),
    }));
  }
  edits(rev: number | string = this.rev): Edit[] {
      value: value.regions ? value.regions[f] : value[f],
    };
  }

  // ---- runs and checks ----
  cases(fn?: string, opts: { count?: number; seed?: number; inputs?: Record<string, unknown> } = {}) {
    const f = this.fname(fn);
    return casesFrom(storeOf(this.head.value), f, {
      count: opts.count ?? 20,
      seed: opts.seed ?? 7,
      inputs: { ...(this.inputs[f] ?? {}), ...(opts.inputs ?? {}) } as never,
    }).map(c => ({ n: c.n, args: c.args, items: c.items }));
  }
  private argSpec(type: string, v: unknown): unknown {
    const fe =
      (this.head.value.frontEnd as {
        records?: Record<string, unknown>;
        enums?: Record<string, Record<string, number>>;
      }) ?? {};
    const enums = fe.enums ?? {},
      records = fe.records ?? {};
    if (enums[type] && typeof v === 'string') {
      if (!(v in enums[type]))
        fail('badArgument', `${type} has no case "${v}"`, `cases: ${Object.keys(enums[type]).join(', ')}`);
      return enums[type][v];
    }
    if (
      records[type] &&
      v &&
      typeof v === 'object' &&
      !Array.isArray(v) &&
      !(v as { record?: unknown }).record
    )
      return {
        record: Object.fromEntries(
          Object.entries(v).map(([k, x]) => [k, [(x as number) | 0, (x as number) | 0]]),
        ),
      };
    if (Array.isArray(v)) return { cells: v };
    if (typeof v === 'string') return { string: v };
    if (typeof v === 'boolean') return v ? 1 : 0;
    return v ?? 0;
  }
  /** One call on the evaluator: positional args or named; buffers as arrays, strings as text. */
  exec(
    fn: string | undefined,
    args: readonly unknown[] | Record<string, unknown> = [],
    opts: { limit?: number; counts?: boolean } = {},
  ) {
    this.requireOk();
    const f = this.fname(fn),
      st = storeOf(this.head.value),
      F = st.fn(f);
    const list = Array.isArray(args)
      ? args
      : F.params.map((_, i) => (args as Record<string, unknown>)[F.locals[i].name]);
    const bench: Record<string, unknown> = {};
    F.params.forEach((t, i) => (bench[F.locals[i].name] = this.argSpec(t, list[i])));
    const c = benchCase(st, f, bench);
    const r = evaluate(st, f, c.args, c.memory, { limit: opts.limit ?? 5e6, counts: !!opts.counts });
    return {
      kind: 'run',
      engine: r.engine,
      fn: f,
      args: c.args,
      result: r.result,
      trap: r.trap,
      steps: r.steps,
      unit: r.unit,
      buffers: c.items
        .filter(x => x.kind === 'buffer')
        .map(x => ({ name: x.name, at: x.at, cells: readBuffer(r.bytes, x.at).slice(0, 64) })),
      ...(opts.counts && r.counts ? { counts: Object.fromEntries(r.counts) } : {}),
    };
  }
  /**
   * The head against r0 per function (Compiler Workbench's `p.check()`): agree / decided, traps on both sides,
   * step-limit hits, counterexamples. `against` may be a function that runs another engine on a case.
   */
  check(
    opts: {
      fn?: string;
      count?: number;
      seed?: number;
      against?: (fn: string, c: ReturnType<typeof casesFrom>[number]) => RunResult;
    } = {},
  ) {
    this.requireOk();
    const head = storeOf(this.head.value),
      base = storeOf(this.origin.value);
    const all = this.options.entries ? this.fns().filter(f => this.options.entries!.includes(f)) : this.fns();
    const rows = (opts.fn ? [this.fname(opts.fn)] : all).map(f => {
      const cases = casesFrom(head, f, {
        count: opts.count ?? 100,
        seed: opts.seed ?? 7,
        inputs: this.inputs[f] ?? {},
      });
      let agree = 0,
        bothTrap = 0,
        inconclusive = 0;
      const counterexamples: unknown[] = [];
      for (const c of cases) {
        const expected = opts.against
          ? evaluate(head, f, c.args, c.memory, { limit: 2e4 })
          : evaluate(base, f, c.args, c.memory, { limit: 2e4 });
        const got = opts.against ? opts.against(f, c) : evaluate(head, f, c.args, c.memory, { limit: 2e4 });
        if (expected.limit || got.limit) {
          inconclusive++;
          continue;
        }
        if (agrees(expected, got)) {
          agree++;
          if (expected.trap) bothTrap++;
        } else if (counterexamples.length < 5)
          counterexamples.push({
            n: c.n,
            args: c.args,
            expected: outcome(expected),
            got: got.fault ? `fault: ${got.trap}` : outcome(got),
          });
      }
      const decided = cases.length - inconclusive;
      return {
        fn: f,
        rev: `r${this.rev}`,
        agree,
        total: decided,
        bothTrap,
        inconclusive,
        status: decided === 0 ? 'inconclusive' : agree === decided ? 'agree' : 'disagree',
        counterexamples,
          : (rnd() * 4294967296) | 0;
}

export interface Case {
  readonly fn: string;
  readonly n: number;
  readonly args: readonly number[];
  readonly memory: Uint8Array;
  readonly items: readonly MemoryItem[];
}

/** `count` cases for one function, deterministic in `seed` (Compiler Workbench's `cases.from`). */
export function casesFrom(
  st: Store,
  fname: string,
  { count = 50, seed = 7, inputs = {} as FunctionInputs } = {},
): Case[] {
  const f = st.fn(fname),
    fe = tables(st),
    out: Case[] = [],
    rnd = rng(seed);
  // the first quarter of the cases (at most one per edge value) give each unspecified f32 parameter an edge value:
  // parameter i of case k takes edge (k + i), so every edge meets every parameter and NaN meets ordinary values
  const edges = f.params.includes('f32') ? Math.min(F32_EDGES.length, Math.floor(count / 4)) : 0;
  for (let k = 0; k < count; k++) {
    const mem = new Memory();
    const args = f.params.map((t, i) =>
      t === 'f32' && k < edges && inputs[f.locals[i].name] === undefined
        ? F32_EDGES[(k + i) % F32_EDGES.length]
        : makeValue(inputs[f.locals[i].name], t, mem, rnd, fe, f.locals[i].name),
    );
    out.push({ fn: fname, n: k, args, memory: mem.image(), items: mem.items.slice() });
  }
  return out;
}

/** One concrete call: `{ name: number | {cells} | {buffer} | {string} }`. */
export function benchCase(st: Store, fname: string, bench: Readonly<Record<string, unknown>> = {}): Case {
  const f = st.fn(fname),
    mem = new Memory(),
    rnd = rng(1);
  const args = f.params.map((t, i) =>
    makeValue(bench[f.locals[i].name] ?? 0, t, mem, rnd, tables(st), f.locals[i].name),
  );
  return { fn: fname, n: 0, args, memory: mem.image(), items: mem.items.slice() };
}

const MASK = 31;
export function binop(op: string, a: number, b: number): number {
  switch (op) {
    case 'add':
      return (a + b) | 0;
    case 'sub':
      return (a - b) | 0;
    case 'mul':
      return Math.imul(a, b);
    case 'div':
      if (b === 0) throw new Trap('division by zero');
      if (a === -2147483648 && b === -1) throw new Trap('division overflow');
      return (a / b) | 0;
    case 'rem':
      if (b === 0) throw new Trap('division by zero');
      if (b === -1) return 0;
      return a % b | 0;
    case 'and':
      return a & b;
    case 'or':
      return a | b;
    case 'xor':
      return a ^ b;
    case 'shl':
      ? Object.fromEntries(Object.entries(v).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)))
      : v,
  );

/**
 * `typed.meaning-kept`: every function of `candidate` agrees with `origin` (normally r0) on `count` generated
 * cases per function. The case parameters are part of the definition (its version carries their hash), and one
 * definition object exists per parameter set, as the contract registry requires.
 */
export function meaningKept(
  params: MeaningParams = {},
): DifferentialInvariant<{ origin: typeof BlocksIR; candidate: typeof BlocksIR }> {
  const count = params.count ?? 40,
    seed = params.seed ?? 7,
    inputs = params.inputs ?? {},
    limit = params.limit ?? 2e4,
    roots = params.roots ? [...params.roots].sort() : null;
  const key = canonicalJson(roots ? { count, seed, inputs, limit, roots } : { count, seed, inputs, limit });
  let check = meaningChecks.get(key);
  if (!check) {
    check = differential<{ origin: typeof BlocksIR; candidate: typeof BlocksIR }, Case, RunResult>({
      id: 'typed.meaning-kept',
      version: `1+${hash(key)}`,
      description: `${roots ? `the entries ${roots.join(', ')} agree` : 'every function agrees'} with the origin on ${count} generated cases (seed ${seed})`,
      inputs: { origin: BlocksIR, candidate: BlocksIR },
      baseline: 'origin',
      subject: 'candidate',
      count,
      seed,
      random: rng,
      cases: ({ origin }) => {
        const st = storeOf(origin.value);
        return (roots ?? [...st.fns.keys()]).flatMap(fn => casesFrom(st, fn, { count, seed, inputs: inputs[fn] ?? {} }));
      },
      run: (_side, art, c) =>
        evaluate(storeOf((art as Artifact<TypedBlocks>).value), c.fn, c.args, c.memory, { limit }),
      inconclusive: r => r.limit,
      compare: (expected, got, c) =>
        agrees(expected, got)
          ? true
          : {
              ok: false,
              reason: `${c.fn}#${c.n}: expected ${String(outcome(expected))}, got ${String(outcome(got))}`,
            },
      describeCase: c => ({ fn: c.fn, n: c.n, args: c.args }),
      maxCounterexamples: 5,
      // IRWB-004 D1: the cases and the origin's outcomes are a function of the origin's value (and of the parameters,
      // which the version carries); a case's outcome on the candidate is a function of the case and the code the case
      // can reach (closureKey). See src/typed/parts.ts.
      baselineKey: ({ origin }) => `${origin.kind}@${origin.schemaVersion}:${origin.revision}`,
      subjectKey: (art, c) => closureKey((art as Artifact<TypedBlocks>).value, c.fn),
      // IRWB-004 F4: an installed executor (worker threads) decides the cases; without one, they are decided here
      decide: (ports, cases, todo) =>
        meaningExecutor()?.decide({ params, origin: ports.origin, candidate: ports.candidate, cases, todo }),
    });
    meaningChecks.set(key, check);
  }
  return check;
}
// Read corpus/projects/<id>/ into { files } maps for the typed domain (Node only).
import { readdirSync, readFileSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';

export const corpusDir = fileURLToPath(new URL('../corpus/projects/', import.meta.url));
export const projectIds = () => readdirSync(corpusDir).filter(d => statSync(join(corpusDir, d)).isDirectory()).sort();
export function projectFiles(id) {
  const dir = join(corpusDir, id), files = {};
  for (const f of readdirSync(dir)) if (f === 'project.json' || f.endsWith('.typed')) files[f] = readFileSync(join(dir, f), 'utf8');
  return files;
}

/** Every file of a project (project.json, sources, notes, scripts/, ui/), path -> text. */
export function projectAllFiles(id) {
  const out = {};
  const walk = (dir, prefix) => {
    for (const f of readdirSync(dir).sort()) {
      const p = join(dir, f);
      if (statSync(p).isDirectory()) walk(p, prefix + f + '/');
      else out[prefix + f] = readFileSync(p, 'utf8');
    }
  };
  walk(join(corpusDir, id), '');
  return out;
}

/** The built-in projects in the book's order (corpus/projects/index.json), as { id, files }. */
export function builtinProjects() {
  const order = JSON.parse(readFileSync(join(corpusDir, 'index.json'), 'utf8')).order;
  const ids = [...order, ...projectIds().filter(id => !order.includes(id))];
  return ids.map(id => ({ id, files: projectAllFiles(id) }));
}
