export interface ImageInsn {
  readonly id: string;
  readonly fn: string;
  /** Byte address in the image. */
  readonly offset: number;
  /** The machine operation the backend emitted (`addi`, `blt`, `call`, `ret`, ...). */
  readonly op: string;
  readonly word: number;
  /** The disassembler's reading of `word`. */
  readonly text: string;
  /** `text` with its target named (a block, `exit`, a local label, a callee) instead of addressed. */
  readonly sym: string;
  /** The typed.blocks ids this instruction implements: a value and its statement, or the function. */
  readonly covers: readonly string[];
  readonly why?: string;
  /** Branches and jumps: the byte address of the target, and its label. */
  readonly target?: number;
  readonly label?: string;
  readonly callee?: string;
}

/**
/**
 * Lower a typed.blocks artifact to an `rv32.image` artifact (id `img:PROGRAM` unless given), with the
 * correspondence from the program's entities to the image's instructions.
 */
export function lowerToImage(
  blocks: Artifact<TypedBlocks>,
  options: BackendOptionsInput = {},
  opts: BackendFacts & { readonly id?: string } = {},
): Lowered {
  const image = createIRArtifact(
    imageAdapter,
    opts.id ?? `img:${blocks.value.program}`,
    compileImage(blocks, options, opts),
  );
  return { image, correspondence: imageCorrespondence(blocks, image) };
}

/** IRWB-003: per function, which variant the estimate chose under these options (none for the defaults). */
export function variantChoices(
  blocks: Artifact<TypedBlocks>,
  options: BackendOptionsInput = {},
  facts: BackendFacts = {},
): Record<string, VariantChoice | null> {
  const o = checkBackendOptions(options),
    st = storeOf(blocks.value);
  const { liveness, ranges } = factsFor(blocks, o, facts);
  return Object.fromEntries(
    [...st.fns.values()].map(f => [f.name, compileFunction(st, f, o, liveness, ranges).choice ?? null]),
  );
}

