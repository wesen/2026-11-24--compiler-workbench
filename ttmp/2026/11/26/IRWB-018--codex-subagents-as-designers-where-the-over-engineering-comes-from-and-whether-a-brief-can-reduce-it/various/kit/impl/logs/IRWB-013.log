      pass: pass.typed.name,
      rev: `r${this.rev}`,
      edits: report.edits.length,
      changed: true,
      kinds: report.kinds,
      ms,
      ...(evidence ? { check: `${evidence.agree}/${evidence.total - evidence.inconclusive}` } : {}),
    };
