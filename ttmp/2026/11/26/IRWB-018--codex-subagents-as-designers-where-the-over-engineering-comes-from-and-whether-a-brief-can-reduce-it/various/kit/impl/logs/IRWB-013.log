function sha256Block(message: buffer, roundK: buffer, out: buffer): i32 {
    const w = new Int32Array(64);
    const length = message.length;
    for (let i = 0; i < length; i = i + 1) {
        const word = i / 4;
        w[word] = w[word] | (message.charCodeAt(i) << ((3 - (i & 3)) * 8));
    }
    const padWord = length / 4;
    w[padWord] = w[padWord] | (0x80 << ((3 - (length & 3)) * 8));
    w[15] = length * 8;

    for (let t = 16; t < 64; t = t + 1) {
        const x = w[t - 15];
        const y = w[t - 2];
        const x7 = rotr(x, 7);
        const x18 = rotr(x, 18);
        const y17 = rotr(y, 17);
        const y19 = rotr(y, 19);
        const s0 = x7 "'^ x18 ''^ (x >>> 3);
        const s1 = y17 ''^ y19 ''^ (y >>> 10);
        w[t] = w[t - 16] + s0 + w[t - 7] + s1;
    }

