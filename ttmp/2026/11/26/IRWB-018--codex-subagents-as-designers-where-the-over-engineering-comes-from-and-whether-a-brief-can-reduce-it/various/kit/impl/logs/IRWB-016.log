export interface WbConfig {
  readonly storage?: Storage | null;
  readonly projects?: readonly BuiltinProject[];
  readonly book?: readonly Chapter[];
  /** The API reference (Markdown); `wb.help(topic)` prints one `##` section. */
  readonly reference?: string;
  /** The workbench's own source, path -> text, for `wb.source` and the Code view. */
  readonly sources?: Readonly<Record<string, string>>;
}

/** Handles over a working store (a pass's), for user pass bodies and user analyses. */
function storeHost(st: Store): EntityHost {
  const get = (id: string) => st.get(id);
  return {
    id: `prog:${st.program}`,
    rev: st.rev,
    get head() {
      return st;
    },
    find: id => (st.has(id) ? { entity: st.get(id), store: st, rev: st.rev } : undefined),
    statusOf: id => (st.has(id) ? 'live' : 'absent'),
    text: id => describeText(st, id),
    lineage: id => lineageOf(get, id),
    lines: id => linesOf(get, id),
    why: id => ({ id, text: describeText(st, id) }),
    history: () => [],
    fact: (name, fn) => {
      const a = FACTS.get(name);
      if (!a || ['liveness', 'reaching', 'ranges'].includes(name) || a.user)
        fail('unknownAnalysis', `inside a pass, "${name}" comes through .needs({ alias: '${name}' })`);
      const value = a!.compute(null as never, st, st.fn(fn!));
      return { id: `fact:${name}(${fn})`, status: 'fresh', rev: `r${st.rev}`, ms: 0, value };
    },
    listing: fn => listingOf(st, fn),
    related: () => ({ lines: [], values: [], stmts: [], insns: [] }),
    },
    statusOf(id: string) {
      return p.statusOf(id);
    },
    text(id: string) {
      return p.text(id);
    },
    whyChain(id: string) {
      return k.whyChain(id);
    },

    // ---- runs and checks ----
    cases(fn?: string, opts: { count?: number; seed?: number; inputs?: Record<string, unknown> } = {}) {
      return k.cases(fname(fn), opts);
    },
    exec(
      fn: string | undefined,
      args: readonly unknown[] | Record<string, unknown> = [],
      opts: { engine?: string; image?: unknown; limit?: number; counts?: boolean } = {},
    ) {
      const f = fname(fn);
      const engine = opts.engine || (opts.image ? 'rv32' : 'evaluator');
      let out: Record<string, unknown>;
      if (engine === 'rv32') {
        const img = opts.image ? imageEnt(opts.image) : p.compile();
        const c = benchOf(p.head, f, args);
        const r = runImage(img.artifact, f, c.args, c.memory, { limit: opts.limit || 5e6 });
        out = {
          kind: 'run',
          engine: 'rv32',
          image: img.id,
          fn: f,
          args: c.args,
          result: r.result,
          trap: r.trap,
          steps: r.steps,
          unit: r.unit,
          ...(r.fault ? { fault: true } : {}),
          buffers: r.bytes.length
            ? c.items
                .filter(x => x.kind === 'buffer')
                .map(x => ({ name: x.name, at: x.at, cells: readBuffer(r.bytes, x.at).slice(0, 64) }))
            : [],
        };
      } else out = k.exec(f, args, { limit: opts.limit, counts: opts.counts });
      env.emit('run', { program: p.name, run: out });
      return out;
    },
    check(opts: { fn?: string; count?: number; seed?: number; against?: string; image?: unknown } = {}) {
      p.requireOk();
      const against = opts.against || 'r0';
      if (against === 'reference')
        fail(
          'noReference',
          `${p.id} has no reference image: reference images are not shipped in this build`,
          { fix: "check against 'r0' or 'image'" },

