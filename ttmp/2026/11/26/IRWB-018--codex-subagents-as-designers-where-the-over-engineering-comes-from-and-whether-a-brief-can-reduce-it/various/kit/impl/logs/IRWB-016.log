  readonly note?: string;
  /** The assumptions in force when this revision was made (see `Program.assume`). */
  readonly assumptions?: Readonly<Record<string, Readonly<Record<string, number>>>>;
}

export interface ApplyResult {
  readonly pass: string;
  readonly rev: string;
  readonly edits: number;
  readonly changed: boolean;
  readonly kinds?: Readonly<Record<string, number>>;
  readonly ms: number;
  readonly check?: string;
}

const revNumber = (r: number | string) => (typeof r === 'string' ? +r.replace(/^r/, '') : r);
const now = () => (typeof performance !== 'undefined' ? performance.now() : Date.now());

export class Program {
  readonly manager = new AnalysisManager();
  readonly revisions: Revision[] = [];
  status: 'ok' | 'frontEndError' | 'unsupported' = 'ok';
  error: { message: string; line?: number; col?: number } | null = null;
  constructor(
    readonly name: string,
    readonly source: string,
    readonly options: {
      inputs?: ProgramInputs;
      fileMap?: ProjectSource['fileMap'];
      project?: string;
      /** How to ingest: from the tape (`{ tape: true, maxSourceLength }`, e.g. for Candela) or by default. */
      ingest?: IngestOptions;
      /**
       * The functions the host calls (Candela: the gallery slot's four). When given, checks compare only these, and
       * passes may change or remove functions only they call. Absent: every function is an entry.
       */
      entries?: readonly string[];
    } = {},
  ) {
    let r0: Artifact<TypedBlocks>;
    try {
      r0 = createIRArtifact(blocksAdapter, name, ingest(name, source, options.ingest).toNative());
    } catch (e) {
      if (!(e instanceof LiftError)) throw e;
      this.status = e.code === 'unsupportedOp' ? 'unsupported' : 'frontEndError';
      this.error = { message: e.message, ...(e.at ?? {}) };
      r0 = createIRArtifact(blocksAdapter, name, {
        formatVersion: 1,
        program: name,
        rev: 0,
        counters: {},
        fnOrder: [],
        fns: {},
        blocks: {},
        stmts: {},
        values: {},
        ops: {},
        frontEnd: { wasmBytes: 0, records: null, enums: null, signatures: null },
      });
    }
    this.revisions.push({
      rev: 0,
      pass: 'ingest',
      artifact: r0,
      edits: [],
      ms: 0,
      note: 'ingest from the typed front end',
    });
  }

  static fromProject(p: ProjectSource): Program {
    return new Program(p.name, p.source, {
      inputs: p.meta.inputs,
      fileMap: p.fileMap,
      project: p.id,
      ...(p.meta.ingest ? { ingest: p.meta.ingest } : {}),
      ...(p.meta.entries ? { entries: p.meta.entries } : {}),
    });
  }

  get id(): string {
    return `prog:${this.name}`;
  }
  /** Parameter values every check now assumes (set by `assume`, e.g. from a specialization's outer facts). */
  readonly assumptions: Record<string, Record<string, number>> = {};
  /** The case inputs checks use: the project's specifications, with assumed parameters fixed. */
  get inputs(): ProgramInputs {
    const base = this.options.inputs ?? {};
    const out: Record<string, Record<string, unknown>> = Object.fromEntries(
      Object.entries(base).map(([f, v]) => [f, { ...v }]),
    );
    for (const [f, params] of Object.entries(this.assumptions))
      for (const [k, v] of Object.entries(params)) {
        const dot = k.indexOf('.');
        if (dot < 0) {
          out[f] = { ...(out[f] ?? {}), [k]: v };
          continue;
        }
        // a record field: fix it inside the parameter's record specification
        const param = k.slice(0, dot),
          field = k.slice(dot + 1);
        const spec = ((out[f] ?? {})[param] ?? { record: {} }) as { record?: Record<string, unknown> };
        out[f] = { ...(out[f] ?? {}), [param]: { ...spec, record: { ...(spec.record ?? {}), [field]: { oneOf: [v] } } } };
      }
    return out as ProgramInputs;
  }
  /**
   * Restrict the program's meaning to inputs satisfying `bindings`: from now on the contract every pass must meet,
   * and every check, compares with r0 only on such inputs. Returns the previous assumptions (for `unassume`).
   */
  assume(
    bindings: readonly { fn?: string; param?: string; record?: string; field?: string; value: number }[],
  ): Record<string, Record<string, number>> {
    const previous = JSON.parse(JSON.stringify(this.assumptions));
    for (const b of bindings) {
      if (b.record && b.field) {
        // every parameter of that record type, in every function
        const st = storeOf(this.head.value);
        for (const f of st.fns.values())
          f.params.forEach((t, i) => {
            if (t === b.record) (this.assumptions[f.name] ??= {})[`${f.locals[i].name}.${b.field}`] = b.value;
          });
        continue;
      }
      this.fname(b.fn!);
      (this.assumptions[b.fn!] ??= {})[b.param!] = b.value;
    }
    return previous;
  }
  /** Specialize on an outer artifact's facts: assume them, then apply the `specialize` pass under that contract. */
  async specialize(bindings: Artifact<import('./specialize.js').Bindings>): Promise<ApplyResult> {
    const { specialize } = await import('./specialize.js');
    const previous = this.assume(bindings.value.bindings);
    try {
      return await this.apply(specialize, { params: { bindings } });
    } catch (e) {
      for (const k of Object.keys(this.assumptions)) delete this.assumptions[k];
      Object.assign(this.assumptions, previous);
      throw e;
    }
  }
  get rev(): number {
    return this.revisions.length - 1;
  }
  get head(): Artifact<TypedBlocks> {
    return this.revisions[this.rev].artifact;
  }
  get origin(): Artifact<TypedBlocks> {
    return this.revisions[0].artifact;
  }
  private requireOk(): void {
    if (this.status !== 'ok') fail('notCompiled', `${this.id} did not compile: ${this.error?.message}`);
  }
  artifact(rev: number | string = this.rev): Artifact<TypedBlocks> {
    const n = revNumber(rev);
    if (!(n >= 0 && n <= this.rev)) fail('noRevision', `${this.id} has revisions r0 to r${this.rev}`);
    return this.revisions[n].artifact;
  }

  // ---- structure ----
  fns(): string[] {
    return [...this.head.value.fnOrder];
  }
  private fname(fn?: string): string {
    const names = this.fns();
    if (fn === undefined) return names[0] ?? fail('unknownFunction', `${this.id} has no functions`);
    if (!names.includes(fn))
      fail('unknownFunction', `${this.id} has no function "${fn}"`, `functions: ${names.join(', ')}`);
    return fn;
  }
  listing(fn?: string): string {
    this.requireOk();
    return listing(storeOf(this.head.value), fn === undefined ? undefined : this.fname(fn));
  }
  has(id: string): boolean {
    return this.lookup(id) !== undefined;
  }

  // ---- the pass manager ----
  resolvePass(x: string | TypedPass): TypedPass {
    if (typeof x !== 'string') return x;
    return (
      PASSES[x] ??
      USER_PASSES.get(x) ??
      fail(
        'unknownPass',
        `no pass named "${x}"`,
        `passes: ${[...Object.keys(PASSES), ...USER_PASSES.keys()].join(', ')}`,
      )
    );
  }
  /** Apply one pass as one revision; checked against r0 unless `check: false`. Nothing changes on rejection. */
  async apply(
    x: string | TypedPass,
    opts: { params?: Record<string, unknown>; check?: boolean; count?: number; seed?: number } = {},
  ): Promise<ApplyResult> {
    this.requireOk();
    const pass = this.resolvePass(x),
      t0 = now();
    const contract =
      opts.check === false
        ? undefined
        : optimizationContract({
            inputs: this.inputs,
            count: opts.count ?? 40,
            seed: opts.seed ?? 7,
            ...(this.options.entries ? { roots: this.options.entries } : {}),
          });
    const r = await applyPass(pass, this.head, {
      manager: this.manager,
      params: opts.params,
      contract,
      contractInputs: { origin: this.origin },
    });
    const ms = +(now() - t0).toFixed(2);
    if (!r.changed) return { pass: pass.typed.name, rev: `r${this.rev}`, edits: 0, changed: false, ms };
    const report = r.report as RevisionReport;
    this.revisions.push({
      rev: this.rev + 1,
      pass: pass.typed.name,
      artifact: r.artifact,
      edits: report.edits,
      correspondence: r.correspondence,
      ms,
      fns: report.fns,
      assumptions: JSON.parse(JSON.stringify(this.assumptions)),
    });
    const checks =
      (r.contract as { execution?: { checks?: { phase: string; evidence?: any }[] } } | undefined)?.execution
        ?.checks ?? [];
    const evidence = checks.find(c => c.phase === 'ensures' && c.evidence?.method === 'sampled')?.evidence as
      | { agree: number; total: number; inconclusive: number }
      | undefined;
    return {
      pass: pass.typed.name,
      rev: `r${this.rev}`,
      edits: report.edits.length,
      changed: true,
      kinds: report.kinds,
// Corpus parity: every project's pipeline with checks after each pass, then a 100-case check of the head
// revision against r0, totalled as Compiler Workbench's book reports them (projects, functions, decided cases).
// node tools/parity.mjs [--json] [id...]
import { installVendor } from './node-vendor.mjs';
import { projectIds, projectFiles } from './corpus.mjs';

await installVendor();
const { projectSource, ingestProject, runPipeline } = await import('../dist/typed/project.js');
const { meaningKept } = await import('../dist/typed/evaluate.js');
const { AnalysisManager } = await import('../dist/framework/contracts/index.js');

const args = process.argv.slice(2), json = args.includes('--json'), only = args.filter(a => !a.startsWith('--'));
const rows = [];
let fns = 0, total = 0, agree = 0, inconclusive = 0, failures = 0;
for (const id of only.length ? only : projectIds()) {
  const p = projectSource(id, projectFiles(id));
  const row = { id, pipeline: p.meta.pipeline };
  try {
    const r0 = ingestProject(p), manager = new AnalysisManager();
    const roots = p.meta.entries ? { roots: p.meta.entries } : {};
    const run = await runPipeline(r0, p.meta.pipeline, { manager, inputs: p.meta.inputs, ...roots });
    row.revisions = run.steps.filter(s => s.changed).map(s => s.pass);
    row.rejected = run.steps.filter(s => s.rejected).map(s => s.pass);
    const final = await manager.checkInvariant(meaningKept({ inputs: p.meta.inputs, count: 100, ...roots }), { origin: r0, candidate: run.artifact });
    const ev = final.evidence;
    row.fns = Object.keys(r0.value.fns).length;
    Object.assign(row, { total: ev.total, agree: ev.agree, inconclusive: ev.inconclusive, disagree: ev.disagree });
    fns += row.fns; total += ev.total; agree += ev.agree; inconclusive += ev.inconclusive;
    if (ev.disagree || (row.rejected.length && p.meta.pipeline !== 'broken')) failures++;
  } catch (e) {
    row.error = String(e.message).slice(0, 200);
    failures++;
  }
  rows.push(row);
}
const summary = { projects: rows.length, functions: fns, cases: total, decided: total - inconclusive, agree, inconclusive, failures };
if (json) console.log(JSON.stringify({ summary, rows }, null, 2));
else {
  for (const r of rows) console.log(`${r.id.padEnd(22)} ${r.error ? 'ERROR ' + r.error : `${String(r.revisions.length).padStart(2)} revs  ${r.agree}/${r.total - r.inconclusive} (+${r.inconclusive} limit)${r.rejected.length ? '  rejected: ' + r.rejected.join(',') : ''}`}`);
  console.log(JSON.stringify(summary));
}
